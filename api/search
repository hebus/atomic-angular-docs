6":5,"2157":5,"2158":5,"2159":5,"2160":5,"2161":5,"2162":5,"2163":5,"2164":5,"2165":5,"2166":5,"2167":5,"2168":5,"2169":5,"2170":5,"2171":5,"2172":5,"2173":5,"2174":5,"2175":5,"2176":5,"2177":5,"2178":5,"2179":5,"2180":5,"2181":5,"2182":5,"2183":5,"2184":5,"2185":5,"2186":5,"2187":5,"2188":5,"2189":5,"2190":5,"2191":5,"2192":5,"2193":5,"2194":5}}},"docs":{"docs":{"1":{"id":"/docs/atomic-angular","page_id":"/docs/atomic-angular","type":"page","content":"@sinequa/atomic-angular","breadcrumbs":["Docs","Atomic Angular"],"tags":[],"url":"/docs/atomic-angular"},"2":{"id":"/docs/atomic-angular-0","page_id":"/docs/atomic-angular","tags":[],"type":"text","url":"/docs/atomic-angular","content":"The business layer of Sinequa's Angular front-end stack — search features (auth, filters, preview, collections) composed from atomic and galactik."},"3":{"id":"/docs/atomic-angular-1","page_id":"/docs/atomic-angular","type":"heading","tags":[],"url":"/docs/atomic-angular#what-this-library-is-not","content":"What this library is not"},"4":{"id":"/docs/atomic-angular-2","page_id":"/docs/atomic-angular","type":"heading","tags":[],"url":"/docs/atomic-angular#whats-next","content":"What's next"},"5":{"id":"/docs/atomic-angular-3","page_id":"/docs/atomic-angular","tags":[],"type":"text","url":"/docs/atomic-angular","content":"`@sinequa/atomic-angular` composes Angular search features — sign-in, filtering and aggregations, document\npreview, collections, saved searches, and more — on top of two lower-level libraries: `@sinequa/atomic` (the\nframework-agnostic client that talks to a Sinequa server) and `@sinequa/galactik` (the presentation components\nthis library's UI is built from). It is the only layer in this stack allowed to depend on both a presentation\nlibrary and the backend client at once."},"6":{"id":"/docs/atomic-angular-4","page_id":"/docs/atomic-angular","tags":[],"type":"text","url":"/docs/atomic-angular","content":"A Sinequa application typically layers three things: a **backend** (the search engine and its REST API), a\n**client** (`@sinequa/atomic`, which turns REST calls into typed queries and results), and a **UI layer**\n(this library) that renders that data as sign-in screens, facets, result lists and previews. Nothing here talks\nto the backend directly — every network call goes through `@sinequa/atomic`."},"7":{"id":"/docs/atomic-angular-5","page_id":"/docs/atomic-angular","tags":[],"type":"text","url":"/docs/atomic-angular#what-this-library-is-not","content":"`@sinequa/atomic-angular` never renders raw presentation markup of its own where an equivalent already exists\nin `@sinequa/galactik` — new code here composes `galactik` components rather than reinventing them. It no\nlonger depends on `@sinequa/ui`, the older presentation library `galactik` replaces; see this repository's\n`ARCHITECTURE.md` for the state of that migration."},"8":{"id":"/docs/atomic-angular-6","page_id":"/docs/atomic-angular","tags":[],"type":"text","url":"/docs/atomic-angular#whats-next","content":"Install the library, connect a Sinequa client, and render a first authenticated search screen."},"9":{"id":"/docs/atomic-angular-7","page_id":"/docs/atomic-angular","tags":[],"type":"text","url":"/docs/atomic-angular#whats-next","content":"The richest guide in this documentation, and the reference every other page follows."},"10":{"id":"/docs/atomic-angular/start","page_id":"/docs/atomic-angular/start","type":"page","content":"Getting started","breadcrumbs":["Docs","Atomic Angular"],"tags":[],"url":"/docs/atomic-angular/start"},"11":{"id":"/docs/atomic-angular/start-0","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start","content":"Install @sinequa/atomic-angular, connect a client, sign a user in, and render a first authenticated search screen with a facet."},"12":{"id":"/docs/atomic-angular/start-1","page_id":"/docs/atomic-angular/start","type":"heading","tags":[],"url":"/docs/atomic-angular/start#install","content":"Install"},"13":{"id":"/docs/atomic-angular/start-2","page_id":"/docs/atomic-angular/start","type":"heading","tags":[],"url":"/docs/atomic-angular/start#provide-a-client-and-bootstrap-the-application","content":"Provide a client and bootstrap the application"},"14":{"id":"/docs/atomic-angular/start-3","page_id":"/docs/atomic-angular/start","type":"heading","tags":[],"url":"/docs/atomic-angular/start#authenticate-the-user","content":"Authenticate the user"},"15":{"id":"/docs/atomic-angular/start-4","page_id":"/docs/atomic-angular/start","type":"heading","tags":[],"url":"/docs/atomic-angular/start#render-a-first-search-screen","content":"Render a first search screen"},"16":{"id":"/docs/atomic-angular/start-5","page_id":"/docs/atomic-angular/start","type":"heading","tags":[],"url":"/docs/atomic-angular/start#whats-next","content":"What's next"},"17":{"id":"/docs/atomic-angular/start-6","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start","content":"This walks through the whole path from an empty Angular application to a first authenticated screen showing\nsearch results and a facet. Each step links to the page that covers it in full — this tutorial only shows the\nminimum needed to reach the next step."},"18":{"id":"/docs/atomic-angular/start-7","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start","content":"You need a Sinequa server reachable from the browser, with at least one query web service configured. Nothing\nhere works against a mock — the client, the guard and the query service all make real HTTP requests."},"19":{"id":"/docs/atomic-angular/start-8","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#install","content":"`@sinequa/atomic-angular` composes two lower-level libraries — `@sinequa/galactik` (presentation) and\n`@sinequa/atomic` (the framework-agnostic client). Both are peer dependencies, alongside `@angular/aria`."},"20":{"id":"/docs/atomic-angular/start-9","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#install","content":"`chart.js`/`chartjs-chart-matrix` and `markdown-it` are also peer dependencies, but only needed if you use the\nChart.js-based data visualization components or the preview's Markdown fallback —\nskip them otherwise."},"21":{"id":"/docs/atomic-angular/start-10","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#provide-a-client-and-bootstrap-the-application","content":"Every store, service and component reaches the backend through one client. Registering it and bootstrapping\nthe application are two providers in `app.config.ts`."},"22":{"id":"/docs/atomic-angular/start-11","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#provide-a-client-and-bootstrap-the-application","content":"`bootstrapApp()` resolves the authentication mode, signs the user in if a session already exists, and\ninitializes the application's stores before the first view renders — see Provide a\nclient and Bootstrap the application\nfor the full contract, including what to do when part of the configuration is only known at runtime."},"23":{"id":"/docs/atomic-angular/start-12","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#authenticate-the-user","content":"Route `/login` and `/logout` to `AuthPageComponent` — it switches between the credentials form,\nchange-password and forgot-password based on the route and the `mode` query param — and guard every protected\nroute with `AuthGuard()`."},"24":{"id":"/docs/atomic-angular/start-13","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#authenticate-the-user","content":"`AuthGuard()` checks the session, loads the signed-in user, and — in `credentials` mode — redirects to\nchange-password when the session's password has expired; it never guards `/login`/`/logout` themselves. See\nSign In for embedding the form outside a full page, and Authentication\nflows for how the guard, the interceptor, sign-in and logout fit together\nend to end."},"25":{"id":"/docs/atomic-angular/start-14","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#render-a-first-search-screen","content":"`QueryService` runs the search and exposes the result as a signal; `<Aggregation>` renders one facet from that\nsame result and turns a click into an applied filter."},"26":{"id":"/docs/atomic-angular/start-15","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#render-a-first-search-screen","content":"Clicking a value in the \"Sources\" facet applies a filter to the shared query state and re-runs the search on\nits own — nothing in `SearchComponent` has to react to that click by hand. See Filtering\nresults for facet types, controlled mode and custom item templates, and\nQuery for paging, running several queries in parallel, and telling a failed request\napart from a genuine zero-match."},"27":{"id":"/docs/atomic-angular/start-16","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#whats-next","content":"How the guard, the interceptor, sign-in and logout fit together end to end."},"28":{"id":"/docs/atomic-angular/start-17","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#whats-next","content":"Facet types, controlled mode, custom item templates, and every input and pitfall in depth."},"29":{"id":"/docs/atomic-angular/start-18","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#whats-next","content":"Configuration resolved at runtime, reading the client without redirecting, and serving a second backend."},"30":{"id":"/docs/atomic-angular/start-19","page_id":"/docs/atomic-angular/start","tags":[],"type":"text","url":"/docs/atomic-angular/start#whats-next","content":"Paging, running several queries in parallel, and the result/failure contract in full."},"31":{"id":"/docs/galactik","page_id":"/docs/galactik","type":"page","content":"@sinequa/galactik","breadcrumbs":["Docs","Galactik"],"tags":[],"url":"/docs/galactik"},"32":{"id":"/docs/galactik-0","page_id":"/docs/galactik","tags":[],"type":"text","url":"/docs/galactik","content":"A pure Angular presentation library of tokens-only components — buttons, forms, overlays, navigation — for building Sinequa search UIs."},"33":{"id":"/docs/galactik-1","page_id":"/docs/galactik","type":"heading","tags":[],"url":"/docs/galactik#what-this-library-is-not","content":"What this library is not"},"34":{"id":"/docs/galactik-2","page_id":"/docs/galactik","type":"heading","tags":[],"url":"/docs/galactik#whats-next","content":"What's next"},"35":{"id":"/docs/galactik-3","page_id":"/docs/galactik","tags":[],"type":"text","url":"/docs/galactik","content":"`@sinequa/galactik` is a library of Angular presentation components: buttons, form controls, overlays\n(dialogs, menus, popovers), navigation (tabs, sidebar) and display primitives (badges, tags, avatars). It has\nno knowledge of search, of a Sinequa backend, or of any business concept — every component takes plain inputs\nand emits plain outputs, and every visual choice comes from a fixed set of design tokens."},"36":{"id":"/docs/galactik-4","page_id":"/docs/galactik","tags":[],"type":"text","url":"/docs/galactik","content":"A **token** is a CSS custom property published by the design system — `--bg-primary-base`,\n`--font-primary-muted`, `--row-height-xs` — rather than a raw Tailwind utility or a literal colour. Every\n`galactik` component is styled exclusively through these tokens, so an application that declares them gets a\nconsistent look with zero component-level configuration."},"37":{"id":"/docs/galactik-5","page_id":"/docs/galactik","tags":[],"type":"text","url":"/docs/galactik#what-this-library-is-not","content":"`@sinequa/galactik` never imports `@sinequa/ui` (the library it replaces, still named \"atomic-ui\" in some\nplaces) and never imports `@sinequa/atomic-angular` (the business layer that composes search features on top\nof both). If you are looking for a search results list, a query builder, or anything that talks to a Sinequa\nserver, that lives in `@sinequa/atomic-angular` instead — this library only supplies the visual building\nblocks it is composed from."},"38":{"id":"/docs/galactik-6","page_id":"/docs/galactik","tags":[],"type":"text","url":"/docs/galactik#whats-next","content":"Install the library, declare the tokens your application needs, and render a first component."},"39":{"id":"/docs/galactik-7","page_id":"/docs/galactik","tags":[],"type":"text","url":"/docs/galactik#whats-next","content":"The richest component in the library, and the reference page every other one follows."},"40":{"id":"/docs/galactik/start","page_id":"/docs/galactik/start","type":"page","content":"Getting started","breadcrumbs":["Docs","Galactik"],"tags":[],"url":"/docs/galactik/start"},"41":{"id":"/docs/galactik/start-0","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start","content":"Install @sinequa/galactik, wire up its design tokens, and render a first form that opens a confirmation dialog."},"42":{"id":"/docs/galactik/start-1","page_id":"/docs/galactik/start","type":"heading","tags":[],"url":"/docs/galactik/start#prerequisites","content":"Prerequisites"},"43":{"id":"/docs/galactik/start-2","page_id":"/docs/galactik/start","type":"heading","tags":[],"url":"/docs/galactik/start#install","content":"Install"},"44":{"id":"/docs/galactik/start-3","page_id":"/docs/galactik/start","type":"heading","tags":[],"url":"/docs/galactik/start#configure-the-design-tokens","content":"Configure the design tokens"},"45":{"id":"/docs/galactik/start-4","page_id":"/docs/galactik/start","type":"heading","tags":[],"url":"/docs/galactik/start#render-a-first-component","content":"Render a first component"},"46":{"id":"/docs/galactik/start-5","page_id":"/docs/galactik/start","type":"heading","tags":[],"url":"/docs/galactik/start#whats-next","content":"What's next"},"47":{"id":"/docs/galactik/start-6","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start","content":"Four steps take you from an empty Angular 22 workspace to a form built entirely from `@sinequa/galactik`\ncomponents, styled by its design tokens."},"48":{"id":"/docs/galactik/start-7","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#prerequisites","content":"An Angular 22 workspace with Tailwind CSS v4 already set up. `@sinequa/galactik` declares three peer\ndependencies — install them alongside it:"},"49":{"id":"/docs/galactik/start-8","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#prerequisites","content":"<TypeTable\n  type=\"{\n  &#x22;@angular/core&#x22;: { type: &#x22;^22.0.0&#x22;, description: &#x22;The library's own version.&#x22; },\n  &#x22;@angular/aria&#x22;: { type: &#x22;^22.0.0&#x22;, description: &#x22;Accessible interaction primitives several components build on (List, Tabs, Toolbar…).&#x22; },\n  cn: { type: &#x22;^0.2.5&#x22;, description: &#x22;The class-merging helper every component's `class` input goes through.&#x22; },\n}\"\n/>"},"50":{"id":"/docs/galactik/start-9","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#configure-the-design-tokens","content":"Every component reads its colors, spacing and radii exclusively from CSS custom properties —\n`--bg-primary-base`, `--font-primary-muted`, `--radius-2xl` — never a raw Tailwind color or a shadcn utility\nclass. `@sinequa/galactik` ships **no CSS of its own**: an application declares these tokens itself, once."},"51":{"id":"/docs/galactik/start-10","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#configure-the-design-tokens","content":"Import Tailwind, then a stylesheet that declares the tokens under `:root`. This repository's own demo app\nkeeps that stylesheet at `projects/demo/src/css/galactik-tokens.css` — copy it (or your design system's own\nexport of the same token set) into your application and import it right after Tailwind:"},"52":{"id":"/docs/galactik/start-11","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#configure-the-design-tokens","content":"Every galactik component now renders with the correct look — there is nothing to configure per component.\nA dark variant is optional: the demo app keeps its dark-mode token overrides in a second file\n(`galactik-tokens-dark.css`), scoped under a `.dark` class, imported after the light one."},"53":{"id":"/docs/galactik/start-12","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#render-a-first-component","content":"A small form: an `Input` bound to a signal, and a `Button` that opens a confirmation `Dialog` before\n\"submitting\" — the same `createCallable`/`injectCallRef` pattern the Dialog page\nteaches in full."},"54":{"id":"/docs/galactik/start-13","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#render-a-first-component","content":"`provideCallable()` must be registered once in your application's providers for `ConfirmSave.call(...)` to\nwork without passing an explicit injector — see the Dialog page's Options\nsection."},"55":{"id":"/docs/galactik/start-14","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#whats-next","content":"The full imperative call/result API this page's example only introduces."},"56":{"id":"/docs/galactik/start-15","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#whats-next","content":"A single- or multiple-choice dropdown, the other half of most forms."},"57":{"id":"/docs/galactik/start-16","page_id":"/docs/galactik/start","tags":[],"type":"text","url":"/docs/galactik/start#whats-next","content":"A collapsible app navigation panel, for the shell around pages like this one."},"58":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","type":"page","content":"Bookmarks","breadcrumbs":["Docs","Atomic Angular","Bookmarks & saved searches"],"tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks"},"59":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-0","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","content":"A starred toggle button on any document, and a paginated list of the user's bookmarks — reopening one re-runs the query it came from to land back on the exact record."},"60":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-1","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#minimal-example","content":"Minimal example"},"61":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-2","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#how-it-works","content":"How it works"},"62":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-3","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#options","content":"Options"},"63":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-4","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#pitfalls","content":"Pitfalls"},"64":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-5","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#whats-next","content":"What's next"},"65":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-6","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","content":"Bookmarking marks a single document for later, independently of any collection or label. `<bookmark-button>`\nis the toggle a result row or a preview header shows; `<bookmarks>` is the paginated list of everything the\nuser has bookmarked."},"66":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-7","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#minimal-example","content":"The button reads its own pressed state from `UserSettingsStore.isBookmarked(article)` — there is nothing else\nto wire for the toggle itself to reflect reality after a bookmark is added elsewhere in the app."},"67":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-8","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#how-it-works","content":"Opening a bookmark from the list is a **search**, not a direct navigation to a stored document: `<bookmarks>`\nre-runs the query the bookmark was made from (`bookmark.queryName`), filtered to that document's id, and makes\nthe first matching record the current article (`SelectionService.setCurrentArticle`). When that query no longer returns the record — the source query was\nremoved from the app, say — it falls back to the app's default query before giving up and warning the user the\nbookmark looks outdated."},"68":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-9","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#options","content":"<TypeTable\n  type=\"{\n  article: { type: &#x22;Article&#x22;, description: &#x22;BookmarkButtonComponent, required. The document the toggle bookmarks.&#x22; },\n  variant: { type: &#x22;ButtonVariants[\\&#x22;variant\\&#x22;]&#x22;, default: '&#x22;tertiary&#x22;', description: &#x22;BookmarkButtonComponent.&#x22; },\n  size: { type: &#x22;ButtonVariants[\\&#x22;size\\&#x22;]&#x22;, default: '&#x22;md&#x22;', description: &#x22;BookmarkButtonComponent.&#x22; },\n  tabIndex: {\n    type: &#x22;number | undefined&#x22;,\n    description:\n      &#x22;BookmarkButtonComponent. Forwarded to the inner native button — needed when a caller manages focus itself (a roving tabindex, an @angular/aria grid cell), since the host custom element itself is never focusable.&#x22;,\n  },\n  options: {\n    type: &#x22;BookmarksConfig&#x22;,\n    description: &#x22;BookmarksComponent. { itemsPerPage?, showLoadMore?, routerLink? }, merged over BOOKMARKS_CONFIG's default (10 items, load-more shown, /bookmarks).&#x22;,\n  },\n}\"\n/>"},"69":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-10","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#pitfalls","content":"`<bookmark-button>` is a custom element; only the native `<button>` inside it is focusable, and a caller that\nmanages focus itself (an `@angular/aria` grid, a manual roving tabindex) can move focus onto it but not remove\nit from the natural tab order on top of that. Set `[tabIndex]=\"-1\"` (or whatever the roving pattern expects)\nexplicitly rather than assuming the host element's own absence from the DOM tabindex chain is enough."},"70":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-11","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#pitfalls","content":"Expected once the record it points to is genuinely gone from both the original query and the app's default\nquery — not a bug in the list itself. The warning is the fallback path's own signal that neither search found\nthe document, distinct from a bookmark that simply has not loaded yet."},"71":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-12","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#whats-next","content":"Name and reopen a whole search — text, filters and all — rather than a single document."},"72":{"id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks-13","page_id":"/docs/atomic-angular/bookmarks-and-searches/bookmarks","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/bookmarks#whats-next","content":"The same list, populated automatically from search history."},"73":{"id":"/docs/atomic-angular/bookmarks-and-searches","page_id":"/docs/atomic-angular/bookmarks-and-searches","type":"page","content":"Bookmarks & saved searches","breadcrumbs":["Docs","Atomic Angular","Bookmarks & saved searches"],"tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches"},"74":{"id":"/docs/atomic-angular/bookmarks-and-searches-0","page_id":"/docs/atomic-angular/bookmarks-and-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches","content":"Bookmarking individual documents, saving or recalling whole searches, and acting on a multi-document selection."},"75":{"id":"/docs/atomic-angular/bookmarks-and-searches-1","page_id":"/docs/atomic-angular/bookmarks-and-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches#whats-next","content":"What's next"},"76":{"id":"/docs/atomic-angular/bookmarks-and-searches-2","page_id":"/docs/atomic-angular/bookmarks-and-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches","content":"Three independent ways a user keeps track of things across sessions: a single bookmarked document, a whole\nsaved (or automatically recorded) search, and — for the moment several documents are selected at once — a\nfloating action bar."},"77":{"id":"/docs/atomic-angular/bookmarks-and-searches-3","page_id":"/docs/atomic-angular/bookmarks-and-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches#whats-next","content":"A starred toggle button on a document, and the paginated list of everything bookmarked."},"78":{"id":"/docs/atomic-angular/bookmarks-and-searches-4","page_id":"/docs/atomic-angular/bookmarks-and-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches#whats-next","content":"Name and store a whole search — text, filters, sort — behind a starred toggle."},"79":{"id":"/docs/atomic-angular/bookmarks-and-searches-5","page_id":"/docs/atomic-angular/bookmarks-and-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches#whats-next","content":"The same list shape, populated automatically instead of explicitly saved."},"80":{"id":"/docs/atomic-angular/bookmarks-and-searches-6","page_id":"/docs/atomic-angular/bookmarks-and-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches#whats-next","content":"A floating bar for acting on several selected documents at once."},"81":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","type":"page","content":"Multi-selection toolbar","breadcrumbs":["Docs","Atomic Angular","Bookmarks & saved searches"],"tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar"},"82":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-0","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","content":"A floating action bar that appears once the user has multi-selected documents — add to a collection, export, or attach to an AI assistant — backed by the shared SelectionStore."},"83":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-1","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#minimal-example","content":"Minimal example"},"84":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-2","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#how-it-works","content":"How it works"},"85":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-3","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#options","content":"Options"},"86":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-4","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#pitfalls","content":"Pitfalls"},"87":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-5","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#whats-next","content":"What's next"},"88":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-6","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","content":"`<multi-selection-toolbar>` is the bar that slides up from the bottom of the screen once the user has selected\nmore than one document — add them all to a collection, export them, or (when the app's assistant feature\nallows it) attach them to an AI overview. It reads the current selection from `SelectionStore` and needs\nnothing wired to know when to appear."},"89":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-7","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","content":"`SelectionStore` holds two independent things: the single currently-**open** article (`article`), and the\n**multi-selection** (`multiSelection`, an `Article[]`) the toolbar acts on."},"90":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-8","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#minimal-example","content":"The toolbar is invisible (`opacity-0`, translated off-screen) whenever `SelectionStore.multiSelectCount()` is\nzero — there is no `hidden`/`shown` input to manage yourself."},"91":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-9","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#how-it-works","content":"\"Add to collection\" reuses the same `AddToCollection`\ncallable a single-document flow would call, passed the whole `multiSelection` array at once — the dialog\nalready accepts one article or an array. If every selected document ends up removed from the target collection\n(the dialog resolves `\"dialog-no\"`), the toolbar clears the selection on the assumption the user is done with\nit."},"92":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-10","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#options","content":"<TypeTable\n  type=\"{\n  class: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;Additional CSS classes merged into the computed variant classes.&#x22; },\n  variant: { type: '&#x22;dark&#x22; | &#x22;light&#x22; | &#x22;glassy&#x22;', default: '&#x22;dark&#x22;', description: &#x22;Visual style of the bar.&#x22; },\n  updatedCollections: { type: &#x22;OutputEmitterRef<void>&#x22;, description: &#x22;Fires once AddToCollection resolves with an actual add or remove (not on a plain dismiss).&#x22; },\n}\"\n/>"},"93":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-11","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#pitfalls","content":"Gated behind `AppStore`'s assistant feature configuration\n(`appFeatures.features.assistant`) for an instance resolved as `<app-name>-search-results-assistant` (or plain\n`search-results-assistant`, depending on `usePrefixName`) — it only shows once that assistant instance exists\nand has `modeSettings.enabledUserInput` set. Confirm the assistant feature is actually configured for the app\nbefore assuming the button is broken."},"94":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-12","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#pitfalls","content":"Only removing **every** selected document from a collection (the dialog resolving `\"dialog-no\"`) clears the\nselection automatically — adding them (`\"dialog-yes\"`) deliberately leaves the selection in place, so the user\ncan immediately act on the same set again (export it next, say). Clear it yourself if your flow expects the\nopposite."},"95":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-13","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#whats-next","content":"What \"Add to collection\" actually does with the selected documents."},"96":{"id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar-14","page_id":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/multi-selection-toolbar#whats-next","content":"Marking one document at a time, rather than a batch."},"97":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","type":"page","content":"Recent searches","breadcrumbs":["Docs","Atomic Angular","Bookmarks & saved searches"],"tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches"},"98":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-0","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","content":"An automatically populated, paginated list of the user's past searches — the same shape as saved searches, with nothing to save explicitly."},"99":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-1","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches#minimal-example","content":"Minimal example"},"100":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-2","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches#how-it-works","content":"How it works"},"101":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-3","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches#options","content":"Options"},"102":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-4","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches#whats-next","content":"What's next"},"103":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-5","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","content":"`<recent-searches>` lists the searches a user has actually run, most recent first — populated automatically by\n`UserSettingsStore` as the user searches, with no explicit \"save\" step. It shares its row shape (filter-count\nbadge, relative date) and its reopen mechanism with saved searches."},"104":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-6","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches#how-it-works","content":"Reopening a recent search and deleting one both work exactly like their saved\nsearches counterparts — the two components are effectively the same list\nshape over two different backing arrays."},"105":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-7","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches#options","content":"<TypeTable\n  type=\"{\n  options: {\n    type: &#x22;SearchesConfig&#x22;,\n    description: &#x22;{ itemsPerPage?, showLoadMore?, routerLink? }, merged over RECENT_SEARCHES_CONFIG's default (10 items, load-more shown, /recent-searches).&#x22;,\n  },\n}\"\n/>"},"106":{"id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches-8","page_id":"/docs/atomic-angular/bookmarks-and-searches/recent-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/recent-searches#whats-next","content":"The explicitly-named counterpart — a starred toggle and a save dialog."},"107":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"page","content":"Saved searches","breadcrumbs":["Docs","Atomic Angular","Bookmarks & saved searches"],"tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches"},"108":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-0","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","content":"Name and store a whole search — text, filters, sort, everything the URL carries — behind a starred toggle button, and reopen it later from a paginated list."},"109":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-1","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#minimal-example","content":"Minimal example"},"110":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-2","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#how-it-works","content":"How it works"},"111":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-3","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#recipes","content":"Recipes"},"112":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-4","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#the-full-list-with-filter-counts-and-relative-dates","content":"The full list, with filter counts and relative dates"},"113":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-5","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#naming-and-saving-explicitly","content":"Naming and saving explicitly"},"114":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-6","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#options","content":"Options"},"115":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-7","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#pitfalls","content":"Pitfalls"},"116":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-8","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","type":"heading","tags":[],"url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#whats-next","content":"What's next"},"117":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-9","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","content":"A bookmark remembers one document; a **saved search** remembers a whole search state — the query text, every\napplied filter, the sort order — as the URL that reproduces it. `<saved-search-popover>` is the starred toggle\nthat saves or unsaves the *current* search in one click; `<saved-searches>` is the paginated list of everything\nthe user has saved."},"118":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-10","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","content":"`SavedSearchesService` stores each saved search as its full URL (`SearchItem.url`), not as a structured filter\nobject. Reopening one means navigating to that URL — `navigateToSearch()` parses it back into query params — so\na saved search stays valid across app versions as long as the URL scheme itself does."},"119":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-11","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#minimal-example","content":"The popover reads whether the current search is already saved from `UserSettingsStore.getSavedSearch(queryText)`\n— there is no separate \"saved\" input to keep in sync yourself."},"120":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-12","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#how-it-works","content":"Saving and unsaving are asymmetric on purpose: saving needs a name, so it always goes through\n`SavedSearchDialog`; unsaving an already-named search needs no further input, so the popover calls\n`SavedSearchesService.deleteSavedSearch()` directly, with no confirmation dialog."},"121":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-13","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#the-full-list-with-filter-counts-and-relative-dates","content":"Each row shows a badge with the number of applied filters and a relative date (\"2 days ago\"), both derived\nfrom parsing the stored URL — nothing extra to compute on the caller's side."},"122":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-14","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#naming-and-saving-explicitly","content":"Calling `SavedSearch` directly — rather than through the popover — is useful from a custom \"save\" action that\nis not a starred toggle."},"123":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-15","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#options","content":"<TypeTable\n  type=\"{\n  queryText: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;SavedSearchPopover. The current search's text, used to look it up among already-saved searches.&#x22; },\n  onSavedSearch: { type: &#x22;OutputEmitterRef<SearchItem | undefined>&#x22;, description: &#x22;SavedSearchPopover. Fires only when unsaving — the SavedSearch call handles the save path internally.&#x22; },\n  options: {\n    type: &#x22;SearchesConfig&#x22;,\n    description: &#x22;SavedSearchesComponent. { itemsPerPage?, showLoadMore?, routerLink? }, merged over SAVED_SEARCHES_CONFIG's default (10 items, load-more shown, /saved-searches).&#x22;,\n  },\n}\"\n/>"},"124":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-16","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#pitfalls","content":"`SavedSearchPopover.savedSearch` recomputes from `queryText()` — confirm the same text that was passed to\n`SavedSearch.call(...)` is also what the popover's `[queryText]` input carries afterwards. A popover bound to a\nsignal that changed shape between the two (trimmed differently, say) will not find a match even though the\nsearch was genuinely saved."},"125":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-17","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#pitfalls","content":"`SavedSearchesComponent.onDelete` deletes by the **index into the raw `userSettingsStore.savedSearches()`\narray** (`ListPanelDeleteEvent.index`), not by any value comparison — this is handled correctly by the\ncomponent itself, but a custom list built the same way must delete by that same index, not by matching on\n`url` or `label` (two saved searches can legitimately share a display label)."},"126":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-18","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#whats-next","content":"The same list shape, populated automatically instead of explicitly saved."},"127":{"id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches-19","page_id":"/docs/atomic-angular/bookmarks-and-searches/saved-searches","tags":[],"type":"text","url":"/docs/atomic-angular/bookmarks-and-searches/saved-searches#whats-next","content":"Remembering a single document instead of a whole search."},"128":{"id":"/docs/atomic-angular/collections-and-labels/collections","page_id":"/docs/atomic-angular/collections-and-labels/collections","type":"page","content":"Collections","breadcrumbs":["Docs","Atomic Angular","Collections & labels"],"tags":[],"url":"/docs/atomic-angular/collections-and-labels/collections"},"129":{"id":"/docs/atomic-angular/collections-and-labels/collections-0","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections","content":"A paginated list of the user's saved collections (baskets), with an add-to-collection dialog and a delete confirmation — built on the shared ListPanel primitives."},"130":{"id":"/docs/atomic-angular/collections-and-labels/collections-1","page_id":"/docs/atomic-angular/collections-and-labels/collections","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/collections#minimal-example","content":"Minimal example"},"131":{"id":"/docs/atomic-angular/collections-and-labels/collections-2","page_id":"/docs/atomic-angular/collections-and-labels/collections","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/collections#how-it-works","content":"How it works"},"132":{"id":"/docs/atomic-angular/collections-and-labels/collections-3","page_id":"/docs/atomic-angular/collections-and-labels/collections","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/collections#options","content":"Options"},"133":{"id":"/docs/atomic-angular/collections-and-labels/collections-4","page_id":"/docs/atomic-angular/collections-and-labels/collections","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/collections#pitfalls","content":"Pitfalls"},"134":{"id":"/docs/atomic-angular/collections-and-labels/collections-5","page_id":"/docs/atomic-angular/collections-and-labels/collections","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/collections#whats-next","content":"What's next"},"135":{"id":"/docs/atomic-angular/collections-and-labels/collections-6","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections","content":"A **collection** (the API calls it a *basket*) is a user-managed group of documents, persisted server-side\nthrough `UserSettingsStore`. `<collections>` renders the current user's collections as a list; the\n`AddToCollection` and `DeleteCollection` callables handle adding articles to one and removing one entirely."},"136":{"id":"/docs/atomic-angular/collections-and-labels/collections-7","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections","content":"A basket is the backend's name for a collection: a named list of document ids, stored per user. `Basket` (from\n`@sinequa/atomic-angular`'s models) is `{ name: string; ids?: string[] }` — the type every component on this\npage reads and writes."},"137":{"id":"/docs/atomic-angular/collections-and-labels/collections-8","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#minimal-example","content":"Clicking a collection syncs `QueryParamsStore.basket` and navigates to `/search?b=<name>` — the sync happens\n**before** the navigation so a consuming app's own `allowEmptySearch: false` guard already sees the basket by\nthe time the destination page evaluates it (see Pitfalls)."},"138":{"id":"/docs/atomic-angular/collections-and-labels/collections-9","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#how-it-works","content":"`CollectionsComponent` itself never adds documents to a collection — that is a separate entry point, callable\nfrom anywhere a set of articles is available (a result row, a multi-selection toolbar):"},"139":{"id":"/docs/atomic-angular/collections-and-labels/collections-10","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#how-it-works","content":"The dialog shows a checkbox per collection, checked (or indeterminate, for several articles) if the article is\nalready in it — ticking one toggles membership immediately, no separate \"confirm\" step; a \"Create collection\"\nscreen at the bottom lets the user start a brand-new one already containing the article(s)."},"140":{"id":"/docs/atomic-angular/collections-and-labels/collections-11","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#options","content":"<TypeTable\n  type=\"{\n  options: {\n    type: &#x22;CollectionsConfig&#x22;,\n    description:\n      &#x22;{ itemsPerPage?, showLoadMore?, routerLink? }. Overrides the COLLECTIONS_CONFIG-provided default (10 items, no load-more, /collections), merged over it.&#x22;,\n  },\n}\"\n/>"},"141":{"id":"/docs/atomic-angular/collections-and-labels/collections-12","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#options","content":"`CollectionsComponent` has no outputs — clicking a collection navigates directly via the router."},"142":{"id":"/docs/atomic-angular/collections-and-labels/collections-13","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#pitfalls","content":"Confirm the destination search page's empty-search guard (`allowEmptySearch: false`) reads\n`QueryParamsStore.basket` rather than a component-local copy of the URL — `CollectionsComponent.onClick()`\nalready patches the store (with `syncUrl: false`) before navigating, precisely so the guard sees the basket in\ntime. A page that derives its own \"is this search empty\" check from something other than the store can still\nrace the navigation."},"143":{"id":"/docs/atomic-angular/collections-and-labels/collections-14","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#pitfalls","content":"If the empty-search guard skips the query, make sure the component consuming `QueryService.result()` treats a\nskipped query the same as a genuinely empty result — a stale previous result left in the signal reads as \"the\ncollection has these documents\", when in fact no query ran."},"144":{"id":"/docs/atomic-angular/collections-and-labels/collections-15","page_id":"/docs/atomic-angular/collections-and-labels/collections","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/collections#whats-next","content":"Public and private labels on a document, with autosuggest and a bulk-edit dialog."},"145":{"id":"/docs/atomic-angular/collections-and-labels","page_id":"/docs/atomic-angular/collections-and-labels","type":"page","content":"Collections & labels","breadcrumbs":["Docs","Atomic Angular","Collections & labels"],"tags":[],"url":"/docs/atomic-angular/collections-and-labels"},"146":{"id":"/docs/atomic-angular/collections-and-labels-0","page_id":"/docs/atomic-angular/collections-and-labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels","content":"Grouping documents into a user-managed collection, and tagging them with shared or personal labels."},"147":{"id":"/docs/atomic-angular/collections-and-labels-1","page_id":"/docs/atomic-angular/collections-and-labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels#whats-next","content":"What's next"},"148":{"id":"/docs/atomic-angular/collections-and-labels-2","page_id":"/docs/atomic-angular/collections-and-labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels","content":"Two independent ways a user organizes documents outside of search itself: grouping them into a named\ncollection (a *basket*), and tagging individual documents with public or private labels."},"149":{"id":"/docs/atomic-angular/collections-and-labels-3","page_id":"/docs/atomic-angular/collections-and-labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels#whats-next","content":"A paginated list of the user's collections, with add-to-collection and delete dialogs."},"150":{"id":"/docs/atomic-angular/collections-and-labels-4","page_id":"/docs/atomic-angular/collections-and-labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels#whats-next","content":"Public and private labels on a document — an autosuggest field and a bulk-edit dialog."},"151":{"id":"/docs/atomic-angular/collections-and-labels/labels","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"page","content":"Labels","breadcrumbs":["Docs","Atomic Angular","Collections & labels"],"tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels"},"152":{"id":"/docs/atomic-angular/collections-and-labels/labels-0","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels","content":"Public and private labels on a document — an autosuggest multi-select field, and a bulk-edit dialog that shows both fields side by side, gated by the labels web service's own configuration."},"153":{"id":"/docs/atomic-angular/collections-and-labels/labels-1","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels#minimal-example","content":"Minimal example"},"154":{"id":"/docs/atomic-angular/collections-and-labels/labels-2","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels#how-it-works","content":"How it works"},"155":{"id":"/docs/atomic-angular/collections-and-labels/labels-3","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels#recipes","content":"Recipes"},"156":{"id":"/docs/atomic-angular/collections-and-labels/labels-4","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels#editing-both-label-fields-for-one-document","content":"Editing both label fields for one document"},"157":{"id":"/docs/atomic-angular/collections-and-labels/labels-5","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels#options","content":"Options"},"158":{"id":"/docs/atomic-angular/collections-and-labels/labels-6","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels#pitfalls","content":"Pitfalls"},"159":{"id":"/docs/atomic-angular/collections-and-labels/labels-7","page_id":"/docs/atomic-angular/collections-and-labels/labels","type":"heading","tags":[],"url":"/docs/atomic-angular/collections-and-labels/labels#whats-next","content":"What's next"},"160":{"id":"/docs/atomic-angular/collections-and-labels/labels-8","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels","content":"A **label** is a free-text tag attached to a document, either **public** (shared, visible to every user) or\n**private** (visible only to the user who added it). `<multiselect-labels>` is the field that adds and removes\nthem on one article field; `EditLabels` is the dialog that shows the public and private fields together for a\nsingle document."},"161":{"id":"/docs/atomic-angular/collections-and-labels/labels-9","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels","content":"Whether labels are available at all — and which article fields hold the public/private lists — comes from the\nSinequa server's **labels web service** configuration, read through `LabelService.getLabelsConfig()`. An app\nwith no labels web service configured has no label fields to show; `EditLabels` renders nothing in that case\nrather than an empty dialog."},"162":{"id":"/docs/atomic-angular/collections-and-labels/labels-10","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels#minimal-example","content":"`labelsField` names the article property the picked/removed labels are read from and written back to — it has\nto match the field the labels web service configuration actually uses for that visibility (public or private),\nwhich is exactly what `EditLabels` resolves for you (see Recipes)."},"163":{"id":"/docs/atomic-angular/collections-and-labels/labels-11","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels#how-it-works","content":"`MultiSelectLabelsComponent` wraps a `galactik` `<Autocomplete>` — suggestions come from\n`client.api.labels.get(query, isPublic)`, and picking or removing a label calls\n`client.api.labels.add`/`remove` directly (not through `LabelService`, which exists mainly for the bulk and\nrights-checking operations used elsewhere)."},"164":{"id":"/docs/atomic-angular/collections-and-labels/labels-12","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels#editing-both-label-fields-for-one-document","content":"`EditLabels` reads the labels web service configuration itself and renders a public field, a private field, or\nboth, depending on what the app actually exposes — the caller does not need to know the field names."},"165":{"id":"/docs/atomic-angular/collections-and-labels/labels-13","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels#options","content":"<TypeTable\n  type=\"{\n  article: {\n    type: &#x22;ModelSignal<Article | undefined>&#x22;,\n    description: &#x22;Two-way [(article)] binding — the document whose labelsField is read from and written back to.&#x22;,\n  },\n  labelsField: { type: &#x22;string | undefined&#x22;, description: &#x22;The article property holding this field's labels.&#x22; },\n  isPublic: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Public vs. private labels — changes both the endpoint called and the field's own suggest scope.&#x22; },\n  allowModification: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Whether the field lets the user add/remove labels, or only displays the current ones.&#x22; },\n}\"\n/>"},"166":{"id":"/docs/atomic-angular/collections-and-labels/labels-14","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels#pitfalls","content":"`add()`/`remove()` call the labels web service directly and set an error flag on any rejection — most often\nthe current user lacking the rights the server enforces for that visibility (public labels usually require an\nelevated right). Check `LabelService.canHandleLabels()` before assuming the field itself is broken."},"167":{"id":"/docs/atomic-angular/collections-and-labels/labels-15","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels#pitfalls","content":"The app has no labels web service configured, or `LabelService.getLabelsConfig()` resolved with no\n`publicLabelsField`/`privateLabelsField` at all — `EditLabels` renders nothing in that case rather than a\nmisleading empty field. Confirm the server's labels web service is actually attached to the app."},"168":{"id":"/docs/atomic-angular/collections-and-labels/labels-16","page_id":"/docs/atomic-angular/collections-and-labels/labels","tags":[],"type":"text","url":"/docs/atomic-angular/collections-and-labels/labels#whats-next","content":"Group documents into a user-managed, named collection."},"169":{"id":"/docs/atomic-angular/auth/auth-guard","page_id":"/docs/atomic-angular/auth/auth-guard","type":"page","content":"AuthGuard","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/auth-guard"},"170":{"id":"/docs/atomic-angular/auth/auth-guard-0","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard","content":"A functional route guard that checks authentication, loads the principal, and redirects to change-password when a credentials session's password has expired."},"171":{"id":"/docs/atomic-angular/auth/auth-guard-1","page_id":"/docs/atomic-angular/auth/auth-guard","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-guard#minimal-example","content":"Minimal example"},"172":{"id":"/docs/atomic-angular/auth/auth-guard-2","page_id":"/docs/atomic-angular/auth/auth-guard","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-guard#how-it-works","content":"How it works"},"173":{"id":"/docs/atomic-angular/auth/auth-guard-3","page_id":"/docs/atomic-angular/auth/auth-guard","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-guard#options","content":"Options"},"174":{"id":"/docs/atomic-angular/auth/auth-guard-4","page_id":"/docs/atomic-angular/auth/auth-guard","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-guard#pitfalls","content":"Pitfalls"},"175":{"id":"/docs/atomic-angular/auth/auth-guard-5","page_id":"/docs/atomic-angular/auth/auth-guard","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-guard#whats-next","content":"What's next"},"176":{"id":"/docs/atomic-angular/auth/auth-guard-6","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard","content":"`AuthGuard()` returns a `CanActivateFn` that protects a route: it checks the user is authenticated, ensures\n`PrincipalStore` is loaded, and — in `credentials` mode — redirects to the change-password view when the\nsession's password has expired."},"177":{"id":"/docs/atomic-angular/auth/auth-guard-7","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#how-it-works","content":"Two details worth knowing:"},"178":{"id":"/docs/atomic-angular/auth/auth-guard-8","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#how-it-works","content":"The guard lets `/login` and `/logout` through unconditionally — guarding the login form against \"not\nlogged in\" would redirect it to itself, and guarding `/logout` would send a user who just signed out back\nto the form they just left."},"179":{"id":"/docs/atomic-angular/auth/auth-guard-9","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#how-it-works","content":"`initialize()` runs whenever the store's state is not `\"loaded\"` — not only when it is `\"initial\"`. That\ncovers an initialization already in flight elsewhere (`\"loading\"`, awaited rather than assumed absent —\n`initialize()` itself de-duplicates concurrent calls into the same fetch) and a previous failed attempt\n(`\"error\"`, retried instead of permanently redirecting to login)."},"180":{"id":"/docs/atomic-angular/auth/auth-guard-10","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#how-it-works","content":"**SSO mode** (`authMode.kind === \"sso\"`): the browser/proxy carries the auth, so an unauthenticated state is\nlet through — the session is established out of band."},"181":{"id":"/docs/atomic-angular/auth/auth-guard-11","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#how-it-works","content":"**Not authenticated** (non-SSO): redirect to `loginPath` with the original URL as `returnUrl`."},"182":{"id":"/docs/atomic-angular/auth/auth-guard-12","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#how-it-works","content":"**Credentials mode, expired password**: when the partition is editable and the password is expired, the\nguard redirects to `/login?mode=changepassword&alert=passwordExpired&username=…`."},"183":{"id":"/docs/atomic-angular/auth/auth-guard-13","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#options","content":"<TypeTable\n  type=\"{\n  &#x22;client.config.loginPath&#x22;: { type: &#x22;string&#x22;, default: '&#x22;/login&#x22;', description: &#x22;Where to redirect when authentication is needed.&#x22; },\n  &#x22;client.config.authMode&#x22;: {\n    type: &#x22;AuthMode&#x22;,\n    description: &#x22;The source of truth for the authentication method — branch on authMode.kind, not the legacy useCredentials/useSSO booleans.&#x22;,\n  },\n}\"\n/>"},"184":{"id":"/docs/atomic-angular/auth/auth-guard-14","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#pitfalls","content":"Confirm your routes actually declare `loginPath` (default `/login`) **and** `/error` — and that `/login`\nroutes to `AuthPageComponent`, not `SignInComponent` directly, so the guard's own redirect target renders\ncorrectly. See Authentication flows."},"185":{"id":"/docs/atomic-angular/auth/auth-guard-15","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#pitfalls","content":"This only applies in `credentials` mode, and only when `editablePartition` is set on the principal — an\naccount on a partition that does not manage passwords locally (SSO, an external identity provider) has\nnothing to expire from this guard's point of view."},"186":{"id":"/docs/atomic-angular/auth/auth-guard-16","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#whats-next","content":"Where this guard fits among the interceptor, sign-in and logout."},"187":{"id":"/docs/atomic-angular/auth/auth-guard-17","page_id":"/docs/atomic-angular/auth/auth-guard","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-guard#whats-next","content":"The store this guard loads before letting a protected route through."},"188":{"id":"/docs/atomic-angular/auth/auth-interceptor","page_id":"/docs/atomic-angular/auth/auth-interceptor","type":"page","content":"Auth interceptor","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/auth-interceptor"},"189":{"id":"/docs/atomic-angular/auth/auth-interceptor-0","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor","content":"Attaches the CSRF token, bearer authorization and impersonation headers to every request built with Angular's HttpClient — the one channel the atomic client itself never sees."},"190":{"id":"/docs/atomic-angular/auth/auth-interceptor-1","page_id":"/docs/atomic-angular/auth/auth-interceptor","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-interceptor#minimal-example","content":"Minimal example"},"191":{"id":"/docs/atomic-angular/auth/auth-interceptor-2","page_id":"/docs/atomic-angular/auth/auth-interceptor","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-interceptor#how-it-works","content":"How it works"},"192":{"id":"/docs/atomic-angular/auth/auth-interceptor-3","page_id":"/docs/atomic-angular/auth/auth-interceptor","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-interceptor#pitfalls","content":"Pitfalls"},"193":{"id":"/docs/atomic-angular/auth/auth-interceptor-4","page_id":"/docs/atomic-angular/auth/auth-interceptor","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/auth-interceptor#whats-next","content":"What's next"},"194":{"id":"/docs/atomic-angular/auth/auth-interceptor-5","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor","content":"`authInterceptorFn` serves the **Angular `HttpClient` channel**, which `@sinequa/atomic`'s own client does not\nsee. The library's stores and services no longer use `HttpClient` — they go through the client, which sets\nthese headers itself, per client — but `@sinequa/agent` and `@sinequa/assistant` build their requests with\n`HttpClient`, as may your own code. Without this interceptor, those requests leave with no CSRF token and the\nserver answers 401."},"195":{"id":"/docs/atomic-angular/auth/auth-interceptor-6","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor#how-it-works","content":"On every request it adds `Sinequa-csrf-token` (read from the stored session token),\n`Authorization: Bearer <token>` when a bearer token is configured, `sinequa-override-user`/\n`sinequa-override-domain` when an impersonation is active, and `withCredentials: true` — aligning the\n`HttpClient` path with the client's own `fetch`, which uses `credentials: \"include\"`. It also refreshes the\nstored CSRF token from the `sinequa-csrf-token` response header whenever the server sends a new one."},"196":{"id":"/docs/atomic-angular/auth/auth-interceptor-7","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor#how-it-works","content":"The bearer token is resolved from `authMode: AuthMode.bearer(token)` first, then from the legacy `bearerToken`\nconfiguration key."},"197":{"id":"/docs/atomic-angular/auth/auth-interceptor-8","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor#pitfalls","content":"Confirm this interceptor is actually registered on the `provideHttpClient` used by the request — an\napplication that only calls `@sinequa/atomic`'s client never needs it, but the moment `@sinequa/agent`,\n`@sinequa/assistant`, or your own code issues an `HttpClient` request, this interceptor is what carries the\nsession across."},"198":{"id":"/docs/atomic-angular/auth/auth-interceptor-9","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor#pitfalls","content":"Only reading the legacy `bearerToken` key would leave every `HttpClient` request unauthenticated once an\napplication sets `authMode: AuthMode.bearer(token)` explicitly — there is no reason to also repeat the token\nunder the legacy key. Prefer `authMode.bearer(token)` going forward; the legacy key stays as a fallback for\nolder configuration."},"199":{"id":"/docs/atomic-angular/auth/auth-interceptor-10","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor#pitfalls","content":"This interceptor reads the configuration and session of the **default** client. A client provided at the root\nholds its own snapshot of the configuration, so the `backendUrl` it resolves and the impersonation state it\nrecords never reach this code — keep the application root on the default client if you need this interceptor\nto see it."},"200":{"id":"/docs/atomic-angular/auth/auth-interceptor-11","page_id":"/docs/atomic-angular/auth/auth-interceptor","tags":[],"type":"text","url":"/docs/atomic-angular/auth/auth-interceptor#whats-next","content":"The two channels — this interceptor and atomic's own recovery — never handle the same request."},"201":{"id":"/docs/atomic-angular/auth/authentication-flows","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"page","content":"Authentication flows","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/authentication-flows"},"202":{"id":"/docs/atomic-angular/auth/authentication-flows-0","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows","content":"How AuthGuard, the auth interceptor, SignIn and logout fit together end to end — the Angular-side orchestration on top of @sinequa/atomic's core authentication state machine."},"203":{"id":"/docs/atomic-angular/auth/authentication-flows-1","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#the-pieces","content":"The pieces"},"204":{"id":"/docs/atomic-angular/auth/authentication-flows-2","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#required-routes","content":"Required routes"},"205":{"id":"/docs/atomic-angular/auth/authentication-flows-3","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#bootstrap-sequence","content":"Bootstrap sequence"},"206":{"id":"/docs/atomic-angular/auth/authentication-flows-4","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#signin-per-mode","content":"`signIn()` per mode"},"207":{"id":"/docs/atomic-angular/auth/authentication-flows-5","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#token-expiry-and-401-re-authentication","content":"Token expiry and 401 re-authentication"},"208":{"id":"/docs/atomic-angular/auth/authentication-flows-6","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#logout","content":"Logout"},"209":{"id":"/docs/atomic-angular/auth/authentication-flows-7","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#requests-that-trail-behind-the-logout","content":"Requests that trail behind the logout"},"210":{"id":"/docs/atomic-angular/auth/authentication-flows-8","page_id":"/docs/atomic-angular/auth/authentication-flows","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/authentication-flows#whats-next","content":"What's next"},"211":{"id":"/docs/atomic-angular/auth/authentication-flows-9","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows","content":"This page describes how `@sinequa/atomic-angular` **orchestrates** authentication — how the pieces fit\ntogether and how every flow is handled. It is the Angular-side companion to the core state machine\ndocumented by `@sinequa/atomic` (detection, `login()` resolution, the OAuth/SAML redirect loop guard, error\nenvelopes) — this page never repeats that part, only what Angular adds on top of it."},"212":{"id":"/docs/atomic-angular/auth/authentication-flows-10","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#the-pieces","content":"<TypeTable\n  type=\"{\n  bootstrapApp: { type: &#x22;APP_INITIALIZER&#x22;, description: &#x22;Resolves config, signs in, initializes the app.&#x22; },\n  &#x22;signIn()&#x22;: { type: &#x22;function&#x22;, description: &#x22;Acts on globalConfig.authMode to start the right flow.&#x22; },\n  AuthGuard: { type: &#x22;CanActivateFn factory&#x22;, description: &#x22;Protects routes; handles unauthenticated + expired-password.&#x22; },\n  AuthPageComponent: { type: &#x22;component&#x22;, description: 'Hosts the signin / changepassword / forgotpassword / signedout views.' },\n  SignInComponent: { type: &#x22;component&#x22;, description: &#x22;Credentials form or loader (external auth).&#x22; },\n  SignedOutComponent: { type: &#x22;component&#x22;, description: &#x22;Post-logout confirmation shown on /logout (no auto re-auth).&#x22; },\n  authInterceptorFn: { type: &#x22;HttpInterceptorFn&#x22;, description: &#x22;Retries a 401 once after re-auth, on the HttpClient channel.&#x22; },\n  &#x22;auth.recoverFromUnauthorized&#x22;: { type: &#x22;@sinequa/atomic&#x22;, description: &#x22;Same recovery for the requests atomic issues itself, wired by bootstrapApp.&#x22; },\n}\"\n/>"},"213":{"id":"/docs/atomic-angular/auth/authentication-flows-11","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#required-routes","content":"`AuthPageComponent` switches between the sign-in, change-password, forgot-password and signed-out views (from\nthe route path and the `mode` query param) — in particular `/logout` renders the signed-out confirmation, not\nthe sign-in form. `SignInComponent` alone only renders the credentials form and ignores the route."},"214":{"id":"/docs/atomic-angular/auth/authentication-flows-12","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#bootstrap-sequence","content":"When authenticated, `bootstrapApp` awaits `initialize(createRoutes)` (routing to `/error` on failure); when\nnot, `signIn()` has already navigated to `/login` (credentials) or reloaded the page (`sso`)."},"215":{"id":"/docs/atomic-angular/auth/authentication-flows-13","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#signin-per-mode","content":"<TypeTable\n  type=\"{\n  credentials: { type: '&#x22;credentials&#x22;', description: 'Navigate to loginPath (show the form) — resolves false.' },\n  sso: { type: '&#x22;sso&#x22;', description: &#x22;window.location.reload() so the proxy/browser performs the handshake — resolves false.&#x22; },\n  &#x22;oauth · saml&#x22;: { type: '&#x22;oauth&#x22; | &#x22;saml&#x22;', description: &#x22;Delegate to login(), which redirects to the provider.&#x22; },\n  bearer: {\n    type: '&#x22;bearer&#x22;',\n    description:\n      &#x22;Delegate to login(). No session is looked for — the token authenticates every request through its Authorization header — but a session cookie is still requested so the browser can load previews and thumbnails on its own.&#x22;,\n  },\n  unknown: {\n    type: '&#x22;unknown&#x22;',\n    description:\n      &#x22;Delegate to login() (session-first; it probes server-side auto-authentication — e.g. OIDC, recorded as sso on success — then resolves to credentials on failure).&#x22;,\n  },\n}\"\n/>"},"216":{"id":"/docs/atomic-angular/auth/authentication-flows-14","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#signin-per-mode","content":"On a recoverable **401** it routes to `loginPath`; on a &#x2A;*fatal (non-401)** error it routes to `/error` with\nthe reason and resolves `false`, so the app never fires further doomed authenticated calls."},"217":{"id":"/docs/atomic-angular/auth/authentication-flows-15","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#token-expiry-and-401-re-authentication","content":"Sessions use a **sliding refresh** (handled in `@sinequa/atomic`): every response carrying a\n`sinequa-jwt-refresh` header re-stores the token, so an active user never expires mid-use. Expiry only\nhappens after idle time, or server-side revocation."},"218":{"id":"/docs/atomic-angular/auth/authentication-flows-16","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#token-expiry-and-401-re-authentication","content":"When a token has expired, the next API call answers **401**, and the recovery runs on two channels that never\nhandle the same request — registering both is correct, not duplicated:"},"219":{"id":"/docs/atomic-angular/auth/authentication-flows-17","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#token-expiry-and-401-re-authentication","content":"<TypeTable\n  type=\"{\n  &#x22;auth.recoverFromUnauthorized&#x22;: { type: &#x22;wired by bootstrapApp&#x22;, description: &#x22;Every request @sinequa/atomic issues on its own transport.&#x22; },\n  authInterceptorFn: { type: &#x22;HttpInterceptorFn&#x22;, description: &#x22;Every request built with Angular's HttpClient — @sinequa/agent, @sinequa/assistant, your own code.&#x22; },\n}\"\n/>"},"220":{"id":"/docs/atomic-angular/auth/authentication-flows-18","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#token-expiry-and-401-re-authentication","content":"Each calls `signIn()` and replays the original request at most once — an `AUTH_RETRIED` context guard\nprevents an infinite loop on the interceptor side. Some requests never trigger a recovery at all: audit\nevents (fire-and-forget telemetry), the sign-in's own probes (their 401 is the answer being asked for), and\nanything trailing behind a deliberate `logout()` (see below). `signIn()` also never redirects when the user\nis already on an authentication screen — they are already where they belong."},"221":{"id":"/docs/atomic-angular/auth/authentication-flows-19","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#logout","content":"The user menu's logout action clears the local token. The challenge response may carry a `logoutUrl` — the\nprovider end-session endpoint for OAuth/SAML:"},"222":{"id":"/docs/atomic-angular/auth/authentication-flows-20","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#logout","content":"`/logout` renders the **signed-out** view, not the sign-in form — this matters for the external modes, where\n`SignInComponent` auto-initiates its handshake on mount: rendering it on `/logout` would immediately\nre-authenticate the user, a spinner that loops back in. See Signed Out."},"223":{"id":"/docs/atomic-angular/auth/authentication-flows-21","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#requests-that-trail-behind-the-logout","content":"A view being torn down as the router leaves the page, a save already in flight, a telemetry event — all of\nthem can reach the server moments later, on a cookie that has just been deleted, and answer 401. Nothing\nrecovers from those: `@sinequa/atomic` (2.3.2+) closes the recovery from a deliberate `logout()` until the\nnext successful authentication, and `signIn()` refuses to redirect away from an authentication screen. Without\neither, the audit event's 401 re-probed the session, found it gone, and replaced the \"signed out\" confirmation\nwith `/login?returnUrl=/logout` — signing back in then returned the user to the logout page."},"224":{"id":"/docs/atomic-angular/auth/authentication-flows-22","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#whats-next","content":"The credentials form and the entry point of the whole sequence above."},"225":{"id":"/docs/atomic-angular/auth/authentication-flows-23","page_id":"/docs/atomic-angular/auth/authentication-flows","tags":[],"type":"text","url":"/docs/atomic-angular/auth/authentication-flows#whats-next","content":"The route guard that starts this sequence for a protected route."},"226":{"id":"/docs/atomic-angular/auth/change-password","page_id":"/docs/atomic-angular/auth/change-password","type":"page","content":"Change Password","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/change-password"},"227":{"id":"/docs/atomic-angular/auth/change-password-0","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password","content":"A current/new/confirm password form that signs the user back in on success, so the session is never left stale — used both as the /login?mode=changepassword route and embedded in a profile panel."},"228":{"id":"/docs/atomic-angular/auth/change-password-1","page_id":"/docs/atomic-angular/auth/change-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/change-password#minimal-example","content":"Minimal example"},"229":{"id":"/docs/atomic-angular/auth/change-password-2","page_id":"/docs/atomic-angular/auth/change-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/change-password#how-it-works","content":"How it works"},"230":{"id":"/docs/atomic-angular/auth/change-password-3","page_id":"/docs/atomic-angular/auth/change-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/change-password#recipes","content":"Recipes"},"231":{"id":"/docs/atomic-angular/auth/change-password-4","page_id":"/docs/atomic-angular/auth/change-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/change-password#embedded-in-a-panel-or-a-dialog","content":"Embedded in a panel or a dialog"},"232":{"id":"/docs/atomic-angular/auth/change-password-5","page_id":"/docs/atomic-angular/auth/change-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/change-password#options","content":"Options"},"233":{"id":"/docs/atomic-angular/auth/change-password-6","page_id":"/docs/atomic-angular/auth/change-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/change-password#pitfalls","content":"Pitfalls"},"234":{"id":"/docs/atomic-angular/auth/change-password-7","page_id":"/docs/atomic-angular/auth/change-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/change-password#whats-next","content":"What's next"},"235":{"id":"/docs/atomic-angular/auth/change-password-8","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password","content":"`ChangePassword` renders the change-password form and, on success, signs the user back in with the new\npassword — the session is never left stale. It is used both as a standalone view (the\n`/login?mode=changepassword` route, through `AuthPageComponent`) and embedded —\nthe user-profile panel hosts it inline."},"236":{"id":"/docs/atomic-angular/auth/change-password-9","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password#how-it-works","content":"The old token is cleared **after** the change succeeds, never before — a failed change leaves the session\nintact."},"237":{"id":"/docs/atomic-angular/auth/change-password-10","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password#options","content":"<TypeTable\n  type=\"{\n  passwords: { type: &#x22;model<PasswordChange>&#x22;, default: &#x22;all empty&#x22;, description: &#x22;Form model: { currentPassword, newPassword, confirmPassword }.&#x22; },\n  username: { type: &#x22;string | null&#x22;, default: &#x22;null&#x22;, description: &#x22;Account to sign back in with. Falls back to the authenticated principal's name.&#x22; },\n  alert: { type: &#x22;string | undefined&#x22;, description: 'Translation key shown as a banner — e.g. &#x22;login.passwordExpired&#x22;.' },\n  redirectAfterSuccess: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Initializes the app and navigates to / after the change.&#x22; },\n  redirectAfterCancel: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Calls location.back() on cancel.&#x22; },\n  surface: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Renders the form as a card. Set false when the container already provides one.&#x22; },\n}\"\n/>"},"238":{"id":"/docs/atomic-angular/auth/change-password-11","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password#options","content":"<TypeTable\n  type=\"{\n  success: { type: &#x22;void&#x22;, description: &#x22;Password changed and the user is signed back in.&#x22; },\n  cancel: { type: &#x22;void&#x22;, description: &#x22;The user dismissed the form.&#x22; },\n}\"\n/>"},"239":{"id":"/docs/atomic-angular/auth/change-password-12","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password#pitfalls","content":"The client API's argument order is `change(newPassword, currentPassword)` — swapping them is the classic\nmistake, and the server's rejection message does not make the actual cause obvious."},"240":{"id":"/docs/atomic-angular/auth/change-password-13","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password#pitfalls","content":"Expected while either password field is still empty: `required` already covers that case, and showing both\nmessages at once helps nobody. The mismatch message appears once both fields have content."},"241":{"id":"/docs/atomic-angular/auth/change-password-14","page_id":"/docs/atomic-angular/auth/change-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/change-password#whats-next","content":"The screen behind Sign In's \"forgot password\" link."},"242":{"id":"/docs/atomic-angular/auth/forgot-password","page_id":"/docs/atomic-angular/auth/forgot-password","type":"page","content":"Forgot Password","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/forgot-password"},"243":{"id":"/docs/atomic-angular/auth/forgot-password-0","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password","content":"A one-field form that requests a password-reset email — no router, no navigation, safe to drop into a dialog or a wizard step as-is."},"244":{"id":"/docs/atomic-angular/auth/forgot-password-1","page_id":"/docs/atomic-angular/auth/forgot-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/forgot-password#minimal-example","content":"Minimal example"},"245":{"id":"/docs/atomic-angular/auth/forgot-password-2","page_id":"/docs/atomic-angular/auth/forgot-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/forgot-password#how-it-works","content":"How it works"},"246":{"id":"/docs/atomic-angular/auth/forgot-password-3","page_id":"/docs/atomic-angular/auth/forgot-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/forgot-password#recipes","content":"Recipes"},"247":{"id":"/docs/atomic-angular/auth/forgot-password-4","page_id":"/docs/atomic-angular/auth/forgot-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/forgot-password#carrying-the-username-from-a-previous-wizard-step","content":"Carrying the username from a previous wizard step"},"248":{"id":"/docs/atomic-angular/auth/forgot-password-5","page_id":"/docs/atomic-angular/auth/forgot-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/forgot-password#options","content":"Options"},"249":{"id":"/docs/atomic-angular/auth/forgot-password-6","page_id":"/docs/atomic-angular/auth/forgot-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/forgot-password#pitfalls","content":"Pitfalls"},"250":{"id":"/docs/atomic-angular/auth/forgot-password-7","page_id":"/docs/atomic-angular/auth/forgot-password","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/forgot-password#whats-next","content":"What's next"},"251":{"id":"/docs/atomic-angular/auth/forgot-password-8","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password","content":"`ForgotPassword` asks for a username and requests a password-reset email for that account. It is the screen\nbehind the \"forgot password\" link of Sign In, reached through\n`AuthPageComponent` on `/login?mode=forgotpassword`."},"252":{"id":"/docs/atomic-angular/auth/forgot-password-9","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password#how-it-works","content":"This component touches no store and injects no `Router` — everything it reports goes through `success`/\n`cancel`, which is what makes it safe to embed anywhere. The reset email is only sent if the account exists\nand has an email address; the server does not disclose which, and the confirmation message is deliberately\nidentical either way."},"253":{"id":"/docs/atomic-angular/auth/forgot-password-10","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password#carrying-the-username-from-a-previous-wizard-step","content":"The model is two-way bindable, which is what lets a wizard carry the username from a previous step."},"254":{"id":"/docs/atomic-angular/auth/forgot-password-11","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password#options","content":"<TypeTable\n  type=\"{\n  resetRequest: { type: &#x22;model<PasswordResetRequest>&#x22;, default: '{ username: &#x22;&#x22; }', description: &#x22;Form model. Note the lowercase n, aligned with Credentials.username.&#x22; },\n  surface: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Renders the form as a card. Set false when the container already provides one.&#x22; },\n}\"\n/>"},"255":{"id":"/docs/atomic-angular/auth/forgot-password-12","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password#options","content":"<TypeTable\n  type=\"{\n  success: { type: &#x22;void&#x22;, description: &#x22;The reset email was requested successfully.&#x22; },\n  cancel: { type: &#x22;void&#x22;, description: &#x22;The user dismissed the form.&#x22; },\n}\"\n/>"},"256":{"id":"/docs/atomic-angular/auth/forgot-password-13","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password#pitfalls","content":"It should not — `pending` is cleared in a `finally`, including on the error path. If it stays disabled, check\nthat no other guard on the submit button (a custom `[disabled]` override) is combining with the component's\nown state."},"257":{"id":"/docs/atomic-angular/auth/forgot-password-14","page_id":"/docs/atomic-angular/auth/forgot-password","tags":[],"type":"text","url":"/docs/atomic-angular/auth/forgot-password#whats-next","content":"The confirmation screen shown after a logout — the third authentication view."},"258":{"id":"/docs/atomic-angular/auth","page_id":"/docs/atomic-angular/auth","type":"page","content":"Authentication","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth"},"259":{"id":"/docs/atomic-angular/auth-0","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth","content":"Sign-in, password reset and change, session guards and interceptors, and the principal store."},"260":{"id":"/docs/atomic-angular/auth-1","page_id":"/docs/atomic-angular/auth","type":"heading","tags":[],"url":"/docs/atomic-angular/auth#whats-next","content":"What's next"},"261":{"id":"/docs/atomic-angular/auth-2","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth","content":"Every mode a Sinequa application signs a user in with — credentials, SSO, OAuth, SAML, bearer — funnels\nthrough the same handful of pieces: a guard that protects routes, an interceptor that carries the session on\nthe `HttpClient` channel, and four views `AuthPageComponent` switches between."},"262":{"id":"/docs/atomic-angular/auth-3","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"The credentials form, and the entry point of the whole authentication sequence."},"263":{"id":"/docs/atomic-angular/auth-4","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"How the guard, the interceptor, sign-in and logout fit together end to end."},"264":{"id":"/docs/atomic-angular/auth-5","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"Protects routes, and redirects to change-password when the session's password has expired."},"265":{"id":"/docs/atomic-angular/auth-6","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"The signed-in user's data, loaded once and shared through a signal store."},"266":{"id":"/docs/atomic-angular/auth-7","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"Carries the session on the Angular HttpClient channel, which the atomic client never sees."},"267":{"id":"/docs/atomic-angular/auth-8","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"Current/new/confirm, then signs the user back in — standalone or embedded."},"268":{"id":"/docs/atomic-angular/auth-9","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"A one-field reset-email request, safe to embed anywhere."},"269":{"id":"/docs/atomic-angular/auth-10","page_id":"/docs/atomic-angular/auth","tags":[],"type":"text","url":"/docs/atomic-angular/auth#whats-next","content":"The post-logout confirmation that breaks the external-mode re-authentication loop."},"270":{"id":"/docs/atomic-angular/auth/principal-store","page_id":"/docs/atomic-angular/auth/principal-store","type":"page","content":"Principal store","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/principal-store"},"271":{"id":"/docs/atomic-angular/auth/principal-store-0","page_id":"/docs/atomic-angular/auth/principal-store","tags":[],"type":"text","url":"/docs/atomic-angular/auth/principal-store","content":"The signed-in user's data, loaded once and shared through a signal store — initials, admin status, and user-override state."},"272":{"id":"/docs/atomic-angular/auth/principal-store-1","page_id":"/docs/atomic-angular/auth/principal-store","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/principal-store#minimal-example","content":"Minimal example"},"273":{"id":"/docs/atomic-angular/auth/principal-store-2","page_id":"/docs/atomic-angular/auth/principal-store","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/principal-store#how-it-works","content":"How it works"},"274":{"id":"/docs/atomic-angular/auth/principal-store-3","page_id":"/docs/atomic-angular/auth/principal-store","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/principal-store#options","content":"Options"},"275":{"id":"/docs/atomic-angular/auth/principal-store-4","page_id":"/docs/atomic-angular/auth/principal-store","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/principal-store#pitfalls","content":"Pitfalls"},"276":{"id":"/docs/atomic-angular/auth/principal-store-5","page_id":"/docs/atomic-angular/auth/principal-store","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/principal-store#whats-next","content":"What's next"},"277":{"id":"/docs/atomic-angular/auth/principal-store-6","page_id":"/docs/atomic-angular/auth/principal-store","tags":[],"type":"text","url":"/docs/atomic-angular/auth/principal-store","content":"`PrincipalStore` holds the authenticated user's data — name, email, administrator status, password expiry —\nloaded once via `initialize()` and shared by every consumer through NgRx Signals."},"278":{"id":"/docs/atomic-angular/auth/principal-store-7","page_id":"/docs/atomic-angular/auth/principal-store","tags":[],"type":"text","url":"/docs/atomic-angular/auth/principal-store#how-it-works","content":"`initialize()` fetches the principal through the shared client (so it goes through the same auth handling as\nthe rest of `@sinequa/atomic` — cookies included, and the SSO-aware auto-authentication flag) and patches the\nstore. Concurrent calls — a guard awaiting the fetch while another initialization is already in flight — share\nthe same promise rather than issuing two requests."},"279":{"id":"/docs/atomic-angular/auth/principal-store-8","page_id":"/docs/atomic-angular/auth/principal-store","tags":[],"type":"text","url":"/docs/atomic-angular/auth/principal-store#options","content":"<TypeTable\n  type=\"{\n  allowUserOverride: { type: &#x22;Signal<boolean>&#x22;, description: &#x22;isAdministrator() and not userOverrideActive() — whether impersonation can be started.&#x22; },\n  isOverridingUser: { type: &#x22;Signal<boolean>&#x22;, description: &#x22;Whether an admin impersonation is currently active.&#x22; },\n  initials: { type: &#x22;Signal<string>&#x22;, description: &#x22;Uppercase initials derived from fullName — empty string with no name loaded.&#x22; },\n  state: { type: '&#x22;initial&#x22; | &#x22;loading&#x22; | &#x22;loaded&#x22; | &#x22;error&#x22;', description: &#x22;Load state, read by AuthGuard to decide whether to (re)initialize.&#x22; },\n  &#x22;initialize()&#x22;: { type: &#x22;() => Promise<void>&#x22;, description: &#x22;Fetches and patches the principal. De-duplicates concurrent calls.&#x22; },\n}\"\n/>"},"280":{"id":"/docs/atomic-angular/auth/principal-store-9","page_id":"/docs/atomic-angular/auth/principal-store","tags":[],"type":"text","url":"/docs/atomic-angular/auth/principal-store#pitfalls","content":"Read `state()` before trusting the other fields, or await `initialize()` yourself — a freshly-mounted\ncomponent may render before the store's own `initialize()` call (typically from `AuthGuard`) has resolved."},"281":{"id":"/docs/atomic-angular/auth/principal-store-10","page_id":"/docs/atomic-angular/auth/principal-store","tags":[],"type":"text","url":"/docs/atomic-angular/auth/principal-store#pitfalls","content":"`PrincipalService` is deprecated in favor of this store and will be removed in a future version — read\n`inject(PrincipalStore)` and the fields directly, or `getState(PrincipalStore)` for a plain snapshot, instead\nof subscribing to an `Observable`."},"282":{"id":"/docs/atomic-angular/auth/principal-store-11","page_id":"/docs/atomic-angular/auth/principal-store","tags":[],"type":"text","url":"/docs/atomic-angular/auth/principal-store#whats-next","content":"The guard that loads this store before letting a protected route through."},"283":{"id":"/docs/atomic-angular/auth/sign-in","page_id":"/docs/atomic-angular/auth/sign-in","type":"page","content":"Sign In","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/sign-in"},"284":{"id":"/docs/atomic-angular/auth/sign-in-0","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in","content":"Render the credentials form or drive the SSO/OAuth/SAML/bearer handshake automatically, with declarative Signal Forms validation and safe post-login navigation."},"285":{"id":"/docs/atomic-angular/auth/sign-in-1","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#minimal-example","content":"Minimal example"},"286":{"id":"/docs/atomic-angular/auth/sign-in-2","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#how-it-works","content":"How it works"},"287":{"id":"/docs/atomic-angular/auth/sign-in-3","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#recipes","content":"Recipes"},"288":{"id":"/docs/atomic-angular/auth/sign-in-4","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#embedded-in-a-dialog-or-a-wizard-step","content":"Embedded in a dialog or a wizard step"},"289":{"id":"/docs/atomic-angular/auth/sign-in-5","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#extending-the-component","content":"Extending the component"},"290":{"id":"/docs/atomic-angular/auth/sign-in-6","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#options","content":"Options"},"291":{"id":"/docs/atomic-angular/auth/sign-in-7","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#pitfalls","content":"Pitfalls"},"292":{"id":"/docs/atomic-angular/auth/sign-in-8","page_id":"/docs/atomic-angular/auth/sign-in","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/sign-in#whats-next","content":"What's next"},"293":{"id":"/docs/atomic-angular/auth/sign-in-9","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in","content":"`SignIn` is the credentials form and the entry point of the whole authentication sequence. In the external\nmodes (`sso`, `oauth`, `saml`, `bearer`) it shows a loader and starts the handshake itself instead of rendering\na form; in `credentials` mode it renders a real `<form>` built on\nSignal Forms."},"294":{"id":"/docs/atomic-angular/auth/sign-in-10","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in","content":"`SignInComponent` only ever renders the credentials form. Route `/login` (and `/logout`) to\n`AuthPageComponent` instead — it switches between sign-in, change-password, forgot-password and signed-out\nbased on the route and the `mode` query param. See Authentication flows."},"295":{"id":"/docs/atomic-angular/auth/sign-in-11","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#how-it-works","content":"`initialize()` runs with `syncUrl: false` — deliberately: this component navigates to the `returnUrl` itself,\nand letting the query-params store sync to the URL first would navigate to the bare route, dropping the\n`returnUrl`'s search parameters (and running the search twice, once on empty text)."},"296":{"id":"/docs/atomic-angular/auth/sign-in-12","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#how-it-works","content":"The `authenticated` DOM event only drives navigation for the **external** handshake — a credentials login owns\nits own sequence, and navigating from that event too would race the application initialization."},"297":{"id":"/docs/atomic-angular/auth/sign-in-13","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#embedded-in-a-dialog-or-a-wizard-step","content":"Opt out of the behaviours that assume the component owns the whole page. `autoStart` matters most: without it,\nmounting the form in an external auth mode would redirect the entire page to the identity provider."},"298":{"id":"/docs/atomic-angular/auth/sign-in-14","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#extending-the-component","content":"Subclass it to replace the template while keeping the whole authentication sequence. Bind your controls to\n`signInForm` — the validation schema comes along with it, so `[formRoot]` alone drives submit interception,\n`preventDefault()` and validity gating."},"299":{"id":"/docs/atomic-angular/auth/sign-in-15","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#options","content":"<TypeTable\n  type=\"{\n  credentials: { type: &#x22;model<Credentials>&#x22;, default: '{ username: &#x22;&#x22;, password: &#x22;&#x22; }', description: &#x22;Two-way bindable form model.&#x22; },\n  class: { type: &#x22;string&#x22;, description: &#x22;Extra classes merged into the host.&#x22; },\n  fullscreen: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Full-height centred layout. Set false when embedding.&#x22; },\n  surface: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Renders the form as a card. Set false when the container already provides one.&#x22; },\n  autoStart: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Starts the SSO/OAuth/SAML/bearer handshake on init. Set false when embedding.&#x22; },\n  redirectAfterSuccess: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Navigates to the returnUrl once authenticated. Set false to let the host decide.&#x22; },\n}\"\n/>"},"300":{"id":"/docs/atomic-angular/auth/sign-in-16","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#options","content":"<TypeTable\n  type=\"{\n  success: { type: &#x22;void&#x22;, description: &#x22;Authenticated and the application is initialized — emitted before any navigation.&#x22; },\n  forgotPassword: { type: &#x22;void&#x22;, description: &#x22;The user asked for a password reset.&#x22; },\n  changePassword: { type: &#x22;string&#x22;, description: &#x22;Username — the server rejected the login with an expired password.&#x22; },\n}\"\n/>"},"301":{"id":"/docs/atomic-angular/auth/sign-in-17","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#pitfalls","content":"The component renders its own `<form>` — nested forms are invalid HTML, and browsers resolve them\nunpredictably. In a wizard, keep the navigation buttons outside the step, or let each step own its own\nsubmission instead of wrapping it."},"302":{"id":"/docs/atomic-angular/auth/sign-in-18","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#pitfalls","content":"`autoStart` defaults to `true` — in `sso`/`oauth`/`saml`/`bearer` mode the component starts the handshake as\nsoon as it mounts, which for a full-page redirect means navigating away from the dialog entirely. Set\n`[autoStart]=\"false\"` whenever the component is embedded rather than owning the route."},"303":{"id":"/docs/atomic-angular/auth/sign-in-19","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#pitfalls","content":"They will — messages are translated from the error `kind` (`login.errors.required`), not baked in at\nvalidation time, so a later language change is reflected automatically. If they appear frozen, check that the\ntranslation scope providing `login.errors.*` is actually loaded for the new language."},"304":{"id":"/docs/atomic-angular/auth/sign-in-20","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#whats-next","content":"How every piece — guard, interceptor, sign-in, logout — fits together end to end."},"305":{"id":"/docs/atomic-angular/auth/sign-in-21","page_id":"/docs/atomic-angular/auth/sign-in","tags":[],"type":"text","url":"/docs/atomic-angular/auth/sign-in#whats-next","content":"Protects routes, and redirects to change-password when the session's password has expired."},"306":{"id":"/docs/atomic-angular/auth/signed-out","page_id":"/docs/atomic-angular/auth/signed-out","type":"page","content":"Signed Out","breadcrumbs":["Docs","Atomic Angular","Authentication"],"tags":[],"url":"/docs/atomic-angular/auth/signed-out"},"307":{"id":"/docs/atomic-angular/auth/signed-out-0","page_id":"/docs/atomic-angular/auth/signed-out","tags":[],"type":"text","url":"/docs/atomic-angular/auth/signed-out","content":"The post-logout confirmation shown on /logout — breaks the re-authentication loop that rendering the sign-in form there would cause in external auth modes."},"308":{"id":"/docs/atomic-angular/auth/signed-out-1","page_id":"/docs/atomic-angular/auth/signed-out","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/signed-out#minimal-example","content":"Minimal example"},"309":{"id":"/docs/atomic-angular/auth/signed-out-2","page_id":"/docs/atomic-angular/auth/signed-out","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/signed-out#how-it-works","content":"How it works"},"310":{"id":"/docs/atomic-angular/auth/signed-out-3","page_id":"/docs/atomic-angular/auth/signed-out","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/signed-out#options","content":"Options"},"311":{"id":"/docs/atomic-angular/auth/signed-out-4","page_id":"/docs/atomic-angular/auth/signed-out","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/signed-out#pitfalls","content":"Pitfalls"},"312":{"id":"/docs/atomic-angular/auth/signed-out-5","page_id":"/docs/atomic-angular/auth/signed-out","type":"heading","tags":[],"url":"/docs/atomic-angular/auth/signed-out#whats-next","content":"What's next"},"313":{"id":"/docs/atomic-angular/auth/signed-out-6","page_id":"/docs/atomic-angular/auth/signed-out","tags":[],"type":"text","url":"/docs/atomic-angular/auth/signed-out","content":"`SignedOut` is the post-logout confirmation shown on the `/logout` route by\n`AuthPageComponent`. It states that the session has ended and offers a single\nexplicit action to sign in again."},"314":{"id":"/docs/atomic-angular/auth/signed-out-7","page_id":"/docs/atomic-angular/auth/signed-out","tags":[],"type":"text","url":"/docs/atomic-angular/auth/signed-out","content":"In the external authentication modes (`sso`, `oauth`, `saml`, `bearer`), Sign In starts the\nhandshake as soon as it mounts. Rendering the sign-in form on `/logout` would therefore re-authenticate the\nuser immediately — a spinner that loops straight back in, defeating the logout. This view breaks that loop."},"315":{"id":"/docs/atomic-angular/auth/signed-out-8","page_id":"/docs/atomic-angular/auth/signed-out","tags":[],"type":"text","url":"/docs/atomic-angular/auth/signed-out#how-it-works","content":"The `returnUrl` is not decorative: in the external modes, the sign-in screen only navigates away once the\nhandshake completes **if** a `returnUrl` is present — without one it sits on the loader forever."},"316":{"id":"/docs/atomic-angular/auth/signed-out-9","page_id":"/docs/atomic-angular/auth/signed-out","tags":[],"type":"text","url":"/docs/atomic-angular/auth/signed-out#options","content":"This component has no inputs or outputs of its own — its only public surface is `signInAgain(): void`,\nnavigating to `loginPath` (default `/login`) with `returnUrl: \"/\"`."},"317":{"id":"/docs/atomic-angular/auth/signed-out-10","page_id":"/docs/atomic-angular/auth/signed-out","tags":[],"type":"text","url":"/docs/atomic-angular/auth/signed-out#pitfalls","content":"Check that navigation actually attached a `returnUrl` — `signInAgain()` always sets one, so this usually means\na custom router configuration stripped or overrode the query params on the way to `/login`."},"318":{"id":"/docs/atomic-angular/auth/signed-out-11","page_id":"/docs/atomic-angular/auth/signed-out","tags":[],"type":"text","url":"/docs/atomic-angular/auth/signed-out#whats-next","content":"Why /logout renders this view instead of the sign-in form, end to end."},"319":{"id":"/docs/atomic-angular/notifications/alerts","page_id":"/docs/atomic-angular/notifications/alerts","type":"page","content":"Alerts","breadcrumbs":["Docs","Atomic Angular","Notifications & feedback"],"tags":[],"url":"/docs/atomic-angular/notifications/alerts"},"320":{"id":"/docs/atomic-angular/notifications/alerts-0","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts","content":"List, reorder and delete a user's search alerts, and create or edit one through a callable Signal Forms dialog."},"321":{"id":"/docs/atomic-angular/notifications/alerts-1","page_id":"/docs/atomic-angular/notifications/alerts","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/alerts#minimal-example","content":"Minimal example"},"322":{"id":"/docs/atomic-angular/notifications/alerts-2","page_id":"/docs/atomic-angular/notifications/alerts","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/alerts#how-it-works","content":"How it works"},"323":{"id":"/docs/atomic-angular/notifications/alerts-3","page_id":"/docs/atomic-angular/notifications/alerts","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/alerts#recipes","content":"Recipes"},"324":{"id":"/docs/atomic-angular/notifications/alerts-4","page_id":"/docs/atomic-angular/notifications/alerts","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/alerts#editing-an-existing-alert","content":"Editing an existing alert"},"325":{"id":"/docs/atomic-angular/notifications/alerts-5","page_id":"/docs/atomic-angular/notifications/alerts","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/alerts#options","content":"Options"},"326":{"id":"/docs/atomic-angular/notifications/alerts-6","page_id":"/docs/atomic-angular/notifications/alerts","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/alerts#pitfalls","content":"Pitfalls"},"327":{"id":"/docs/atomic-angular/notifications/alerts-7","page_id":"/docs/atomic-angular/notifications/alerts","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/alerts#whats-next","content":"What's next"},"328":{"id":"/docs/atomic-angular/notifications/alerts-8","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts","content":"An alert is a saved query the server re-runs on a schedule — a frequency, the weekdays it repeats on, a time of\nday. `<Alerts>` lists, reorders and deletes them; `AlertForm` opens the dialog that creates or edits one."},"329":{"id":"/docs/atomic-angular/notifications/alerts-9","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts","content":"Unlike a saved search a user re-runs by hand, an alert is re-run **by the server** on a schedule, and (depending\non how the deployment is configured) can notify the user out of band when new matches appear."},"330":{"id":"/docs/atomic-angular/notifications/alerts-10","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#minimal-example","content":"`AlertForm` is a callable, not a component — there is nothing to place in a template and no `opened` flag to\ndrive. The returned promise resolves with the `DialogEvent` that closed it: `\"dialog-confirm\"` when the alert\nwas saved, `\"dialog-cancel\"` otherwise."},"331":{"id":"/docs/atomic-angular/notifications/alerts-11","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#how-it-works","content":"The whole dialog is one Signal Forms field tree (`[formRoot]`), and the Confirm button **is** the form's\n`submit` — there is no separate click handler that reads the model and calls a service. The seven weekday\ncheckboxes bind to plain booleans, one field each; `Alert.Days` (the bitfield the server actually stores) only\nexists at the edges, folded by `flagsFromWeekdays()`/unfolded by `weekdaysFromFlags()`."},"332":{"id":"/docs/atomic-angular/notifications/alerts-12","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#options","content":"<TypeTable\n  type=\"{\n  AlertFormModel: {\n    type: &#x22;{ name: string; frequency: Alert.Frequency | null; days: Record<WeekdayKey, boolean>; time: string; active: boolean }&#x22;,\n    description: 'The dialog\\'s field-tree model. frequency includes null because that is the Select\\'s empty state.',\n  },\n  &#x22;weekdaysFromFlags(mask)&#x22;: { type: &#x22;(mask: Alert.Days) => Record<WeekdayKey, boolean>&#x22;, description: &#x22;Splits the stored bitfield into the seven form booleans.&#x22; },\n  &#x22;flagsFromWeekdays(days)&#x22;: { type: &#x22;(days: Record<WeekdayKey, boolean>) => Alert.Days&#x22;, description: &#x22;Folds the seven form booleans back into the bitfield the server stores.&#x22; },\n}\"\n/>"},"333":{"id":"/docs/atomic-angular/notifications/alerts-13","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#options","content":"Neither component takes an input. `AlertsComponent` reads its list from `UserSettingsStore`; `AlertDialog`\nreceives its index through the callable's props and reports only through the resolved promise."},"334":{"id":"/docs/atomic-angular/notifications/alerts-14","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#pitfalls","content":"Not a bug: the model's empty state is `null`, never `undefined` — `undefined` would orphan the `Select` control\nunder Signal Forms (`NG01902`) — and `required()` on the field correctly treats `null`, not `0`, as empty.\n`Alert.Frequency.Daily` being `0` is handled correctly precisely because the check is against `null`."},"335":{"id":"/docs/atomic-angular/notifications/alerts-15","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#pitfalls","content":"Deliberate. A disabled `submit` never fires `submit()`, which is what marks every field touched and reveals\nvalidation messages — and the weekday `<fieldset>` has no other way to become touched, since the galactik\n`Checkbox` emits no `touch` output on its own. Leaving Confirm enabled is what lets a user discover which field\nis missing."},"336":{"id":"/docs/atomic-angular/notifications/alerts-16","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#pitfalls","content":"`ButtonComponent` is a directive on the bare `button` selector and does not set `type` for you — a button left\nuntyped inside a `<form>` submits it by default HTML behavior. Every button in this dialog other than Confirm\nneeds an explicit `type=\"button\"`."},"337":{"id":"/docs/atomic-angular/notifications/alerts-17","page_id":"/docs/atomic-angular/notifications/alerts","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/alerts#whats-next","content":"Where a failed request's own error notifications come from."},"338":{"id":"/docs/atomic-angular/notifications","page_id":"/docs/atomic-angular/notifications","type":"page","content":"Notifications & feedback","breadcrumbs":["Docs","Atomic Angular","Notifications & feedback"],"tags":[],"url":"/docs/atomic-angular/notifications"},"339":{"id":"/docs/atomic-angular/notifications-0","page_id":"/docs/atomic-angular/notifications","tags":[],"type":"text","url":"/docs/atomic-angular/notifications","content":"Saved search alerts the server re-runs on a schedule, and the toast interceptor that surfaces a failed HttpClient request to the user."},"340":{"id":"/docs/atomic-angular/notifications-1","page_id":"/docs/atomic-angular/notifications","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications#whats-next","content":"What's next"},"341":{"id":"/docs/atomic-angular/notifications-2","page_id":"/docs/atomic-angular/notifications","tags":[],"type":"text","url":"/docs/atomic-angular/notifications","content":"Two unrelated ways the application tells the user something happened outside the current screen: a scheduled\nalert the user set up themselves, and an automatic toast when a request fails."},"342":{"id":"/docs/atomic-angular/notifications-3","page_id":"/docs/atomic-angular/notifications","tags":[],"type":"text","url":"/docs/atomic-angular/notifications#whats-next","content":"List, reorder, delete, create and edit scheduled search alerts."},"343":{"id":"/docs/atomic-angular/notifications-4","page_id":"/docs/atomic-angular/notifications","tags":[],"type":"text","url":"/docs/atomic-angular/notifications#whats-next","content":"Turn a failed HttpClient request into a toast, for the statuses worth telling the user about."},"344":{"id":"/docs/atomic-angular/notifications/toast","page_id":"/docs/atomic-angular/notifications/toast","type":"page","content":"Toast interceptor","breadcrumbs":["Docs","Atomic Angular","Notifications & feedback"],"tags":[],"url":"/docs/atomic-angular/notifications/toast"},"345":{"id":"/docs/atomic-angular/notifications/toast-0","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast","content":"An HttpInterceptorFn that turns a failed HttpClient request into a toast for the status codes worth telling the user about, without wrapping HttpClient itself."},"346":{"id":"/docs/atomic-angular/notifications/toast-1","page_id":"/docs/atomic-angular/notifications/toast","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/toast#minimal-example","content":"Minimal example"},"347":{"id":"/docs/atomic-angular/notifications/toast-2","page_id":"/docs/atomic-angular/notifications/toast","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/toast#how-it-works","content":"How it works"},"348":{"id":"/docs/atomic-angular/notifications/toast-3","page_id":"/docs/atomic-angular/notifications/toast","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/toast#pitfalls","content":"Pitfalls"},"349":{"id":"/docs/atomic-angular/notifications/toast-4","page_id":"/docs/atomic-angular/notifications/toast","type":"heading","tags":[],"url":"/docs/atomic-angular/notifications/toast#whats-next","content":"What's next"},"350":{"id":"/docs/atomic-angular/notifications/toast-5","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast","content":"`toastInterceptorFn` watches the Angular `HttpClient` channel and raises a toast (through `@sinequa/atomic`'s\nnotification system) for the handful of error statuses a user should actually hear about — leaving every other\nfailure to whatever already handles it."},"351":{"id":"/docs/atomic-angular/notifications/toast-6","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast","content":"`provideAtomicNotifications()` does the same job for the Sinequa\nclient's **own** requests, by listening to its `requestFailed` event — a different channel entirely. The two\ncover disjoint request sets (the client's, versus `HttpClient` requests from `@sinequa/agent`,\n`@sinequa/assistant` or your own code), so registering both raises exactly one toast per failure, never two."},"352":{"id":"/docs/atomic-angular/notifications/toast-7","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast#how-it-works","content":"Requests to `api/v1/audit.notify` pass through untouched — auditing itself must never trigger a notification\nabout a failed audit call. Every other request is watched for:"},"353":{"id":"/docs/atomic-angular/notifications/toast-8","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast#how-it-works","content":"**`401` during an active user-override**, with a specific server error code — shown once as \"Cannot override\nuser: Unauthorized access\", then a request-scoped flag suppresses a repeat toast for the same request context."},"354":{"id":"/docs/atomic-angular/notifications/toast-9","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast#how-it-works","content":"**`400`, `403`, `500`, `503`** — shown as `${statusText}: ${errorCodeText} — ${errorMessage}`, with two\nexceptions: a `400` from `api/v2/user-profile` (handled by the caller instead) and any status from\n`api/v1/preview` (preview failures are shown in the preview surface itself, not as a toast)."},"355":{"id":"/docs/atomic-angular/notifications/toast-10","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast#pitfalls","content":"Deliberate — every status code from a URL containing `api/v1/preview` is excluded, on the assumption that the\npreview surface already reports its own failure state. If you need a toast for a preview-related request of\nyour own, route it through a different endpoint or handle the error yourself."},"356":{"id":"/docs/atomic-angular/notifications/toast-11","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast#pitfalls","content":"Also deliberate — `api/v2/user-profile` requests are excluded so the caller (typically a form) can show the\nerror inline instead of as a transient toast."},"357":{"id":"/docs/atomic-angular/notifications/toast-12","page_id":"/docs/atomic-angular/notifications/toast","tags":[],"type":"text","url":"/docs/atomic-angular/notifications/toast#whats-next","content":"The equivalent for the Sinequa client's own requests, on a different channel."},"358":{"id":"/docs/atomic-angular/dataviz/aggregation-chart","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","type":"page","content":"Aggregation Chart","breadcrumbs":["Docs","Atomic Angular","Data visualization"],"tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-chart"},"359":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-0","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart","content":"A Sinequa aggregation as a bar, pie or doughnut chart, on Chart.js — an optional peer dependency, from a separate entry point."},"360":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-1","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-chart#minimal-example","content":"Minimal example"},"361":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-2","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-chart#how-it-works","content":"How it works"},"362":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-3","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-chart#chartcanvas--the-shared-lifecycle","content":"`<ChartCanvas>` — the shared lifecycle"},"363":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-4","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-chart#options","content":"Options"},"364":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-5","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-chart#pitfalls","content":"Pitfalls"},"365":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-6","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-chart#whats-next","content":"What's next"},"366":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-7","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart","content":"The classic chart view of a facet: a bar, pie or doughnut over an aggregation's items, with a click on a\nslice or bar reporting its label back so it can become a filter."},"367":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-8","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart","content":"This component ships from `@sinequa/atomic-angular/charts`, a **secondary entry point** — an application that\nnever imports from it does not need `chart.js` installed, and npm will not warn about it."},"368":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-9","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#how-it-works","content":"`<AggregationChart>` does three things only: `toSeries()` turns the aggregation into two parallel arrays\n(pure, testable, no dependency of its own), a `computed()` builds a Chart.js `ChartConfiguration` from them, and\n`<ChartCanvas>` owns the actual canvas lifecycle. It never fetches and\nnever touches the DOM directly."},"369":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-10","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#chartcanvas--the-shared-lifecycle","content":"Every chart in this entry point renders through the same `<ChartCanvas>`, which enforces four rules no caller\nhas to think about: create the Chart.js instance only after the first render (a canvas created earlier\nmeasures as 0×0); always destroy it on teardown; rebuild when the chart `type` changes (Chart.js cannot swap\ncontrollers on a live instance); and rebuild when the color theme flips (`Chart.defaults` is read once, at\nconstruction)."},"370":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-11","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#chartcanvas--the-shared-lifecycle","content":"**The host must have a resolved height** — Chart.js measures the canvas' parent box, and a blank chart is\nalmost always a container with no height (`class=\"h-64\"` above)."},"371":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-12","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#options","content":"<TypeTable\n  type=\"{\n  aggregation: { type: &#x22;AggregationLike | undefined&#x22;, description: &#x22;The aggregation to render.&#x22; },\n  type: { type: '&#x22;bar&#x22; | &#x22;pie&#x22; | &#x22;doughnut&#x22;', default: '&#x22;bar&#x22;', description: &#x22;Chart type.&#x22; },\n  label: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;Dataset label, shown in the legend and the tooltip.&#x22; },\n  limit: { type: &#x22;number&#x22;, default: &#x22;10&#x22;, description: &#x22;Items kept, largest first. Charts stop being readable long before the data runs out.&#x22; },\n  asPercentage: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Plot each item as a share of the total instead of a raw count.&#x22; },\n  weightField: { type: &#x22;string | undefined&#x22;, description: &#x22;Read operatorResults[weightField] instead of count — for an average response time, say.&#x22; },\n  emptyLabel: { type: &#x22;string&#x22;, default: '&#x22;No data&#x22;', description: &#x22;Shown when the aggregation resolves to no items.&#x22; },\n}\"\n/>"},"372":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-13","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#pitfalls","content":"Almost always a container with no resolved height — Chart.js sizes the canvas from its parent's box. Give the\nhost (or its wrapper) an explicit height, as the examples on this page do with `class=\"h-64\"`."},"373":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-14","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#pitfalls","content":"This library ships no date adapter, and Chart.js only validates that at runtime, not at compile time. Every\nchart in this entry point uses a `category` axis instead — see\nAggregation Timeline for the time-series case."},"374":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-15","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#whats-next","content":"A time series with a drag-to-select range brush, on the same ChartCanvas foundation."},"375":{"id":"/docs/atomic-angular/dataviz/aggregation-chart-16","page_id":"/docs/atomic-angular/dataviz/aggregation-chart","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-chart#whats-next","content":"A two-dimensional distribution on canvas, for matrices too large for the DOM."},"376":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","type":"page","content":"Aggregation Heatmap","breadcrumbs":["Docs","Atomic Angular","Data visualization"],"tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-heatmap"},"377":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-0","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap","content":"The canvas sibling of Heatmap, for a two-dimensional distribution too large for the DOM — same inputs, same output payloads, one import change."},"378":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-1","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-heatmap#minimal-example","content":"Minimal example"},"379":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-2","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-heatmap#how-it-works","content":"How it works"},"380":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-3","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-heatmap#options","content":"Options"},"381":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-4","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-heatmap#pitfalls","content":"Pitfalls"},"382":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-5","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-heatmap#whats-next","content":"What's next"},"383":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-6","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap","content":"`<Heatmap>` is the one to reach for first — it costs no dependency and is fully accessible.\n`<AggregationHeatmap>` exists for the case `<Heatmap>` cannot serve: a matrix large enough that hundreds of DOM\nnodes become the bottleneck. Canvas rendering is flat in the cell count; a DOM grid is not."},"384":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-7","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap","content":"Switching to this component costs a dependency (`chartjs-chart-matrix`, on top of `chart.js`) and it costs\naccessibility — a canvas is opaque to screen readers and to text selection, and nothing brings that back.\nWhat it does **not** cost is the clickable axis label: `createAxisClickPlugin()` reproduces it on canvas, and\n`(axisSelected)` emits the exact same payload shape as `<Heatmap>`."},"385":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-8","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap#how-it-works","content":"`chartjs-chart-matrix` ships no other chart in this library needs, so it lives in its own tertiary entry point\n(`@sinequa/atomic-angular/charts/heatmap`) rather than the shared `/charts` one — an application drawing only\nbar charts never resolves it."},"386":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-9","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap#how-it-works","content":"The same `buildHeatmap()` pure function `<Heatmap>` uses parses the aggregation here too, so\nthe two components are interchangeable: identical inputs, identical `(cellSelected)`/`(axisSelected)` payload\nshapes. Swapping one for the other is an import change, nothing more."},"387":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-10","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap#how-it-works","content":"**Clickable axis labels, reproduced on canvas.** Chart.js's own `options.onClick` never fires on an axis\nlabel — it only fires inside the chart area, and labels sit outside it by construction. `createAxisClickPlugin()`\ndoes its own hit test against the scale's box instead, walking `getPixelForTick()` rather than inverting\n`getValueForPixel()` (which assumes uniform spacing and breaks under `offset`/`autoSkip`, both of which this\ncomponent sets)."},"388":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-11","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap#options","content":"<TypeTable\n  type=\"{\n  aggregation: { type: &#x22;AggregationLike | undefined&#x22;, description: &#x22;The two-dimensional aggregation to render.&#x22; },\n  encoding: {\n    type: 'HeatmapEncoding',\n    default: '{ kind: &#x22;separator&#x22;, separator: &#x22;$@$&#x22; }',\n    description: &#x22;Same shape and meaning as on <Heatmap> — see that page.&#x22;,\n  },\n  maxX: { type: &#x22;number&#x22;, default: &#x22;20&#x22;, description: &#x22;Columns kept, ranked by total weight.&#x22; },\n  maxY: { type: &#x22;number&#x22;, default: &#x22;20&#x22;, description: &#x22;Rows kept, ranked by total weight.&#x22; },\n  enableAxisSelection: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;Makes axis labels clickable. Turn off when nothing listens to axisSelected — a pointer cursor with nothing behind it is worse than none.&#x22;,\n  },\n  emptyLabel: { type: &#x22;string&#x22;, default: '&#x22;No data&#x22;', description: &#x22;Shown when the aggregation resolves to no cells.&#x22; },\n}\"\n/>"},"389":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-12","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap#pitfalls","content":"Check that nothing overrode `options.events` on a custom configuration passed further down the chain — the\nsame event-list requirement `<AggregationTimeline>`'s brush has does not apply\nhere (the axis-click plugin uses a different hookup), but a heavily customized chart configuration can still\ninterfere with hit testing. Confirm first with the defaults, then reintroduce customization incrementally."},"390":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-13","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap#pitfalls","content":"By design — canvas rendering is opaque to assistive technology and to text selection, and no plugin restores\neither. If accessibility matters more than raw cell count, use `<Heatmap>` instead; if the\nmatrix is genuinely too large for a DOM grid, this trade-off is the one to accept."},"391":{"id":"/docs/atomic-angular/dataviz/aggregation-heatmap-14","page_id":"/docs/atomic-angular/dataviz/aggregation-heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-heatmap#whats-next","content":"The accessible DOM sibling — reach for it first."},"392":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"page","content":"Aggregation Timeline","breadcrumbs":["Docs","Atomic Angular","Data visualization"],"tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline"},"393":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-0","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline","content":"A time series with a drag-to-select range brush, on Chart.js — no d3, no date adapter, gap-filled buckets."},"394":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-1","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline#minimal-example","content":"Minimal example"},"395":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-2","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline#how-it-works","content":"How it works"},"396":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-3","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline#recipes","content":"Recipes"},"397":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-4","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline#comparing-two-periods","content":"Comparing two periods"},"398":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-5","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline#options","content":"Options"},"399":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-6","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline#pitfalls","content":"Pitfalls"},"400":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-7","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/aggregation-timeline#whats-next","content":"What's next"},"401":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-8","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline","content":"A date aggregation's buckets, plotted as a stepped line with an optional drag-to-select brush — replacing an\n\\~800-line d3 timeline with Chart.js alone, plus a category axis and a small brush plugin."},"402":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-9","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline","content":"Ships from `@sinequa/atomic-angular/charts`, same as `<AggregationChart>` — see that\npage for the `chart.js` install note and the shared `<ChartCanvas>` lifecycle rules."},"403":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-10","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline#how-it-works","content":"A `category` axis, never `\"time\"` — this library ships no Chart.js date adapter, and setting\n`scales.x.type = \"time\"` without one compiles perfectly and throws at runtime. Bucket labels are resolved by\n`buildTimeline()` (a pure function, unit-testable without a chart), which also fills gaps: an empty bucket is\ndrawn flat at zero rather than skipped, so the shape of the series is never silently misrepresented."},"404":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-11","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline#how-it-works","content":"**`(rangeSelected)` only reports a range — it does not zoom anything on its own.** If nothing in the host reacts\nto it, dragging paints a selection rectangle that then disappears and nothing else happens; the component is\nworking as designed. Keep a stack of ranges in the host: a drag pushes one (zoom in), a control pops it (zoom\nout)."},"405":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-12","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline#comparing-two-periods","content":"`dashSecondary` renders every second series dashed, the \"previous period\" convention, and pairs it with the\nsame color as the series it compares against rather than doubling the palette."},"406":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-13","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline#options","content":"<TypeTable\n  type=\"{\n  series: { type: &#x22;readonly TimelineSeriesInput[]&#x22;, default: &#x22;[]&#x22;, description: &#x22;The series to plot. Each carries an aggregation whose items are date buckets.&#x22; },\n  mask: {\n    type: &#x22;TimelineMask | undefined&#x22;,\n    default: '&#x22;YYYY-MM-DD&#x22;',\n    description: &#x22;Bucket width, for gap filling. Without it, empty buckets are skipped instead of drawn flat at zero.&#x22;,\n  },\n  enableSelection: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Enable the drag-to-select brush.&#x22; },\n  dashSecondary: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Render every second series dashed — the previous-period convention.&#x22; },\n  emptyLabel: { type: &#x22;string&#x22;, default: '&#x22;No data&#x22;', description: &#x22;Shown when every series is empty.&#x22; },\n}\"\n/>"},"407":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-14","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline#pitfalls","content":"Expected — `(rangeSelected)` only reports the drag; it changes nothing on its own. See \"How it works\" above:\nkeep a stack of ranges in the host and re-fetch on push/pop."},"408":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-15","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline#pitfalls","content":"If a custom `options.events` was set on the underlying configuration, check it still includes\n`\"mousedown\"` and `\"mouseup\"` — Chart.js' own default event list omits both, which the brush plugin relies on\nto detect a drag start and end. Overriding `events` without keeping them makes the brush silently inert, with\nno error."},"409":{"id":"/docs/atomic-angular/dataviz/aggregation-timeline-16","page_id":"/docs/atomic-angular/dataviz/aggregation-timeline","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/aggregation-timeline#whats-next","content":"The bar/pie/doughnut sibling, for a ranked distribution rather than a time series."},"410":{"id":"/docs/atomic-angular/dataviz/heatmap","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"page","content":"Heatmap","breadcrumbs":["Docs","Atomic Angular","Data visualization"],"tags":[],"url":"/docs/atomic-angular/dataviz/heatmap"},"411":{"id":"/docs/atomic-angular/dataviz/heatmap-0","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap","content":"Render a two-dimensional aggregation as a grid of intensity-shaded cells — no charting dependency, real clickable buttons for cells and axis labels, readable by a screen reader."},"412":{"id":"/docs/atomic-angular/dataviz/heatmap-1","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/heatmap#minimal-example","content":"Minimal example"},"413":{"id":"/docs/atomic-angular/dataviz/heatmap-2","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/heatmap#how-it-works","content":"How it works"},"414":{"id":"/docs/atomic-angular/dataviz/heatmap-3","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/heatmap#recipes","content":"Recipes"},"415":{"id":"/docs/atomic-angular/dataviz/heatmap-4","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/heatmap#filtering-from-an-axis-label","content":"Filtering from an axis label"},"416":{"id":"/docs/atomic-angular/dataviz/heatmap-5","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/heatmap#options","content":"Options"},"417":{"id":"/docs/atomic-angular/dataviz/heatmap-6","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/heatmap#pitfalls","content":"Pitfalls"},"418":{"id":"/docs/atomic-angular/dataviz/heatmap-7","page_id":"/docs/atomic-angular/dataviz/heatmap","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/heatmap#whats-next","content":"What's next"},"419":{"id":"/docs/atomic-angular/dataviz/heatmap-8","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap","content":"A two-dimensional distribution — documents by source **and** by format, say — needs more than a list: a\nheatmap shows both axes at once, with colour standing in for count. `<Heatmap>` renders it as a CSS grid,\nwhich is what lets every cell and every axis label be a real, clickable, keyboard-reachable `<button>`."},"420":{"id":"/docs/atomic-angular/dataviz/heatmap-9","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap","content":"Sinequa encodes a two-dimensional aggregation's two axes inside each item's single `value` field, one of three\nways depending on how the aggregation was configured on the server: `\"separator\"` (both values joined by a\ndelimiter), `\"cooccurrence\"` (a nested structure) or `\"cross\"` (a fielded expression, where the filterable\nvalue differs from the displayed label). `<Heatmap>`'s `encoding` input tells it which one to parse."},"421":{"id":"/docs/atomic-angular/dataviz/heatmap-10","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#minimal-example","content":"The host needs a resolved height (`class=\"h-80\"` above) for the same reason every chart in this section does:\nthe grid fills its container, and a container with no height renders nothing to see."},"422":{"id":"/docs/atomic-angular/dataviz/heatmap-11","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#how-it-works","content":"`<Heatmap>` never fetches and never transforms the aggregation itself — `buildHeatmap()`, a pure function, does\nboth jobs: it parses `encoding`, ranks and caps both axes at `maxX`/`maxY`, and returns an indexed grid the\ntemplate renders directly."},"423":{"id":"/docs/atomic-angular/dataviz/heatmap-12","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#how-it-works","content":"`AggregationLike` is a **structural** type, not an import of `@sinequa/atomic`'s `Aggregation` — a real\n`Aggregation` is assignable to it with no cast, so nothing here depends on that package. The same pattern\nrecurs across every component in this section: a pure, dependency-free data module (`buildHeatmap`,\n`toSeries`, `buildTimeline`, `buildTagCloud`) does the parsing, and the component only renders."},"424":{"id":"/docs/atomic-angular/dataviz/heatmap-13","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#how-it-works","content":"Colour comes from a **primitive** galactik token (`--blue-500`), resolved once after the first render — reading\nit any earlier returns nothing useful, since `getComputedStyle` has nothing to compute against before styles\napply. A primitive token is invariant across themes, which is why the ramp keeps its identity when the page\nflips to dark mode, unlike the semantic tokens (axis text, grid lines) the Chart.js-based charts use instead."},"425":{"id":"/docs/atomic-angular/dataviz/heatmap-14","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#filtering-from-an-axis-label","content":"`(axisSelected)` reports the value **behind** the label, not the label text — under the `\"cross\"` encoding the\ntwo differ, so always read `.value` when building a filter, never `.label`."},"426":{"id":"/docs/atomic-angular/dataviz/heatmap-15","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#options","content":"<TypeTable\n  type=\"{\n  aggregation: { type: &#x22;AggregationLike | undefined&#x22;, description: &#x22;The two-dimensional aggregation to render.&#x22; },\n  encoding: {\n    type: '{ kind: &#x22;separator&#x22;, separator?: string } | { kind: &#x22;cooccurrence&#x22; } | { kind: &#x22;cross&#x22; }',\n    default: '{ kind: &#x22;separator&#x22;, separator: &#x22;$@$&#x22; }',\n    description: &#x22;How the two axes are packed into each item's value — must match the server-side configuration.&#x22;,\n  },\n  maxX: { type: &#x22;number&#x22;, default: &#x22;20&#x22;, description: &#x22;Columns kept, ranked by total weight.&#x22; },\n  maxY: { type: &#x22;number&#x22;, default: &#x22;20&#x22;, description: &#x22;Rows kept, ranked by total weight.&#x22; },\n  emptyLabel: { type: &#x22;string&#x22;, default: '&#x22;No data&#x22;', description: &#x22;Shown when the aggregation resolves to no cells.&#x22; },\n  class: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;Extra classes on the host.&#x22; },\n}\"\n/>"},"427":{"id":"/docs/atomic-angular/dataviz/heatmap-16","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#pitfalls","content":"Check `encoding` against how the aggregation was actually configured on the server first — a `\"separator\"`\naggregation parsed with `{ kind: \"cross\" }` produces no valid cells, and `<Heatmap>` has no way to detect the\nmismatch on its own. A faint, uniform grey grid with no data-colored cells is the same symptom as a missing\naggregation: nothing parsed."},"428":{"id":"/docs/atomic-angular/dataviz/heatmap-17","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#pitfalls","content":"Expected — `<Heatmap>` is capped at 20×20 by default and is not meant to grow into the thousands: the DOM node\ncount is what buys its accessibility (real buttons, screen-reader support, text selection), and that stops\nscaling long before a canvas would. Reach for\n`<AggregationHeatmap>` instead — same inputs, same output payloads, an import\nchange — and accept the accessibility trade-off it documents."},"429":{"id":"/docs/atomic-angular/dataviz/heatmap-18","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#pitfalls","content":"Only under the `\"cross\"` encoding, where the displayed label (`item.display`) and the filterable value (a\nfielded expression) are different strings — filtering on the label sends a value the server never indexed.\n`(axisSelected)`'s `.value` field is already resolved to the right one for whichever encoding is in effect; use\nit instead of reading the label back out of the DOM or the event source."},"430":{"id":"/docs/atomic-angular/dataviz/heatmap-19","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#whats-next","content":"A one-dimensional aggregation as a wrapping list of tags — the lightweight option."},"431":{"id":"/docs/atomic-angular/dataviz/heatmap-20","page_id":"/docs/atomic-angular/dataviz/heatmap","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/heatmap#whats-next","content":"The canvas sibling, for a matrix too large for the DOM."},"432":{"id":"/docs/atomic-angular/dataviz","page_id":"/docs/atomic-angular/dataviz","type":"page","content":"Data visualization","breadcrumbs":["Docs","Atomic Angular","Data visualization"],"tags":[],"url":"/docs/atomic-angular/dataviz"},"433":{"id":"/docs/atomic-angular/dataviz-0","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz","content":"Render a Sinequa aggregation as a heatmap, a tag or word cloud, or a Chart.js bar/pie/doughnut/timeline — all in controlled mode, like <Aggregation>."},"434":{"id":"/docs/atomic-angular/dataviz-1","page_id":"/docs/atomic-angular/dataviz","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz#whats-next","content":"What's next"},"435":{"id":"/docs/atomic-angular/dataviz-2","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz","content":"Every component here follows the same contract as `<Aggregation>` in controlled\nmode: it takes an `aggregation` (or `aggregations`) input, never reads or writes `QueryParamsStore` /\n`AggregationsStore`, and reports interactions through outputs. A chart is therefore interchangeable with a\nlist facet — feed it from `AggregationsStore`, from `QueryService.search()` or from `fetchQuery()`, whichever\nsuits, and wire its output back into a filter the same way."},"436":{"id":"/docs/atomic-angular/dataviz-3","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz","content":"`Heatmap`, `TagCloud` and `WordCloud` need no charting dependency and ship from the main\n`@sinequa/atomic-angular` entry point. `AggregationChart`, `AggregationTimeline` and `AggregationHeatmap` are\nbuilt on Chart.js, an **optional peer dependency** — they ship from a separate\n`@sinequa/atomic-angular/charts` entry point (and, for the matrix-based heatmap, a further\n`@sinequa/atomic-angular/charts/heatmap`), so an application that never imports from there never needs\n`chart.js` installed."},"437":{"id":"/docs/atomic-angular/dataviz-4","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz#whats-next","content":"A two-dimensional distribution as a CSS grid — no dependency, accessible, clickable axis labels."},"438":{"id":"/docs/atomic-angular/dataviz-5","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz#whats-next","content":"Aggregation values as a wrapping list of tags, sized by count."},"439":{"id":"/docs/atomic-angular/dataviz-6","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz#whats-next","content":"The same data, packed into a compact spiral layout."},"440":{"id":"/docs/atomic-angular/dataviz-7","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz#whats-next","content":"A bar, pie or doughnut chart, from the Chart.js entry point."},"441":{"id":"/docs/atomic-angular/dataviz-8","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz#whats-next","content":"A time series with a drag-to-select range brush."},"442":{"id":"/docs/atomic-angular/dataviz-9","page_id":"/docs/atomic-angular/dataviz","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz#whats-next","content":"The canvas sibling of Heatmap, for matrices too large for the DOM."},"443":{"id":"/docs/atomic-angular/dataviz/tag-cloud","page_id":"/docs/atomic-angular/dataviz/tag-cloud","type":"page","content":"Tag Cloud","breadcrumbs":["Docs","Atomic Angular","Data visualization"],"tags":[],"url":"/docs/atomic-angular/dataviz/tag-cloud"},"444":{"id":"/docs/atomic-angular/dataviz/tag-cloud-0","page_id":"/docs/atomic-angular/dataviz/tag-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/tag-cloud","content":"Aggregation values rendered as a wrapping list of tags sized by count — the lightweight default, with no layout algorithm and no canvas."},"445":{"id":"/docs/atomic-angular/dataviz/tag-cloud-1","page_id":"/docs/atomic-angular/dataviz/tag-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/tag-cloud#minimal-example","content":"Minimal example"},"446":{"id":"/docs/atomic-angular/dataviz/tag-cloud-2","page_id":"/docs/atomic-angular/dataviz/tag-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/tag-cloud#how-it-works","content":"How it works"},"447":{"id":"/docs/atomic-angular/dataviz/tag-cloud-3","page_id":"/docs/atomic-angular/dataviz/tag-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/tag-cloud#recipes","content":"Recipes"},"448":{"id":"/docs/atomic-angular/dataviz/tag-cloud-4","page_id":"/docs/atomic-angular/dataviz/tag-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/tag-cloud#balancing-high-cardinality-aggregations","content":"Balancing high-cardinality aggregations"},"449":{"id":"/docs/atomic-angular/dataviz/tag-cloud-5","page_id":"/docs/atomic-angular/dataviz/tag-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/tag-cloud#options","content":"Options"},"450":{"id":"/docs/atomic-angular/dataviz/tag-cloud-6","page_id":"/docs/atomic-angular/dataviz/tag-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/tag-cloud#whats-next","content":"What's next"},"451":{"id":"/docs/atomic-angular/dataviz/tag-cloud-7","page_id":"/docs/atomic-angular/dataviz/tag-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/tag-cloud","content":"The simplest way to show \"what's in this aggregation, roughly, at a glance\": a flex list of buttons, each\nsized by its count. No placement algorithm, no measurement, no canvas — reach for this before\n`<WordCloud>`, which trades that simplicity for a denser, packed look."},"452":{"id":"/docs/atomic-angular/dataviz/tag-cloud-8","page_id":"/docs/atomic-angular/dataviz/tag-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/tag-cloud#how-it-works","content":"`buildTagCloud()` merges every supplied aggregation's items into one ranked list, keeping track of which\naggregation each entry came from (`entry.source`) so the cloud can color entity types consistently. Font size\nis a direct, linear function of `entry.weight` — no measurement pass, which is what makes this component cheap\nenough to not need its own bundle split."},"453":{"id":"/docs/atomic-angular/dataviz/tag-cloud-9","page_id":"/docs/atomic-angular/dataviz/tag-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/tag-cloud#balancing-high-cardinality-aggregations","content":"Without `uniformRepartition`, the globally largest items win `limit` regardless of source — one aggregation\nwith many distinct values can crowd out the others entirely."},"454":{"id":"/docs/atomic-angular/dataviz/tag-cloud-10","page_id":"/docs/atomic-angular/dataviz/tag-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/tag-cloud#options","content":"<TypeTable\n  type=\"{\n  aggregations: { type: &#x22;ReadonlyArray<AggregationLike | undefined>&#x22;, default: &#x22;[]&#x22;, description: &#x22;One or more aggregations — mixing several entity types is the common case.&#x22; },\n  limit: { type: &#x22;number&#x22;, default: &#x22;50&#x22;, description: &#x22;Maximum number of tags displayed.&#x22; },\n  countThreshold: { type: &#x22;number&#x22;, default: &#x22;0&#x22;, description: &#x22;Drop items at or below this count.&#x22; },\n  uniformRepartition: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Give each aggregation an equal share of limit, instead of the globally largest items.&#x22; },\n  showCount: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Append the count after each label.&#x22; },\n  emptyLabel: { type: &#x22;string&#x22;, default: '&#x22;No data&#x22;', description: &#x22;Shown when every aggregation is empty.&#x22; },\n}\"\n/>"},"455":{"id":"/docs/atomic-angular/dataviz/tag-cloud-11","page_id":"/docs/atomic-angular/dataviz/tag-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/tag-cloud#whats-next","content":"Same data, packed into a compact spiral layout instead of a wrapping list."},"456":{"id":"/docs/atomic-angular/dataviz/tag-cloud-12","page_id":"/docs/atomic-angular/dataviz/tag-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/tag-cloud#whats-next","content":"For a two-dimensional distribution instead of a ranked one-dimensional list."},"457":{"id":"/docs/atomic-angular/dataviz/word-cloud","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"page","content":"Word Cloud","breadcrumbs":["Docs","Atomic Angular","Data visualization"],"tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud"},"458":{"id":"/docs/atomic-angular/dataviz/word-cloud-0","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud","content":"Aggregation values packed into a compact spiral layout — large words centered, smaller ones tucked into the gaps, some rotated."},"459":{"id":"/docs/atomic-angular/dataviz/word-cloud-1","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud#minimal-example","content":"Minimal example"},"460":{"id":"/docs/atomic-angular/dataviz/word-cloud-2","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud#how-it-works","content":"How it works"},"461":{"id":"/docs/atomic-angular/dataviz/word-cloud-3","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud#recipes","content":"Recipes"},"462":{"id":"/docs/atomic-angular/dataviz/word-cloud-4","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud#reacting-to-dropped-words","content":"Reacting to dropped words"},"463":{"id":"/docs/atomic-angular/dataviz/word-cloud-5","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud#options","content":"Options"},"464":{"id":"/docs/atomic-angular/dataviz/word-cloud-6","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud#pitfalls","content":"Pitfalls"},"465":{"id":"/docs/atomic-angular/dataviz/word-cloud-7","page_id":"/docs/atomic-angular/dataviz/word-cloud","type":"heading","tags":[],"url":"/docs/atomic-angular/dataviz/word-cloud#whats-next","content":"What's next"},"466":{"id":"/docs/atomic-angular/dataviz/word-cloud-8","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud","content":"The denser, classic \"word cloud\" look: words placed by a spiral search with collision detection, some rotated,\nsized and colored like `<TagCloud>` but laid out rather than wrapped. Reach for `<TagCloud>`\nfirst — this component carries a real placement algorithm, and is worth its cost only when the packed look is\nthe point."},"467":{"id":"/docs/atomic-angular/dataviz/word-cloud-9","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud#how-it-works","content":"Rendered as SVG rather than absolutely-positioned `<div>`s: one coordinate system, rotation for free through\n`transform`, and a native `<title>` tooltip needs no JavaScript. The words stay real, focusable DOM nodes."},"468":{"id":"/docs/atomic-angular/dataviz/word-cloud-10","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud#how-it-works","content":"The layout re-runs whenever the aggregation data, the container size, or web-font readiness changes — the last\none matters because the canvas used to measure each word's ink box needs the real font metrics, not a\nfallback, to place words tightly."},"469":{"id":"/docs/atomic-angular/dataviz/word-cloud-11","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud#reacting-to-dropped-words","content":"A cloud needs space: words that find no room are dropped rather than shown overlapping, and the count is\nsurfaced so the omission is never silent."},"470":{"id":"/docs/atomic-angular/dataviz/word-cloud-12","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud#options","content":"<TypeTable\n  type=\"{\n  aggregations: { type: &#x22;ReadonlyArray<AggregationLike | undefined>&#x22;, default: &#x22;[]&#x22;, description: &#x22;One or more aggregations.&#x22; },\n  limit: { type: &#x22;number&#x22;, default: &#x22;50&#x22;, description: &#x22;Maximum words considered — some may still be dropped for lack of space.&#x22; },\n  countThreshold: { type: &#x22;number&#x22;, default: &#x22;0&#x22;, description: &#x22;Drop items at or below this count.&#x22; },\n  uniformRepartition: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Give each aggregation an equal share of limit.&#x22; },\n  showCount: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Append the count to each label — it is measured as part of the word, so it affects packing.&#x22; },\n  emptyLabel: { type: &#x22;string&#x22;, default: '&#x22;No data&#x22;', description: &#x22;Shown when every aggregation is empty.&#x22; },\n}\"\n/>"},"471":{"id":"/docs/atomic-angular/dataviz/word-cloud-13","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud#pitfalls","content":"Expected in a narrow or short container: words that find no free space during placement are dropped, not\noverlapped. The dropped count renders as a small note in the corner (`N not shown`) — if the omission matters,\neither lower `limit`, enlarge the container, or use `<TagCloud>`, which never drops\nanything since it only wraps."},"472":{"id":"/docs/atomic-angular/dataviz/word-cloud-14","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud#pitfalls","content":"The placement measures text with the real web font once `document.fonts.ready` resolves — before that, the\nfirst layout pass may use fallback metrics. This resolves itself automatically and re-lays out; it is not a\nbug to guard against in host code."},"473":{"id":"/docs/atomic-angular/dataviz/word-cloud-15","page_id":"/docs/atomic-angular/dataviz/word-cloud","tags":[],"type":"text","url":"/docs/atomic-angular/dataviz/word-cloud#whats-next","content":"The lighter sibling — no placement algorithm, nothing ever dropped."},"474":{"id":"/docs/atomic-angular/filters/aggregation-date","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"page","content":"Aggregation date","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters/aggregation-date"},"475":{"id":"/docs/atomic-angular/filters/aggregation-date-0","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date","content":"Render a date facet as preset ranges plus an optional custom range, and turn a pick into an applied filter — live or deferred, controlled or not."},"476":{"id":"/docs/atomic-angular/filters/aggregation-date-1","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#minimal-example","content":"Minimal example"},"477":{"id":"/docs/atomic-angular/filters/aggregation-date-2","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#how-it-works","content":"How it works"},"478":{"id":"/docs/atomic-angular/filters/aggregation-date-3","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#the-custom-range-dialog","content":"The custom range dialog"},"479":{"id":"/docs/atomic-angular/filters/aggregation-date-4","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#controlled-vs-uncontrolled-and-emiton","content":"Controlled vs. uncontrolled, and `emitOn`"},"480":{"id":"/docs/atomic-angular/filters/aggregation-date-5","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#recipes","content":"Recipes"},"481":{"id":"/docs/atomic-angular/filters/aggregation-date-6","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#a-controlled-date-facet-with-a-live-selection","content":"A controlled date facet, with a live selection"},"482":{"id":"/docs/atomic-angular/filters/aggregation-date-7","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#disable-the-custom-range-entirely","content":"Disable the custom range entirely"},"483":{"id":"/docs/atomic-angular/filters/aggregation-date-8","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#options","content":"Options"},"484":{"id":"/docs/atomic-angular/filters/aggregation-date-9","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#controlled-mode","content":"Controlled mode"},"485":{"id":"/docs/atomic-angular/filters/aggregation-date-10","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#calendar-styles","content":"Calendar styles"},"486":{"id":"/docs/atomic-angular/filters/aggregation-date-11","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#pitfalls","content":"Pitfalls"},"487":{"id":"/docs/atomic-angular/filters/aggregation-date-12","page_id":"/docs/atomic-angular/filters/aggregation-date","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation-date#whats-next","content":"What's next"},"488":{"id":"/docs/atomic-angular/filters/aggregation-date-13","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date","content":"`<aggregation-date>` is what `<Aggregation>` delegates to for a date column — see\nAggregation. Unlike the list and tree variants, its options are a **radio\nlist** (never a multi-select), and it opens a dialog for a custom range instead of paging through buckets."},"489":{"id":"/docs/atomic-angular/filters/aggregation-date-14","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date","content":"The server turns a date column's buckets into named **date options** (\"Today\", \"This week\", \"This year\") via\n`translateAggregationToDateOptions`. Picking `\"custom-range\"` is the seventh, always-present option: it opens\nAggregationDateRangeDialogComponent instead of applying immediately."},"490":{"id":"/docs/atomic-angular/filters/aggregation-date-15","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#minimal-example","content":"Picking a preset radio, or confirming a date in the custom-range dialog, reveals the **Apply** button —\nexactly like the list and tree facets — rather than applying instantly. Clicking it writes the filter to\n`QueryParamsStore` and re-runs the query."},"491":{"id":"/docs/atomic-angular/filters/aggregation-date-16","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#the-custom-range-dialog","content":"Selecting `\"custom-range\"` opens `<aggregation-date-range-dialog>`, which renders one of two pickers —\n`<aggregation-date-dual-pickers>` (two independent calendars) or `<aggregation-date-custom-range>` (one\nrange-aware calendar), chosen by its `useDateRange` input:"},"492":{"id":"/docs/atomic-angular/filters/aggregation-date-17","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#the-custom-range-dialog","content":"The pickers are destroyed and recreated on every open (`@if (isDialogOpen())`) — a projected datepicker keeps\nits previous selection otherwise, leaving a stale \"From\"/\"To\" behind from the last time the dialog was used."},"493":{"id":"/docs/atomic-angular/filters/aggregation-date-18","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#controlled-vs-uncontrolled-and-emiton","content":"Like `<Aggregation>`, setting any of `query`, `aggregation` or `selection&#x60; switches to controlled mode. Being a\nradio list, controlled mode has one behaviour the list/tree variants do not: **`emitOn=\"selection\"` (the\ndefault) emits live**, at the moment a preset is picked or a custom range confirmed — there is no Apply click\nto wait for. Set `emitOn=\"apply\"` to defer every emission to the Apply button instead, matching the list/tree\nselect-then-Apply flow."},"494":{"id":"/docs/atomic-angular/filters/aggregation-date-19","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#a-controlled-date-facet-with-a-live-selection","content":"The emitted `AggregationSelection` is `{ kind: \"option\", option }` for a preset — the item's real filter\n`value`, never its `display`, so a round-trip survives across days for presets computed relative to today —\nor `{ kind: \"range\", from, to }` for a custom range."},"495":{"id":"/docs/atomic-angular/filters/aggregation-date-20","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#disable-the-custom-range-entirely","content":"Some deployments only want the fixed presets — no \"custom range\" option at all."},"496":{"id":"/docs/atomic-angular/filters/aggregation-date-21","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#options","content":"<TypeTable\n  type=\"{\n  name: { type: &#x22;string | null&#x22; },\n  column: { type: &#x22;string | null&#x22; },\n  collapsible: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22; },\n  collapsed: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22; },\n  searchable: { type: &#x22;boolean | undefined&#x22;, description: &#x22;Accepted for parity with the base facet, but the date variant has no search-within-facet UI.&#x22; },\n  showFiltersCount: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22; },\n  syncUrl: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  title: {\n    type: &#x22;AggregationTitle&#x22;,\n    default: '{ label: &#x22;Date&#x22;, icon: &#x22;far fa-calendar-day&#x22; }',\n    description: &#x22;The facet header's label and icon.&#x22;,\n  },\n  displayEmptyDistributionIntervals: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Whether date buckets with a zero count still appear as pickable options.&#x22;,\n  },\n}\"\n/>"},"497":{"id":"/docs/atomic-angular/filters/aggregation-date-22","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#controlled-mode","content":"<TypeTable\n  type=\"{\n  query: { type: &#x22;Query | undefined&#x22; },\n  aggregation: { type: &#x22;Aggregation | undefined&#x22; },\n  selection: {\n    type: &#x22;AggregationSelection | undefined&#x22;,\n    description: '{ kind: &#x22;option&#x22;, option } for a preset, { kind: &#x22;range&#x22;, from?, to? } for a custom range.',\n  },\n  emitOn: {\n    type: '&#x22;selection&#x22; | &#x22;apply&#x22;',\n    default: '&#x22;selection&#x22;',\n    description: &#x22;selection emits live on every pick/confirm; apply defers everything to the Apply button.&#x22;,\n  },\n}\"\n/>"},"498":{"id":"/docs/atomic-angular/filters/aggregation-date-23","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#calendar-styles","content":"The custom-range dialog renders `vanillajs-datepicker` calendars,\nwhich ship no styling of their own. The library publishes a ready-made stylesheet, built on galactik's semantic\ntokens, so the calendar follows the light/dark theme with no extra rule. Import it once from the application's\nglobal stylesheet:"},"499":{"id":"/docs/atomic-angular/filters/aggregation-date-24","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#calendar-styles","content":"Without a bundler that resolves package exports, link the file instead:\n`<link rel=\"stylesheet\" href=\"node_modules/@sinequa/atomic-angular/styles/datepicker.css\" />`."},"500":{"id":"/docs/atomic-angular/filters/aggregation-date-25","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#calendar-styles","content":"The application also installs `vanillajs-datepicker` (a peer dependency) and, for non-English calendars,\nregisters the locales it needs — e.g. `Datepicker.locales.fr = fr` with `import fr from \"vanillajs-datepicker/locales/fr\"`.\nTwo custom properties tune the look: `--datepicker-today` and `--datepicker-selected`."},"501":{"id":"/docs/atomic-angular/filters/aggregation-date-26","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#pitfalls","content":"Expected, and not a missing feature — `<aggregation-date>` has no `hideWhenEmpty` input at all. A date facet\nhas no \"resolved but empty\" state to gate behind one: its custom range stays usable with zero buckets, so it\nis either missing (always hidden) or present (always visible). See\nAggregation's missing-vs-empty rules."},"502":{"id":"/docs/atomic-angular/filters/aggregation-date-27","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#pitfalls","content":"Feeding `selectionChange`'s payload straight back into `[selection]` is safe: seeding the form from the\n`[selection]` input is guarded internally against re-triggering a live emission. If you see a loop, check that\n`selection` is a **stable value** between renders (built in a `computed()`/signal, not an inline object\nliteral) — the same rule as `<Aggregation>`'s own `[aggregation]` input, see\nits pitfall."},"503":{"id":"/docs/atomic-angular/filters/aggregation-date-28","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#pitfalls","content":"Intentional. Picking `\"custom-range\"` only opens the dialog — nothing is emitted (or applied) until a real\ndate is actually confirmed in it. A stale range left over from a previous open is never surfaced by merely\nre-selecting the radio."},"504":{"id":"/docs/atomic-angular/filters/aggregation-date-29","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#pitfalls","content":"Not a bug — this is why presets round-trip on the item's `value`, not on a resolved date. `\"This week\"`'s\n`value` stays a stable identifier; only its resolved bounds change day to day. A controlled `[selection]` of\n`{ kind: \"option\", option: item.value }` re-selects correctly regardless of when it round-trips. If you\ncompare resolved dates yourself instead of the option/item value, expect drift."},"505":{"id":"/docs/atomic-angular/filters/aggregation-date-30","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#whats-next","content":"The shared missing/empty rules, controlled mode, and the list/tree variants."},"506":{"id":"/docs/atomic-angular/filters/aggregation-date-31","page_id":"/docs/atomic-angular/filters/aggregation-date","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation-date#whats-next","content":"Where a date facet like this one is typically opened from — one popover per filter."},"507":{"id":"/docs/atomic-angular/filters/aggregation","page_id":"/docs/atomic-angular/filters/aggregation","type":"page","content":"Aggregation","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters/aggregation"},"508":{"id":"/docs/atomic-angular/filters/aggregation-0","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation","content":"Render a facet as a list, a tree or a date range from a query's aggregations, and turn a click into an applied filter — with a custom item template or full control over the data."},"509":{"id":"/docs/atomic-angular/filters/aggregation-1","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#minimal-example","content":"Minimal example"},"510":{"id":"/docs/atomic-angular/filters/aggregation-2","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#how-it-works","content":"How it works"},"511":{"id":"/docs/atomic-angular/filters/aggregation-3","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"Missing vs. empty"},"512":{"id":"/docs/atomic-angular/filters/aggregation-4","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#controlled-vs-uncontrolled","content":"Controlled vs. uncontrolled"},"513":{"id":"/docs/atomic-angular/filters/aggregation-5","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#recipes","content":"Recipes"},"514":{"id":"/docs/atomic-angular/filters/aggregation-6","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#custom-item-content-in-a-list","content":"Custom item content, in a list"},"515":{"id":"/docs/atomic-angular/filters/aggregation-7","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#full-control-over-the-data-and-the-selection","content":"Full control over the data and the selection"},"516":{"id":"/docs/atomic-angular/filters/aggregation-8","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#options","content":"Options"},"517":{"id":"/docs/atomic-angular/filters/aggregation-9","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#controlled-mode","content":"Controlled mode"},"518":{"id":"/docs/atomic-angular/filters/aggregation-10","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"Pitfalls"},"519":{"id":"/docs/atomic-angular/filters/aggregation-11","page_id":"/docs/atomic-angular/filters/aggregation","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aggregation#whats-next","content":"What's next"},"520":{"id":"/docs/atomic-angular/filters/aggregation-12","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation","content":"A facet — \"Sources\", \"Authors\", \"Modified date\" — is one **aggregation** of a query's result, rendered so the\nuser can turn a bucket into a filter with a click. `<Aggregation>` picks and renders the right shape (a flat\nlist, a tree, or a date range) for a given column, and handles selecting, applying and clearing the filter for\nyou."},"521":{"id":"/docs/atomic-angular/filters/aggregation-13","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation","content":"An **aggregation** is a bucketed count over one column of the result set — how many documents have each\nvalue of `docformat`, how many fall in each date range of `modified`. The server computes it alongside the\nresult records; `<Aggregation>` never computes it itself, only renders and lets the user filter on it."},"522":{"id":"/docs/atomic-angular/filters/aggregation-14","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#minimal-example","content":"`name` and `column` identify which aggregation of the current query's result to render — `name` is matched\nfirst against the app's aggregation configuration, `column` as a fallback. Selecting an item and clicking\n**Apply** (or ticking a value in a facet search) writes the corresponding filter to the shared\n`QueryParamsStore` and re-runs the query; nothing else in the template has to react to that by hand."},"523":{"id":"/docs/atomic-angular/filters/aggregation-15","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#how-it-works","content":"`<Aggregation>` does not render anything itself — it resolves which of three sub-components actually renders,\nthen delegates:"},"524":{"id":"/docs/atomic-angular/filters/aggregation-16","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#how-it-works","content":"Set `type` explicitly (`\"list\" | \"tree\" | \"date\"`, instead of the default `\"auto\"`) when the heuristic cannot\napply — a date facet of a query the app's column map does not know about, for instance."},"525":{"id":"/docs/atomic-angular/filters/aggregation-17","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"Two different situations can leave a facet with nothing to show, and `<Aggregation>` treats them differently:"},"526":{"id":"/docs/atomic-angular/filters/aggregation-18","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"Case"},"527":{"id":"/docs/atomic-angular/filters/aggregation-19","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"Behaviour"},"528":{"id":"/docs/atomic-angular/filters/aggregation-20","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"**Missing** — no entry in the store matching `name`/`column`, or an empty `[aggregation]` in controlled mode"},"529":{"id":"/docs/atomic-angular/filters/aggregation-21","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"Always hidden, unconditionally"},"530":{"id":"/docs/atomic-angular/filters/aggregation-22","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"**Resolves to zero items**"},"531":{"id":"/docs/atomic-angular/filters/aggregation-23","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"Visible with a dimmed, non-expandable header by default; hidden too when `[hideWhenEmpty]=\"true\"`"},"532":{"id":"/docs/atomic-angular/filters/aggregation-24","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#missing-vs-empty","content":"A missing aggregation is a misconfiguration (a typo'd `name`, an aggregation removed from the app's setup) —\nnot a state worth showing the user anything about — so it always disappears. A facet that genuinely resolves\nto zero items is a legitimate, often temporary state, so it stays by default and only disappears once you opt\nin with `hideWhenEmpty`. Two exemptions keep a facet the user can still act on regardless of that input: a\ndate facet (no \"resolved but empty\" state exists for it — see Pitfalls) and a facet currently\ncarrying an applied filter (hiding it would leave no way to clear that filter from the facet itself)."},"533":{"id":"/docs/atomic-angular/filters/aggregation-25","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#controlled-vs-uncontrolled","content":"By default `<Aggregation>` reads and writes the shared `QueryParamsStore`/`AggregationsStore` and the URL. Set\nany of `query`, `aggregation` or `selection` to switch the whole instance to **controlled mode**: it then\nreads only from those inputs, holds its own state, and never touches the shared stores, the URL or\n`sessionStorage` — changes surface exclusively through `(selectionChange)`/`(filtersChange)`. This is what lets\nseveral independent facet instances coexist on one page, each over its own query."},"534":{"id":"/docs/atomic-angular/filters/aggregation-26","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#custom-item-content-in-a-list","content":"Project an `<ng-template aggregationItem>` to own the content/label region of each row; `<aggregation-list>`\nkeeps the checkbox, click-to-select, count and virtualization."},"535":{"id":"/docs/atomic-angular/filters/aggregation-27","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#custom-item-content-in-a-list","content":"The same directive works on `<aggregation-tree>` — the context gains `level`/`expanded`/`hasChildren`, typed\nas required through `AggregationTreeItemContext` if you annotate `let-*` manually."},"536":{"id":"/docs/atomic-angular/filters/aggregation-28","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#full-control-over-the-data-and-the-selection","content":"Set `query`, `aggregation` and `selection` together to render an aggregation that belongs to a query the\ncurrent app does not manage — an independent facet panel over a per-agent query, for instance. Nothing is\nread from or written to the shared stores; every change surfaces through the outputs."},"537":{"id":"/docs/atomic-angular/filters/aggregation-29","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#full-control-over-the-data-and-the-selection","content":"The `aggregation` input is deep-cloned on the way in, so the host's object is never mutated and several\ninstances can safely share one source object — but any **reference change** of that input reseeds the whole\ninternal state (pages loaded through load-more, tree nodes opened by the user are discarded)."},"538":{"id":"/docs/atomic-angular/filters/aggregation-30","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#options","content":"<TypeTable\n  type=\"{\n  name: { type: &#x22;string&#x22;, description: &#x22;Matched first against the app's aggregation configuration.&#x22; },\n  column: { type: &#x22;string&#x22;, description: &#x22;Fallback match, and the column passed to filter.* when applying.&#x22; },\n  type: {\n    type: '&#x22;auto&#x22; | &#x22;list&#x22; | &#x22;tree&#x22; | &#x22;date&#x22;',\n    default: '&#x22;auto&#x22;',\n    description:\n      &#x22;Which sub-component renders. auto keeps the isDateColumn / isTree heuristic; set explicitly when it cannot apply.&#x22;,\n  },\n  searchable: { type: &#x22;boolean | undefined&#x22;, description: &#x22;Search-within-facet. Undefined defers to the aggregation's own setting.&#x22; },\n  showFiltersCount: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Shows the count of currently applied filters in the header.&#x22; },\n  showCheckbox: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;Whether to render the per-item checkbox. Selection still toggles on row click when false — pair with a custom aggregationItem template. Ignored by the date variant.&#x22;,\n  },\n  applyOnSelect: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Every selection gesture (row, checkbox, Space/Enter) applies immediately instead of only revealing Apply. Independent of the app-wide quickFilter flag — see Pitfalls.&#x22;,\n  },\n  hideWhenEmpty: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Hide the host once it resolves to zero items, instead of a dimmed non-expandable header. Never affects a missing aggregation, which always hides. See How it works.&#x22;,\n  },\n  syncUrl: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;When false, applying/clearing updates the store without touching browser history or the URL.&#x22; },\n}\"\n/>"},"539":{"id":"/docs/atomic-angular/filters/aggregation-31","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#controlled-mode","content":"<TypeTable\n  type=\"{\n  query: { type: &#x22;Query | undefined&#x22;, description: &#x22;Switches to controlled mode. Operations run against this query instead of the shared one.&#x22; },\n  aggregation: { type: &#x22;Aggregation | undefined&#x22;, description: &#x22;Switches to controlled mode. Rendered instead of reading from the shared store — deep-cloned on the way in.&#x22; },\n  selection: {\n    type: &#x22;AggregationSelection | undefined&#x22;,\n    description:\n      'Switches to controlled mode. { kind: &#x22;values&#x22; | &#x22;paths&#x22; | &#x22;option&#x22; | &#x22;range&#x22;, ... } depending on list / tree / date.',\n  },\n  emitOn: {\n    type: '&#x22;selection&#x22; | &#x22;apply&#x22;',\n    default: '&#x22;selection&#x22;',\n    description: &#x22;Date variant only. selection emits live on every pick/confirm; apply defers to an Apply button, matching list/tree.&#x22;,\n  },\n}\"\n/>"},"540":{"id":"/docs/atomic-angular/filters/aggregation-32","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"`<Aggregation>` (and `<aggregation-list>`/`<aggregation-tree>` directly) hides itself **unconditionally** when\nthe aggregation is **missing** — no entry in the store matching `name`/`column`, most often a typo, or an\nempty `[aggregation]` in controlled mode. This is different from resolving to zero items, which stays visible\nby default. `hideWhenEmpty` has no effect on a missing aggregation; check the `name`/`column` values against\nthe app's aggregation configuration first."},"541":{"id":"/docs/atomic-angular/filters/aggregation-33","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"Expected — a date facet has no \"resolved but empty\" state: it is either missing (always hidden) or present\n(always visible), because its custom range stays usable with no bucket at all. `hideWhenEmpty` only ever\naffects `<aggregation-list>`/`<aggregation-tree>`."},"542":{"id":"/docs/atomic-angular/filters/aggregation-34","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"Expected, and the same contract as the list. The app-wide `features.quickFilter` flag is a **node-label**\nshortcut only — clicking the label applies in one gesture, but the checkbox, the row and Space/Enter always\njust select and reveal the **Apply** button. Set `[applyOnSelect]=\"true\"` on the instance to make every\ngesture apply immediately, independently of the app-wide flag."},"543":{"id":"/docs/atomic-angular/filters/aggregation-35","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"Both behaviours are part of the **default** label only. Projecting a custom template replaces that whole\nregion, so you lose the built-in search highlight and the quick-filter click-to-apply along with it — this is\nintentional, not a bug to work around. Re-apply the highlight yourself with the public `highlightWord` pipe,\nusing the `searchText` the template context already gives you."},"544":{"id":"/docs/atomic-angular/filters/aggregation-36","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"The **list** virtualizer estimates row height at a fixed \\~32px and never measures — keep a custom list item\nroughly that height, or rows start to overlap. The **tree** virtualizer measures each row instead, so a custom\ntree item is free to vary in height."},"545":{"id":"/docs/atomic-angular/filters/aggregation-37","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"An inline object literal on `[aggregation]` — `[aggregation]=\"{ ...agg, display: label }\"` — is a **new\nreference on every change-detection pass**, and any reference change reseeds the whole instance (discarding\nload-more pages and open tree nodes). It also fails to compile: the raw `Aggregation` type from\n`@sinequa/atomic` has no `display` field, so the literal trips the excess-property check."},"546":{"id":"/docs/atomic-angular/filters/aggregation-38","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#pitfalls","content":"Build the object once, in a `computed()` or a plain field, and pass that stable reference instead — see\nFull control over the data and the selection above."},"547":{"id":"/docs/atomic-angular/filters/aggregation-39","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#whats-next","content":"Render the same aggregation data as a chart instead of a list — bar charts, heatmaps, timelines."},"548":{"id":"/docs/atomic-angular/filters/aggregation-40","page_id":"/docs/atomic-angular/filters/aggregation","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aggregation#whats-next","content":"Connect a client and run your first query, if you have not yet."},"549":{"id":"/docs/atomic-angular/filters/applied-filters","page_id":"/docs/atomic-angular/filters/applied-filters","type":"page","content":"Applied filters","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters/applied-filters"},"550":{"id":"/docs/atomic-angular/filters/applied-filters-0","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters","content":"Show what the query is currently filtered by, as one removable chip per value — the counterpart of the filters bar, which shows what a user can filter on."},"551":{"id":"/docs/atomic-angular/filters/applied-filters-1","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#minimal-example","content":"Minimal example"},"552":{"id":"/docs/atomic-angular/filters/applied-filters-2","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#how-it-works","content":"How it works"},"553":{"id":"/docs/atomic-angular/filters/applied-filters-3","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#recipes","content":"Recipes"},"554":{"id":"/docs/atomic-angular/filters/applied-filters-4","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#two-backends-sharing-one-screen","content":"Two backends sharing one screen"},"555":{"id":"/docs/atomic-angular/filters/applied-filters-5","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#controlled--the-caller-owns-the-state","content":"Controlled — the caller owns the state"},"556":{"id":"/docs/atomic-angular/filters/applied-filters-6","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#reconciling-a-facets-own-selection-after-a-removal","content":"Reconciling a facet's own selection after a removal"},"557":{"id":"/docs/atomic-angular/filters/applied-filters-7","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#options","content":"Options"},"558":{"id":"/docs/atomic-angular/filters/applied-filters-8","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#exports","content":"Exports"},"559":{"id":"/docs/atomic-angular/filters/applied-filters-9","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#pitfalls","content":"Pitfalls"},"560":{"id":"/docs/atomic-angular/filters/applied-filters-10","page_id":"/docs/atomic-angular/filters/applied-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/applied-filters#whats-next","content":"What's next"},"561":{"id":"/docs/atomic-angular/filters/applied-filters-11","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters","content":"`<applied-filters>` shows what the query **is** filtered by, one chip per value. Contrast with\nFilters bar, which shows what a user **can** filter on."},"562":{"id":"/docs/atomic-angular/filters/applied-filters-12","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters","content":"`QueryParamsStore` keeps **one filter entry per field or per aggregation** — three selected authors are a\nsingle `values` array, and two selected date buckets are a nested `or` tree. Rendering that directly would\nshow one chip for three choices, and removing it would drop all three. `<applied-filters>` expands each entry\ninto one chip per value first, so each one can be removed independently."},"563":{"id":"/docs/atomic-angular/filters/applied-filters-13","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#minimal-example","content":"`(changed)` fires on any mutation — a removal or a full clear alike — so a host that only needs to re-run its\nquery can bind that one output and ignore the more precise `(removed)`/`(cleared)`."},"564":{"id":"/docs/atomic-angular/filters/applied-filters-14","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#how-it-works","content":"Removing a chip never deletes the whole stored entry outright: `rebuildWithout` returns the entry **minus**\nthat one value, so the aggregation's other selections survive. A named entry (one carrying the aggregation's\n`name`) is *replaced* through `updateFilter` rather than patched, because `updateFilter` only ever merges —\ngrowing a selection, never shrinking it."},"565":{"id":"/docs/atomic-angular/filters/applied-filters-15","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#how-it-works","content":"A chip's identity is its **leaf filter**, not its value: a date distribution's two bounds can share one value\n(\"This year\" is `modified >= 2026-01-01`, \"Before this year\" is `modified < 2026-01-01`, differing only by\noperator), so tracking by value would make removing one chip drop both."},"566":{"id":"/docs/atomic-angular/filters/applied-filters-16","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#two-backends-sharing-one-screen","content":"Both scopes would otherwise fight over the URL query parameters they have in common."},"567":{"id":"/docs/atomic-angular/filters/applied-filters-17","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#controlled--the-caller-owns-the-state","content":"Providing `[filters]` writes nothing to `QueryParamsStore`: the component only renders what it is given and\nemits what the caller should keep on `(filtersChange)`."},"568":{"id":"/docs/atomic-angular/filters/applied-filters-18","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#reconciling-a-facets-own-selection-after-a-removal","content":"A facet lit from its own local selection state has to reconcile after a chip is removed elsewhere on the\npage — neither the value nor the object reference survives the round-trip (the store rebuilds entries by\nspreading them), so compare on `filterKey` instead:"},"569":{"id":"/docs/atomic-angular/filters/applied-filters-19","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#options","content":"<TypeTable\n  type=\"{\n  filters: { type: &#x22;LegacyFilter[] | undefined&#x22;, description: &#x22;Switches to controlled mode. Omit to read QueryParamsStore.&#x22; },\n  syncUrl: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Whether a removal is reflected in the URL.&#x22; },\n  showField: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Whether each chip is prefixed with its aggregation (or field) name.&#x22; },\n  variant: { type: 'TagVariants[&#x22;variant&#x22;]', description: &#x22;Chip fill, passed to galactik's tag. null opts out — and silently neutralises scheme too, see Pitfalls.&#x22; },\n  scheme: { type: 'TagVariants[&#x22;scheme&#x22;]', default: '&#x22;grey&#x22;' },\n  size: { type: 'TagVariants[&#x22;size&#x22;]', default: '&#x22;sm&#x22;' },\n  chipClass: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;Extra classes merged onto each chip.&#x22; },\n}\"\n/>"},"570":{"id":"/docs/atomic-angular/filters/applied-filters-20","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#exports","content":"<TypeTable\n  type=\"{\n  AppliedFilterChip: { type: &#x22;type&#x22;, description: &#x22;{ field, name?, value, display, leaf, source, id } — one rendered value.&#x22; },\n  filterLeaves: { type: &#x22;(filter: LegacyFilter) => LegacyFilter[]&#x22;, description: &#x22;The leaf filters of an entry, flattening a nested and/or tree.&#x22; },\n  filterValues: { type: &#x22;(filter: LegacyFilter) => string[]&#x22;, description: &#x22;Every value a filter carries. Not unique — see filterLeaves for identity.&#x22; },\n  filterKey: { type: &#x22;(leaf: LegacyFilter) => string&#x22;, description: 'A leaf\\'s stable identity: &#x22;field|operator|value|values&#x22;.' },\n  rebuildWithout: { type: &#x22;(source, chip) => LegacyFilter | undefined&#x22;, description: &#x22;The filter left once one chip is dropped, or undefined when nothing remains.&#x22; },\n}\"\n/>"},"571":{"id":"/docs/atomic-angular/filters/applied-filters-21","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#pitfalls","content":"That would mean `rebuildWithout` is being bypassed — check that removal goes through the component's own\n`(click)` handler rather than a custom one calling `queryParamsStore.removeFilter` directly, which drops the\nwhole entry regardless of which value was clicked."},"572":{"id":"/docs/atomic-angular/filters/applied-filters-22","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#pitfalls","content":"This is the distribution-bounds trap: two chips can share the same **value** (two ends of a bucket), so a\nvalue-keyed removal drops both. `<applied-filters>` itself keys removal on the chip's **leaf**, not its value,\nso this should not happen inside the component — but if you reconcile your own selection state afterward,\nmake sure you compare with `filterKey`, not the chip's `value`."},"573":{"id":"/docs/atomic-angular/filters/applied-filters-23","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#pitfalls","content":"Documented, not a bug: the tag's colours come from a `variant` × `scheme` compound pair, and\n`class-variance-authority` treats an explicit `null` as opting out of the whole variant — which silently\nneutralises `scheme` along with it. Leave `variant` `undefined` (the default) unless you specifically want to\nopt out of both together."},"574":{"id":"/docs/atomic-angular/filters/applied-filters-24","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#pitfalls","content":"Deliberate — the host is hidden (`class.hidden`) whenever there are zero chips, so no empty gap is left in a\n`flex`/`grid` layout that uses `gap` between siblings. There is no built-in \"no filters applied\" placeholder;\nrender your own conditionally on the chip count if you need one."},"575":{"id":"/docs/atomic-angular/filters/applied-filters-25","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#whats-next","content":"What a user can filter on — the counterpart this component's chips come from."},"576":{"id":"/docs/atomic-angular/filters/applied-filters-26","page_id":"/docs/atomic-angular/filters/applied-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/applied-filters#whats-next","content":"Where a selection actually gets made, before it reaches the applied-filters store."},"577":{"id":"/docs/atomic-angular/filters/aside-filters","page_id":"/docs/atomic-angular/filters/aside-filters","type":"page","content":"Aside filters","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters/aside-filters"},"578":{"id":"/docs/atomic-angular/filters/aside-filters-0","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters","content":"A collapsible accordion of facets for a sidebar or drawer, with keyboard navigation jumping directly between facet headers."},"579":{"id":"/docs/atomic-angular/filters/aside-filters-1","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#minimal-example","content":"Minimal example"},"580":{"id":"/docs/atomic-angular/filters/aside-filters-2","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#how-it-works","content":"How it works"},"581":{"id":"/docs/atomic-angular/filters/aside-filters-3","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#recipes","content":"Recipes"},"582":{"id":"/docs/atomic-angular/filters/aside-filters-4","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#an-explicit-developer-chosen-facet-list","content":"An explicit, developer-chosen facet list"},"583":{"id":"/docs/atomic-angular/filters/aside-filters-5","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#independent-sections-expanded-by-default","content":"Independent sections, expanded by default"},"584":{"id":"/docs/atomic-angular/filters/aside-filters-6","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#options","content":"Options"},"585":{"id":"/docs/atomic-angular/filters/aside-filters-7","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#pitfalls","content":"Pitfalls"},"586":{"id":"/docs/atomic-angular/filters/aside-filters-8","page_id":"/docs/atomic-angular/filters/aside-filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/aside-filters#whats-next","content":"What's next"},"587":{"id":"/docs/atomic-angular/filters/aside-filters-9","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters","content":"`<aside-filters>` stacks several Aggregation facets as a native `<details>`/`<summary>`\naccordion — the sidebar counterpart of Filters bar, for a layout where facets sit in a\npersistent column or drawer rather than a row of buttons."},"588":{"id":"/docs/atomic-angular/filters/aside-filters-10","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#minimal-example","content":"By default this renders every `\"left\"`/`\"both\"` aggregation from the app's JSON configuration (excluding\nadmin-`hidden` ones), each collapsed, one open at a time (`exclusive`, the native `<details name>` behaviour)."},"589":{"id":"/docs/atomic-angular/filters/aside-filters-11","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#how-it-works","content":"Passing an explicit `aggregations` list **bypasses** the JSON `position`/`hidden` configuration entirely — the\nlisted aggregations render as-is, in the given order, provided they exist in the store. Resolution tries each\nentry as a `name` first (the canonical identifier), then falls back to a `column` match."},"590":{"id":"/docs/atomic-angular/filters/aside-filters-12","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#how-it-works","content":"Facet headers share one keyboard grid (`ngGrid`): `ArrowUp`/`ArrowDown` jump straight from one facet's\n`<summary>` to the next, rather than tabbing through every header's own controls (collapse toggle, clear,\napply, select-all) in between."},"591":{"id":"/docs/atomic-angular/filters/aside-filters-13","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#options","content":"<TypeTable\n  type=\"{\n  aggregations: {\n    type: &#x22;string[]&#x22;,\n    default: &#x22;[]&#x22;,\n    description: &#x22;Explicit name/column list, bypassing the JSON position/hidden rules. Resolution tries name first, then column.&#x22;,\n  },\n  exclusive: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;true: shared native <details name>, one section open at a time. false: each section expands independently.&#x22;,\n  },\n  collapsible: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Relayed to every <Aggregation [collapsible]>.&#x22; },\n  collapsed: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Relayed to every <Aggregation [collapsed]>.&#x22; },\n  hideWhenEmpty: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Relayed to every <Aggregation [hideWhenEmpty]>. A missing aggregation still always hides regardless.&#x22;,\n  },\n}\"\n/>"},"592":{"id":"/docs/atomic-angular/filters/aside-filters-14","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#pitfalls","content":"Check the input is bound with brackets (`[collapsible]=\"false\"`), not passed as a bare attribute\n(`collapsible`) — a bare attribute is always truthy. The same applies to `collapsed`, `exclusive` and\n`hideWhenEmpty`, all `booleanAttribute`-transformed inputs."},"593":{"id":"/docs/atomic-angular/filters/aside-filters-15","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#pitfalls","content":"`[aggregations]` resolves each entry against the `AggregationsStore` **first by name, then by column** —\nit does not create an aggregation from nothing. If the store has no entry matching either, that name is\nsilently dropped from the rendered list, not shown as an error. Confirm the aggregation is actually present in\nthe current query's result — `[aggregations]` filters an existing list, it does not fetch one."},"594":{"id":"/docs/atomic-angular/filters/aside-filters-16","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#pitfalls","content":"Expected only while focus is genuinely inside the facet's expanded content (its list, its search box). Arrow\nkeys jump between **facet headers** — once focus moves into a facet's own interactive content (a listbox, a\ntree, a radio group), that content's own keyboard handling takes over, by design; the ambient grid stops\npropagating past that boundary."},"595":{"id":"/docs/atomic-angular/filters/aside-filters-17","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#whats-next","content":"The toolbar counterpart of this sidebar accordion."},"596":{"id":"/docs/atomic-angular/filters/aside-filters-18","page_id":"/docs/atomic-angular/filters/aside-filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters/aside-filters#whats-next","content":"The same stacked-facet accordion, shown from an overflow popover instead of a persistent sidebar."},"597":{"id":"/docs/atomic-angular/filters/filter-button","page_id":"/docs/atomic-angular/filters/filter-button","type":"page","content":"Filter button","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters/filter-button"},"598":{"id":"/docs/atomic-angular/filters/filter-button-0","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button","content":"The single-facet popover button rendered by the filters bar — one Aggregation per button, sized to fit the viewport."},"599":{"id":"/docs/atomic-angular/filters/filter-button-1","page_id":"/docs/atomic-angular/filters/filter-button","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filter-button#minimal-example","content":"Minimal example"},"600":{"id":"/docs/atomic-angular/filters/filter-button-2","page_id":"/docs/atomic-angular/filters/filter-button","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filter-button#how-it-works","content":"How it works"},"601":{"id":"/docs/atomic-angular/filters/filter-button-3","page_id":"/docs/atomic-angular/filters/filter-button","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filter-button#recipes","content":"Recipes"},"602":{"id":"/docs/atomic-angular/filters/filter-button-4","page_id":"/docs/atomic-angular/filters/filter-button","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filter-button#a-fixed-placement-ignoring-available-space","content":"A fixed placement, ignoring available space"},"603":{"id":"/docs/atomic-angular/filters/filter-button-5","page_id":"/docs/atomic-angular/filters/filter-button","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filter-button#options","content":"Options"},"604":{"id":"/docs/atomic-angular/filters/filter-button-6","page_id":"/docs/atomic-angular/filters/filter-button","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filter-button#pitfalls","content":"Pitfalls"},"605":{"id":"/docs/atomic-angular/filters/filter-button-7","page_id":"/docs/atomic-angular/filters/filter-button","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filter-button#whats-next","content":"What's next"},"606":{"id":"/docs/atomic-angular/filters/filter-button-8","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button","content":"`<filter-button>` is what Filters bar renders one of, per authorized aggregation: a pill\nbutton that opens the aggregation's facet in a native popover."},"607":{"id":"/docs/atomic-angular/filters/filter-button-9","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#minimal-example","content":"The button's label follows the same `display`/`name` precedence as Aggregation, and shows\na count badge once more than one value is selected. A date column renders its currently-applied range inline\ninstead of a plain label."},"608":{"id":"/docs/atomic-angular/filters/filter-button-10","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#how-it-works","content":"The popover is a native `[popover]` element (top layer): it can never be clipped by an ancestor's\n`overflow`/`z-index`, and only the viewport itself bounds its size. Its inner `<Aggregation>` is capped to the\nactual available space between the trigger and the viewport edge:"},"609":{"id":"/docs/atomic-angular/filters/filter-button-11","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#how-it-works","content":"Without this, `flip()`/`shift()` alone only reposition the popover — they never shrink it — so a facet with\nmany values could overflow past the viewport in the gap between the trigger and the screen edge."},"610":{"id":"/docs/atomic-angular/filters/filter-button-12","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#options","content":"<TypeTable\n  type=\"{\n  name: { type: &#x22;string | undefined&#x22; },\n  column: { type: &#x22;string&#x22;, description: &#x22;Required.&#x22; },\n  position: { type: &#x22;Placement&#x22;, default: '&#x22;bottom-start&#x22;' },\n  offset: { type: &#x22;number&#x22;, default: &#x22;8&#x22; },\n  lockPosition: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22; },\n  expandedLevel: { type: &#x22;number | undefined&#x22;, description: &#x22;Relayed to the inner Aggregation, for a tree facet.&#x22; },\n}\"\n/>"},"611":{"id":"/docs/atomic-angular/filters/filter-button-13","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#pitfalls","content":"Check the aggregation actually has items — `disabled` follows `!agg?.items?.length`, **unless** the column is\na date column, which is never disabled even with zero buckets (a date's custom range stays usable regardless,\nthe same exemption `<aggregation-date>` itself has — see\nits pitfall)."},"612":{"id":"/docs/atomic-angular/filters/filter-button-14","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#pitfalls","content":"This would be a regression, not expected behaviour — the popover panel deliberately stops propagation of every\nkeyboard/pointer event except `Tab` and `Escape`, precisely so the surrounding `filters-bar` toolbar (which\nowns arrow-key roving) never intercepts navigation meant for the facet inside the panel (a listbox, a tree, a\ndate radio group)."},"613":{"id":"/docs/atomic-angular/filters/filter-button-15","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#pitfalls","content":"Also a regression to report, not expected — the component closes its own popover on `focusout` once focus\ngenuinely leaves the button and its panel (checked via `contains()` on the `relatedTarget`). A `null`\n`relatedTarget` — focus leaving the document entirely (alt-tab, browser chrome) — is the one case where it is\ndeliberately left open, so it survives a window switch."},"614":{"id":"/docs/atomic-angular/filters/filter-button-16","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#whats-next","content":"Where these buttons are rendered from, and how overflow is handled."},"615":{"id":"/docs/atomic-angular/filters/filter-button-17","page_id":"/docs/atomic-angular/filters/filter-button","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filter-button#whats-next","content":"What actually renders inside the popover."},"616":{"id":"/docs/atomic-angular/filters/filters-bar","page_id":"/docs/atomic-angular/filters/filters-bar","type":"page","content":"Filters bar","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters/filters-bar"},"617":{"id":"/docs/atomic-angular/filters/filters-bar-0","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar","content":"A toolbar listing the facets a user can filter on — one popover button per aggregation, with overflow handled by a \"More\" button."},"618":{"id":"/docs/atomic-angular/filters/filters-bar-1","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#minimal-example","content":"Minimal example"},"619":{"id":"/docs/atomic-angular/filters/filters-bar-2","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#how-it-works","content":"How it works"},"620":{"id":"/docs/atomic-angular/filters/filters-bar-3","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#recipes","content":"Recipes"},"621":{"id":"/docs/atomic-angular/filters/filters-bar-4","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#limit-and-reorder-the-visible-filters","content":"Limit and reorder the visible filters"},"622":{"id":"/docs/atomic-angular/filters/filters-bar-5","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#a-vertical-bar-for-a-sidebar-layout","content":"A vertical bar, for a sidebar layout"},"623":{"id":"/docs/atomic-angular/filters/filters-bar-6","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#options","content":"Options"},"624":{"id":"/docs/atomic-angular/filters/filters-bar-7","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#pitfalls","content":"Pitfalls"},"625":{"id":"/docs/atomic-angular/filters/filters-bar-8","page_id":"/docs/atomic-angular/filters/filters-bar","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/filters-bar#whats-next","content":"What's next"},"626":{"id":"/docs/atomic-angular/filters/filters-bar-9","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar","content":"`<filters-bar>` renders one filter button per authorized aggregation, in a keyboard-\nnavigable toolbar, and folds whatever does not fit into a \"More\" button. It shows what a user\n**can** filter on — contrast with Applied filters, which shows what the query **is**\ncurrently filtered by."},"627":{"id":"/docs/atomic-angular/filters/filters-bar-10","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar","content":"An aggregation becomes a filter button only if the app's JSON configuration says so (`position: \"left\" |\n\"both\"`, never `\"left\"` only in the bar) and the admin has not marked it `hidden`. Resolving that list is\n`AggregationsService.getAuthorizedFilters` — the bar, `<more-button>` and `<aside-filters>` all call through it,\nso the three surfaces never disagree on which facets exist."},"628":{"id":"/docs/atomic-angular/filters/filters-bar-11","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#minimal-example","content":"Each button opens its aggregation in a popover — see Filter button. Once more filters\nare authorized than `filtersCount` allows, the remaining ones move into the \"More\" button rather than\noverflowing the toolbar."},"629":{"id":"/docs/atomic-angular/filters/filters-bar-12","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#how-it-works","content":"The bar is an `@angular/aria` `Toolbar`: arrow keys rove between buttons, and the overflow manager recounts how\nmany fit whenever the container resizes or the applied filters/basket change — a button hidden by overflow\nemits no resize notification of its own when its natural width changes, so the recount is driven by the store\ninstead."},"630":{"id":"/docs/atomic-angular/filters/filters-bar-13","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#limit-and-reorder-the-visible-filters","content":"`filtersCount` can also be set application-wide through the `FILTERS_BREAKPOINT` injection token, rather than\nrepeating it on every `<filters-bar>`:"},"631":{"id":"/docs/atomic-angular/filters/filters-bar-14","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#options","content":"<TypeTable\n  type=\"{\n  ariaLabel: { type: &#x22;string&#x22;, description: &#x22;Overrides the translated filters.filterControls. Set it when a page shows more than one bar.&#x22; },\n  direction: { type: '&#x22;horizontal&#x22; | &#x22;vertical&#x22;', default: '&#x22;horizontal&#x22;' },\n  position: { type: &#x22;Placement&#x22;, default: '&#x22;bottom-start&#x22;', description: &#x22;Popover placement for each filter button.&#x22; },\n  morePosition: { type: &#x22;Placement&#x22;, default: '&#x22;bottom-end&#x22;', description: &#x22;Popover placement for the More button.&#x22; },\n  lockPosition: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables floating-ui's automatic repositioning for every popover in the bar.&#x22; },\n  aggregations: { type: &#x22;Aggregation[] | undefined&#x22;, description: &#x22;Explicit aggregation list, bypassing AppStore's own JSON-driven authorization.&#x22; },\n  includeFilters: { type: &#x22;string[]&#x22;, default: &#x22;[]&#x22; },\n  excludeFilters: { type: &#x22;string[]&#x22;, default: &#x22;[]&#x22; },\n  filtersCount: { type: &#x22;number&#x22;, default: &#x22;inject(FILTERS_BREAKPOINT) — 5&#x22;, description: &#x22;Filters shown before the rest overflow into More.&#x22; },\n  showMoreFiltersButton: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  homepage: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Only filters flagged homepage: true in the app's JSON; none if none are flagged.&#x22; },\n  offset: { type: &#x22;number&#x22;, default: &#x22;8&#x22;, description: &#x22;Distance in pixels between a popover and its trigger.&#x22; },\n}\"\n/>"},"632":{"id":"/docs/atomic-angular/filters/filters-bar-15","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#pitfalls","content":"Check its `position` first — the bar only ever renders `\"left\"` **or** `\"both\"` aggregations (a JSON-only\n`\"left\"` facet lives in a drawer, never the bar), and the admin `hidden` rule is applied on top of that. Both\nchecks happen in `AggregationsService.getAuthorizedFilters`, shared with `<more-button>` and\n`<aside-filters>` — if it is missing from all three, the configuration is the first thing to check, not the\ncomponent."},"633":{"id":"/docs/atomic-angular/filters/filters-bar-16","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#pitfalls","content":"If this happens transiently on load, it is expected and harmless: the toolbar is only rendered once\n`hasFilters() || currentBasket() || hasAggregations()` is true, specifically so a keyboard user never lands\non an empty, zero-height strip that still announces \"Filter controls\"."},"634":{"id":"/docs/atomic-angular/filters/filters-bar-17","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#pitfalls","content":"`showMoreFiltersButton` might be `false`, but if not: the overflow count is measured against the **full**\nauthorized list, not the list capped by `filtersCount` — so this should not happen. If it does, check that\n`aggregations`/`includeFilters`/`excludeFilters` are consistent between what you expect and what\n`getAuthorizedFilters` actually resolves; the \"More\" button and the bar always agree with each other, but not\nnecessarily with an assumption made outside the component."},"635":{"id":"/docs/atomic-angular/filters/filters-bar-18","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#whats-next","content":"What a single button in the bar opens, and how its popover sizes itself to the viewport."},"636":{"id":"/docs/atomic-angular/filters/filters-bar-19","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#whats-next","content":"Where the filters beyond filtersCount go, and how it adapts to mobile."},"637":{"id":"/docs/atomic-angular/filters/filters-bar-20","page_id":"/docs/atomic-angular/filters/filters-bar","tags":[],"type":"text","url":"/docs/atomic-angular/filters/filters-bar#whats-next","content":"What the bar's siblings show once a filter from it is actually applied."},"638":{"id":"/docs/atomic-angular/filters","page_id":"/docs/atomic-angular/filters","type":"page","content":"Filtering results","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters"},"639":{"id":"/docs/atomic-angular/filters-0","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters","content":"Rendering facets over a query's aggregations, and turning clicks into filters — the aggregation family, the filters bar and its overflow, and what ends up applied."},"640":{"id":"/docs/atomic-angular/filters-1","page_id":"/docs/atomic-angular/filters","type":"heading","tags":[],"url":"/docs/atomic-angular/filters#whats-next","content":"What's next"},"641":{"id":"/docs/atomic-angular/filters-2","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters","content":"A search rarely stays a plain text query. The user ticks \"PDF only\", expands a folder in a tree, picks \"last\nmonth\" — each facet renders one aggregation of the query's result, and clicking an item turns into a filter on\nthe next query. This section covers that whole loop: rendering a facet, applying and clearing its selection,\nand showing the user what is currently filtered."},"642":{"id":"/docs/atomic-angular/filters-3","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters#whats-next","content":"Render a facet as a list, a tree or a date range, and turn a click into an applied filter."},"643":{"id":"/docs/atomic-angular/filters-4","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters#whats-next","content":"The date variant's preset options and custom-range dialog, live or deferred."},"644":{"id":"/docs/atomic-angular/filters-5","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters#whats-next","content":"One popover button per authorized facet, with overflow handled by More."},"645":{"id":"/docs/atomic-angular/filters-6","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters#whats-next","content":"The single-facet popover the bar renders one of."},"646":{"id":"/docs/atomic-angular/filters-7","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters#whats-next","content":"Filters beyond the bar's visible count — popover, Dialog, or a mobile Sheet."},"647":{"id":"/docs/atomic-angular/filters-8","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters#whats-next","content":"The same stacked facets, in a persistent sidebar accordion."},"648":{"id":"/docs/atomic-angular/filters-9","page_id":"/docs/atomic-angular/filters","tags":[],"type":"text","url":"/docs/atomic-angular/filters#whats-next","content":"What the query is currently filtered by — one removable chip per value."},"649":{"id":"/docs/atomic-angular/filters/more","page_id":"/docs/atomic-angular/filters/more","type":"page","content":"More","breadcrumbs":["Docs","Atomic Angular","Filtering results"],"tags":[],"url":"/docs/atomic-angular/filters/more"},"650":{"id":"/docs/atomic-angular/filters/more-0","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more","content":"The overflow surface for filters beyond the filters bar's visible count — a popover on desktop, escalating to a Dialog or a mobile Sheet."},"651":{"id":"/docs/atomic-angular/filters/more-1","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#minimal-example","content":"Minimal example"},"652":{"id":"/docs/atomic-angular/filters/more-2","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#how-it-works","content":"How it works"},"653":{"id":"/docs/atomic-angular/filters/more-3","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#recipes","content":"Recipes"},"654":{"id":"/docs/atomic-angular/filters/more-4","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#escalate-to-a-modal-past-a-threshold","content":"Escalate to a modal past a threshold"},"655":{"id":"/docs/atomic-angular/filters/more-5","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#more-alone-inside-a-custom-container","content":"`<More>` alone, inside a custom container"},"656":{"id":"/docs/atomic-angular/filters/more-6","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#options","content":"Options"},"657":{"id":"/docs/atomic-angular/filters/more-7","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#pitfalls","content":"Pitfalls"},"658":{"id":"/docs/atomic-angular/filters/more-8","page_id":"/docs/atomic-angular/filters/more","type":"heading","tags":[],"url":"/docs/atomic-angular/filters/more#whats-next","content":"What's next"},"659":{"id":"/docs/atomic-angular/filters/more-9","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more","content":"`<more-button>` renders the \"More\" trigger Filters bar shows once more filters are\nauthorized than fit — its content, `<more>`, is the same stacked-facet accordion as\nAside filters, just shown inside an overlay instead of a persistent sidebar."},"660":{"id":"/docs/atomic-angular/filters/more-10","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#minimal-example","content":"`count` is how many authorized filters are already shown elsewhere (typically the bar's own `filtersCount`) —\n`<more-button>` renders everything **beyond** that."},"661":{"id":"/docs/atomic-angular/filters/more-11","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#how-it-works","content":"`<more-button>` picks its container by context, never the same one twice on a given viewport:"},"662":{"id":"/docs/atomic-angular/filters/more-12","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#how-it-works","content":"Above 6 overflow filters, `<More>` itself grows a facet-name search box, independently of which container it\nrenders inside — a popover with many facets is otherwise as hard to scan as a sidebar with many facets."},"663":{"id":"/docs/atomic-angular/filters/more-13","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#more-alone-inside-a-custom-container","content":"Reach for `<more>` directly (skipping `<more-button>`'s own popover/dialog/sheet selection) when it needs to\nsit inside a container you already control:"},"664":{"id":"/docs/atomic-angular/filters/more-14","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#options","content":"<TypeTable\n  type=\"{\n  count: { type: &#x22;number&#x22;, default: &#x22;2&#x22;, description: &#x22;Filters already shown elsewhere; everything authorized beyond this renders here.&#x22; },\n  position: { type: &#x22;Placement&#x22;, default: '&#x22;bottom-end&#x22;', description: &#x22;Desktop popover placement.&#x22; },\n  lockPosition: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22; },\n  includedFilters: { type: &#x22;string[]&#x22;, default: &#x22;[]&#x22; },\n  excludedFilters: { type: &#x22;string[]&#x22;, default: &#x22;[]&#x22; },\n  aggregations: { type: &#x22;Aggregation[] | undefined&#x22; },\n  homepage: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22; },\n  hideWhenEmpty: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Relayed to every <Aggregation [hideWhenEmpty]> in the overflow list.&#x22; },\n  enrichedThreshold: {\n    type: &#x22;number | undefined&#x22;,\n    description: &#x22;Above this many overflow filters, escalate the desktop Popover to a modal Dialog. Unset: never escalate, whatever the count.&#x22;,\n  },\n}\"\n/>"},"665":{"id":"/docs/atomic-angular/filters/more-15","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#pitfalls","content":"`count` must match what the bar itself actually shows — typically its own `filtersCount` (or the app-wide\n`FILTERS_BREAKPOINT` it defaults to). `<more-button>` has no way to know what another component rendered; it\nonly knows how many to skip."},"666":{"id":"/docs/atomic-angular/filters/more-16","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#pitfalls","content":"Not configurable — it appears automatically past 6 overflow filters (`SEARCH_THRESHOLD`), regardless of\ncontainer or `enrichedThreshold`. It exists precisely because a long facet list is hard to scan in a popover."},"667":{"id":"/docs/atomic-angular/filters/more-17","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#pitfalls","content":"Expected — mobile always uses the bottom Sheet, checked first and independently of `enrichedThreshold`. That\ninput only arbitrates between the desktop Popover and Dialog."},"668":{"id":"/docs/atomic-angular/filters/more-18","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#whats-next","content":"Where this overflow button is normally mounted from."},"669":{"id":"/docs/atomic-angular/filters/more-19","page_id":"/docs/atomic-angular/filters/more","tags":[],"type":"text","url":"/docs/atomic-angular/filters/more#whats-next","content":"The same stacked-facet accordion, in a persistent sidebar instead of an overlay."},"670":{"id":"/docs/atomic-angular/integration/atomic-client","page_id":"/docs/atomic-angular/integration/atomic-client","type":"page","content":"Provide a client","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/atomic-client"},"671":{"id":"/docs/atomic-angular/integration/atomic-client-0","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client","content":"Give an application its own Sinequa client — its own configuration, session and event subscribers — instead of the default one backing the free functions."},"672":{"id":"/docs/atomic-angular/integration/atomic-client-1","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#minimal-example","content":"Minimal example"},"673":{"id":"/docs/atomic-angular/integration/atomic-client-2","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#how-it-works","content":"How it works"},"674":{"id":"/docs/atomic-angular/integration/atomic-client-3","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#recipes","content":"Recipes"},"675":{"id":"/docs/atomic-angular/integration/atomic-client-4","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#configuration-known-only-at-start-up","content":"Configuration known only at start-up"},"676":{"id":"/docs/atomic-angular/integration/atomic-client-5","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#reading-the-client-and-checking-the-session-without-redirecting","content":"Reading the client and checking the session without redirecting"},"677":{"id":"/docs/atomic-angular/integration/atomic-client-6","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#options","content":"Options"},"678":{"id":"/docs/atomic-angular/integration/atomic-client-7","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#pitfalls","content":"Pitfalls"},"679":{"id":"/docs/atomic-angular/integration/atomic-client-8","page_id":"/docs/atomic-angular/integration/atomic-client","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-client#whats-next","content":"What's next"},"680":{"id":"/docs/atomic-angular/integration/atomic-client-9","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client","content":"Every store, service and component in this library reaches the Sinequa backend through **one client**,\nresolved from the `ATOMIC_CLIENT` injection token. `provideAtomicClient()` is how an application gives that\ntoken its own client instead of the default one."},"681":{"id":"/docs/atomic-angular/integration/atomic-client-10","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client","content":"`ATOMIC_CLIENT` defaults to the client backing `@sinequa/atomic`'s free functions (`login()`, `fetchQuery()`,\n…), whose configuration **is** `globalConfig`. An application that never calls `provideAtomicClient()` behaves\nexactly as before — there is nothing to migrate."},"682":{"id":"/docs/atomic-angular/integration/atomic-client-11","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#how-it-works","content":"`provideAtomicClient(config)` registers a factory for `ATOMIC_CLIENT` that calls\n`createAtomicClient(config)` from `@sinequa/atomic` — one client, one configuration, one session, one set of\nevent subscribers, isolated from whatever the default client is doing. `injectAtomicClient()` is\n`inject(ATOMIC_CLIENT)` under a clearer name."},"683":{"id":"/docs/atomic-angular/integration/atomic-client-12","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#how-it-works","content":"Registering `provideAtomicClient()` again in a route or component injector shadows the token for that subtree\nonly — which is how a second backend is served (see Serve a second backend).\nProviding the client alone is rarely what a subtree serving a second backend wants, though: the library's\nstores and services stay bound to whichever client was in scope when they were first constructed — use\n`provideAtomicScope()` for a self-contained subtree."},"684":{"id":"/docs/atomic-angular/integration/atomic-client-13","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#configuration-known-only-at-start-up","content":"Pass a **function** instead of an object when part of the configuration is resolved after this module is\nevaluated — an SPFx web part supplying `backendUrl` at runtime, say. The object form is captured when the\nproviders are declared; the function form runs when the injector actually builds the client."},"685":{"id":"/docs/atomic-angular/integration/atomic-client-14","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#reading-the-client-and-checking-the-session-without-redirecting","content":"`login()` is not a question — for `oauth`/`saml` it navigates away to the identity provider. Ask\n`hasSession()` instead to decide what to render."},"686":{"id":"/docs/atomic-angular/integration/atomic-client-15","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#reading-the-client-and-checking-the-session-without-redirecting","content":"`client.auth.isRedirectPending()` tells a provider handshake apart from a plain missing session.\n`client.storagePrefix` reads back the prefix namespacing this client's storage keys."},"687":{"id":"/docs/atomic-angular/integration/atomic-client-16","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#options","content":"<TypeTable\n  type=\"{\n  &#x22;provideAtomicClient(config)&#x22;: {\n    type: &#x22;AtomicClientConfig | (() => AtomicClientConfig)&#x22;,\n    description: &#x22;Registers an isolated client on ATOMIC_CLIENT for the injector it is called from. Returns EnvironmentProviders.&#x22;,\n  },\n  &#x22;atomicClientProvider(config)&#x22;: {\n    type: &#x22;AtomicClientConfig | (() => AtomicClientConfig)&#x22;,\n    description: &#x22;The same client as an ordinary Provider, for a component's providers array (typed Provider[], rejects EnvironmentProviders).&#x22;,\n  },\n  &#x22;injectAtomicClient()&#x22;: {\n    type: &#x22;() => AtomicClient&#x22;,\n    description: &#x22;inject(ATOMIC_CLIENT), for readability. Must be called from an injection context.&#x22;,\n  },\n}\"\n/>"},"688":{"id":"/docs/atomic-angular/integration/atomic-client-17","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#pitfalls","content":"Those packages read `globalConfig.backendUrl`/`.app`/`.userOverride*` directly — they know nothing of\n`ATOMIC_CLIENT`. A client created by `provideAtomicClient()` keeps a *snapshot* of the configuration it was\nhanded, so `initializeConfig()` resolves `backendUrl` on that client alone, and the other packages go on\nbuilding requests against `undefined`. Nothing warns you — the rest of the application keeps working, since\nit goes through the client."},"689":{"id":"/docs/atomic-angular/integration/atomic-client-18","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#pitfalls","content":"Leave the root on the default client instead (no `provideAtomicClient()` call), and configure it from your\nentry point:"},"690":{"id":"/docs/atomic-angular/integration/atomic-client-19","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#pitfalls","content":"Do not set `uiLanguage` there — `bootstrapApp()` keeps it on the interface language instead (see\nBootstrap the application)."},"691":{"id":"/docs/atomic-angular/integration/atomic-client-20","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#pitfalls","content":"Once an application provides a client, calling a **free function** (`fetchQuery()`, `login()`, …) still runs\non the *default* client — configured from `globalConfig`, which the provided client never updates. The two\nshare the browser session (same storage keys, unless `storagePrefix` differs), so requests still succeed; only\nthe configuration silently diverges. `backendUrl` is the one that bites, since `initializeConfig()` writes it\nto the client only."},"692":{"id":"/docs/atomic-angular/integration/atomic-client-21","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#pitfalls","content":"Adopt `injectAtomicClient()` everywhere once a client is provided; do not mix free functions and a provided\nclient in the same application."},"693":{"id":"/docs/atomic-angular/integration/atomic-client-22","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#pitfalls","content":"A recovery hook (`client.config.auth.recoverFromUnauthorized`) usually performs requests of its own. If one of\nthose comes back 401, the client calls the hook again — and a hook that returns the recovery already in flight\nwaits on itself, silently. Pass `noRecovery: true` on the requests your recovery makes, and have it refuse\nre-entry while a recovery is already running."},"694":{"id":"/docs/atomic-angular/integration/atomic-client-23","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#whats-next","content":"Give a route or component subtree its own client, plus the stores and services it needs."},"695":{"id":"/docs/atomic-angular/integration/atomic-client-24","page_id":"/docs/atomic-angular/integration/atomic-client","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-client#whats-next","content":"Sign the user in and initialize the application's stores before the first view renders."},"696":{"id":"/docs/atomic-angular/integration/atomic-notifications","page_id":"/docs/atomic-angular/integration/atomic-notifications","type":"page","content":"Notify failed requests as toasts","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/atomic-notifications"},"697":{"id":"/docs/atomic-angular/integration/atomic-notifications-0","page_id":"/docs/atomic-angular/integration/atomic-notifications","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-notifications","content":"Surface a failed backend request as a toast notification, without wrapping Angular's HttpClient."},"698":{"id":"/docs/atomic-angular/integration/atomic-notifications-1","page_id":"/docs/atomic-angular/integration/atomic-notifications","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-notifications#minimal-example","content":"Minimal example"},"699":{"id":"/docs/atomic-angular/integration/atomic-notifications-2","page_id":"/docs/atomic-angular/integration/atomic-notifications","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-notifications#how-it-works","content":"How it works"},"700":{"id":"/docs/atomic-angular/integration/atomic-notifications-3","page_id":"/docs/atomic-angular/integration/atomic-notifications","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-notifications#pitfalls","content":"Pitfalls"},"701":{"id":"/docs/atomic-angular/integration/atomic-notifications-4","page_id":"/docs/atomic-angular/integration/atomic-notifications","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-notifications#whats-next","content":"What's next"},"702":{"id":"/docs/atomic-angular/integration/atomic-notifications-5","page_id":"/docs/atomic-angular/integration/atomic-notifications","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-notifications","content":"`provideAtomicNotifications()` subscribes to the client's own `requestFailed` event and raises a toast for the\nstatuses worth telling the user about, replacing the retired `toastInterceptorFn`."},"703":{"id":"/docs/atomic-angular/integration/atomic-notifications-6","page_id":"/docs/atomic-angular/integration/atomic-notifications","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-notifications#how-it-works","content":"`400`, `403`, `500` and `503` raise a `notify.error(…)` toast; an impersonation rejected by the server\n(`401` with `errorCode: 6`) gets its own explicit message. A plain `401` raises nothing — it is handled by the\nauthentication path, not shown to the user. Two sources of noise are silenced on top of that: a `400` on\n`api/v2/user-profile` (the expected \"not created yet\" answer) and any failure on `api/v1/preview`, which the\npreview panel surfaces itself."},"704":{"id":"/docs/atomic-angular/integration/atomic-notifications-7","page_id":"/docs/atomic-angular/integration/atomic-notifications","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-notifications#how-it-works","content":"Because it listens to the **client's** event rather than wrapping `HttpClient`, it covers every request the\nclient makes — including the ones that never go through Angular's `HttpClient` at all."},"705":{"id":"/docs/atomic-angular/integration/atomic-notifications-8","page_id":"/docs/atomic-angular/integration/atomic-notifications","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-notifications#pitfalls","content":"`toastInterceptorFn` only ever saw requests going through Angular's `HttpClient`. Since the library issues every\nbackend request through the atomic client now, the interceptor has nothing left to intercept for the library's\nown requests — keep it only if **your own** code still calls the Sinequa backend through `HttpClient` directly.\nIt stays exported and functional, and will be removed in a future major version."},"706":{"id":"/docs/atomic-angular/integration/atomic-notifications-9","page_id":"/docs/atomic-angular/integration/atomic-notifications","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-notifications#pitfalls","content":"`provideAtomicNotifications()` registered at the root only covers the root client's events. A\nscope serving a second backend has its own event subscribers — register\n`provideAtomicNotifications()` in the scope's own providers too if you want its failures notified."},"707":{"id":"/docs/atomic-angular/integration/atomic-notifications-10","page_id":"/docs/atomic-angular/integration/atomic-notifications","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-notifications#whats-next","content":"The client whose events this listens to."},"708":{"id":"/docs/atomic-angular/integration/atomic-scope","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"page","content":"Serve a second backend","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/atomic-scope"},"709":{"id":"/docs/atomic-angular/integration/atomic-scope-0","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope","content":"Give a route or component subtree its own Sinequa client plus a self-contained copy of the library's stores and services, so two backends never leak into each other."},"710":{"id":"/docs/atomic-angular/integration/atomic-scope-1","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#minimal-example","content":"Minimal example"},"711":{"id":"/docs/atomic-angular/integration/atomic-scope-2","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#how-it-works","content":"How it works"},"712":{"id":"/docs/atomic-angular/integration/atomic-scope-3","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#recipes","content":"Recipes"},"713":{"id":"/docs/atomic-angular/integration/atomic-scope-4","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#two-backends-side-by-side","content":"Two backends side by side"},"714":{"id":"/docs/atomic-angular/integration/atomic-scope-5","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#composing-the-provider-list-yourself","content":"Composing the provider list yourself"},"715":{"id":"/docs/atomic-angular/integration/atomic-scope-6","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#options","content":"Options"},"716":{"id":"/docs/atomic-angular/integration/atomic-scope-7","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#pitfalls","content":"Pitfalls"},"717":{"id":"/docs/atomic-angular/integration/atomic-scope-8","page_id":"/docs/atomic-angular/integration/atomic-scope","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/atomic-scope#whats-next","content":"What's next"},"718":{"id":"/docs/atomic-angular/integration/atomic-scope-9","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope","content":"`provideAtomicClient()` alone is enough at the application root, where the root singletons already resolve to\nthe right client. A **route or component subtree that targets another backend** needs more: its own client\n*and* its own copy of everything that holds per-backend state. `provideAtomicScope()` provides both."},"719":{"id":"/docs/atomic-angular/integration/atomic-scope-10","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#minimal-example","content":"Inside the `support` branch, `inject(AppStore)`, `inject(QueryService)`, `injectAtomicClient()` — everything\nresolves to that scope's own instances, talking to the second backend with its own session. Outside it,\nnothing changes."},"720":{"id":"/docs/atomic-angular/integration/atomic-scope-11","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#how-it-works","content":"`ATOMIC_SCOPED_PROVIDERS` re-creates seven stores and thirteen services alongside the client — every one of\nthem is `providedIn: \"root\"`, so a store left at the root would keep the **root** client and silently read and\nwrite the *first* backend from inside the second backend's subtree."},"721":{"id":"/docs/atomic-angular/integration/atomic-scope-12","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#how-it-works","content":"`ThemeStore` is deliberately absent from that list: the theme is a user-interface preference, not backend\nstate, and both scopes should keep sharing it."},"722":{"id":"/docs/atomic-angular/integration/atomic-scope-13","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#two-backends-side-by-side","content":"Two backends on the same screen is a component-tree question, not a routing one — `provideAtomicScope()` also\nworks in a component's `providers`."},"723":{"id":"/docs/atomic-angular/integration/atomic-scope-14","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#two-backends-side-by-side","content":"Each panel then runs its own search, with its own stores, against its own backend. Two instances of the\n*same* component cannot be configured differently, though — Angular resolves `providers` per component\n**type**, before any `input()` exists. Write one thin wrapper per backend, each with its own literal\nconfiguration, both delegating to a shared presentational component."},"724":{"id":"/docs/atomic-angular/integration/atomic-scope-15","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#composing-the-provider-list-yourself","content":"`ATOMIC_SCOPED_PROVIDERS` is exported, for an application that wants to add its own scoped service alongside\nthe library's."},"725":{"id":"/docs/atomic-angular/integration/atomic-scope-16","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#options","content":"<TypeTable\n  type=\"{\n  &#x22;provideAtomicScope(config)&#x22;: {\n    type: &#x22;AtomicClientConfig | (() => AtomicClientConfig)&#x22;,\n    description: &#x22;An isolated client and the library's stores/services alongside it, as a plain Provider[] (not EnvironmentProviders).&#x22;,\n  },\n  ATOMIC_SCOPED_PROVIDERS: {\n    type: &#x22;Provider[]&#x22;,\n    description: &#x22;The provider list alone, for an application composing its own — see Recipes.&#x22;,\n  },\n}\"\n/>"},"726":{"id":"/docs/atomic-angular/integration/atomic-scope-17","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#pitfalls","content":"Anything calling a **free function** (`fetchQuery()`, `login()`, `globalConfig.…`) runs on the default client,\nwhatever subtree it sits in — inside a scope, that means querying the *first* backend, silently, since the\nrequest still succeeds. Audit your own components for those calls; the library's own code never makes them."},"727":{"id":"/docs/atomic-angular/integration/atomic-scope-18","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#pitfalls","content":"`provideAtomicScope()` deliberately returns a plain `Provider[]`, not `EnvironmentProviders` — a component's\n`providers` is typed `Provider[]` and rejects `EnvironmentProviders`. `Route.providers`,\n`ApplicationConfig.providers` and `createEnvironmentInjector` all accept\n`Array<Provider | EnvironmentProviders>` and flatten nested arrays, so the routing form works either way; only\nthe component form depends on this."},"728":{"id":"/docs/atomic-angular/integration/atomic-scope-19","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#pitfalls","content":"Without distinct `storagePrefix` values, two clients read and write the same session storage keys and\noverwrite each other's token. Set `storagePrefix` as soon as two clients target different backends — including\nthe default client if the application still uses it alongside a scoped one."},"729":{"id":"/docs/atomic-angular/integration/atomic-scope-20","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#whats-next","content":"The single-backend case, and the client every scope wraps."},"730":{"id":"/docs/atomic-angular/integration/atomic-scope-21","page_id":"/docs/atomic-angular/integration/atomic-scope","tags":[],"type":"text","url":"/docs/atomic-angular/integration/atomic-scope#whats-next","content":"Sign the user in and initialize the application's stores before the first view renders."},"731":{"id":"/docs/atomic-angular/integration/bootstrap-app","page_id":"/docs/atomic-angular/integration/bootstrap-app","type":"page","content":"Bootstrap the application","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/bootstrap-app"},"732":{"id":"/docs/atomic-angular/integration/bootstrap-app-0","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app","content":"Sign the user in and initialize the application's stores — and, optionally, its dynamic routes — before the first view renders."},"733":{"id":"/docs/atomic-angular/integration/bootstrap-app-1","page_id":"/docs/atomic-angular/integration/bootstrap-app","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/bootstrap-app#minimal-example","content":"Minimal example"},"734":{"id":"/docs/atomic-angular/integration/bootstrap-app-2","page_id":"/docs/atomic-angular/integration/bootstrap-app","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/bootstrap-app#how-it-works","content":"How it works"},"735":{"id":"/docs/atomic-angular/integration/bootstrap-app-3","page_id":"/docs/atomic-angular/integration/bootstrap-app","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/bootstrap-app#options","content":"Options"},"736":{"id":"/docs/atomic-angular/integration/bootstrap-app-4","page_id":"/docs/atomic-angular/integration/bootstrap-app","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/bootstrap-app#pitfalls","content":"Pitfalls"},"737":{"id":"/docs/atomic-angular/integration/bootstrap-app-5","page_id":"/docs/atomic-angular/integration/bootstrap-app","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/bootstrap-app#whats-next","content":"What's next"},"738":{"id":"/docs/atomic-angular/integration/bootstrap-app-6","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app","content":"`bootstrapApp()` is the one call most applications register as an `provideAppInitializer`: it resolves the\nauthentication mode, signs the user in, and initializes the application's stores in the right order, so no\ncomponent has to guard against a half-initialized application."},"739":{"id":"/docs/atomic-angular/integration/bootstrap-app-7","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#how-it-works","content":"Resolving `backendUrl` and the authentication mode **before** signing in is what removes a long-standing\nbootstrap race: every store or service that derives its API URL from the client's configuration is only\nconstructed *after* that resolution, so none of them can capture an unresolved backend URL. `bootstrapApp` also\nwires the client's `recoverFromUnauthorized` hook to `signIn()`, so a `401` on any of the client's own requests\nre-authenticates and replays the request once — the same recovery the HTTP interceptors provide for requests\nthe client never sees (see Cross-cutting interceptors)."},"740":{"id":"/docs/atomic-angular/integration/bootstrap-app-8","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#how-it-works","content":"`bootstrapApp` keeps the client's `uiLanguage` on the interface language rather than a value fixed at\nstart-up: it follows `TranslocoService.langChanges$` for as long as the application runs, which is also what\nthe request body interceptor and the `syslang`/`translocoDate` pipes read on their own side (see\nCross-cutting pipes)."},"741":{"id":"/docs/atomic-angular/integration/bootstrap-app-9","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#options","content":"<TypeTable\n  type=\"{\n  createRoutes: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;Whether ApplicationService builds dynamic routes for the query's tabs after initialization.&#x22;,\n  },\n}\"\n/>"},"742":{"id":"/docs/atomic-angular/integration/bootstrap-app-10","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#options","content":"The promise `bootstrapApp` returns never rejects — it resolves `true` once fully initialized, `false` when the\nuser is not authenticated or an error occurred (already logged and, for a fatal error, already routed to\n`/error`)."},"743":{"id":"/docs/atomic-angular/integration/bootstrap-app-11","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#pitfalls","content":"Something was injected **before** `bootstrapApp` resolved the configuration — most often\n`inject(ApplicationService)` called eagerly in a factory, rather than left for `bootstrapApp` to inject\ninternally. `client.initializeConfig()` must run, and set `backendUrl`, before any service or store that reads\nit is constructed. The deprecated `withBootstrapApp(applicationService, options)` signature existed for exactly\nthe pattern that broke this — migrate to `bootstrapApp(options)` alone and let it inject `ApplicationService`\nitself."},"744":{"id":"/docs/atomic-angular/integration/bootstrap-app-12","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#pitfalls","content":"An audit event fired in the moments after a logout can land on the deleted session cookie, answer 401, and\nre-trigger `signIn()` — signing the user back in to a login form they deliberately left. `bootstrapApp` refuses\nrecovery for `api/v1/audit.notify` specifically, and for any request while a sign-in is already in flight (a\nrecovery that waited on its own in-flight sign-in would never settle). Both guards are already built in; if you\nsee this with a different endpoint, mark that request `noRecovery: true` rather than trying to special-case it\nhere."},"745":{"id":"/docs/atomic-angular/integration/bootstrap-app-13","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#whats-next","content":"The client bootstrapApp resolves the configuration and session on."},"746":{"id":"/docs/atomic-angular/integration/bootstrap-app-14","page_id":"/docs/atomic-angular/integration/bootstrap-app","tags":[],"type":"text","url":"/docs/atomic-angular/integration/bootstrap-app#whats-next","content":"The same recovery, for requests the client never sees."},"747":{"id":"/docs/atomic-angular/integration","page_id":"/docs/atomic-angular/integration","type":"page","content":"Integration","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration"},"748":{"id":"/docs/atomic-angular/integration-0","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration","content":"Wiring the client, bootstrap, and cross-cutting interceptors, pipes, services and utilities into a host application."},"749":{"id":"/docs/atomic-angular/integration-1","page_id":"/docs/atomic-angular/integration","type":"heading","tags":[],"url":"/docs/atomic-angular/integration#whats-next","content":"What's next"},"750":{"id":"/docs/atomic-angular/integration-2","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration","content":"The pieces every application wires in once, regardless of which search features it uses: the client\nconnecting to the backend, the bootstrap sequence that signs the user in, and the interceptors, pipes,\nservices and utilities that cut across every feature rather than belonging to one."},"751":{"id":"/docs/atomic-angular/integration-3","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"Give the application its own Sinequa client instead of the default one."},"752":{"id":"/docs/atomic-angular/integration-4","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"A route or component subtree with its own client, stores and services."},"753":{"id":"/docs/atomic-angular/integration-5","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"Surface a failed request without wrapping HttpClient."},"754":{"id":"/docs/atomic-angular/integration-6","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"Sign the user in and initialize the application's stores."},"755":{"id":"/docs/atomic-angular/integration-7","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"The interface language, audit metadata and 401 recovery, on the HttpClient channel."},"756":{"id":"/docs/atomic-angular/integration-8","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"Legacy filter display, translated system strings, locale-aware dates, file sizes, highlighting."},"757":{"id":"/docs/atomic-angular/integration-9","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"Building a query from the route, a Web Worker wrapper, a baseline fetch wrapper."},"758":{"id":"/docs/atomic-angular/integration-10","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"Registering route components, custom audit events, JsonMethod plugin calls."},"759":{"id":"/docs/atomic-angular/integration-11","page_id":"/docs/atomic-angular/integration","tags":[],"type":"text","url":"/docs/atomic-angular/integration#whats-next","content":"Supplies the application's default query name to a route with no explicit one."},"760":{"id":"/docs/atomic-angular/integration/interceptors","page_id":"/docs/atomic-angular/integration/interceptors","type":"page","content":"Cross-cutting interceptors","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/interceptors"},"761":{"id":"/docs/atomic-angular/integration/interceptors-0","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors","content":"Three Angular HttpInterceptorFn covering requests the atomic client never sees — the ui-language body field, audit metadata, and 401 recovery on the HttpClient channel."},"762":{"id":"/docs/atomic-angular/integration/interceptors-1","page_id":"/docs/atomic-angular/integration/interceptors","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/interceptors#minimal-example","content":"Minimal example"},"763":{"id":"/docs/atomic-angular/integration/interceptors-2","page_id":"/docs/atomic-angular/integration/interceptors","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/interceptors#how-it-works","content":"How it works"},"764":{"id":"/docs/atomic-angular/integration/interceptors-3","page_id":"/docs/atomic-angular/integration/interceptors","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/interceptors#bodyinterceptorfn--the-interface-language","content":"`bodyInterceptorFn` — the interface language"},"765":{"id":"/docs/atomic-angular/integration/interceptors-4","page_id":"/docs/atomic-angular/integration/interceptors","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/interceptors#errorinterceptorfn--401-recovery","content":"`errorInterceptorFn` — 401 recovery"},"766":{"id":"/docs/atomic-angular/integration/interceptors-5","page_id":"/docs/atomic-angular/integration/interceptors","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/interceptors#auditinterceptorfn--audit-metadata","content":"`auditInterceptorFn` — audit metadata"},"767":{"id":"/docs/atomic-angular/integration/interceptors-6","page_id":"/docs/atomic-angular/integration/interceptors","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/interceptors#pitfalls","content":"Pitfalls"},"768":{"id":"/docs/atomic-angular/integration/interceptors-7","page_id":"/docs/atomic-angular/integration/interceptors","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/interceptors#whats-next","content":"What's next"},"769":{"id":"/docs/atomic-angular/integration/interceptors-8","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors","content":"The `@sinequa/atomic` client covers its own requests directly — the interface language, audit metadata and\n401 recovery are all built into it. These three interceptors give the same coverage to requests that never go\nthrough the client at all: `@sinequa/agent`, `@sinequa/assistant`, or your own code built on Angular's\n`HttpClient`."},"770":{"id":"/docs/atomic-angular/integration/interceptors-9","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors","content":"A request either goes through the atomic client (which handles it directly) or through `HttpClient` (which\nthese interceptors cover) — never both. Registering the client's own handling *and* these interceptors is\ntherefore correct, not a duplicate."},"771":{"id":"/docs/atomic-angular/integration/interceptors-10","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors#bodyinterceptorfn--the-interface-language","content":"Adds the current interface language to the request body as `ui-language`, read fresh from `TranslocoService`\non **every** request rather than captured once — the language changes while the application runs (the user\nmenus and the user-profile form call `setActiveLang`), and a request must carry the one in force when it is\nsent. `FormData` bodies get the field appended directly; a plain object body is cloned with the field added.\n`GET`/`HEAD` requests pass through untouched — they carry no body with the `fetch` backend."},"772":{"id":"/docs/atomic-angular/integration/interceptors-11","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors#errorinterceptorfn--401-recovery","content":"Same recovery as the client's own `recoverFromUnauthorized` hook (see Bootstrap the\napplication), on the `HttpClient` channel: on a `401`, call `signIn()`, and retry the\noriginal request **once** — only if `signIn()` reports the user is authenticated. A `403` is propagated as a\npermanent auth failure, never retried."},"773":{"id":"/docs/atomic-angular/integration/interceptors-12","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors#auditinterceptorfn--audit-metadata","content":"Adds Sinequa's audit metadata to a request body, for any request whose URL contains `api/v1` and whose body is\nJSON-serializable (skipped for `HttpParams` bodies). The `@sinequa/atomic` API functions already add this to\ntheir own requests; this covers the ones built directly on `HttpClient`."},"774":{"id":"/docs/atomic-angular/integration/interceptors-13","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors#pitfalls","content":"`errorInterceptorFn` retries **at most once per request**, tracked through an `HttpContextToken`\n(`AUTH_RETRIED`) carried on the request itself (never sent to the server). A second `401` on the retried\nrequest propagates instead of triggering another `signIn()`. Without this guard, an endpoint that keeps\nrejecting even after a successful re-authentication would re-trigger sign-in on every response, forever."},"775":{"id":"/docs/atomic-angular/integration/interceptors-14","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors#pitfalls","content":"It cannot, and does not try to — `bodyInterceptorFn` reads `TranslocoService.getActiveLang()` at the moment\neach request is dispatched, not when the interceptor is registered. A request already in flight when the\nlanguage changes keeps the language it was sent with; the next request picks up the new one."},"776":{"id":"/docs/atomic-angular/integration/interceptors-15","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors#whats-next","content":"The same 401 recovery, wired to the atomic client's own requests."},"777":{"id":"/docs/atomic-angular/integration/interceptors-16","page_id":"/docs/atomic-angular/integration/interceptors","tags":[],"type":"text","url":"/docs/atomic-angular/integration/interceptors#whats-next","content":"Pipes that follow the same interface-language changes on the display side."},"778":{"id":"/docs/atomic-angular/integration/pipes","page_id":"/docs/atomic-angular/integration/pipes","type":"page","content":"Cross-cutting pipes","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/pipes"},"779":{"id":"/docs/atomic-angular/integration/pipes-0","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes","content":"Six template pipes with no search-specific meaning of their own — legacy filter display, a translated system string, locale-aware dates, file sizes, and search-term highlighting."},"780":{"id":"/docs/atomic-angular/integration/pipes-1","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#highlightword--mark-a-search-term-inside-text","content":"`highlightWord` — mark a search term inside text"},"781":{"id":"/docs/atomic-angular/integration/pipes-2","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#syslang--a-translated-system-string","content":"`syslang` — a translated system string"},"782":{"id":"/docs/atomic-angular/integration/pipes-3","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#translocodate--a-locale-aware-datepipe","content":"`translocoDate` — a locale-aware `DatePipe`"},"783":{"id":"/docs/atomic-angular/integration/pipes-4","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#filesize--bytes-to-a-unit-and-a-magnitude","content":"`fileSize` — bytes to a unit and a magnitude"},"784":{"id":"/docs/atomic-angular/integration/pipes-5","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#operator--a-legacy-filter-as-a-comparison-string","content":"`operator` — a legacy filter as a comparison string"},"785":{"id":"/docs/atomic-angular/integration/pipes-6","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#options","content":"Options"},"786":{"id":"/docs/atomic-angular/integration/pipes-7","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#pitfalls","content":"Pitfalls"},"787":{"id":"/docs/atomic-angular/integration/pipes-8","page_id":"/docs/atomic-angular/integration/pipes","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/pipes#whats-next","content":"What's next"},"788":{"id":"/docs/atomic-angular/integration/pipes-9","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes","content":"None of these pipes know anything about a query or a result — they format a value for display, and are useful\nanywhere in an application, not only in a search screen."},"789":{"id":"/docs/atomic-angular/integration/pipes-10","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#highlightword--mark-a-search-term-inside-text","content":"Returns an array of `HighlightWords.Chunk` (from the `highlight-words` package), not a string — render each\nchunk yourself, styling the ones with `match: true`. Matching is accent-insensitive on both sides (`café`\nhighlights on a search for `cafe`), since both the text and the query are Unicode-normalized and stripped of\ncombining diacritics before comparing."},"790":{"id":"/docs/atomic-angular/integration/pipes-11","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#syslang--a-translated-system-string","content":"A compatibility bridge for a legacy `Text[lang]Translation` syntax that predates Angular i18n — most\napplications never author strings in this format themselves, but the server still returns some. Impure by\ndesign: it re-evaluates on every `TranslocoService.langChanges$` emission, not only on a new input value, so a\nlabel already on screen updates when the user switches language without any component code reacting to it."},"791":{"id":"/docs/atomic-angular/integration/pipes-12","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#translocodate--a-locale-aware-datepipe","content":"Extends Angular's own `DatePipe`, passing `TranslocoService`'s current language as the `locale` argument on\nevery transform — the format string (`'mediumDate'`, `'short'`, …) is Angular's own, only the locale follows\nthe interface language automatically instead of the app's static `LOCALE_ID`."},"792":{"id":"/docs/atomic-angular/integration/pipes-13","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#filesize--bytes-to-a-unit-and-a-magnitude","content":"Returns `{ key: string; value: number }` — a translation key (`memorySize.kb`, `.mb`, `.gb`, `.tb`, `.pb`, or\n`memorySize.bytes` below 1 KB) and the numeric magnitude in that unit, **not** a formatted string. Your\napplication's translation catalog must define those keys; pass `value` through a number pipe and `key` through\nyour own translation pipe separately."},"793":{"id":"/docs/atomic-angular/integration/pipes-14","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#operator--a-legacy-filter-as-a-comparison-string","content":"Takes a `LegacyFilter` (from `@sinequa/atomic`) and renders it as a human-readable comparison, using the\ninterface language's date formatting for any date-valued operand. `between` and an `and` of `gte`/`lte`\ncollapse into one range string; every other operator renders as its symbol (`=`, `≠`, `<`, `≤`, `>`, `≥`)\nfollowed by the value."},"794":{"id":"/docs/atomic-angular/integration/pipes-15","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#options","content":"<TypeTable\n  type=\"{\n  &#x22;highlightWord: (word: string, clipBy?: number)&#x22;: {\n    type: &#x22;HighlightWords.Chunk[]&#x22;,\n    description: &#x22;word to highlight, clipBy optionally limits the returned text's length.&#x22;,\n  },\n  &#x22;syslang: (lang?: string)&#x22;: {\n    type: &#x22;string | null&#x22;,\n    description: &#x22;lang forces a language regardless of the current interface language.&#x22;,\n  },\n  &#x22;translocoDate: (format?: string, timezone?: string)&#x22;: {\n    type: &#x22;string | null&#x22;,\n    description: &#x22;Same signature as Angular's DatePipe — format defaults to DatePipe's own default.&#x22;,\n  },\n  fileSize: {\n    type: &#x22;{ key: string; value: number }&#x22;,\n    description: &#x22;No arguments. key is one of memorySize.{bytes,kb,mb,gb,tb,pb} — your app must translate it.&#x22;,\n  },\n  operator: {\n    type: &#x22;string&#x22;,\n    description: &#x22;No arguments beyond the LegacyFilter itself.&#x22;,\n  },\n}\"\n/>"},"795":{"id":"/docs/atomic-angular/integration/pipes-16","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#pitfalls","content":"`{{ value | fileSize }}` alone stringifies the returned `{ key, value }` object. Read `.value` and `.key`\nseparately — see the recipe above — and translate `.key` through your application's own translation pipe."},"796":{"id":"/docs/atomic-angular/integration/pipes-17","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#pitfalls","content":"Check the pipe is not being called from a template expression Angular has cached as pure — these four are all\ndeclared `pure: false` specifically so they re-run on every change-detection pass and pick up\n`TranslocoService.langChanges$`. If the surrounding component uses `OnPush` and never triggers change detection\non a language change on its own, nothing re-evaluates any pipe, pure or not; `bootstrapApp` and the request-body\ninterceptor already trigger enough application-wide activity that this is rarely the actual cause in practice."},"797":{"id":"/docs/atomic-angular/integration/pipes-18","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#pitfalls","content":"`SourceIconPipe` is `@deprecated` and kept only for backward compatibility — it returns a `fa-*` class string\nlooked up against `AppStore.sources()`, a workplace-search-only shape most applications' custom JSON does not\npopulate, in which case it silently falls back to `\"far fa-file\"`. Do not reach for it in new code; prefer a\nsource-specific icon resolved from the document's own metadata instead."},"798":{"id":"/docs/atomic-angular/integration/pipes-19","page_id":"/docs/atomic-angular/integration/pipes","tags":[],"type":"text","url":"/docs/atomic-angular/integration/pipes#whats-next","content":"The request-side counterpart — the interface language sent with every request body."},"799":{"id":"/docs/atomic-angular/integration/query-name-resolver","page_id":"/docs/atomic-angular/integration/query-name-resolver","type":"page","content":"Default query name resolver","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/query-name-resolver"},"800":{"id":"/docs/atomic-angular/integration/query-name-resolver-0","page_id":"/docs/atomic-angular/integration/query-name-resolver","tags":[],"type":"text","url":"/docs/atomic-angular/integration/query-name-resolver","content":"An Angular route resolver that supplies the application's default query name to a route with no explicit one."},"801":{"id":"/docs/atomic-angular/integration/query-name-resolver-1","page_id":"/docs/atomic-angular/integration/query-name-resolver","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/query-name-resolver#pitfalls","content":"Pitfalls"},"802":{"id":"/docs/atomic-angular/integration/query-name-resolver-2","page_id":"/docs/atomic-angular/integration/query-name-resolver","tags":[],"type":"text","url":"/docs/atomic-angular/integration/query-name-resolver","content":"`queryNameResolver` reads `AppStore.getDefaultQuery()` and resolves to its `name`, or an empty string if the\napplication has no default query configured yet — it never throws, so a route that resolves it does not need\nto guard against a missing application configuration on its own."},"803":{"id":"/docs/atomic-angular/integration/query-name-resolver-3","page_id":"/docs/atomic-angular/integration/query-name-resolver","tags":[],"type":"text","url":"/docs/atomic-angular/integration/query-name-resolver#pitfalls","content":"`AppStore` must already be initialized (`AppStore.initialize()`, which `bootstrapApp`/`ApplicationService`\ncall) before this resolver runs, or `getDefaultQuery()` has nothing to read yet. A route protected by\n`AuthGuard` and reached only after bootstrap completes does not hit this; a resolver\nregistered on a route that can be reached before bootstrap finishes can."},"804":{"id":"/docs/atomic-angular/integration/services","page_id":"/docs/atomic-angular/integration/services","type":"page","content":"Cross-cutting services","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/services"},"805":{"id":"/docs/atomic-angular/integration/services-0","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services","content":"Registering your own route components, sending custom audit events, calling a JsonMethod plugin, and reading the route the user navigated away from."},"806":{"id":"/docs/atomic-angular/integration/services-1","page_id":"/docs/atomic-angular/integration/services","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/services#route_components--registering-components-for-dynamic-routes","content":"`ROUTE_COMPONENTS` — registering components for dynamic routes"},"807":{"id":"/docs/atomic-angular/integration/services-2","page_id":"/docs/atomic-angular/integration/services","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/services#auditservice--sending-audit-events-by-hand","content":"`AuditService` — sending audit events by hand"},"808":{"id":"/docs/atomic-angular/integration/services-3","page_id":"/docs/atomic-angular/integration/services","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/services#jsonmethodpluginservice--calling-a-jsonmethod-plugin","content":"`JsonMethodPluginService` — calling a JsonMethod plugin"},"809":{"id":"/docs/atomic-angular/integration/services-4","page_id":"/docs/atomic-angular/integration/services","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/services#navigationservice--the-url-to-return-to-after-sign-in","content":"`NavigationService` — the URL to return to after sign-in"},"810":{"id":"/docs/atomic-angular/integration/services-5","page_id":"/docs/atomic-angular/integration/services","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/services#options","content":"Options"},"811":{"id":"/docs/atomic-angular/integration/services-6","page_id":"/docs/atomic-angular/integration/services","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/services#pitfalls","content":"Pitfalls"},"812":{"id":"/docs/atomic-angular/integration/services-7","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services#route_components--registering-components-for-dynamic-routes","content":"`ApplicationService` (injected internally by `bootstrapApp` when `createRoutes: true`)\nreads this token to know which component renders each tab of the query's `tabSearch` configuration, and which\none is the root layout (`isRoot: true`) wrapping the whole `search` route."},"813":{"id":"/docs/atomic-angular/integration/services-8","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services#auditservice--sending-audit-events-by-hand","content":"`notifyDocument(type, doc, resultOrId, parameters?, rfmParameters?)` is the one most applications reach for\ndirectly — it also listens for the tab losing and regaining visibility right after the call, to notify a\n`Navigation_Return` event if the user opened the document and came back within a second. `notify()` is a no-op\nwhile the client reports no session (`client.auth.isAuthenticated()` is false)."},"814":{"id":"/docs/atomic-angular/integration/services-9","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services#jsonmethodpluginservice--calling-a-jsonmethod-plugin","content":"`post`/`get` both call the client's own `http` transport (`plugin/<method>`) rather than Angular's\n`HttpClient` — a plugin call issued this way is already covered by the client's own request/response handling\n(interface language, audit metadata, 401 recovery), with nothing further to register."},"815":{"id":"/docs/atomic-angular/integration/services-10","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services#navigationservice--the-url-to-return-to-after-sign-in","content":"`navigationEnd$` is the lower-level piece underneath it — an `Observable<NavigationEnd>` that also notifies\n`AuditService.notifyRouteChange()` once per distinct route (query-parameter-only changes on the same route,\nwhich make up most of a search session, do not re-notify)."},"816":{"id":"/docs/atomic-angular/integration/services-11","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services#options","content":"<TypeTable\n  type=\"{\n  ROUTE_COMPONENTS: {\n    type: &#x22;InjectionToken<ComponentMapping[]>&#x22;,\n    description: 'ComponentMapping = { path: string; component: Type<unknown>; isRoot?: boolean }. Defaults to [].',\n  },\n  &#x22;AuditService.notify(event)&#x22;: { type: &#x22;(event: AuditEvents) => void&#x22;, description: &#x22;The low-level call every other method funnels through.&#x22; },\n  &#x22;AuditService.notifyDocument(...)&#x22;: { type: &#x22;(type, doc, resultOrId, parameters?, rfmParameters?) => void&#x22;, description: &#x22;The one most applications call directly.&#x22; },\n  &#x22;JsonMethodPluginService.post/get&#x22;: { type: &#x22;(method: string, query, options?) => Observable<any>&#x22;, description: &#x22;options is @sinequa/atomic's RequestOptions, not HttpClient's.&#x22; },\n  &#x22;NavigationService.urlAfterNavigation&#x22;: { type: &#x22;string | null&#x22;, description: &#x22;null while the current route is an authentication screen.&#x22; },\n  &#x22;NavigationService.navigationEnd$&#x22;: { type: &#x22;Observable<RouterEvent>&#x22;, description: &#x22;Deduped per distinct route, shareReplay(1).&#x22; },\n}\"\n/>"},"817":{"id":"/docs/atomic-angular/integration/services-12","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services#pitfalls","content":"Check its `path` was actually registered on `ROUTE_COMPONENTS` — `ApplicationService.createRoutes()` falls back\nsilently to the layout component (`isRoot: true`) for any tab whose path has no matching entry, which reads as\nthe wrong content rather than an error."},"818":{"id":"/docs/atomic-angular/integration/services-13","page_id":"/docs/atomic-angular/integration/services","tags":[],"type":"text","url":"/docs/atomic-angular/integration/services#pitfalls","content":"Both live under `services/deprecated/` now — `AppService` and `PrincipalService` are superseded by\n`AppStore`/`PrincipalStore` (the `@ngrx/signals` stores, exported from the same barrel). New code should inject\nthe store directly; the deprecated services are kept only for applications not yet migrated."},"819":{"id":"/docs/atomic-angular/integration/utils","page_id":"/docs/atomic-angular/integration/utils","type":"page","content":"Cross-cutting utilities","breadcrumbs":["Docs","Atomic Angular","Integration"],"tags":[],"url":"/docs/atomic-angular/integration/utils"},"820":{"id":"/docs/atomic-angular/integration/utils-0","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils","content":"Loose functions with no search-specific meaning — building a query from the current route, reading route metadata, running code in a Web Worker, and a fetch wrapper with baseline error handling."},"821":{"id":"/docs/atomic-angular/integration/utils-1","page_id":"/docs/atomic-angular/integration/utils","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/utils#buildquery--getquerynamefromroute--a-query-from-the-current-route","content":"`buildQuery` / `getQueryNameFromRoute` — a query from the current route"},"822":{"id":"/docs/atomic-angular/integration/utils-2","page_id":"/docs/atomic-angular/integration/utils","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/utils#getcurrentpath--getcurrentqueryname--reading-route-metadata","content":"`getCurrentPath` / `getCurrentQueryName` — reading route metadata"},"823":{"id":"/docs/atomic-angular/integration/utils-3","page_id":"/docs/atomic-angular/integration/utils","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/utils#inlineworker--running-a-function-in-a-web-worker","content":"`InlineWorker` — running a function in a Web Worker"},"824":{"id":"/docs/atomic-angular/integration/utils-4","page_id":"/docs/atomic-angular/integration/utils","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/utils#withfetch--a-fetch-wrapper-with-baseline-error-handling","content":"`withFetch` — a fetch wrapper with baseline error handling"},"825":{"id":"/docs/atomic-angular/integration/utils-5","page_id":"/docs/atomic-angular/integration/utils","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/utils#options","content":"Options"},"826":{"id":"/docs/atomic-angular/integration/utils-6","page_id":"/docs/atomic-angular/integration/utils","type":"heading","tags":[],"url":"/docs/atomic-angular/integration/utils#pitfalls","content":"Pitfalls"},"827":{"id":"/docs/atomic-angular/integration/utils-7","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#buildquery--getquerynamefromroute--a-query-from-the-current-route","content":"`buildQuery(partial)` resolves the query's `name` by checking, in order: `partial.name`,\n`getQueryNameFromRoute()` (the active route's `queryName` route data, or the current tab's `t` query\nparameter matched against the app's `search` route children), then the URL's own stored parameters — and\nmerges everything else from the URL underneath your `partial`. Both must run inside an injection context."},"828":{"id":"/docs/atomic-angular/integration/utils-8","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#getcurrentpath--getcurrentqueryname--reading-route-metadata","content":"Distinct from `getQueryNameFromRoute()` above: this one matches the current URL **path** against the static\n`Router.config`, rather than walking the live `ActivatedRoute` tree — useful outside a component that has an\ninjected `ActivatedRoute` of its own."},"829":{"id":"/docs/atomic-angular/integration/utils-9","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#inlineworker--running-a-function-in-a-web-worker","content":"`onmessage()`/`onerror()` return RxJS `Observable`s rather than plain callbacks. Throws synchronously if\n`Worker` is unavailable in the current environment (a non-browser SSR context, most often)."},"830":{"id":"/docs/atomic-angular/integration/utils-10","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#withfetch--a-fetch-wrapper-with-baseline-error-handling","content":"Catches the callback's rejection and logs it; on a `401` it also shows a warning toast and, if an `injector`\nwas passed, re-triggers the sign-in flow. Returns `undefined` on any error rather than rethrowing — check for\n`undefined` at the call site instead of wrapping the call in `try`/`catch`."},"831":{"id":"/docs/atomic-angular/integration/utils-11","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#options","content":"<TypeTable\n  type=\"{\n  &#x22;buildQuery(partial?)&#x22;: { type: &#x22;Partial<Query>&#x22;, description: &#x22;Merges URL params, route queryName, and partial into a complete Query.&#x22; },\n  &#x22;getQueryNameFromRoute()&#x22;: { type: &#x22;() => string | undefined&#x22;, description: &#x22;Walks the live ActivatedRoute tree for a queryName.&#x22; },\n  &#x22;getCurrentPath()&#x22;: { type: &#x22;() => string | undefined&#x22;, description: &#x22;The current ActivatedRoute snapshot's URL segments, joined.&#x22; },\n  &#x22;getCurrentQueryName()&#x22;: { type: &#x22;() => string | undefined&#x22;, description: &#x22;Matches the current path against the static Router.config.&#x22; },\n  &#x22;new InlineWorker(fn)&#x22;: { type: &#x22;(fn: () => void) => InlineWorker&#x22;, description: &#x22;fn's body becomes the whole worker script — no closures.&#x22; },\n  &#x22;withFetch(callback, injector?)&#x22;: { type: &#x22;(() => Promise<T>, injector?) => Promise<T | undefined>&#x22;, description: &#x22;undefined on any error; injector enables 401 → sign-in.&#x22; },\n}\"\n/>"},"832":{"id":"/docs/atomic-angular/integration/utils-12","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#pitfalls","content":"The worker function's body is extracted by calling `.toString()` on it and stripping the outer `function(){ }`\nwrapper — it never actually closes over the surrounding scope, so any reference to a variable, import, or\n`this` from outside the function is simply undefined inside the worker. Write the worker function as fully\nself-contained, using only what a Web Worker's global scope (`self`, `postMessage`) provides."},"833":{"id":"/docs/atomic-angular/integration/utils-13","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#pitfalls","content":"By design — it returns `undefined` on every error path rather than rethrowing, logging the error instead (plus\na toast on `401`). If the caller needs to distinguish failure from a legitimately empty result, call the\nunderlying `fetch`/API function directly and handle the rejection yourself instead of wrapping it in\n`withFetch`."},"834":{"id":"/docs/atomic-angular/integration/utils-14","page_id":"/docs/atomic-angular/integration/utils","tags":[],"type":"text","url":"/docs/atomic-angular/integration/utils#pitfalls","content":"`debouncedSignal` is `@deprecated` — Angular's own `debounced()` (`@angular/core`, experimental since v22)\ncovers the same need natively. It returns a `Resource<T>`, not a plain `Signal<T>`: read the debounced value\nthrough `.value()` rather than calling it directly."},"835":{"id":"/docs/atomic-angular/preview/child-marker","page_id":"/docs/atomic-angular/preview/child-marker","type":"page","content":"ChildMarker","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/child-marker"},"836":{"id":"/docs/atomic-angular/preview/child-marker-0","page_id":"/docs/atomic-angular/preview/child-marker","tags":[],"type":"text","url":"/docs/atomic-angular/preview/child-marker","content":"Mark a projected <ng-template> so a parent component can discover and render it dynamically, for structural composition patterns like a @for loop over projected children."},"837":{"id":"/docs/atomic-angular/preview/child-marker-1","page_id":"/docs/atomic-angular/preview/child-marker","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/child-marker#minimal-example","content":"Minimal example"},"838":{"id":"/docs/atomic-angular/preview/child-marker-2","page_id":"/docs/atomic-angular/preview/child-marker","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/child-marker#options","content":"Options"},"839":{"id":"/docs/atomic-angular/preview/child-marker-3","page_id":"/docs/atomic-angular/preview/child-marker","tags":[],"type":"text","url":"/docs/atomic-angular/preview/child-marker","content":"`[childMarker]` marks a projected `<ng-template>` and exposes its `TemplateRef` publicly, so the parent\ncomponent that receives it (typically through `contentChildren`) can render it wherever and however many times\nit needs to — a `@for` loop being the common case."},"840":{"id":"/docs/atomic-angular/preview/child-marker-4","page_id":"/docs/atomic-angular/preview/child-marker","tags":[],"type":"text","url":"/docs/atomic-angular/preview/child-marker#options","content":"<TypeTable\n  type=\"{\n  template: { type: &#x22;TemplateRef<unknown>&#x22;, description: &#x22;The marked element's TemplateRef, injected and exposed for the parent to render.&#x22; },\n}\"\n/>"},"841":{"id":"/docs/atomic-angular/preview/child-marker-5","page_id":"/docs/atomic-angular/preview/child-marker","tags":[],"type":"text","url":"/docs/atomic-angular/preview/child-marker#options","content":"This directive has no inputs of its own and no outputs — it exists purely to expose `template` to a querying\nparent."},"842":{"id":"/docs/atomic-angular/preview","page_id":"/docs/atomic-angular/preview","type":"page","content":"Preview","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview"},"843":{"id":"/docs/atomic-angular/preview-0","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview","content":"Rendering a document's converted preview — the iframe surface, its toolbar, a metadata header, and the directives that open or select an article into it."},"844":{"id":"/docs/atomic-angular/preview-1","page_id":"/docs/atomic-angular/preview","type":"heading","tags":[],"url":"/docs/atomic-angular/preview#whats-next","content":"What's next"},"845":{"id":"/docs/atomic-angular/preview-2","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview","content":"Everything involved in showing a document once it has been selected: the preview surface itself (an iframe, or\na Markdown fallback), the toolbar overlaid on it (zoom, search-in-document, highlights, converter choice), a\nprojectable metadata header, and the small directives that turn a click or a keypress into a selection."},"846":{"id":"/docs/atomic-angular/preview-3","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"The full preview surface — load, render, zoom, page, and fall back to Markdown when needed."},"847":{"id":"/docs/atomic-angular/preview-4","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"The toolbar nested inside it, usable standalone for a custom preview surface."},"848":{"id":"/docs/atomic-angular/preview-5","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"A collapsible metadata panel with caller-projected rows."},"849":{"id":"/docs/atomic-angular/preview-6","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"Fetch, close, zoom and paginate — the service every preview component delegates to."},"850":{"id":"/docs/atomic-angular/preview-7","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"Fetch surrounding-context text chunks for a set of highlight locations."},"851":{"id":"/docs/atomic-angular/preview-8","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"Select an article on click or Enter, with a choice of four strategies."},"852":{"id":"/docs/atomic-angular/preview-9","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"Open an article in a new tab on Ctrl+Enter."},"853":{"id":"/docs/atomic-angular/preview-10","page_id":"/docs/atomic-angular/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview#whats-next","content":"Mark a projected template for parent-controlled, repeatable rendering."},"854":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","type":"page","content":"OpenArticleOnCtrlEnter","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter"},"855":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-0","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","tags":[],"type":"text","url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","content":"Open an article in a new browser tab when the user presses Ctrl+Enter while the host element is focused."},"856":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-1","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter#minimal-example","content":"Minimal example"},"857":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-2","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter#options","content":"Options"},"858":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-3","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter#whats-next","content":"What's next"},"859":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-4","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","tags":[],"type":"text","url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","content":"`[openArticleOnCtrlEnter]` opens an article's preview in a new browser tab when the user presses **Ctrl+Enter**\nwhile the host element is focused — the same \"open in background tab\" gesture browsers already give search\nresult links."},"860":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-5","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","tags":[],"type":"text","url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter#minimal-example","content":"The host element needs to be focusable (a `tabindex`, or a naturally focusable element) for the keydown to\never reach it."},"861":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-6","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","tags":[],"type":"text","url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter#options","content":"<TypeTable\n  type=\"{\n  article: { type: &#x22;Article | undefined&#x22;, description: &#x22;Required. The article to open externally on Ctrl+Enter.&#x22; },\n}\"\n/>"},"862":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-7","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","tags":[],"type":"text","url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter#options","content":"This directive has no outputs — opening happens as a side effect through the injected `PreviewService`."},"863":{"id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter-8","page_id":"/docs/atomic-angular/preview/open-article-on-ctrl-enter","tags":[],"type":"text","url":"/docs/atomic-angular/preview/open-article-on-ctrl-enter#whats-next","content":"The plain-click/Enter counterpart, for selecting rather than opening externally."},"864":{"id":"/docs/atomic-angular/preview/preview-actions","page_id":"/docs/atomic-angular/preview/preview-actions","type":"page","content":"Preview Actions","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/preview-actions"},"865":{"id":"/docs/atomic-angular/preview/preview-actions-0","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions","content":"The toolbar overlaid on a document preview — a converter dropdown, zoom controls, search-in-document, and a highlights popover — plus a slot for app-specific actions."},"866":{"id":"/docs/atomic-angular/preview/preview-actions-1","page_id":"/docs/atomic-angular/preview/preview-actions","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-actions#minimal-example","content":"Minimal example"},"867":{"id":"/docs/atomic-angular/preview/preview-actions-2","page_id":"/docs/atomic-angular/preview/preview-actions","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-actions#recipes","content":"Recipes"},"868":{"id":"/docs/atomic-angular/preview/preview-actions-3","page_id":"/docs/atomic-angular/preview/preview-actions","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-actions#add-an-app-specific-action","content":"Add an app-specific action"},"869":{"id":"/docs/atomic-angular/preview/preview-actions-4","page_id":"/docs/atomic-angular/preview/preview-actions","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-actions#options","content":"Options"},"870":{"id":"/docs/atomic-angular/preview/preview-actions-5","page_id":"/docs/atomic-angular/preview/preview-actions","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-actions#pitfalls","content":"Pitfalls"},"871":{"id":"/docs/atomic-angular/preview/preview-actions-6","page_id":"/docs/atomic-angular/preview/preview-actions","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-actions#whats-next","content":"What's next"},"872":{"id":"/docs/atomic-angular/preview/preview-actions-7","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions","content":"`<preview-actions>` is the floating toolbar `<preview-content>` overlays on its iframe: a converter dropdown,\nzoom fit/in/out, a search-in-document popover, and a highlights popover — everything a zoomable, searchable\n`PreviewService` needs, collapsed behind a `<floating-toolbar>` trigger."},"873":{"id":"/docs/atomic-angular/preview/preview-actions-8","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#minimal-example","content":"Every action here reads `previewData` and calls straight into the injected `PreviewService` — nothing about\nzoom or highlights needs wiring beyond passing the loaded data in. `<preview-content>` already does this for\nyou; use `<preview-actions>` directly only when building a preview surface of your own."},"874":{"id":"/docs/atomic-angular/preview/preview-actions-9","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#add-an-app-specific-action","content":"The built-in actions (converter, zoom, search, highlights) are generic to any preview — anything app-specific,\nlike an AI-description toggle, is projected into the `extra-actions` slot instead of being hard-coded here."},"875":{"id":"/docs/atomic-angular/preview/preview-actions-10","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#options","content":"<TypeTable\n  type=\"{\n  previewData: { type: &#x22;PreviewData | undefined&#x22;, description: &#x22;Forwarded to the converter dropdown and the highlights popover.&#x22; },\n  activeConversion: {\n    type: &#x22;CConverter | undefined&#x22;,\n    description: &#x22;The conversion already active upstream, so the dropdown re-syncs its selection on remount instead of resetting to the first option.&#x22;,\n  },\n  showSearch: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;false hides the search-in-document trigger/popover entirely. Zoom and highlights stay unaffected.&#x22;,\n  },\n}\"\n/>"},"876":{"id":"/docs/atomic-angular/preview/preview-actions-11","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#options","content":"This component has one output, `onConversionSelect` (`OutputEmitterRef<CConverter | undefined>`), forwarding\nthe converter dropdown's pick."},"877":{"id":"/docs/atomic-angular/preview/preview-actions-12","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#pitfalls","content":"A bare `@if` around projected content does not carry the `slot` attribute the content projection matches on —\nwrap it in an `<ng-container slot=\"extra-actions\">` (as in the recipe above), not a bare `@if` directly around\nthe action."},"878":{"id":"/docs/atomic-angular/preview/preview-actions-13","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#pitfalls","content":"Both popovers are opened with `{ closeOnClick: false }` deliberately — they host repeated interaction (typing\na search, clicking prev/next through entity occurrences), and a popover that closed on its first inner click\nwould make that unusable. If you build a similar popover yourself, remember the option; the default closes on\nany click inside."},"879":{"id":"/docs/atomic-angular/preview/preview-actions-14","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#whats-next","content":"The full preview surface this toolbar is normally nested inside."},"880":{"id":"/docs/atomic-angular/preview/preview-actions-15","page_id":"/docs/atomic-angular/preview/preview-actions","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-actions#whats-next","content":"The service every action here delegates to."},"881":{"id":"/docs/atomic-angular/preview/preview-content","page_id":"/docs/atomic-angular/preview/preview-content","type":"page","content":"Preview Content","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/preview-content"},"882":{"id":"/docs/atomic-angular/preview/preview-content-0","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content","content":"Render a document's converted preview in an iframe — with zoom, search-in-document, highlights, an AI-description toggle, and a Markdown fallback — from a single drop-in component."},"883":{"id":"/docs/atomic-angular/preview/preview-content-1","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#minimal-example","content":"Minimal example"},"884":{"id":"/docs/atomic-angular/preview/preview-content-2","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#how-it-works","content":"How it works"},"885":{"id":"/docs/atomic-angular/preview/preview-content-3","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#recipes","content":"Recipes"},"886":{"id":"/docs/atomic-angular/preview/preview-content-4","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#hide-search-in-document-in-a-narrow-host","content":"Hide search-in-document in a narrow host"},"887":{"id":"/docs/atomic-angular/preview/preview-content-5","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#mirror-the-active-conversion-in-a-parent-badge","content":"Mirror the active conversion in a parent badge"},"888":{"id":"/docs/atomic-angular/preview/preview-content-6","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#options","content":"Options"},"889":{"id":"/docs/atomic-angular/preview/preview-content-7","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#outputs","content":"Outputs"},"890":{"id":"/docs/atomic-angular/preview/preview-content-8","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#pitfalls","content":"Pitfalls"},"891":{"id":"/docs/atomic-angular/preview/preview-content-9","page_id":"/docs/atomic-angular/preview/preview-content","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-content#whats-next","content":"What's next"},"892":{"id":"/docs/atomic-angular/preview/preview-content-10","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content","content":"`<preview-content>` is the whole document preview surface: it loads the previewed document, picks the right\nrendering path (a converted-document iframe, or a Markdown fallback when no conversion is available), and\nlayers the toolbar (`<preview-actions>`) and page navigator (`<preview-navigator>`) on top."},"893":{"id":"/docs/atomic-angular/preview/preview-content-11","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content","content":"A Sinequa index can store more than one rendered form of a document — its **conversions** (a PDF-like page\nimage, a Markdown extraction, a multi-format bundle). `<preview-content>` resolves which conversion is active\nand swaps its whole rendering strategy (iframe vs. Markdown) based on it — this is not a cosmetic detail, the\nmarkdown branch skips the iframe and `<preview-actions>`'s search/highlights entirely."},"894":{"id":"/docs/atomic-angular/preview/preview-content-12","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#minimal-example","content":"Leave `article` unset to preview whatever the shared selection store currently holds — the common case when\n`<preview-content>` sits in a side panel or a route that reacts to document selection elsewhere on the page."},"895":{"id":"/docs/atomic-angular/preview/preview-content-13","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#how-it-works","content":"The iframe stays hidden behind a spinner overlay until it posts a `ready` message back (its own layout has\nsettled) — only then does the component scroll it to the requested page and reveal it, so the user never sees\nthe intermediate scroll jump. A `current-page` message keeps `<preview-navigator>` in sync as the user scrolls\nor pages manually inside the iframe."},"896":{"id":"/docs/atomic-angular/preview/preview-content-14","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#hide-search-in-document-in-a-narrow-host","content":"`showSearchActions` reaches all the way down to `<preview-actions>`'s own `showSearch` input — set it once here\nrather than wrapping the nested component yourself."},"897":{"id":"/docs/atomic-angular/preview/preview-content-15","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#mirror-the-active-conversion-in-a-parent-badge","content":"`onConversionSelect` fires whenever the active conversion changes (including the very first auto-selection),\nso a parent can mirror it without owning any conversion state of its own."},"898":{"id":"/docs/atomic-angular/preview/preview-content-16","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#options","content":"<TypeTable\n  type=\"{\n  article: {\n    type: &#x22;Article | undefined&#x22;,\n    description: &#x22;The document to preview. Left unset, falls back to the shared selection store's current article.&#x22;,\n  },\n  showSearchActions: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;Forwarded to preview-actions' showSearch — hides the search-in-document trigger/popover. Zoom and highlights stay unaffected.&#x22;,\n  },\n  class: { type: &#x22;string&#x22;, description: &#x22;Standard host class — the host itself carries display: block.&#x22; },\n}\"\n/>"},"899":{"id":"/docs/atomic-angular/preview/preview-content-17","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#outputs","content":"<TypeTable\n  type=\"{\n  onLoadedData: { type: &#x22;OutputEmitterRef<PreviewData | undefined>&#x22;, description: &#x22;Emits once the preview data has loaded (or failed, as undefined).&#x22; },\n  onConversionSelect: { type: &#x22;OutputEmitterRef<CConverter | undefined>&#x22;, description: &#x22;Mirrors the conversion selected inside preview-actions' converter dropdown.&#x22; },\n}\"\n/>"},"900":{"id":"/docs/atomic-angular/preview/preview-content-18","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#pitfalls","content":"Unlike what an older revision of this documentation claimed, `<preview-content>` has no `conversion` input.\nThe active conversion is picked internally — auto-selected on load (defaults and primaries sorted first), then\noverridden once the user picks one in `<preview-actions>`'s converter dropdown, which lives several levels\ndown inside this component. Read it back through `(onConversionSelect)` if a parent needs to display it;\nnothing feeds a value back in."},"901":{"id":"/docs/atomic-angular/preview/preview-content-19","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#pitfalls","content":"The preview resolves its query name from `?n=` in the URL, then from the route's data, then falls back to the\napp's default query — in that order. If your route shape does not carry a `wsName` where the library expects\nit, the preview silently asks the wrong (or no) web service for the document: the error interceptor\ndeliberately skips the toast for the preview endpoint, and the failure is swallowed to release the loading\nspinner. Check the current route's query name matches the tab actually being previewed."},"902":{"id":"/docs/atomic-angular/preview/preview-content-20","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#pitfalls","content":"It is not exposed as an input — it appears only when the currently active conversion is the **primary** one\n*and* the previewed article's own `flags` include `\"ps\"`. There is no way to force it on for a document that\ndoes not carry that flag."},"903":{"id":"/docs/atomic-angular/preview/preview-content-21","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#pitfalls","content":"Expected: the Markdown branch renders the raw content through the `markdown` pipe directly into a `<div>`, not\ninto `preview.js`'s instrumented iframe — so nothing there can `postMessage` a search or a highlight toggle.\nOnly the converter dropdown and a locally-reimplemented zoom (CSS `zoom`, not the iframe's transform-based one)\nsurvive on that branch."},"904":{"id":"/docs/atomic-angular/preview/preview-content-22","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#whats-next","content":"The toolbar nested inside — converter dropdown, zoom, search-in-document, highlights."},"905":{"id":"/docs/atomic-angular/preview/preview-content-23","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#whats-next","content":"A collapsible metadata panel to place above the preview."},"906":{"id":"/docs/atomic-angular/preview/preview-content-24","page_id":"/docs/atomic-angular/preview/preview-content","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-content#whats-next","content":"The service both components delegate to — fetch, close, zoom, pagination."},"907":{"id":"/docs/atomic-angular/preview/preview-header","page_id":"/docs/atomic-angular/preview/preview-header","type":"page","content":"Preview Header","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/preview-header"},"908":{"id":"/docs/atomic-angular/preview/preview-header-0","page_id":"/docs/atomic-angular/preview/preview-header","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-header","content":"A collapsible metadata panel for a document preview — you provide the rows, the component owns only the collapsible shell and their two-column (key | value) layout."},"909":{"id":"/docs/atomic-angular/preview/preview-header-1","page_id":"/docs/atomic-angular/preview/preview-header","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-header#minimal-example","content":"Minimal example"},"910":{"id":"/docs/atomic-angular/preview/preview-header-2","page_id":"/docs/atomic-angular/preview/preview-header","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-header#options","content":"Options"},"911":{"id":"/docs/atomic-angular/preview/preview-header-3","page_id":"/docs/atomic-angular/preview/preview-header","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-header#pitfalls","content":"Pitfalls"},"912":{"id":"/docs/atomic-angular/preview/preview-header-4","page_id":"/docs/atomic-angular/preview/preview-header","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview-header#whats-next","content":"What's next"},"913":{"id":"/docs/atomic-angular/preview/preview-header-5","page_id":"/docs/atomic-angular/preview/preview-header","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-header","content":"`<preview-header>` is a collapsible container for document-preview details: a title, a toggle chevron, and a\ntwo-column table (key | value) whose rows are entirely projected by the caller. It owns only the shell — which metadata fields to\nshow, and what renders them, is entirely up to the consuming app."},"914":{"id":"/docs/atomic-angular/preview/preview-header-6","page_id":"/docs/atomic-angular/preview/preview-header","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-header#minimal-example","content":"Two different host apps can project entirely different rows into the same `<preview-header>` — fewer fields,\nor app-specific ones — without forking the component. A conditional row is written with a plain `@if` around\nthe `<tr>`, same as any other content projection."},"915":{"id":"/docs/atomic-angular/preview/preview-header-7","page_id":"/docs/atomic-angular/preview/preview-header","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-header#options","content":"<TypeTable\n  type=\"{\n  title: { type: &#x22;string&#x22;, description: &#x22;Required. The document's title, shown in the always-visible summary.&#x22; },\n}\"\n/>"},"916":{"id":"/docs/atomic-angular/preview/preview-header-8","page_id":"/docs/atomic-angular/preview/preview-header","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-header#options","content":"This component has no outputs — it manages its own open/collapsed state internally (open by default)."},"917":{"id":"/docs/atomic-angular/preview/preview-header-9","page_id":"/docs/atomic-angular/preview/preview-header","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-header#pitfalls","content":"The table is a native two-column table: every projected `<tr>` must contain exactly one `<th>` (the key) and\none `<td>` (the value). A cell given a non-table `display` (for example `inline-flex` on the `<td>`) leaves the\ntable layout and is rendered as an extra anonymous cell. Put the layout on a `<div>` inside the `<td>` instead."},"918":{"id":"/docs/atomic-angular/preview/preview-header-10","page_id":"/docs/atomic-angular/preview/preview-header","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview-header#whats-next","content":"Where this header typically sits, above the iframe or Markdown fallback."},"919":{"id":"/docs/atomic-angular/preview/preview","page_id":"/docs/atomic-angular/preview/preview","type":"page","content":"Preview service","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/preview"},"920":{"id":"/docs/atomic-angular/preview/preview-0","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview","content":"Fetch a document's preview data, drive its zoom and pagination, and toggle its highlights — the service every preview component delegates to."},"921":{"id":"/docs/atomic-angular/preview/preview-1","page_id":"/docs/atomic-angular/preview/preview","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview#minimal-example","content":"Minimal example"},"922":{"id":"/docs/atomic-angular/preview/preview-2","page_id":"/docs/atomic-angular/preview/preview","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview#recipes","content":"Recipes"},"923":{"id":"/docs/atomic-angular/preview/preview-3","page_id":"/docs/atomic-angular/preview/preview","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview#paginate-a-multi-page-conversion","content":"Paginate a multi-page conversion"},"924":{"id":"/docs/atomic-angular/preview/preview-4","page_id":"/docs/atomic-angular/preview/preview","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview#options","content":"Options"},"925":{"id":"/docs/atomic-angular/preview/preview-5","page_id":"/docs/atomic-angular/preview/preview","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview#pitfalls","content":"Pitfalls"},"926":{"id":"/docs/atomic-angular/preview/preview-6","page_id":"/docs/atomic-angular/preview/preview","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/preview#whats-next","content":"What's next"},"927":{"id":"/docs/atomic-angular/preview/preview-7","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview","content":"`PreviewService` is what `<preview-content>` and `<preview-actions>` both delegate to: fetching the preview\ndata for a document, talking to the preview iframe through `postMessage`, and tracking zoom/page/highlight\nstate. Inject it directly only when building a preview surface that does not compose the existing components."},"928":{"id":"/docs/atomic-angular/preview/preview-8","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview#paginate-a-multi-page-conversion","content":"`gotoPage`/`nextPage`/`prevPage`/`firstPage`/`lastPage` all message the iframe directly; `currentPage` and\n`totalPages` are signals a toolbar can read to render page numbers."},"929":{"id":"/docs/atomic-angular/preview/preview-9","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview#options","content":"<TypeTable\n  type=\"{\n  &#x22;preview(id, q, customHighlights?, audit?)&#x22;: {\n    type: &#x22;(id: string, q: Partial<Query>, customHighlights?: CustomHighlights[], audit?: AuditEvents) => Observable<PreviewData>&#x22;,\n    description: &#x22;Fetches preview data for a document.&#x22;,\n  },\n  &#x22;close(id, query)&#x22;: { type: &#x22;(id: string, query: Partial<Query>) => void&#x22;, description: &#x22;Closes a preview and updates the audit log.&#x22; },\n  &#x22;openExternal(article)&#x22;: { type: &#x22;(article: Article) => void&#x22;, description: &#x22;Opens an article's preview in a new browser tab.&#x22; },\n  &#x22;zoomFit() · zoomIn() · zoomOut()&#x22;: { type: &#x22;() => void&#x22;, description: &#x22;Message the iframe to fit/zoom the current page.&#x22; },\n  &#x22;gotoPage(page) · nextPage() · prevPage() · firstPage() · lastPage()&#x22;: {\n    type: &#x22;(page?: number) => void&#x22;,\n    description: &#x22;Page navigation inside a multi-page conversion, driven through postMessage.&#x22;,\n  },\n  &#x22;toggle(extracts, entities)&#x22;: { type: &#x22;(extracts: boolean, entities: boolean) => void&#x22;, description: &#x22;Toggles extract and entity highlight categories in the preview.&#x22; },\n  &#x22;toggleAIDescription(enabled)&#x22;: { type: &#x22;(enabled: boolean) => void&#x22;, description: &#x22;Enables or disables the AI-generated page description overlay.&#x22; },\n  &#x22;totalPages · currentPage&#x22;: { type: &#x22;Signal<number>&#x22;, description: &#x22;Current pagination state, read-only from outside the service.&#x22; },\n}\"\n/>"},"930":{"id":"/docs/atomic-angular/preview/preview-10","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview#options","content":"Lower-level, for a custom preview surface: `setIframe(iframe)` registers the iframe window the service talks\nto; `setPreviewData(data)` updates the active highlight category from freshly-loaded data; `sendMessage(msg)`\nposts an arbitrary message; `retrieveHtmlContent(id, highlightCategory, previewData)` asks the iframe for a\nhighlight category's HTML."},"931":{"id":"/docs/atomic-angular/preview/preview-11","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview#pitfalls","content":"Every one of these methods `postMessage`s the iframe registered through `setIframe()` — `<preview-content>`\ndoes that registration for you once its own iframe mounts. Called before any iframe is registered (or while\nthe previous document's iframe is still tearing down), the message has nowhere to go and is silently dropped;\nthere is no queueing or replay."},"932":{"id":"/docs/atomic-angular/preview/preview-12","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview#whats-next","content":"The component that wires this service to a real iframe."},"933":{"id":"/docs/atomic-angular/preview/preview-13","page_id":"/docs/atomic-angular/preview/preview","tags":[],"type":"text","url":"/docs/atomic-angular/preview/preview#whats-next","content":"Fetch surrounding-context text chunks for a set of highlight locations."},"934":{"id":"/docs/atomic-angular/preview/select-article","page_id":"/docs/atomic-angular/preview/select-article","type":"page","content":"SelectArticle","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/select-article"},"935":{"id":"/docs/atomic-angular/preview/select-article-0","page_id":"/docs/atomic-angular/preview/select-article","tags":[],"type":"text","url":"/docs/atomic-angular/preview/select-article","content":"Select an article on click or Enter — replace it as the current selection, redirect to a preview route, or emit it — from a single directive."},"936":{"id":"/docs/atomic-angular/preview/select-article-1","page_id":"/docs/atomic-angular/preview/select-article","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/select-article#minimal-example","content":"Minimal example"},"937":{"id":"/docs/atomic-angular/preview/select-article-2","page_id":"/docs/atomic-angular/preview/select-article","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/select-article#options","content":"Options"},"938":{"id":"/docs/atomic-angular/preview/select-article-3","page_id":"/docs/atomic-angular/preview/select-article","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/select-article#pitfalls","content":"Pitfalls"},"939":{"id":"/docs/atomic-angular/preview/select-article-4","page_id":"/docs/atomic-angular/preview/select-article","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/select-article#whats-next","content":"What's next"},"940":{"id":"/docs/atomic-angular/preview/select-article-5","page_id":"/docs/atomic-angular/preview/select-article","tags":[],"type":"text","url":"/docs/atomic-angular/preview/select-article","content":"`[selectArticle]` selects an article when its host element is clicked or receives an Enter keypress, using one\nof three strategies."},"941":{"id":"/docs/atomic-angular/preview/select-article-6","page_id":"/docs/atomic-angular/preview/select-article","tags":[],"type":"text","url":"/docs/atomic-angular/preview/select-article#options","content":"<TypeTable\n  type=\"{\n  article: { type: &#x22;Partial<Article> | undefined&#x22;, description: &#x22;Required. The article to select on click or Enter.&#x22; },\n  strategy: {\n    type: '&#x22;replace&#x22; | &#x22;redirect&#x22; | &#x22;emit&#x22;',\n    default: '&#x22;replace&#x22;',\n    description: '&#x22;replace&#x22; makes the article the current selection, &#x22;redirect&#x22; navigates to a preview route, &#x22;emit&#x22; only fires `selected`.',\n  },\n  redirectUrl: { type: &#x22;string&#x22;, default: '&#x22;/preview&#x22;', description: 'The route to navigate to when strategy is &#x22;redirect&#x22; (appended with the article\\'s id).' },\n}\"\n/>"},"942":{"id":"/docs/atomic-angular/preview/select-article-7","page_id":"/docs/atomic-angular/preview/select-article","tags":[],"type":"text","url":"/docs/atomic-angular/preview/select-article#options","content":"This directive has one output, `selected` (`OutputEmitterRef<void>`), emitted only when `strategy=\"emit\"`."},"943":{"id":"/docs/atomic-angular/preview/select-article-8","page_id":"/docs/atomic-angular/preview/select-article","tags":[],"type":"text","url":"/docs/atomic-angular/preview/select-article#pitfalls","content":"`\"redirect\"` only navigates when the article has an `id`. Without one, it falls back to `\"replace\"` — the same\nbehavior as if no strategy were set at all. Make sure the `article` passed in actually carries an `id` before\nrelying on the redirect."},"944":{"id":"/docs/atomic-angular/preview/select-article-9","page_id":"/docs/atomic-angular/preview/select-article","tags":[],"type":"text","url":"/docs/atomic-angular/preview/select-article#whats-next","content":"Open an article in a new tab instead, on Ctrl+Enter."},"945":{"id":"/docs/atomic-angular/preview/text-chunk","page_id":"/docs/atomic-angular/preview/text-chunk","type":"page","content":"Text Chunk","breadcrumbs":["Docs","Atomic Angular","Preview"],"tags":[],"url":"/docs/atomic-angular/preview/text-chunk"},"946":{"id":"/docs/atomic-angular/preview/text-chunk-0","page_id":"/docs/atomic-angular/preview/text-chunk","tags":[],"type":"text","url":"/docs/atomic-angular/preview/text-chunk","content":"Fetch surrounding-context text chunks for a document's highlight locations, from the Sinequa backend."},"947":{"id":"/docs/atomic-angular/preview/text-chunk-1","page_id":"/docs/atomic-angular/preview/text-chunk","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/text-chunk#minimal-example","content":"Minimal example"},"948":{"id":"/docs/atomic-angular/preview/text-chunk-2","page_id":"/docs/atomic-angular/preview/text-chunk","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/text-chunk#options","content":"Options"},"949":{"id":"/docs/atomic-angular/preview/text-chunk-3","page_id":"/docs/atomic-angular/preview/text-chunk","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/text-chunk#pitfalls","content":"Pitfalls"},"950":{"id":"/docs/atomic-angular/preview/text-chunk-4","page_id":"/docs/atomic-angular/preview/text-chunk","type":"heading","tags":[],"url":"/docs/atomic-angular/preview/text-chunk#whats-next","content":"What's next"},"951":{"id":"/docs/atomic-angular/preview/text-chunk-5","page_id":"/docs/atomic-angular/preview/text-chunk","tags":[],"type":"text","url":"/docs/atomic-angular/preview/text-chunk","content":"`TextChunkService` retrieves text chunks — a highlight location plus a configurable number of sentences of\ncontext on either side — for a given document. Used where a preview needs to show highlighted passages without\nloading the whole converted document."},"952":{"id":"/docs/atomic-angular/preview/text-chunk-6","page_id":"/docs/atomic-angular/preview/text-chunk","tags":[],"type":"text","url":"/docs/atomic-angular/preview/text-chunk#options","content":"<TypeTable\n  type=\"{\n  id: { type: &#x22;string&#x22;, description: &#x22;The document's record id.&#x22; },\n  textChunks: { type: &#x22;TextLocation[]&#x22;, description: &#x22;The text locations to fetch chunks for.&#x22; },\n  highlights: { type: &#x22;string[]&#x22;, description: &#x22;Highlight category names to apply within each chunk.&#x22; },\n  query: { type: &#x22;Query&#x22;, description: &#x22;The query used to retrieve the chunks.&#x22; },\n  leftSentencesCount: { type: &#x22;number&#x22;, description: &#x22;Sentences of context to include before each chunk.&#x22; },\n  rightSentencesCount: { type: &#x22;number&#x22;, description: &#x22;Sentences of context to include after each chunk.&#x22; },\n}\"\n/>"},"953":{"id":"/docs/atomic-angular/preview/text-chunk-7","page_id":"/docs/atomic-angular/preview/text-chunk","tags":[],"type":"text","url":"/docs/atomic-angular/preview/text-chunk#options","content":"`getTextChunks(...)` returns `Observable<TextChunk[]>`."},"954":{"id":"/docs/atomic-angular/preview/text-chunk-8","page_id":"/docs/atomic-angular/preview/text-chunk","tags":[],"type":"text","url":"/docs/atomic-angular/preview/text-chunk#pitfalls","content":"The service catches the request's error internally and returns a plain `[]` from that `catchError` handler —\nnot `of([])`. RxJS treats a returned array as a source to flatten **element by element**, so an empty array\nmeans the resulting observable completes having emitted **nothing at all**: your `next` callback never fires,\nand neither does an `error` callback (the error was already caught). If you need to tell \"the request failed\"\napart from \"the request legitimately returned zero chunks\", add your own `catchError`/`finalize` before\nsubscribing rather than relying on this service's built-in one."},"955":{"id":"/docs/atomic-angular/preview/text-chunk-9","page_id":"/docs/atomic-angular/preview/text-chunk","tags":[],"type":"text","url":"/docs/atomic-angular/preview/text-chunk#whats-next","content":"The service driving the preview surface these chunks are shown alongside."},"956":{"id":"/docs/atomic-angular/theming-and-shell/backdrop","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","type":"page","content":"Backdrop","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/backdrop"},"957":{"id":"/docs/atomic-angular/theming-and-shell/backdrop-0","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/backdrop","content":"A full-screen dimming overlay, shown and hidden through BackdropService — not a settable input."},"958":{"id":"/docs/atomic-angular/theming-and-shell/backdrop-1","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/backdrop#minimal-example","content":"Minimal example"},"959":{"id":"/docs/atomic-angular/theming-and-shell/backdrop-2","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/backdrop#options","content":"Options"},"960":{"id":"/docs/atomic-angular/theming-and-shell/backdrop-3","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/backdrop#pitfalls","content":"Pitfalls"},"961":{"id":"/docs/atomic-angular/theming-and-shell/backdrop-4","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/backdrop","content":"`<backdrop>` renders nothing but a dimmed, full-screen overlay, and shows or hides itself in response to\n`BackdropService.show()`/`hide()`. It is meant to sit once near the root of the application, behind whatever\noverlay (a custom stacked panel, say) needs a scrim."},"962":{"id":"/docs/atomic-angular/theming-and-shell/backdrop-5","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/backdrop#options","content":"<TypeTable\n  type=\"{\n  &#x22;show()&#x22;: { type: &#x22;() => void&#x22;, description: &#x22;BackdropService — makes the backdrop visible.&#x22; },\n  &#x22;hide()&#x22;: { type: &#x22;() => void&#x22;, description: &#x22;BackdropService — hides it.&#x22; },\n  isVisible: { type: &#x22;BehaviorSubject<boolean>&#x22;, description: &#x22;BackdropService — the component's own only source of visibility.&#x22; },\n}\"\n/>"},"963":{"id":"/docs/atomic-angular/theming-and-shell/backdrop-6","page_id":"/docs/atomic-angular/theming-and-shell/backdrop","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/backdrop#pitfalls","content":"`backdropVisible` is not an `@Input()` — it is a `@HostBinding` the component sets itself, subscribed to\n`BackdropService.isVisible`. The only way to show or hide the backdrop is through the service's `show()`/`hide()`,\nnever a template binding on the component."},"964":{"id":"/docs/atomic-angular/theming-and-shell/error","page_id":"/docs/atomic-angular/theming-and-shell/error","type":"page","content":"Error","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/error"},"965":{"id":"/docs/atomic-angular/theming-and-shell/error-0","page_id":"/docs/atomic-angular/theming-and-shell/error","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/error","content":"A full-page error state with an optional detail message read from the \"message\" query param, and a way back to a fresh sign-in attempt."},"966":{"id":"/docs/atomic-angular/theming-and-shell/error-1","page_id":"/docs/atomic-angular/theming-and-shell/error","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/error#minimal-example","content":"Minimal example"},"967":{"id":"/docs/atomic-angular/theming-and-shell/error-2","page_id":"/docs/atomic-angular/theming-and-shell/error","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/error#how-it-works","content":"How it works"},"968":{"id":"/docs/atomic-angular/theming-and-shell/error-3","page_id":"/docs/atomic-angular/theming-and-shell/error","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/error#options","content":"Options"},"969":{"id":"/docs/atomic-angular/theming-and-shell/error-4","page_id":"/docs/atomic-angular/theming-and-shell/error","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/error#pitfalls","content":"Pitfalls"},"970":{"id":"/docs/atomic-angular/theming-and-shell/error-5","page_id":"/docs/atomic-angular/theming-and-shell/error","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/error","content":"`<ErrorComponent>` is a route target — mount it on an `\"error\"` path and navigate to it (optionally with a\n`message` query param) whenever the application cannot continue."},"971":{"id":"/docs/atomic-angular/theming-and-shell/error-6","page_id":"/docs/atomic-angular/theming-and-shell/error","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/error#how-it-works","content":"The page reads `message` from the current route's query params once, at construction — it is not reactive to\nfurther navigation while the component stays mounted. The single action button, \"Go to homepage\", navigates to\n`/` and then calls `window.location.reload()`: a full reload, not an in-place retry, so a fresh application\nbootstrap (and a fresh sign-in attempt) starts from scratch."},"972":{"id":"/docs/atomic-angular/theming-and-shell/error-7","page_id":"/docs/atomic-angular/theming-and-shell/error","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/error#options","content":"<TypeTable\n  type=\"{\n  &#x22;goHome()&#x22;: { type: &#x22;() => void&#x22;, description: 'Navigates to &#x22;/&#x22;, then reloads the page.' },\n  message: { type: &#x22;string | undefined&#x22;, description: 'Read once from the &#x22;message&#x22; query param at construction; undefined shows no detail box.' },\n}\"\n/>"},"973":{"id":"/docs/atomic-angular/theming-and-shell/error-8","page_id":"/docs/atomic-angular/theming-and-shell/error","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/error#pitfalls","content":"The action is `goHome()`, not `reload()` — and it does more than reload: it navigates to `/` first, then calls\n`window.location.reload()`, which is a full application re-bootstrap rather than reloading the current route in\nplace."},"974":{"id":"/docs/atomic-angular/theming-and-shell","page_id":"/docs/atomic-angular/theming-and-shell","type":"page","content":"Theming & app shell","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell"},"975":{"id":"/docs/atomic-angular/theming-and-shell-0","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell","content":"Register and switch color themes per scope, and the small components an application shell is built from — tabs, a dimming backdrop, error and loading states."},"976":{"id":"/docs/atomic-angular/theming-and-shell-1","page_id":"/docs/atomic-angular/theming-and-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"What's next"},"977":{"id":"/docs/atomic-angular/theming-and-shell-2","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell","content":"Two loosely related concerns share this section: theming (registering color themes at bootstrap, switching a\nscope between them and between light/dark), and the handful of components that make up an application's outer\nshell rather than any one search feature."},"978":{"id":"/docs/atomic-angular/theming-and-shell-3","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"Register themes at bootstrap and switch a scope's active theme and dark mode."},"979":{"id":"/docs/atomic-angular/theming-and-shell-4","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"Apply a scope's theme to one element and everything under it — nestable."},"980":{"id":"/docs/atomic-angular/theming-and-shell-5","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"A menu listing every registered theme for a scope."},"981":{"id":"/docs/atomic-angular/theming-and-shell-6","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"A light/dark switch for a scope."},"982":{"id":"/docs/atomic-angular/theming-and-shell-7","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"A tab bar generated straight from the router's child-route configuration."},"983":{"id":"/docs/atomic-angular/theming-and-shell-8","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"A full-screen dimming overlay, shown and hidden through a service."},"984":{"id":"/docs/atomic-angular/theming-and-shell-9","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"A full-page error state with an optional detail message."},"985":{"id":"/docs/atomic-angular/theming-and-shell-10","page_id":"/docs/atomic-angular/theming-and-shell","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell#whats-next","content":"The spinner route bootstrap-time authentication replaced."},"986":{"id":"/docs/atomic-angular/theming-and-shell/loading","page_id":"/docs/atomic-angular/theming-and-shell/loading","type":"page","content":"Loading","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/loading"},"987":{"id":"/docs/atomic-angular/theming-and-shell/loading-0","page_id":"/docs/atomic-angular/theming-and-shell/loading","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/loading","content":"Deprecated — a spinner shown while the application initialized at a dedicated /loading route. Authentication now happens at bootstrap instead."},"988":{"id":"/docs/atomic-angular/theming-and-shell/loading-1","page_id":"/docs/atomic-angular/theming-and-shell/loading","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/loading","content":"`LoadingComponent` and the `/loading` route pattern it was built for are no longer used. Authentication now\nhappens at bootstrap (`withBootstrapApp`/`signIn`), and `AuthGuard` redirects an unauthenticated user straight\nto the sign-in page — there is no longer an intermediate loading route to wait through. This component will be\nremoved in a future major release; do not use it in new code."},"989":{"id":"/docs/atomic-angular/theming-and-shell/loading-2","page_id":"/docs/atomic-angular/theming-and-shell/loading","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/loading","content":"If you still have an existing `/loading` route relying on it, see Authentication\nflows for the bootstrap sequence that replaces it."},"990":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","type":"page","content":"Navbar Tabs","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/navbar-tabs"},"991":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-0","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs","content":"A tab bar generated from the Angular Router's own child-route configuration, with automatic overflow into a dropdown and optional per-tab result counts."},"992":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-1","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#minimal-example","content":"Minimal example"},"993":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-2","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#how-it-works","content":"How it works"},"994":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-3","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#where-the-counts-and-the-persisted-filters-behavior-come-from","content":"Where the counts and the persisted-filters behavior come from"},"995":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-4","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#options","content":"Options"},"996":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-5","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#pitfalls","content":"Pitfalls"},"997":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-6","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#whats-next","content":"What's next"},"998":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-7","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs","content":"`<navbar-tabs>` renders one tab per child route of a given router `path` — there is no tab list to pass in,\nonly a `data` object per route. The active tab tracks the current URL, and whatever doesn't fit collapses into\na \"⋮\" menu instead of clipping."},"999":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-8","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#minimal-example","content":"Renders nothing when `path` has no matching child routes in the router config."},"1000":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-9","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#how-it-works","content":"Selection is a two-way `model` (`selectedTab`) kept in sync with `currentPath()` **one-way only** — an effect\npushes `currentPath()` into `selectedTab`, never the reverse — so a click (which updates `selectedTab` before\nthe URL actually changes) is not immediately overwritten by that same effect."},"1001":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-10","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#where-the-counts-and-the-persisted-filters-behavior-come-from","content":"A tab shows no badge at all (not a `0` badge) unless its `queryName` matches the current result's query name;\nit is disabled only once the matched count is exactly `0` — in the visible bar and in the overflow menu alike."},"1002":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-11","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#options","content":"<TypeTable\n  type=\"{\n  path: {\n    type: &#x22;string&#x22;,\n    default: '&#x22;search&#x22;',\n    description: &#x22;Router path segment whose child routes become tabs. Each child's data (display, wsQueryTab, icon, queryName) configures the tab.&#x22;,\n  },\n  showCount: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;Shows a result-count badge per tab, matched by queryName/wsQueryTab. A tab with a matched count of exactly 0 is disabled.&#x22;,\n  },\n  noTruncate: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;true: labels never clip, non-fitting tabs overflow into the menu. false: labels truncate with an ellipsis inside a fixed-width tab.&#x22;,\n  },\n  minTabWidth: {\n    type: &#x22;string | undefined&#x22;,\n    description: &#x22;Explicit minimum width in truncate mode (noTruncate=false), overriding the automatic minimum.&#x22;,\n  },\n  ariaLabel: {\n    type: &#x22;string | undefined&#x22;,\n    description: 'Accessible name of the tab list. Defaults to the translated &#x22;navbarTabs.tabs&#x22; — override when a page holds several tab lists.',\n  },\n}\"\n/>"},"1003":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-12","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#options","content":"No outputs — tab activation navigates through the Angular `Router` directly."},"1004":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-13","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#pitfalls","content":"Expected: `Tabs`/`TabList`/`Tab` (`@sinequa/galactik`) delegate ARIA roles, keyboard navigation and roving\n`tabindex` to `@angular/aria/tabs` via `hostDirectives` — but the \"more\" button is deliberately never\nregistered as a `Tab`, so it does not participate in arrow-key navigation between tabs. It is still reachable:\nit is the last child of `TabList` (inside the same pill, not floating beside it) and opens its menu on click,\nEnter or Space."},"1005":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-14","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#pitfalls","content":"That only happens when its `queryName`/`wsQueryTab` genuinely matches the current result and the matched count\nis `0` — which also disables it. If you expected no badge instead, check the tab's `data.queryName` against\nthe query the result actually came from; a mismatch shows no badge (not a `0` one), so a `0` badge is never a\nfalse positive."},"1006":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-15","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#pitfalls","content":"Depends on the app-wide `general.features.persistFiltersAcrossTabs` flag. When it is off (the default), tab\nnavigation replaces the query params from scratch — filters, sort, selected id and page are explicitly cleared.\nTurn the flag on to merge instead, keeping those params across a tab change."},"1007":{"id":"/docs/atomic-angular/theming-and-shell/navbar-tabs-16","page_id":"/docs/atomic-angular/theming-and-shell/navbar-tabs","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/navbar-tabs#whats-next","content":"Register and apply a color theme, the other piece of the application shell."},"1008":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","type":"page","content":"ThemeProvider","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-provider"},"1009":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-0","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-provider","content":"Apply a scope's active theme to one element and everything under it, as CSS custom properties — nestable, so a page can mix several themes."},"1010":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-1","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-provider#minimal-example","content":"Minimal example"},"1011":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-2","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-provider#options","content":"Options"},"1012":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-3","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-provider#pitfalls","content":"Pitfalls"},"1013":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-4","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-provider#whats-next","content":"What's next"},"1014":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-5","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-provider","content":"`[themeProvider]` reads a scope's current theme and dark-mode state from `ThemeStore` and writes\nthe matching CSS variables directly onto the element it is bound to, via `element.style.setProperty`. Every\ndescendant inherits those variables through normal CSS cascade — including another `[themeProvider]` further\ndown, which is what makes nesting themes just a matter of choosing distinct scope names."},"1015":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-6","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-provider#options","content":"<TypeTable\n  type=\"{\n  themeProvider: {\n    type: &#x22;string&#x22;,\n    description: &#x22;Required. The scope name looked up in ThemeStore — read reactively, so switching the scope's theme updates this element live.&#x22;,\n  },\n}\"\n/>"},"1016":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-7","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-provider#pitfalls","content":"`ThemeStore.scopes()` has no entry for that scope yet — the directive's `effect()` returns early when the\nscope is unregistered. Call `loadDefaultTheme(scope)` or `setCurrentTheme(scope, name)` once before (or\nreactively alongside) mounting the element."},"1017":{"id":"/docs/atomic-angular/theming-and-shell/theme-provider-8","page_id":"/docs/atomic-angular/theming-and-shell/theme-provider","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-provider#whats-next","content":"Let the user pick which registered theme a scope uses."},"1018":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","type":"page","content":"ThemeSelector","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-selector"},"1019":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-0","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-selector","content":"A menu, opened from your own trigger content, listing every registered theme for a scope and switching it on click."},"1020":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-1","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-selector#minimal-example","content":"Minimal example"},"1021":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-2","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-selector#options","content":"Options"},"1022":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-3","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-selector#pitfalls","content":"Pitfalls"},"1023":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-4","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-selector#whats-next","content":"What's next"},"1024":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-5","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-selector","content":"`<theme-selector>` projects whatever you put inside it as the menu's trigger button — there is no default\nlabel or icon — and opens a menu of every theme registered for the given `scope`, each row swatched with that\ntheme's `primary` color."},"1025":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-6","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-selector#options","content":"<TypeTable\n  type=\"{\n  scope: { type: &#x22;string&#x22;, description: &#x22;Required. Which ThemeStore scope this selector reads from and writes to.&#x22; },\n  showPrivate: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Include themes flagged private in the menu.&#x22; },\n  selectedTheme: { type: &#x22;model<string | undefined>&#x22;, description: &#x22;Two-way — the active theme's name, kept in sync with the scope.&#x22; },\n}\"\n/>"},"1026":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-7","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-selector#pitfalls","content":"`<theme-selector>` has no default trigger content — its template is `<button [menuTrigger]=\"…\"><ng-content /></button>`.\nProject a label, an icon, or both between the tags; an empty `<theme-selector scope=\"main\" />` is a button with\nnothing to click on."},"1027":{"id":"/docs/atomic-angular/theming-and-shell/theme-selector-8","page_id":"/docs/atomic-angular/theming-and-shell/theme-selector","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-selector#whats-next","content":"A light/dark switch for the same scope."},"1028":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","type":"page","content":"ThemeToggle","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-toggle"},"1029":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-0","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-toggle","content":"A labeled light/dark switch for one ThemeStore scope, built on Signal Forms' checkbox contract."},"1030":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-1","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-toggle#minimal-example","content":"Minimal example"},"1031":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-2","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-toggle#options","content":"Options"},"1032":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-3","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-toggle#pitfalls","content":"Pitfalls"},"1033":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-4","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme-toggle#whats-next","content":"What's next"},"1034":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-5","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-toggle","content":"`<theme-toggle>` is a hidden checkbox bound through Signal Forms, with an icon and a \"Dark mode\" label doing the\nvisible work — checking it calls `ThemeStore.setDarkMode()` for the given scope."},"1035":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-6","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-toggle#options","content":"<TypeTable\n  type=\"{\n  scope: { type: &#x22;string&#x22;, description: &#x22;Required. Which ThemeStore scope this toggle reads from and writes to.&#x22; },\n  darkMode: { type: &#x22;model<boolean>&#x22;, default: &#x22;false&#x22;, description: &#x22;Two-way — kept in sync with the scope's dark-mode state.&#x22; },\n}\"\n/>"},"1036":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-7","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-toggle#pitfalls","content":"`ThemeStore.scopes()` has no entry for that scope — `toggleDarkMode()` reads the current scope and returns\nearly when it is `undefined` or has no `cssVars`. Register the scope first (`loadDefaultTheme`/`setCurrentTheme`),\nsame as ThemeProvider."},"1037":{"id":"/docs/atomic-angular/theming-and-shell/theme-toggle-8","page_id":"/docs/atomic-angular/theming-and-shell/theme-toggle","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme-toggle#whats-next","content":"Register themes at bootstrap and apply one to the whole page."},"1038":{"id":"/docs/atomic-angular/theming-and-shell/theme","page_id":"/docs/atomic-angular/theming-and-shell/theme","type":"page","content":"Theme","breadcrumbs":["Docs","Atomic Angular","Theming & app shell"],"tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme"},"1039":{"id":"/docs/atomic-angular/theming-and-shell/theme-0","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme","content":"Register one or more color themes at bootstrap, then switch a scope between them (and between light/dark) at runtime through ThemeStore."},"1040":{"id":"/docs/atomic-angular/theming-and-shell/theme-1","page_id":"/docs/atomic-angular/theming-and-shell/theme","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme#minimal-example","content":"Minimal example"},"1041":{"id":"/docs/atomic-angular/theming-and-shell/theme-2","page_id":"/docs/atomic-angular/theming-and-shell/theme","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme#how-it-works","content":"How it works"},"1042":{"id":"/docs/atomic-angular/theming-and-shell/theme-3","page_id":"/docs/atomic-angular/theming-and-shell/theme","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme#options","content":"Options"},"1043":{"id":"/docs/atomic-angular/theming-and-shell/theme-4","page_id":"/docs/atomic-angular/theming-and-shell/theme","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme#pitfalls","content":"Pitfalls"},"1044":{"id":"/docs/atomic-angular/theming-and-shell/theme-5","page_id":"/docs/atomic-angular/theming-and-shell/theme","type":"heading","tags":[],"url":"/docs/atomic-angular/theming-and-shell/theme#whats-next","content":"What's next"},"1045":{"id":"/docs/atomic-angular/theming-and-shell/theme-6","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme","content":"A theme is a named set of CSS custom properties — one value per color role (`primary`, `background`,\n`destructive`, …), in a light and a dark variant. `ThemeStore` holds every registered theme and, for each\n**scope** you define, which one is currently active and in which mode."},"1046":{"id":"/docs/atomic-angular/theming-and-shell/theme-7","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme","content":"A scope is just a string key you choose (`\"application\"`, `\"main\"`, the id of a panel) — `ThemeStore` keeps one\nindependent theme/dark-mode pair per scope, so nesting or coexisting themes is a matter of using different scope\nnames, not a feature you configure."},"1047":{"id":"/docs/atomic-angular/theming-and-shell/theme-8","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#minimal-example","content":"Exporting `THEMES` from its own file is worth doing as soon as a theme carries more than a couple of colors —\na full color set is a large literal, and keeping it out of `app.config.ts` keeps the bootstrap file readable."},"1048":{"id":"/docs/atomic-angular/theming-and-shell/theme-9","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#how-it-works","content":"`withThemes()` pushes your themes into a module-level array read by `ThemeStore` — it does nothing else, and\norder relative to `withThemeBodyHook()` matters: the hook reads that array through `setCurrentTheme()`, so it\nmust run after `withThemes()` in the bootstrap chain. `withThemeBodyHook()` is the one integration that targets\n`document.body` directly, through the fixed scope name `\"application\"` (or whatever `scope` you pass it) —\nevery other scope is applied through `[themeProvider]` on a specific element instead (see\nThemeProvider)."},"1049":{"id":"/docs/atomic-angular/theming-and-shell/theme-10","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#options","content":"<TypeTable\n  type=\"{\n  &#x22;loadDefaultTheme(scope, darkMode?)&#x22;: {\n    type: &#x22;(scope: string, darkMode?: boolean) => void&#x22;,\n    description: 'Shortcut for setCurrentTheme(scope, &#x22;Default&#x22;, darkMode).',\n  },\n  &#x22;setCurrentTheme(scope, themeName, darkMode?)&#x22;: {\n    type: &#x22;(scope: string, themeName: string, darkMode?: boolean) => void&#x22;,\n    description: &#x22;Switches the scope's active theme. Omitted darkMode keeps the scope's current mode, or false for a new scope.&#x22;,\n  },\n  &#x22;setDarkMode(scope, darkMode)&#x22;: {\n    type: &#x22;(scope: string, darkMode: boolean) => void&#x22;,\n    description: &#x22;Toggles light/dark for a scope without changing which theme is active.&#x22;,\n  },\n  &#x22;scopes()&#x22;: {\n    type: &#x22;Signal<Record<string, { cssVars, darkMode, themeName }>>&#x22;,\n    description: &#x22;The full per-scope state, read by every consumer (ThemeProvider, ThemeSelector, ThemeToggle).&#x22;,\n  },\n}\"\n/>"},"1050":{"id":"/docs/atomic-angular/theming-and-shell/theme-11","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#pitfalls","content":"The theme name passed does not match any entry's `name` in the array `withThemes()` registered — including the\nbuilt-in `\"Default\"` theme name used by `loadDefaultTheme()`, which only exists if your own `THEMES` array\nactually defines one named exactly `\"Default\"`."},"1051":{"id":"/docs/atomic-angular/theming-and-shell/theme-12","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#pitfalls","content":"`withThemeBodyHook()` only ever targets `document.body`, for the one scope you passed it (`\"application\"` by\ndefault). Every other scope needs its own `[themeProvider]=\"scopeName\"` on the element that should carry it —\nregistering a scope in `ThemeStore` does not apply it anywhere on its own."},"1052":{"id":"/docs/atomic-angular/theming-and-shell/theme-13","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#whats-next","content":"Apply a scope's theme to one element (and everything under it), nestable."},"1053":{"id":"/docs/atomic-angular/theming-and-shell/theme-14","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#whats-next","content":"A menu of registered themes, bound to a scope."},"1054":{"id":"/docs/atomic-angular/theming-and-shell/theme-15","page_id":"/docs/atomic-angular/theming-and-shell/theme","tags":[],"type":"text","url":"/docs/atomic-angular/theming-and-shell/theme#whats-next","content":"A light/dark switch for a scope."},"1055":{"id":"/docs/atomic-angular/results/autocomplete","page_id":"/docs/atomic-angular/results/autocomplete","type":"page","content":"Autocomplete","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/autocomplete"},"1056":{"id":"/docs/atomic-angular/results/autocomplete-0","page_id":"/docs/atomic-angular/results/autocomplete","tags":[],"type":"text","url":"/docs/atomic-angular/results/autocomplete","content":"Suggestions as the user types — from configured suggest queries on the server, and from the user's own recent/saved searches and bookmarks."},"1057":{"id":"/docs/atomic-angular/results/autocomplete-1","page_id":"/docs/atomic-angular/results/autocomplete","type":"heading","tags":[],"url":"/docs/atomic-angular/results/autocomplete#minimal-example","content":"Minimal example"},"1058":{"id":"/docs/atomic-angular/results/autocomplete-2","page_id":"/docs/atomic-angular/results/autocomplete","type":"heading","tags":[],"url":"/docs/atomic-angular/results/autocomplete#recipes","content":"Recipes"},"1059":{"id":"/docs/atomic-angular/results/autocomplete-3","page_id":"/docs/atomic-angular/results/autocomplete","type":"heading","tags":[],"url":"/docs/atomic-angular/results/autocomplete#mixing-in-the-users-own-history","content":"Mixing in the user's own history"},"1060":{"id":"/docs/atomic-angular/results/autocomplete-4","page_id":"/docs/atomic-angular/results/autocomplete","type":"heading","tags":[],"url":"/docs/atomic-angular/results/autocomplete#options","content":"Options"},"1061":{"id":"/docs/atomic-angular/results/autocomplete-5","page_id":"/docs/atomic-angular/results/autocomplete","type":"heading","tags":[],"url":"/docs/atomic-angular/results/autocomplete#whats-next","content":"What's next"},"1062":{"id":"/docs/atomic-angular/results/autocomplete-6","page_id":"/docs/atomic-angular/results/autocomplete","tags":[],"type":"text","url":"/docs/atomic-angular/results/autocomplete","content":"Two independent sources feed a search box's suggestions: `AutocompleteService` asks the server's configured\nsuggest queries, and separately reads the user's own history (recent/saved searches, bookmarks) client-side."},"1063":{"id":"/docs/atomic-angular/results/autocomplete-7","page_id":"/docs/atomic-angular/results/autocomplete","tags":[],"type":"text","url":"/docs/atomic-angular/results/autocomplete#mixing-in-the-users-own-history","content":"`getFromUserSettingsForText` groups its results by `recent-searches`, `saved-searches` and `bookmarks` — enough\nto render each group under its own heading, or to merge and cap them, as the caller prefers."},"1064":{"id":"/docs/atomic-angular/results/autocomplete-8","page_id":"/docs/atomic-angular/results/autocomplete","tags":[],"type":"text","url":"/docs/atomic-angular/results/autocomplete#options","content":"<TypeTable\n  type=\"{\n  &#x22;getFromSuggestQueriesForText(text)&#x22;: {\n    type: &#x22;(text: string): Promise<Suggestion[][]>&#x22;,\n    description: &#x22;One array per configured suggest query — flatten to merge them, or keep them grouped.&#x22;,\n  },\n  &#x22;getFromUserSettingsForText(text, maxCount)&#x22;: {\n    type: &#x22;(text: string, maxCount: number | Autocomplete): Suggestion[]&#x22;,\n    description: &#x22;Synchronous. Grouped by recent-searches, saved-searches, bookmarks.&#x22;,\n  },\n}\"\n/>"},"1065":{"id":"/docs/atomic-angular/results/autocomplete-9","page_id":"/docs/atomic-angular/results/autocomplete","tags":[],"type":"text","url":"/docs/atomic-angular/results/autocomplete#whats-next","content":"Once a search actually runs, turn its spelling correction into the right message."},"1066":{"id":"/docs/atomic-angular/results/converter-select","page_id":"/docs/atomic-angular/results/converter-select","type":"page","content":"Converter Select","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/converter-select"},"1067":{"id":"/docs/atomic-angular/results/converter-select-0","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select","content":"The dropdown that lets a user pick which converted format previews a document, built from the app's configured converters and hidden entirely when only one applies."},"1068":{"id":"/docs/atomic-angular/results/converter-select-1","page_id":"/docs/atomic-angular/results/converter-select","type":"heading","tags":[],"url":"/docs/atomic-angular/results/converter-select#minimal-example","content":"Minimal example"},"1069":{"id":"/docs/atomic-angular/results/converter-select-2","page_id":"/docs/atomic-angular/results/converter-select","type":"heading","tags":[],"url":"/docs/atomic-angular/results/converter-select#options","content":"Options"},"1070":{"id":"/docs/atomic-angular/results/converter-select-3","page_id":"/docs/atomic-angular/results/converter-select","type":"heading","tags":[],"url":"/docs/atomic-angular/results/converter-select#pitfalls","content":"Pitfalls"},"1071":{"id":"/docs/atomic-angular/results/converter-select-4","page_id":"/docs/atomic-angular/results/converter-select","type":"heading","tags":[],"url":"/docs/atomic-angular/results/converter-select#whats-next","content":"What's next"},"1072":{"id":"/docs/atomic-angular/results/converter-select-5","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select","content":"`<converter-select>` renders only when `previewMultiConversion` is on **and** more than one configured\nconverter matches the currently loaded preview's available conversions — otherwise the host hides itself\nentirely, so it can be dropped into a toolbar without leaving a gap when there is nothing to choose between."},"1073":{"id":"/docs/atomic-angular/results/converter-select-6","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select#minimal-example","content":"`<preview-content>` already embeds this dropdown internally (through `<preview-actions>`) and owns the\nresulting conversion itself — reach for `<converter-select>` directly only when building a **custom** preview\nsurface that does not use `<preview-content>`."},"1074":{"id":"/docs/atomic-angular/results/converter-select-7","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select#minimal-example","content":"Defaults to the converter marked `default` in configuration, then the one marked `primary`, when several\nmatch."},"1075":{"id":"/docs/atomic-angular/results/converter-select-8","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select#options","content":"<TypeTable\n  type=\"{\n  previewData: { type: &#x22;PreviewData | undefined&#x22;, description: &#x22;Loaded preview data; its conversions are matched against general.converters.&#x22; },\n  activeConversion: {\n    type: &#x22;CConverter | undefined&#x22;,\n    description: &#x22;Optional. Re-syncs the dropdown's selection on (re)mount to whatever the host already has selected, instead of resetting to the first option.&#x22;,\n  },\n}\"\n/>"},"1076":{"id":"/docs/atomic-angular/results/converter-select-9","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select#options","content":"`onConversionSelect` emits the selected `CConverter`, or `undefined` when none applies."},"1077":{"id":"/docs/atomic-angular/results/converter-select-10","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select#pitfalls","content":"This component works standalone with no `activeConversion`, defaulting to the first/primary option every time\nit (re)mounts — which is exactly what happens if it sits inside a conditionally-rendered branch that gets torn\ndown and rebuilt by an unrelated reactive change (nested inside `<preview-actions>` inside\n`<preview-content>`'s own conditional branch, for instance). Pass the host's current conversion back as\n`[activeConversion]` so the dropdown re-syncs instead of resetting."},"1078":{"id":"/docs/atomic-angular/results/converter-select-11","page_id":"/docs/atomic-angular/results/converter-select","tags":[],"type":"text","url":"/docs/atomic-angular/results/converter-select#whats-next","content":"Where the loaded PreviewData this component reads conversions from comes from."},"1079":{"id":"/docs/atomic-angular/results/did-you-mean","page_id":"/docs/atomic-angular/results/did-you-mean","type":"page","content":"Did You Mean","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/did-you-mean"},"1080":{"id":"/docs/atomic-angular/results/did-you-mean-0","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean","content":"Turn a result's spelling correction into the right message — the engine corrected the query, expanded it, or only suggests a correction — and let the user switch between the two spellings."},"1081":{"id":"/docs/atomic-angular/results/did-you-mean-1","page_id":"/docs/atomic-angular/results/did-you-mean","type":"heading","tags":[],"url":"/docs/atomic-angular/results/did-you-mean#minimal-example","content":"Minimal example"},"1082":{"id":"/docs/atomic-angular/results/did-you-mean-2","page_id":"/docs/atomic-angular/results/did-you-mean","type":"heading","tags":[],"url":"/docs/atomic-angular/results/did-you-mean#how-it-works","content":"How it works"},"1083":{"id":"/docs/atomic-angular/results/did-you-mean-3","page_id":"/docs/atomic-angular/results/did-you-mean","type":"heading","tags":[],"url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"The three messages"},"1084":{"id":"/docs/atomic-angular/results/did-you-mean-4","page_id":"/docs/atomic-angular/results/did-you-mean","type":"heading","tags":[],"url":"/docs/atomic-angular/results/did-you-mean#options","content":"Options"},"1085":{"id":"/docs/atomic-angular/results/did-you-mean-5","page_id":"/docs/atomic-angular/results/did-you-mean","type":"heading","tags":[],"url":"/docs/atomic-angular/results/did-you-mean#pitfalls","content":"Pitfalls"},"1086":{"id":"/docs/atomic-angular/results/did-you-mean-6","page_id":"/docs/atomic-angular/results/did-you-mean","type":"heading","tags":[],"url":"/docs/atomic-angular/results/did-you-mean#whats-next","content":"What's next"},"1087":{"id":"/docs/atomic-angular/results/did-you-mean-7","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean","content":"When the engine corrects a misspelled query, three different things could actually have happened to the\nsearch: the corrected term fully replaced the original, both spellings were searched together, or nothing was\nsearched yet and the engine only proposes a correction. `<did-you-mean>` reads which one from the result and\nrenders the matching message, with links to switch spellings."},"1088":{"id":"/docs/atomic-angular/results/did-you-mean-8","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean","content":"Since engine 11.14, a corrected result reports `didYouMean.text.appliedChanges` — one entry per corrected term,\neach naming the actual `action` the engine took (`correction`, `expansion`, or `suggestion`). Before 11.14 that\nfield does not exist, and the component falls back to inferring the action from `spellingCorrectionMode`."},"1089":{"id":"/docs/atomic-angular/results/did-you-mean-9","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#how-it-works","content":"Which message renders depends entirely on the resolved `action` — a computed the component derives from the\nresult, never set directly:"},"1090":{"id":"/docs/atomic-angular/results/did-you-mean-10","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#how-it-works","content":"A mixed result — some terms corrected, others expanded — deliberately falls back to `suggestion`: it is the\nonly one of the three messages that does not assert a specific search behavior that may not actually have\nhappened for every term."},"1091":{"id":"/docs/atomic-angular/results/did-you-mean-11","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Action"},"1092":{"id":"/docs/atomic-angular/results/did-you-mean-12","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Meaning"},"1093":{"id":"/docs/atomic-angular/results/did-you-mean-13","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Message"},"1094":{"id":"/docs/atomic-angular/results/did-you-mean-14","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"`correction`"},"1095":{"id":"/docs/atomic-angular/results/did-you-mean-15","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"The original term was replaced"},"1096":{"id":"/docs/atomic-angular/results/did-you-mean-16","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Showing results for **Catalon**. Search instead for katalon"},"1097":{"id":"/docs/atomic-angular/results/did-you-mean-17","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"`expansion`"},"1098":{"id":"/docs/atomic-angular/results/did-you-mean-18","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Both spellings were searched together"},"1099":{"id":"/docs/atomic-angular/results/did-you-mean-19","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Showing results for katalon and **Catalon**"},"1100":{"id":"/docs/atomic-angular/results/did-you-mean-20","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"`suggestion`"},"1101":{"id":"/docs/atomic-angular/results/did-you-mean-21","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Only the original was searched"},"1102":{"id":"/docs/atomic-angular/results/did-you-mean-22","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#the-three-messages","content":"Did you mean **Catalon**?"},"1103":{"id":"/docs/atomic-angular/results/did-you-mean-23","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#options","content":"<TypeTable\n  type=\"{\n  result: { type: &#x22;Result | undefined&#x22;, description: &#x22;The query result to read didYouMean from. Nothing renders while undefined, or when there is no corrected text.&#x22; },\n}\"\n/>"},"1104":{"id":"/docs/atomic-angular/results/did-you-mean-24","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#options","content":"`selectCorrected()` and `selectOriginal()` are the two methods every message's links call — both patch\n`QueryParamsStore` with `spellingCorrectionMode: \"dymonly\"` and navigate with the chosen text, so the engine\ndoes not re-correct the choice the user just made."},"1105":{"id":"/docs/atomic-angular/results/did-you-mean-25","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#pitfalls","content":"Both `selectCorrected()` and `selectOriginal()` set `spellingCorrectionMode: \"dymonly\"` for exactly this\nreason — it tells the engine \"the user already chose a spelling, stop correcting\". If a custom flow bypasses\nthese methods and re-runs the query without that mode, the same suggestion can resurface."},"1106":{"id":"/docs/atomic-angular/results/did-you-mean-26","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#pitfalls","content":"Confirm the engine version reports `appliedChanges` (11.14+) — on an older engine the action is inferred from\n`spellingCorrectionMode` alone, which is coarser: it describes the query-level setting, not what happened\nper-term, so a partially-corrected query can display a message that overstates or understates the correction."},"1107":{"id":"/docs/atomic-angular/results/did-you-mean-27","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#whats-next","content":"Where the Result this component reads from comes from."},"1108":{"id":"/docs/atomic-angular/results/did-you-mean-28","page_id":"/docs/atomic-angular/results/did-you-mean","tags":[],"type":"text","url":"/docs/atomic-angular/results/did-you-mean#whats-next","content":"The message for when correction still finds nothing."},"1109":{"id":"/docs/atomic-angular/results/document-locator","page_id":"/docs/atomic-angular/results/document-locator","type":"page","content":"Document Locator","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/document-locator"},"1110":{"id":"/docs/atomic-angular/results/document-locator-0","page_id":"/docs/atomic-angular/results/document-locator","tags":[],"type":"text","url":"/docs/atomic-angular/results/document-locator","content":"A document's place in a hierarchy, as clickable breadcrumb segments that navigate through an aggregation — and overflow into a dropdown when the container is too narrow."},"1111":{"id":"/docs/atomic-angular/results/document-locator-1","page_id":"/docs/atomic-angular/results/document-locator","type":"heading","tags":[],"url":"/docs/atomic-angular/results/document-locator#minimal-example","content":"Minimal example"},"1112":{"id":"/docs/atomic-angular/results/document-locator-2","page_id":"/docs/atomic-angular/results/document-locator","type":"heading","tags":[],"url":"/docs/atomic-angular/results/document-locator#options","content":"Options"},"1113":{"id":"/docs/atomic-angular/results/document-locator-3","page_id":"/docs/atomic-angular/results/document-locator","type":"heading","tags":[],"url":"/docs/atomic-angular/results/document-locator#pitfalls","content":"Pitfalls"},"1114":{"id":"/docs/atomic-angular/results/document-locator-4","page_id":"/docs/atomic-angular/results/document-locator","type":"heading","tags":[],"url":"/docs/atomic-angular/results/document-locator#whats-next","content":"What's next"},"1115":{"id":"/docs/atomic-angular/results/document-locator-5","page_id":"/docs/atomic-angular/results/document-locator","tags":[],"type":"text","url":"/docs/atomic-angular/results/document-locator","content":"`<document-locator>` renders a document's location within a tree-shaped aggregation (a folder structure, a\ncollection hierarchy) as breadcrumbs. Clicking a segment updates the query's filters and navigates to that\nlocation, and segments that don't fit the available width move into an overflow dropdown automatically."},"1116":{"id":"/docs/atomic-angular/results/document-locator-6","page_id":"/docs/atomic-angular/results/document-locator","tags":[],"type":"text","url":"/docs/atomic-angular/results/document-locator#options","content":"<TypeTable\n  type=\"{\n  article: { type: &#x22;Article&#x22;, description: &#x22;Required. Its treepath (or equivalent hierarchy value) is what gets segmented.&#x22; },\n  aggregation: { type: &#x22;string&#x22;, description: &#x22;Required. Name of the tree aggregation this locator navigates — must match a configured tree facet, since a click writes a filter on it.&#x22; },\n}\"\n/>"},"1117":{"id":"/docs/atomic-angular/results/document-locator-7","page_id":"/docs/atomic-angular/results/document-locator","tags":[],"type":"text","url":"/docs/atomic-angular/results/document-locator#pitfalls","content":"The `aggregation` name has to match a tree aggregation the app's configuration actually defines — a typo'd or\nmissing name means the click has nothing to write a filter against. Cross-check against\nAggregation, which treats a misconfigured name the same way."},"1118":{"id":"/docs/atomic-angular/results/document-locator-8","page_id":"/docs/atomic-angular/results/document-locator","tags":[],"type":"text","url":"/docs/atomic-angular/results/document-locator#whats-next","content":"The tree facet this component's segments ultimately filter on."},"1119":{"id":"/docs/atomic-angular/results","page_id":"/docs/atomic-angular/results","type":"page","content":"Results","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results"},"1120":{"id":"/docs/atomic-angular/results-0","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results","content":"Running a query and rendering what comes back — the query service, autocomplete, spelling correction, sorting, empty states, and the small display components a result list is built from."},"1121":{"id":"/docs/atomic-angular/results-1","page_id":"/docs/atomic-angular/results","type":"heading","tags":[],"url":"/docs/atomic-angular/results#whats-next","content":"What's next"},"1122":{"id":"/docs/atomic-angular/results-2","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results","content":"Once a query has filters (see Filtering results), this section covers the rest of the\nloop: issuing the request, telling a genuine zero-match apart from a failed one, correcting or expanding a\nmisspelled query, and the small components a result list and its rows are built from."},"1123":{"id":"/docs/atomic-angular/results-3","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"Search, tell a failed request apart from a genuine zero results, and page through a result."},"1124":{"id":"/docs/atomic-angular/results-4","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"Suggestions as the user types, from configured suggest queries or from their own history."},"1125":{"id":"/docs/atomic-angular/results-5","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"Turn the engine's spelling correction into the right message — corrected, expanded, or merely suggested."},"1126":{"id":"/docs/atomic-angular/results-6","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"A dropdown of the sort choices a tab or query configuration actually offers."},"1127":{"id":"/docs/atomic-angular/results-7","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"The zero-match message — and where pagination for a result list actually lives now."},"1128":{"id":"/docs/atomic-angular/results-8","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"Which query terms this particular document doesn't contain, each a link to search for them all."},"1129":{"id":"/docs/atomic-angular/results-9","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"A document's place in a hierarchy, as breadcrumbs that overflow into a dropdown."},"1130":{"id":"/docs/atomic-angular/results-10","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"An article field as a row of tags, and the icon identifying which source or collection it came from."},"1131":{"id":"/docs/atomic-angular/results-11","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"Up to three promoted links relevant to the current query."},"1132":{"id":"/docs/atomic-angular/results-12","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"Pick which converted format previews a document, when more than one is configured."},"1133":{"id":"/docs/atomic-angular/results-13","page_id":"/docs/atomic-angular/results","tags":[],"type":"text","url":"/docs/atomic-angular/results#whats-next","content":"Two small layout directives: load more on scroll, and count how many items actually fit."},"1134":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","type":"page","content":"Infinite Scroll & Overflow","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/infinite-scroll-and-overflow"},"1135":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-0","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow","content":"Two small layout directives with no visual output of their own — load more when an element enters the viewport, and count how many items actually fit before a \"more\" trigger."},"1136":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-1","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","type":"heading","tags":[],"url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#infinite-scroll","content":"Infinite scroll"},"1137":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-2","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","type":"heading","tags":[],"url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#overflow-manager","content":"Overflow manager"},"1138":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-3","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","type":"heading","tags":[],"url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#pitfalls","content":"Pitfalls"},"1139":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-4","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","type":"heading","tags":[],"url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#whats-next","content":"What's next"},"1140":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-5","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow","content":"Neither directive renders anything: `InfinityScrollDirective` fires an event when its host becomes visible,\nand the `overflowManager` family hides whichever items do not fit and reports how many do."},"1141":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-6","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#infinite-scroll","content":"Built on `IntersectionObserver`: `onScroll` fires once the host element enters the viewport, typically a thin\nsentinel `<div>` placed at the end of a list."},"1142":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-7","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#infinite-scroll","content":"<TypeTable\n  type=\"{\n  onScroll: { type: &#x22;OutputEmitterRef<void>&#x22;, description: &#x22;Emitted when the host becomes visible in the viewport.&#x22; },\n}\"\n/>"},"1143":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-8","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#overflow-manager","content":"Three directives working together: `overflowManager` on the container, `overflowItem` on each candidate item,\nand `overflowStop` on the trigger whose space must always stay clear (a \"+N more\" button, typically)."},"1144":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-9","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#overflow-manager","content":"The boundary measured is the container's own content edge, not the stop element's position — which keeps the\nmeasurement correct even inside a flex layout, since nothing depends on a sibling staying where expected. The\nstop element's *size* is reserved only once not every item fits (unless `reserveStop` forces it to always be\nreserved), so the last visible item never overlaps the trigger."},"1145":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-10","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#overflow-manager","content":"<TypeTable\n  type=\"{\n  target: { type: &#x22;ElementRef | undefined&#x22;, description: &#x22;Element to observe for resize. Defaults to the host itself.&#x22; },\n  margin: { type: &#x22;number&#x22;, default: &#x22;4&#x22;, description: &#x22;Slack subtracted from the container's content edge, in pixels — not a CSS length string.&#x22; },\n  direction: { type: '&#x22;horizontal&#x22; | &#x22;vertical&#x22;', default: '&#x22;horizontal&#x22;' },\n  reserveStop: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Always reserve the stop element's space, even when every item fits — for a trigger that stays permanently visible.&#x22;,\n  },\n  count: { type: &#x22;OutputEmitterRef<number>&#x22;, description: &#x22;Number of items that fit, debounced.&#x22; },\n}\"\n/>"},"1146":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-11","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#pitfalls","content":"The selector is the kebab-case attribute `[infinity-scroll]` (and the class is `InfinityScrollDirective&#x60;,\nspelled with &#x2A;*\"Infinity\"**, not \"Infinite\") — `<div infinity-scroll (onScroll)=\"...\">`, not a camelCase\n`infinityScroll` binding."},"1147":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-12","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#pitfalls","content":"`margin` is a plain `number` of pixels, consumed directly in a `getBoundingClientRect()`-based calculation —\nnot a CSS length string. Pass `[margin]=\"8\"`, never `margin=\"8px\"`."},"1148":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-13","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#pitfalls","content":"`overflowManager` needs direct DOM access and cannot be used through `hostDirectives` — wrap it in an\n`ng-container` with an explicit `[target]` pointing at the real container element instead."},"1149":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-14","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#pitfalls","content":"`overflowManager` recounts when the container resizes or an individual item's size changes, but a Transloco\ntranslation load does not itself resize anything if it fires before layout — debounce\n`TranslocoService.events$` and call the directive's own `countItems()` (via `viewChild`) once the language\nactually finishes loading."},"1150":{"id":"/docs/atomic-angular/results/infinite-scroll-and-overflow-15","page_id":"/docs/atomic-angular/results/infinite-scroll-and-overflow","tags":[],"type":"text","url":"/docs/atomic-angular/results/infinite-scroll-and-overflow#whats-next","content":"Back to the beginning, if you have not read it yet."},"1151":{"id":"/docs/atomic-angular/results/metadata-and-source","page_id":"/docs/atomic-angular/results/metadata-and-source","type":"page","content":"Metadata & Source","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/metadata-and-source"},"1152":{"id":"/docs/atomic-angular/results/metadata-and-source-0","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source","content":"Two small, read-only display components for a result row — an article field rendered as a row of tags, and the icon identifying which source or collection a document came from."},"1153":{"id":"/docs/atomic-angular/results/metadata-and-source-1","page_id":"/docs/atomic-angular/results/metadata-and-source","type":"heading","tags":[],"url":"/docs/atomic-angular/results/metadata-and-source#metadata","content":"Metadata"},"1154":{"id":"/docs/atomic-angular/results/metadata-and-source-2","page_id":"/docs/atomic-angular/results/metadata-and-source","type":"heading","tags":[],"url":"/docs/atomic-angular/results/metadata-and-source#source","content":"Source"},"1155":{"id":"/docs/atomic-angular/results/metadata-and-source-3","page_id":"/docs/atomic-angular/results/metadata-and-source","type":"heading","tags":[],"url":"/docs/atomic-angular/results/metadata-and-source#whats-next","content":"What's next"},"1156":{"id":"/docs/atomic-angular/results/metadata-and-source-4","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source","content":"Two components that each render one property of an `Article`, nothing more — no interaction, no state."},"1157":{"id":"/docs/atomic-angular/results/metadata-and-source-5","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source#metadata","content":"Renders one `Article` field — `author`, a list of tags, anything array-shaped or scalar — as a row of `Tag`s."},"1158":{"id":"/docs/atomic-angular/results/metadata-and-source-6","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source#metadata","content":"<TypeTable\n  type=\"{\n  article: { type: &#x22;Article&#x22;, description: &#x22;Required.&#x22; },\n  metadata: { type: &#x22;string&#x22;, description: &#x22;Required. Key of the article field to display.&#x22; },\n  limit: { type: &#x22;string | number | undefined&#x22;, description: &#x22;Maximum number of tags shown. All shown by default.&#x22; },\n  variant: { type: '&#x22;primary&#x22; | &#x22;secondary&#x22;', default: '&#x22;primary&#x22;', description: &#x22;Soft fill or outline.&#x22; },\n  scheme: { type: &#x22;TagVariants[\\&#x22;scheme\\&#x22;]&#x22;, default: '&#x22;sage&#x22;', description: &#x22;Any of Tag's 12 color schemes.&#x22; },\n  size: { type: '&#x22;xs&#x22; | &#x22;sm&#x22; | &#x22;md&#x22;', default: '&#x22;xs&#x22;' },\n}\"\n/>"},"1159":{"id":"/docs/atomic-angular/results/metadata-and-source-7","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source#source","content":"Resolves and displays the icon for a document's collection, source or connector, from\n`AppStore`'s `sources` configuration."},"1160":{"id":"/docs/atomic-angular/results/metadata-and-source-8","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source#source","content":"<TypeTable\n  type=\"{\n  collection: { type: &#x22;string[]&#x22;, description: 'Collection path segments, e.g. [&#x22;collection/myCollection&#x22;].' },\n  connector: { type: &#x22;string&#x22;, description: &#x22;Connector name.&#x22; },\n}\"\n/>"},"1161":{"id":"/docs/atomic-angular/results/metadata-and-source-9","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source#source","content":"Resolution order: collection, then source, then connector — provide at least one. Configure overrides through\nthe `sources` customization JSON:"},"1162":{"id":"/docs/atomic-angular/results/metadata-and-source-10","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source#source","content":"An `iconPath` renders an `<img>`; otherwise `iconClass` is applied to an `<i>` element."},"1163":{"id":"/docs/atomic-angular/results/metadata-and-source-11","page_id":"/docs/atomic-angular/results/metadata-and-source","tags":[],"type":"text","url":"/docs/atomic-angular/results/metadata-and-source#whats-next","content":"Another small, configuration-driven display component."},"1164":{"id":"/docs/atomic-angular/results/missing-terms","page_id":"/docs/atomic-angular/results/missing-terms","type":"page","content":"Missing Terms","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/missing-terms"},"1165":{"id":"/docs/atomic-angular/results/missing-terms-0","page_id":"/docs/atomic-angular/results/missing-terms","tags":[],"type":"text","url":"/docs/atomic-angular/results/missing-terms","content":"Which of the query's terms this particular document doesn't contain, struck through, each a link to re-run the search requiring all of them."},"1166":{"id":"/docs/atomic-angular/results/missing-terms-1","page_id":"/docs/atomic-angular/results/missing-terms","type":"heading","tags":[],"url":"/docs/atomic-angular/results/missing-terms#minimal-example","content":"Minimal example"},"1167":{"id":"/docs/atomic-angular/results/missing-terms-2","page_id":"/docs/atomic-angular/results/missing-terms","type":"heading","tags":[],"url":"/docs/atomic-angular/results/missing-terms#how-it-works","content":"How it works"},"1168":{"id":"/docs/atomic-angular/results/missing-terms-3","page_id":"/docs/atomic-angular/results/missing-terms","type":"heading","tags":[],"url":"/docs/atomic-angular/results/missing-terms#options","content":"Options"},"1169":{"id":"/docs/atomic-angular/results/missing-terms-4","page_id":"/docs/atomic-angular/results/missing-terms","type":"heading","tags":[],"url":"/docs/atomic-angular/results/missing-terms#pitfalls","content":"Pitfalls"},"1170":{"id":"/docs/atomic-angular/results/missing-terms-5","page_id":"/docs/atomic-angular/results/missing-terms","type":"heading","tags":[],"url":"/docs/atomic-angular/results/missing-terms#whats-next","content":"What's next"},"1171":{"id":"/docs/atomic-angular/results/missing-terms-6","page_id":"/docs/atomic-angular/results/missing-terms","tags":[],"type":"text","url":"/docs/atomic-angular/results/missing-terms","content":"A document can match a multi-term query without containing every term — `<missing-terms>` reads\n`article.termspresence` and shows the ones absent from this specific document, each one a link that re-runs\nthe search with that term required."},"1172":{"id":"/docs/atomic-angular/results/missing-terms-7","page_id":"/docs/atomic-angular/results/missing-terms","tags":[],"type":"text","url":"/docs/atomic-angular/results/missing-terms#how-it-works","content":"Each rendered term's query params force that term into the search (rather than replacing it), so clicking one\nbroadens the current query instead of starting a new one."},"1173":{"id":"/docs/atomic-angular/results/missing-terms-8","page_id":"/docs/atomic-angular/results/missing-terms","tags":[],"type":"text","url":"/docs/atomic-angular/results/missing-terms#options","content":"<TypeTable\n  type=\"{\n  article: { type: &#x22;Article&#x22;, description: &#x22;Required. Its termspresence array is what this component reads; a document with none renders nothing.&#x22; },\n}\"\n/>"},"1174":{"id":"/docs/atomic-angular/results/missing-terms-9","page_id":"/docs/atomic-angular/results/missing-terms","tags":[],"type":"text","url":"/docs/atomic-angular/results/missing-terms#pitfalls","content":"The component stops click propagation on its own term links for exactly this reason — if a custom result row\nstill sees both events firing, confirm the click handler on the row is not itself intercepting the event\nbefore it reaches this component."},"1175":{"id":"/docs/atomic-angular/results/missing-terms-10","page_id":"/docs/atomic-angular/results/missing-terms","tags":[],"type":"text","url":"/docs/atomic-angular/results/missing-terms#whats-next","content":"Another per-document component — where it sits in a collection hierarchy."},"1176":{"id":"/docs/atomic-angular/results/no-result","page_id":"/docs/atomic-angular/results/no-result","type":"page","content":"No Result","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/no-result"},"1177":{"id":"/docs/atomic-angular/results/no-result-0","page_id":"/docs/atomic-angular/results/no-result","tags":[],"type":"text","url":"/docs/atomic-angular/results/no-result","content":"The stylized zero-match message — and where pagination for a result list actually lives, since the old Pager component is deprecated."},"1178":{"id":"/docs/atomic-angular/results/no-result-1","page_id":"/docs/atomic-angular/results/no-result","type":"heading","tags":[],"url":"/docs/atomic-angular/results/no-result#minimal-example","content":"Minimal example"},"1179":{"id":"/docs/atomic-angular/results/no-result-2","page_id":"/docs/atomic-angular/results/no-result","type":"heading","tags":[],"url":"/docs/atomic-angular/results/no-result#pitfalls","content":"Pitfalls"},"1180":{"id":"/docs/atomic-angular/results/no-result-3","page_id":"/docs/atomic-angular/results/no-result","type":"heading","tags":[],"url":"/docs/atomic-angular/results/no-result#whats-next","content":"What's next"},"1181":{"id":"/docs/atomic-angular/results/no-result-4","page_id":"/docs/atomic-angular/results/no-result","tags":[],"type":"text","url":"/docs/atomic-angular/results/no-result","content":"`<NoResult>` is a purely presentational, input-less message shown when a search genuinely matched nothing —\nsee Query for telling that state apart from a failed request, which is the caller's\nresponsibility, not this component's."},"1182":{"id":"/docs/atomic-angular/results/no-result-5","page_id":"/docs/atomic-angular/results/no-result","tags":[],"type":"text","url":"/docs/atomic-angular/results/no-result#minimal-example","content":"The component takes no input: its icon and title are fixed, translated strings, and the icon's box stays\nsquare as it grows from one line to two (a long translation, a narrow column, mobile) — nothing is exposed to\ntune that."},"1183":{"id":"/docs/atomic-angular/results/no-result-6","page_id":"/docs/atomic-angular/results/no-result","tags":[],"type":"text","url":"/docs/atomic-angular/results/no-result#pitfalls","content":"`PagerComponent` still exists but lives under `components/deprecated/` and is not part of the pages this\nmigration documents — it predates `QueryService.gotoPage()`, which is the current, supported way to move\nbetween pages. See Query."},"1184":{"id":"/docs/atomic-angular/results/no-result-7","page_id":"/docs/atomic-angular/results/no-result","tags":[],"type":"text","url":"/docs/atomic-angular/results/no-result#whats-next","content":"Tell a genuine zero-match apart from a failed request, and page through a result."},"1185":{"id":"/docs/atomic-angular/results/query","page_id":"/docs/atomic-angular/results/query","type":"page","content":"Query","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/query"},"1186":{"id":"/docs/atomic-angular/results/query-0","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query","content":"Run a search, tell a failed request apart from a genuine zero results, and page through a result — the service every result-rendering component in this library sits on top of."},"1187":{"id":"/docs/atomic-angular/results/query-1","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#minimal-example","content":"Minimal example"},"1188":{"id":"/docs/atomic-angular/results/query-2","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#how-it-works","content":"How it works"},"1189":{"id":"/docs/atomic-angular/results/query-3","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#recipes","content":"Recipes"},"1190":{"id":"/docs/atomic-angular/results/query-4","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#paging-through-a-result","content":"Paging through a result"},"1191":{"id":"/docs/atomic-angular/results/query-5","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#running-several-queries-in-parallel","content":"Running several queries in parallel"},"1192":{"id":"/docs/atomic-angular/results/query-6","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#options","content":"Options"},"1193":{"id":"/docs/atomic-angular/results/query-7","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#pitfalls","content":"Pitfalls"},"1194":{"id":"/docs/atomic-angular/results/query-8","page_id":"/docs/atomic-angular/results/query","type":"heading","tags":[],"url":"/docs/atomic-angular/results/query#whats-next","content":"What's next"},"1195":{"id":"/docs/atomic-angular/results/query-9","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query","content":"`QueryService` is the one place a search actually happens: it turns a `Query` into a request, exposes the last\n`Result` and its failure state as signals, and moves between pages. Almost every other component in this\nsection — sorting, spelling correction, missing terms — reads the `Result` this service produced rather than\nissuing a request of its own."},"1196":{"id":"/docs/atomic-angular/results/query-10","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query","content":"A search that fails still resolves to a `Result` — the request never throws — with the failure captured on\n`$error` instead. An empty `records` array is ambiguous by itself: it means \"the corpus matched nothing\" on a\nsuccessful request, and \"something went wrong\" on a failed one. Check `$error` first, always."},"1197":{"id":"/docs/atomic-angular/results/query-11","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#how-it-works","content":"`search()` still returns an `Observable<Result>` for callers that want to compose it, but the same `Result`\nalso lands on the `result` signal (and `failure`, `result().$error`) — which is what a template reads instead\nof subscribing manually. **The observable never errors**: a failed request still emits, because throwing would\ncancel the navigation of any route resolver built on this service, which historically rendered an empty page\ninstead."},"1198":{"id":"/docs/atomic-angular/results/query-12","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#how-it-works","content":"`provideAtomicNotifications()` (see Notify failed requests as\ntoasts) already surfaces every failed request to the *user* as a\ntoast — but that leaves the *component* still rendering \"0 results\" underneath unless it also checks\n`$error` itself. The two are complementary, not either/or."},"1199":{"id":"/docs/atomic-angular/results/query-13","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#running-several-queries-in-parallel","content":"Results come back in the same order as the input queries — index them by position, not by matching them back\nto a query afterward."},"1200":{"id":"/docs/atomic-angular/results/query-14","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#options","content":"<TypeTable\n  type=\"{\n  &#x22;search(q?, includeQueryParams?, audit?)&#x22;: {\n    type: &#x22;(q?: Partial<Query>, includeQueryParams?: boolean, audit?: AuditEvents): Observable<Result>&#x22;,\n    description: &#x22;includeQueryParams (default true) merges the current URL query params automatically.&#x22;,\n  },\n  &#x22;bulkSearch(q, audit?)&#x22;: { type: &#x22;(q: Query[], audit?: AuditEvents): Observable<Result[]>&#x22; },\n  &#x22;gotoPage(page)&#x22;: { type: &#x22;(page: number): void&#x22; },\n  result: { type: &#x22;Signal<Result>&#x22;, description: &#x22;The last result, whether it succeeded or failed.&#x22; },\n  failure: { type: &#x22;Signal<ApiError | undefined>&#x22;, description: &#x22;result().$error — set only on a failed request.&#x22; },\n}\"\n/>"},"1201":{"id":"/docs/atomic-angular/results/query-15","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#pitfalls","content":"You checked `records.length` (or `rowCount`) without checking `$error` first — both a genuine zero-match and a\nfailed request (a 500 on a bad filter, most often) arrive as an empty `records` array. Check `failure()`\n(or `result().$error`) before drawing any conclusion from an empty result."},"1202":{"id":"/docs/atomic-angular/results/query-16","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#pitfalls","content":"It should not throw — the whole point of carrying the failure on `$error` is that `search()` never errors the\nobservable. If nothing fires at all, check that the query actually reached the service (a route resolver that\nswallowed the query, most often), not this service's error handling."},"1203":{"id":"/docs/atomic-angular/results/query-17","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#whats-next","content":"Suggestions as the user types, before a search is even run."},"1204":{"id":"/docs/atomic-angular/results/query-18","page_id":"/docs/atomic-angular/results/query","tags":[],"type":"text","url":"/docs/atomic-angular/results/query#whats-next","content":"Turn a corrected result's didYouMean property into the right message."},"1205":{"id":"/docs/atomic-angular/results/sort-selector","page_id":"/docs/atomic-angular/results/sort-selector","type":"page","content":"Sort Selector","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/sort-selector"},"1206":{"id":"/docs/atomic-angular/results/sort-selector-0","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector","content":"A dropdown listing the sort choices a tab or query configuration actually offers, resolved from the current result rather than passed in by hand."},"1207":{"id":"/docs/atomic-angular/results/sort-selector-1","page_id":"/docs/atomic-angular/results/sort-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sort-selector#minimal-example","content":"Minimal example"},"1208":{"id":"/docs/atomic-angular/results/sort-selector-2","page_id":"/docs/atomic-angular/results/sort-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sort-selector#how-it-works","content":"How it works"},"1209":{"id":"/docs/atomic-angular/results/sort-selector-3","page_id":"/docs/atomic-angular/results/sort-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sort-selector#options","content":"Options"},"1210":{"id":"/docs/atomic-angular/results/sort-selector-4","page_id":"/docs/atomic-angular/results/sort-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sort-selector#pitfalls","content":"Pitfalls"},"1211":{"id":"/docs/atomic-angular/results/sort-selector-5","page_id":"/docs/atomic-angular/results/sort-selector","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sort-selector#whats-next","content":"What's next"},"1212":{"id":"/docs/atomic-angular/results/sort-selector-6","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector","content":"`<sort-selector>` reads which sort choices apply from the **result** it is given — a tab search and a regular\nquery can expose different lists, and the component resolves the right one instead of the caller having to\nknow which applies."},"1213":{"id":"/docs/atomic-angular/results/sort-selector-7","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector#how-it-works","content":"**Tab search** — extracts sorting choices from the specific tab's own configuration (`tab.sortingChoices`),\nfalling back to the query's if the tab defines none."},"1214":{"id":"/docs/atomic-angular/results/sort-selector-8","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector#how-it-works","content":"**Regular query** — uses the query configuration's `sortingChoices` directly."},"1215":{"id":"/docs/atomic-angular/results/sort-selector-9","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector#how-it-works","content":"Either way, a choice whose `orderByClause` includes `globalrelevance` is filtered out when the result has no\nrelevance score (`!result().hasRelevance`) — a relevance sort makes no sense without one."},"1216":{"id":"/docs/atomic-angular/results/sort-selector-10","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector#options","content":"<TypeTable\n  type=\"{\n  result: { type: &#x22;Result&#x22;, description: &#x22;Required. Identifies the query (by name) and, for a tab search, which tab's choices apply.&#x22; },\n  position: { type: &#x22;Placement&#x22;, default: '&#x22;bottom-start&#x22;', description: &#x22;Dropdown placement, from @floating-ui/dom.&#x22; },\n  tabIndex: {\n    type: &#x22;number | undefined&#x22;,\n    description: &#x22;Set inside an ngToolbar with a roving tabindex (0 for the active widget, -1 otherwise); leave undefined outside one.&#x22;,\n  },\n}\"\n/>"},"1217":{"id":"/docs/atomic-angular/results/sort-selector-11","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector#options","content":"`onSort` emits a `SortingChoice` (the configured choice plus a resolved `$isDesc` boolean) only when the user\npicks a **different** option than the one currently active — reselecting the active sort emits nothing."},"1218":{"id":"/docs/atomic-angular/results/sort-selector-12","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector#pitfalls","content":"Check whether its `orderByClause` targets `globalrelevance` — those choices are filtered out whenever the\ncurrent result has no relevance score (`hasRelevance` is `false`), regardless of the configuration."},"1219":{"id":"/docs/atomic-angular/results/sort-selector-13","page_id":"/docs/atomic-angular/results/sort-selector","tags":[],"type":"text","url":"/docs/atomic-angular/results/sort-selector#whats-next","content":"Where the Result this component reads sortingChoices from comes from."},"1220":{"id":"/docs/atomic-angular/results/sponsored-results","page_id":"/docs/atomic-angular/results/sponsored-results","type":"page","content":"Sponsored Results","breadcrumbs":["Docs","Atomic Angular","Results"],"tags":[],"url":"/docs/atomic-angular/results/sponsored-results"},"1221":{"id":"/docs/atomic-angular/results/sponsored-results-0","page_id":"/docs/atomic-angular/results/sponsored-results","tags":[],"type":"text","url":"/docs/atomic-angular/results/sponsored-results","content":"Up to three promoted links relevant to the current query, each opening in a new window with a \"PROMOTED\" badge — customizable, and query-parameter overridable for testing."},"1222":{"id":"/docs/atomic-angular/results/sponsored-results-1","page_id":"/docs/atomic-angular/results/sponsored-results","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sponsored-results#minimal-example","content":"Minimal example"},"1223":{"id":"/docs/atomic-angular/results/sponsored-results-2","page_id":"/docs/atomic-angular/results/sponsored-results","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sponsored-results#recipes","content":"Recipes"},"1224":{"id":"/docs/atomic-angular/results/sponsored-results-3","page_id":"/docs/atomic-angular/results/sponsored-results","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sponsored-results#a-custom-promoted-badge","content":"A custom \"Promoted\" badge"},"1225":{"id":"/docs/atomic-angular/results/sponsored-results-4","page_id":"/docs/atomic-angular/results/sponsored-results","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sponsored-results#options","content":"Options"},"1226":{"id":"/docs/atomic-angular/results/sponsored-results-5","page_id":"/docs/atomic-angular/results/sponsored-results","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sponsored-results#pitfalls","content":"Pitfalls"},"1227":{"id":"/docs/atomic-angular/results/sponsored-results-6","page_id":"/docs/atomic-angular/results/sponsored-results","type":"heading","tags":[],"url":"/docs/atomic-angular/results/sponsored-results#whats-next","content":"What's next"},"1228":{"id":"/docs/atomic-angular/results/sponsored-results-7","page_id":"/docs/atomic-angular/results/sponsored-results","tags":[],"type":"text","url":"/docs/atomic-angular/results/sponsored-results","content":"`<sponsored-results>` fetches and renders the application's configured sponsored links for the current query —\na small, self-contained list with no filtering or paging of its own."},"1229":{"id":"/docs/atomic-angular/results/sponsored-results-8","page_id":"/docs/atomic-angular/results/sponsored-results","tags":[],"type":"text","url":"/docs/atomic-angular/results/sponsored-results#a-custom-promoted-badge","content":"Project a template marked with `*childMarker` to replace the default badge."},"1230":{"id":"/docs/atomic-angular/results/sponsored-results-9","page_id":"/docs/atomic-angular/results/sponsored-results","tags":[],"type":"text","url":"/docs/atomic-angular/results/sponsored-results#options","content":"<TypeTable\n  type=\"{\n  slice: { type: &#x22;number&#x22;, default: &#x22;3&#x22;, description: &#x22;Maximum number of sponsored results shown. Also overridable per-request with the maxSponsoredResults query parameter.&#x22; },\n  displayPromoted: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Shows the \\&#x22;PROMOTED\\&#x22; badge. Also overridable with the displayPromoted query parameter.&#x22; },\n}\"\n/>"},"1231":{"id":"/docs/atomic-angular/results/sponsored-results-10","page_id":"/docs/atomic-angular/results/sponsored-results","tags":[],"type":"text","url":"/docs/atomic-angular/results/sponsored-results#pitfalls","content":"It should not — the host's `role` is set conditionally to `\"list\"` only once there is at least one sponsored\nresult, precisely to avoid exposing a list landmark with no list items when there is nothing to show."},"1232":{"id":"/docs/atomic-angular/results/sponsored-results-11","page_id":"/docs/atomic-angular/results/sponsored-results","tags":[],"type":"text","url":"/docs/atomic-angular/results/sponsored-results#whats-next","content":"Another small, configuration-driven display component."},"1233":{"id":"/docs/atomic-angular/reference/feature-flags","page_id":"/docs/atomic-angular/reference/feature-flags","type":"page","content":"Feature flags","breadcrumbs":["Docs","Atomic Angular","Reference"],"tags":[],"url":"/docs/atomic-angular/reference/feature-flags"},"1234":{"id":"/docs/atomic-angular/reference/feature-flags-0","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags","content":"Every key of the app's general.features/feedback configuration, which ones actually gate behavior, and the live admin editor for testing them."},"1235":{"id":"/docs/atomic-angular/reference/feature-flags-1","page_id":"/docs/atomic-angular/reference/feature-flags","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/feature-flags#minimal-example","content":"Minimal example"},"1236":{"id":"/docs/atomic-angular/reference/feature-flags-2","page_id":"/docs/atomic-angular/reference/feature-flags","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/feature-flags#how-it-works","content":"How it works"},"1237":{"id":"/docs/atomic-angular/reference/feature-flags-3","page_id":"/docs/atomic-angular/reference/feature-flags","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/feature-flags#options","content":"Options"},"1238":{"id":"/docs/atomic-angular/reference/feature-flags-4","page_id":"/docs/atomic-angular/reference/feature-flags","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/feature-flags#generalfeatures--boolean-flags","content":"`general.features` — boolean flags"},"1239":{"id":"/docs/atomic-angular/reference/feature-flags-5","page_id":"/docs/atomic-angular/reference/feature-flags","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/feature-flags#generalfeedback--six-independent-switches","content":"`general.feedback` — six independent switches"},"1240":{"id":"/docs/atomic-angular/reference/feature-flags-6","page_id":"/docs/atomic-angular/reference/feature-flags","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/feature-flags#pitfalls","content":"Pitfalls"},"1241":{"id":"/docs/atomic-angular/reference/feature-flags-7","page_id":"/docs/atomic-angular/reference/feature-flags","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/feature-flags#whats-next","content":"What's next"},"1242":{"id":"/docs/atomic-angular/reference/feature-flags-8","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags","content":"An application customizes its behavior mostly through the `general` object of its JSON configuration (a\ntop-level `general` key, or a `general` customJSON side-file) — read once through `AppStore.general()`. This\npage is the one place that lists every key of `general.features`/`general.feedback` **and says which ones a\nconsumer actually checks**, since a name in the type is not a promise that anything reads it."},"1243":{"id":"/docs/atomic-angular/reference/feature-flags-9","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags","content":"Sinequa configuration ships either **inline**, inside the app's main JSON, or as a named **customJSON**\nside-file merged in under the same key at runtime. `general.features.quickFilter` reads identically either\nway — `AppStore.general()` resolves whichever source is present, inline or customJSON, and returns `{}` if\nneither is."},"1244":{"id":"/docs/atomic-angular/reference/feature-flags-10","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#minimal-example","content":"Opening the live editor — an imperative dialog, like every other dialog in this library."},"1245":{"id":"/docs/atomic-angular/reference/feature-flags-11","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#how-it-works","content":"`FeatureFlagsDialogComponent` reads `AppStore.general()` and lets an **administrator** edit it live: every\nedit rewrites the whole `general` object back onto the store through the same source it was read from (the\n`general` customJSON if the app has one, otherwise inline `data.general`), so unknown keys the dialog does not\nknow about survive the round-trip. A non-administrator still gets the dialog, with an \"admin only\" notice\ninstead of the editor — there is no separate access check to remember on the caller's side."},"1246":{"id":"/docs/atomic-angular/reference/feature-flags-12","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#how-it-works","content":"Changes apply to the current session only — nothing is persisted back to the backend configuration — which is\nwhat makes the tool suitable for testing a behavior without touching the deployment."},"1247":{"id":"/docs/atomic-angular/reference/feature-flags-13","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#generalfeatures--boolean-flags","content":"<TypeTable\n  type=\"{\n  quickFilter: { type: &#x22;boolean&#x22;, description: &#x22;List/tree: clicking an item's label applies its filter immediately. Consumed — see aggregation Pitfalls.&#x22; },\n  showAggregationItemCount: { type: &#x22;boolean&#x22;, description: &#x22;Consumed by the aggregation item count display.&#x22; },\n  previewMultiConversion: { type: &#x22;boolean&#x22;, description: &#x22;Consumed by the preview's format-conversion picker.&#x22; },\n  persistFiltersAcrossTabs: { type: &#x22;boolean&#x22;, description: &#x22;Consumed by the tabs feature to keep filters when switching tabs.&#x22; },\n  filterLinkChildren: { type: &#x22;boolean&#x22;, description: &#x22;Consumed by tree-filter linking behavior.&#x22; },\n  allowChangePassword: {\n    type: &#x22;boolean&#x22;,\n    description: &#x22;Consumed — gates the change-password entry point together with an editable partition and a credentials auth mode.&#x22;,\n  },\n  editablepartition: {\n    type: &#x22;boolean&#x22;,\n    description: &#x22;Inert — editable in this dialog, but nothing in the library reads this key to gate any behavior.&#x22;,\n  },\n  advancedSearch: {\n    type: &#x22;boolean&#x22;,\n    description: &#x22;Inert — editable in this dialog, but nothing in the library reads this key; the advanced-search panel's own availability does not check it.&#x22;,\n  },\n  allowChatDrawer: {\n    type: &#x22;boolean&#x22;,\n    description: &#x22;Deprecated and inert — it gated the chat of the removed drawer. No longer listed in the dialog's catalog: it only shows up there, as an extra flag, when the stored configuration still carries it. Drop it from your configuration.&#x22;,\n  },\n  expandPreview: {\n    type: &#x22;boolean&#x22;,\n    description: &#x22;Inert — editable in this dialog, but nothing in the library reads this key.&#x22;,\n  },\n  &#x22;assistant.usePrefixName&#x22;: { type: &#x22;boolean&#x22;, description: &#x22;Consumed by the assistant feature.&#x22; },\n  &#x22;filters.homepage&#x22;: { type: &#x22;boolean&#x22;, description: &#x22;Consumed — see Filters bar's homepage behavior.&#x22; },\n  &#x22;userProfile.enabled&#x22;: { type: &#x22;boolean&#x22;, description: &#x22;Consumed — gates the User Profile entry point.&#x22; },\n}\"\n/>"},"1248":{"id":"/docs/atomic-angular/reference/feature-flags-14","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#generalfeedback--six-independent-switches","content":"<TypeTable\n  type=\"{\n  like: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Absent is treated as enabled — every switch defaults to on.&#x22; },\n  dislike: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  content: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  ui: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  lang: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  other: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n}\"\n/>"},"1249":{"id":"/docs/atomic-angular/reference/feature-flags-15","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#pitfalls","content":"Check it against the tables above first: `editablepartition`, `advancedSearch` and `expandPreview` are\nall editable here because they exist in the `CFeatures` type, but no consumer in this\nlibrary reads them — toggling them only changes the stored configuration value, with no observable effect.\nThis was confirmed by searching the library's sources for a reader of each key, not assumed from the name."},"1250":{"id":"/docs/atomic-angular/reference/feature-flags-16","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#pitfalls","content":"`APP_FEATURES` is deprecated — it is a separate, older injection token, unrelated to `general.features` and not\nread by this dialog or by `AppStore`. Use `general.features` (edited here, read via `AppStore.general()`)\ninstead."},"1251":{"id":"/docs/atomic-angular/reference/feature-flags-17","page_id":"/docs/atomic-angular/reference/feature-flags","tags":[],"type":"text","url":"/docs/atomic-angular/reference/feature-flags#whats-next","content":"The service, directive and help dialog behind every registered shortcut."},"1252":{"id":"/docs/atomic-angular/reference/highlights","page_id":"/docs/atomic-angular/reference/highlights","type":"page","content":"Highlights","breadcrumbs":["Docs","Atomic Angular","Reference"],"tags":[],"url":"/docs/atomic-angular/reference/highlights"},"1253":{"id":"/docs/atomic-angular/reference/highlights-0","page_id":"/docs/atomic-angular/reference/highlights","tags":[],"type":"text","url":"/docs/atomic-angular/reference/highlights","content":"The injection token configuring the five preview highlight categories — company, geo, person, extract locations, match locations — and how to override their colors."},"1254":{"id":"/docs/atomic-angular/reference/highlights-1","page_id":"/docs/atomic-angular/reference/highlights","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/highlights#options","content":"Options"},"1255":{"id":"/docs/atomic-angular/reference/highlights-2","page_id":"/docs/atomic-angular/reference/highlights","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/highlights#recipes","content":"Recipes"},"1256":{"id":"/docs/atomic-angular/reference/highlights-3","page_id":"/docs/atomic-angular/reference/highlights","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/highlights#overriding-one-highlights-colors","content":"Overriding one highlight's colors"},"1257":{"id":"/docs/atomic-angular/reference/highlights-4","page_id":"/docs/atomic-angular/reference/highlights","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/highlights#whats-next","content":"What's next"},"1258":{"id":"/docs/atomic-angular/reference/highlights-5","page_id":"/docs/atomic-angular/reference/highlights","tags":[],"type":"text","url":"/docs/atomic-angular/reference/highlights","content":"`HIGHLIGHTS` configures the colors the document preview uses to highlight five categories of text — entities\nthe engine extracted, and the terms that matched the query. It ships with defaults and can be overridden\nper-application."},"1259":{"id":"/docs/atomic-angular/reference/highlights-6","page_id":"/docs/atomic-angular/reference/highlights","tags":[],"type":"text","url":"/docs/atomic-angular/reference/highlights#options","content":"<TypeTable\n  type=\"{\n  name: {\n    type: '&#x22;company&#x22; | &#x22;geo&#x22; | &#x22;person&#x22; | &#x22;extractslocations&#x22; | &#x22;matchlocations&#x22;',\n    description: &#x22;The highlight category.&#x22;,\n  },\n  color: { type: &#x22;string&#x22;, description: &#x22;Text color.&#x22; },\n  bgColor: { type: &#x22;string&#x22;, description: &#x22;Background color.&#x22; },\n}\"\n/>"},"1260":{"id":"/docs/atomic-angular/reference/highlights-7","page_id":"/docs/atomic-angular/reference/highlights","tags":[],"type":"text","url":"/docs/atomic-angular/reference/highlights#overriding-one-highlights-colors","content":"`HIGHLIGHTS`'s default factory returns all five; a `provide` override replaces the whole array, so keep every\nentry you are not changing."},"1261":{"id":"/docs/atomic-angular/reference/highlights-8","page_id":"/docs/atomic-angular/reference/highlights","tags":[],"type":"text","url":"/docs/atomic-angular/reference/highlights#whats-next","content":"Every key of the app's general configuration, and which ones actually gate behavior."},"1262":{"id":"/docs/atomic-angular/reference","page_id":"/docs/atomic-angular/reference","type":"page","content":"Reference","breadcrumbs":["Docs","Atomic Angular","Reference"],"tags":[],"url":"/docs/atomic-angular/reference"},"1263":{"id":"/docs/atomic-angular/reference-0","page_id":"/docs/atomic-angular/reference","tags":[],"type":"text","url":"/docs/atomic-angular/reference","content":"Feature flags, keyboard shortcuts and user settings/profile — looked up, not learned."},"1264":{"id":"/docs/atomic-angular/reference-1","page_id":"/docs/atomic-angular/reference","type":"heading","tags":[],"url":"/docs/atomic-angular/reference#whats-next","content":"What's next"},"1265":{"id":"/docs/atomic-angular/reference-2","page_id":"/docs/atomic-angular/reference","tags":[],"type":"text","url":"/docs/atomic-angular/reference","content":"The type declarations in your editor are the exhaustive reference for every input, output and exported type —\nduplicating them here would only let the two drift apart. This section stays small on purpose (DOCS-PLAYBOOK.md\n§3) and exists only for the handful of things autocompletion cannot answer on its own — starting with which\nconfiguration keys actually do something."},"1266":{"id":"/docs/atomic-angular/reference-3","page_id":"/docs/atomic-angular/reference","tags":[],"type":"text","url":"/docs/atomic-angular/reference#whats-next","content":"Every key of general.features/feedback, and which ones a consumer actually checks."},"1267":{"id":"/docs/atomic-angular/reference-4","page_id":"/docs/atomic-angular/reference","tags":[],"type":"text","url":"/docs/atomic-angular/reference#whats-next","content":"The service, directive and help dialog behind every registered shortcut."},"1268":{"id":"/docs/atomic-angular/reference-5","page_id":"/docs/atomic-angular/reference","tags":[],"type":"text","url":"/docs/atomic-angular/reference#whats-next","content":"The store persisting bookmarks, searches, baskets and alerts to the backend."},"1269":{"id":"/docs/atomic-angular/reference-6","page_id":"/docs/atomic-angular/reference","tags":[],"type":"text","url":"/docs/atomic-angular/reference#whats-next","content":"Load and edit the signed-in user's profile, one property at a time."},"1270":{"id":"/docs/atomic-angular/reference-7","page_id":"/docs/atomic-angular/reference","tags":[],"type":"text","url":"/docs/atomic-angular/reference#whats-next","content":"The five preview highlight categories, and how to override their colors."},"1271":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"page","content":"Keyboard shortcuts","breadcrumbs":["Docs","Atomic Angular","Reference"],"tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts"},"1272":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-0","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts","content":"Register a global or page-scoped keyboard shortcut that works on every layout, with a self-documenting help dialog and no manual cleanup."},"1273":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-1","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts#minimal-example","content":"Minimal example"},"1274":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-2","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts#how-it-works","content":"How it works"},"1275":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-3","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts#recipes","content":"Recipes"},"1276":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-4","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts#registering-without-an-element","content":"Registering without an element"},"1277":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-5","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts#options","content":"Options"},"1278":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-6","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts#pitfalls","content":"Pitfalls"},"1279":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-7","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/keyboard-shortcuts#whats-next","content":"What's next"},"1280":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-8","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts","content":"A keyboard shortcut usually means three things to get right at once: comparing the right kind of key across\nkeyboard layouts, not stealing a keystroke a text field or another component needs, and keeping a help list\nthat does not drift from what is actually registered. `KeyboardShortcutsService` is one `keydown` listener, one\nregistry, and a `[keyShortcut]` directive for the common case — built to replace an older engine that could\nnot be made correct on a non-US layout."},"1281":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-9","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts","content":"`event.key` is the **character** a key produces — layout-dependent, so `\"1\"` unshifted is `&` on an AZERTY\nkeyboard. `event.code` is the **physical position** — layout-independent. Digits are compared by `event.code`\nhere specifically because a written `Alt+1` should reach the same physical key everywhere; every other key is\ncompared by `event.key`, since a printed letter is what a person actually reads off their keyboard."},"1282":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-10","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#minimal-example","content":"`[keyShortcut]` registers the combination, writes `aria-keyshortcuts` on the host so assistive technology\nannounces it, and activates the host when the combination fires — the same `(click)` serves the mouse, the\nTab-and-Enter path, and the shortcut, in one code path. The registration disappears with the element, which is\nwhat gives a page-scoped shortcut with nothing to clean up by hand."},"1283":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-11","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#how-it-works","content":"Capture phase, deliberately: several components in this library stop propagation on `keydown` of their own\n(`ngCombobox` on Enter and the arrows, a galactik `ListItem` on Delete, dialogs on Escape) — a bubble-phase\nlistener would be at their mercy. The service only ever consumes an event once a registration actually\nmatches, so it does not steal a key a component below it wants."},"1284":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-12","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#how-it-works","content":"One stack per combination: the **last** registration wins, and the previous one comes back once it\nunregisters — modeling what a panel opening over a page should do to the shortcuts underneath it."},"1285":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-13","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#registering-without-an-element","content":"For a shortcut with no control behind it — a help dialog, a diagnostics panel."},"1286":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-14","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#registering-without-an-element","content":"`KeyboardShortcutsDialog` lists whatever is currently registered, grouped by `categoryKey` — it observes the\nlive registry rather than a hand-written list, which is what keeps the help dialog from drifting away from\nwhat actually works. Opened from a page that registers nothing, it lists nothing, deliberately, rather than a\nlist half of which does not apply."},"1287":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-15","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#options","content":"<TypeTable\n  type=\"{\n  combo: { type: &#x22;string | readonly string[]&#x22;, description: &#x22;One or more written combinations, e.g. \\&#x22;Alt+1\\&#x22; or [\\&#x22;Alt+0\\&#x22;, \\&#x22;Shift+?\\&#x22;].&#x22; },\n  labelKey: { type: &#x22;string&#x22;, description: &#x22;Transloco key of the help-dialog label. Without it, the shortcut is not listed there.&#x22; },\n  categoryKey: { type: &#x22;string&#x22;, description: &#x22;Transloco key of the help dialog's group heading.&#x22; },\n  hidden: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Keeps a registered shortcut out of the help dialog.&#x22; },\n  global: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Stays active while a modal is open. Reserve it for tools like the help dialog itself.&#x22; },\n  preventDefault: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  stopPropagation: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22; },\n  run: { type: &#x22;(event: KeyboardEvent) => void&#x22;, description: &#x22;The action.&#x22; },\n}\"\n/>"},"1288":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-16","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#options","content":"`[keyShortcut]` mirrors this as inputs: `keyShortcut` (the combo, required), `shortcutLabelKey`,\n`shortcutCategoryKey`, `shortcutDisabled` (unregisters while `true`), `shortcutHidden`, `shortcutGlobal`."},"1289":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-17","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#pitfalls","content":"Confirm the combination compares by physical position for a digit — `Alt+1` does, automatically, since digits\nare always promoted to `event.code`. If a *letter* shortcut seems dead specifically on macOS, that is the next\nentry."},"1290":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-18","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#pitfalls","content":"`⌥`+`e`/`u`/`i`/`n` (and others) are dead keys on macOS, used to type `é`, `ü`, `ñ`. Registering `Alt+e` steals\nthat combination system-wide for every app using this service. Prefer `Alt+`*digit* instead, which is free in\nevery browser and compared by physical key."},"1291":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-19","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#pitfalls","content":"That combination is AltGr on Windows, used to compose characters — the service drops those events entirely,\nso a shortcut bound to it is unreachable. Registering it also logs a warning in development mode."},"1292":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-20","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#pitfalls","content":"Expected: a bare-key shortcut is ignored while focus is in a text field, `contenteditable`, a `<select>` or an\nARIA text role — the keystroke belongs to the field. Add a modifier other than Shift if the shortcut needs to\nfire while typing."},"1293":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-21","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#pitfalls","content":"A route held by a `RouteReuseStrategy` is not destroyed on navigation, so a `[keyShortcut]` on it stays\nregistered even though the page is no longer visible. Bind `[shortcutDisabled]` to whether the route is\ncurrently active."},"1294":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-22","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#pitfalls","content":"By design — the registry is one stack per combination, last registration wins, and a duplicate logs a warning\nin development mode. If both are meant to be reachable, use different combinations; if one is meant to\ntemporarily override the other (a panel opening over a page), this is the intended behavior — the covered one\ncomes back once the covering one unregisters."},"1295":{"id":"/docs/atomic-angular/reference/keyboard-shortcuts-23","page_id":"/docs/atomic-angular/reference/keyboard-shortcuts","tags":[],"type":"text","url":"/docs/atomic-angular/reference/keyboard-shortcuts#whats-next","content":"Every key of the app's general configuration, and which ones actually gate behavior."},"1296":{"id":"/docs/atomic-angular/reference/user-profile","page_id":"/docs/atomic-angular/reference/user-profile","type":"page","content":"User profile","breadcrumbs":["Docs","Atomic Angular","Reference"],"tags":[],"url":"/docs/atomic-angular/reference/user-profile"},"1297":{"id":"/docs/atomic-angular/reference/user-profile-0","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile","content":"Load and edit the signed-in user's profile, one property at a time, through a Signal Forms field tree hosted in an imperative dialog."},"1298":{"id":"/docs/atomic-angular/reference/user-profile-1","page_id":"/docs/atomic-angular/reference/user-profile","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-profile#minimal-example","content":"Minimal example"},"1299":{"id":"/docs/atomic-angular/reference/user-profile-2","page_id":"/docs/atomic-angular/reference/user-profile","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-profile#how-it-works","content":"How it works"},"1300":{"id":"/docs/atomic-angular/reference/user-profile-3","page_id":"/docs/atomic-angular/reference/user-profile","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-profile#options","content":"Options"},"1301":{"id":"/docs/atomic-angular/reference/user-profile-4","page_id":"/docs/atomic-angular/reference/user-profile","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-profile#pitfalls","content":"Pitfalls"},"1302":{"id":"/docs/atomic-angular/reference/user-profile-5","page_id":"/docs/atomic-angular/reference/user-profile","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-profile#whats-next","content":"What's next"},"1303":{"id":"/docs/atomic-angular/reference/user-profile-6","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile","content":"`UserProfileFormComponent` renders and edits the current user's profile; `UserProfile` hosts that form in a\ncallable dialog. The form edits one property at a time — each row is read-only until its edit button is\npressed, and saving sends a `PATCH` for that single property only, never the whole profile."},"1304":{"id":"/docs/atomic-angular/reference/user-profile-7","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#minimal-example","content":"`UserProfileFormComponent` can also be embedded directly (`<user-profile-form />`, no inputs — it resolves the\nprofile itself from `PrincipalStore` and `UserProfileService`) when a host wants it inline rather than in a\ndialog."},"1305":{"id":"/docs/atomic-angular/reference/user-profile-8","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#how-it-works","content":"Which properties appear is configuration-driven: `general.features.userProfile.data` selects the standard\nprofile keys, `customData` adds free-form ones. The form model is a `linkedSignal` — a successful save, a\ndeletion or a profile reload re-seeds every field from server state, which is what discards a cancelled draft\nwith no manual DOM restore."},"1306":{"id":"/docs/atomic-angular/reference/user-profile-9","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#options","content":"<TypeTable\n  type=\"{\n  currentLanguage: { type: &#x22;model<string | null>&#x22;, description: &#x22;The language shown in the picker. null is the empty state — never undefined, which would orphan the Select's field (NG01902).&#x22; },\n  changingPassword: { type: &#x22;Signal<boolean>&#x22;, description: &#x22;Whether the inline ChangePassword form replaces the profile fields.&#x22; },\n  allowChangePassword: { type: &#x22;Signal<boolean>&#x22;, description: &#x22;Whether the deployment offers a password change: the feature flag, a credentials auth mode, and an editable partition, all three.&#x22; },\n  &#x22;changeLanguage()&#x22;: { type: &#x22;(): void&#x22;, description: &#x22;Applies currentLanguage() to UserSettingsStore and to Transloco.&#x22; },\n}\"\n/>"},"1307":{"id":"/docs/atomic-angular/reference/user-profile-10","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#options","content":"`UserProfileFormComponent` takes no input and has no output — everything else is protected, internal wiring."},"1308":{"id":"/docs/atomic-angular/reference/user-profile-11","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#options","content":"<TypeTable\n  type=\"{\n  &#x22;getUserProfile(userId)&#x22;: {\n    type: &#x22;(userId: Signal<string | undefined>): HttpResourceRef<UserProfile | undefined>&#x22;,\n    description: &#x22;UserProfileService. A signal of undefined issues no request.&#x22;,\n  },\n}\"\n/>"},"1309":{"id":"/docs/atomic-angular/reference/user-profile-12","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#pitfalls","content":"Store `\"\"` for a deleted property, never `undefined` — Signal Forms excludes `undefined` properties from the\nfield tree entirely, which orphans the control still bound to that key. The built-in delete action already\ndoes this; only relevant if you build a custom mutator against the same field tree."},"1310":{"id":"/docs/atomic-angular/reference/user-profile-13","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#pitfalls","content":"`UserProfileFormComponent` renders its own `<form>`, and so does the `ChangePassword` view it hosts inline.\nNever wrap it in a `<form>` of your own — nested `<form>` elements are invalid HTML, and the outer one's submit\nbehavior becomes unpredictable."},"1311":{"id":"/docs/atomic-angular/reference/user-profile-14","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#pitfalls","content":"`allowChangePassword` alone is not sufficient — the computed also requires a `credentials` auth mode and an\neditable partition. Check all three before assuming the flag is inert (unlike the four flags that genuinely\nare — see Feature flags)."},"1312":{"id":"/docs/atomic-angular/reference/user-profile-15","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#whats-next","content":"Where general.features.userProfile and allowChangePassword are configured."},"1313":{"id":"/docs/atomic-angular/reference/user-profile-16","page_id":"/docs/atomic-angular/reference/user-profile","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-profile#whats-next","content":"The form UserProfile hosts inline when the deployment allows it."},"1314":{"id":"/docs/atomic-angular/reference/user-settings","page_id":"/docs/atomic-angular/reference/user-settings","type":"page","content":"User settings","breadcrumbs":["Docs","Atomic Angular","Reference"],"tags":[],"url":"/docs/atomic-angular/reference/user-settings"},"1315":{"id":"/docs/atomic-angular/reference/user-settings-0","page_id":"/docs/atomic-angular/reference/user-settings","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-settings","content":"The signal store that persists a signed-in user's preferences — language, theme, bookmarks, recent and saved searches, baskets, alerts — to the backend."},"1316":{"id":"/docs/atomic-angular/reference/user-settings-1","page_id":"/docs/atomic-angular/reference/user-settings","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-settings#minimal-example","content":"Minimal example"},"1317":{"id":"/docs/atomic-angular/reference/user-settings-2","page_id":"/docs/atomic-angular/reference/user-settings","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-settings#options","content":"Options"},"1318":{"id":"/docs/atomic-angular/reference/user-settings-3","page_id":"/docs/atomic-angular/reference/user-settings","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-settings#pitfalls","content":"Pitfalls"},"1319":{"id":"/docs/atomic-angular/reference/user-settings-4","page_id":"/docs/atomic-angular/reference/user-settings","type":"heading","tags":[],"url":"/docs/atomic-angular/reference/user-settings#whats-next","content":"What's next"},"1320":{"id":"/docs/atomic-angular/reference/user-settings-5","page_id":"/docs/atomic-angular/reference/user-settings","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-settings","content":"`UserSettingsStore` holds the parts of a user's experience that outlive one session — recent searches,\nbookmarks, saved searches, baskets, alerts, language and assistant preferences — and keeps them synced with the\nbackend on every mutation."},"1321":{"id":"/docs/atomic-angular/reference/user-settings-6","page_id":"/docs/atomic-angular/reference/user-settings","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-settings#minimal-example","content":"Every mutation method (`bookmark()`, `createAlert()`, `updateLanguage()`, …) both patches the store and\npersists the change to the backend API in the same call — there is no separate \"save\" step, and a signal read\nanywhere in the app reflects the change immediately."},"1322":{"id":"/docs/atomic-angular/reference/user-settings-7","page_id":"/docs/atomic-angular/reference/user-settings","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-settings#options","content":"<TypeTable\n  type=\"{\n  &#x22;initialize()&#x22;: { type: &#x22;(): Promise<void>&#x22;, description: &#x22;Fetches user settings from the backend and patches the store. Call once, typically at bootstrap.&#x22; },\n  &#x22;reset()&#x22;: { type: &#x22;(): Promise<void>&#x22;, description: &#x22;Resets the store to its initial (empty) state.&#x22; },\n  &#x22;bookmark(article, queryName?)&#x22;: { type: &#x22;(article: Article, queryName?: string): Promise<void>&#x22;, description: &#x22;Adds an article to bookmarks, if not already bookmarked.&#x22; },\n  &#x22;unbookmark(id)&#x22;: { type: &#x22;(id: string): Promise<void>&#x22; },\n  &#x22;isBookmarked(article)&#x22;: { type: &#x22;(article: Partial<Article>): boolean&#x22; },\n  &#x22;toggleBookmark(article)&#x22;: { type: &#x22;(article: Article): Promise<void>&#x22; },\n  &#x22;addCurrentSearch(queryParams)&#x22;: { type: &#x22;(queryParams: QueryParams): Promise<void>&#x22;, description: &#x22;Adds the current search to recent searches.&#x22; },\n  &#x22;deleteRecentSearch(index)&#x22;: { type: &#x22;(index: number): Promise<void>&#x22; },\n  &#x22;updateSavedSearches(list)&#x22;: { type: &#x22;(list: UserSettings['savedSearches']): Promise<void>&#x22; },\n  &#x22;deleteSavedSearch(index)&#x22;: { type: &#x22;(index: number): Promise<void>&#x22; },\n  &#x22;createBasket(basket)&#x22;: { type: &#x22;(basket: Basket): Promise<void>&#x22; },\n  &#x22;updateBasket(basket, index)&#x22;: { type: &#x22;(basket: Basket, index: number): Promise<void>&#x22; },\n  &#x22;addToBasket(name, ids)&#x22;: { type: &#x22;(name: string, ids: string | string[]): Promise<void>&#x22; },\n  &#x22;removeFromBasket(name, ids)&#x22;: { type: &#x22;(name: string, ids: string | string[]): Promise<void>&#x22; },\n  &#x22;deleteBasket(index)&#x22;: { type: &#x22;(index: number): Promise<void>&#x22; },\n  &#x22;createAlert(alert)&#x22;: { type: &#x22;(alert: Alert): Promise<void>&#x22; },\n  &#x22;updateAlert(alert, index)&#x22;: { type: &#x22;(alert: Alert, index: number): Promise<void>&#x22; },\n  &#x22;deleteAlert(index)&#x22;: { type: &#x22;(index: number): Promise<void>&#x22; },\n  &#x22;updateLanguage(language)&#x22;: { type: &#x22;(language: UserSettings['language']): Promise<void>&#x22;, description: &#x22;Also applied through Transloco by the callers that expose a language picker — see User profile.&#x22; },\n  &#x22;updateAssistantSettings(settings)&#x22;: { type: &#x22;(settings: UserSettings['assistants']): Promise<void>&#x22; },\n  &#x22;updateAssistantCollapsed(collapsed)&#x22;: { type: &#x22;(collapsed: UserSettings['collapseAssistant']): Promise<void>&#x22; },\n}\"\n/>"},"1323":{"id":"/docs/atomic-angular/reference/user-settings-8","page_id":"/docs/atomic-angular/reference/user-settings","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-settings#options","content":"Every mutator that logs activity also accepts an optional `auditEvents` parameter, forwarded to the audit\ninterceptor."},"1324":{"id":"/docs/atomic-angular/reference/user-settings-9","page_id":"/docs/atomic-angular/reference/user-settings","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-settings#pitfalls","content":"It should not need one — every mutation both patches the store and awaits the backend `PATCH`. If a UI reads a\n**different** signal store than the one just mutated (a component-local copy, or a stale `getState()` snapshot\ntaken before the `await`), it will not see the update. Read the mutated slice directly off `UserSettingsStore`."},"1325":{"id":"/docs/atomic-angular/reference/user-settings-10","page_id":"/docs/atomic-angular/reference/user-settings","tags":[],"type":"text","url":"/docs/atomic-angular/reference/user-settings#whats-next","content":"The current user's profile data, editable one property at a time."},"1326":{"id":"/docs/atomic-angular/workspaces/custom-elements","page_id":"/docs/atomic-angular/workspaces/custom-elements","type":"page","content":"Custom elements","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces/custom-elements"},"1327":{"id":"/docs/atomic-angular/workspaces/custom-elements-0","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements","content":"Use the workspaces view, the save-to-workspace picker and the mention list from a page that is not Angular, as custom elements with a prebuilt stylesheet."},"1328":{"id":"/docs/atomic-angular/workspaces/custom-elements-1","page_id":"/docs/atomic-angular/workspaces/custom-elements","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/custom-elements#minimal-example","content":"Minimal example"},"1329":{"id":"/docs/atomic-angular/workspaces/custom-elements-2","page_id":"/docs/atomic-angular/workspaces/custom-elements","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/custom-elements#how-it-works","content":"How it works"},"1330":{"id":"/docs/atomic-angular/workspaces/custom-elements-3","page_id":"/docs/atomic-angular/workspaces/custom-elements","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/custom-elements#reference","content":"Reference"},"1331":{"id":"/docs/atomic-angular/workspaces/custom-elements-4","page_id":"/docs/atomic-angular/workspaces/custom-elements","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/custom-elements#pitfalls","content":"Pitfalls"},"1332":{"id":"/docs/atomic-angular/workspaces/custom-elements-5","page_id":"/docs/atomic-angular/workspaces/custom-elements","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/custom-elements#whats-next","content":"What's next"},"1333":{"id":"/docs/atomic-angular/workspaces/custom-elements-6","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements","content":"`@sinequa/atomic-angular/workspace-elements` wraps the components of `document-workspaces` with `@angular/elements`:\n`<lexiq-workspaces>`, `<lexiq-workspace-picker>` and `<lexiq-workspace-mention-list>`. An Angular application should use\nthe components directly; the elements are for hosts that have no Angular component to put them in."},"1334":{"id":"/docs/atomic-angular/workspaces/custom-elements-7","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#minimal-example","content":"Importing the entry registers nothing: registration is explicit — `bootstrapLexiqWorkspacesElements()` for a page with no\nAngular (it starts a zoneless application and registers the three tags on it), `provideLexiqWorkspacesElements()` among the\nproviders of an Angular application, or `defineLexiqWorkspacePicker(injector)` and its two siblings for one element only."},"1335":{"id":"/docs/atomic-angular/workspaces/custom-elements-8","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#how-it-works","content":"The elements render in the page's own DOM, not in a shadow root, and through the application's injector: they share its\nTransloco configuration, its `@sinequa/atomic` setup and its `WorkspacesStore` with the rest of the page."},"1336":{"id":"/docs/atomic-angular/workspaces/custom-elements-9","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#how-it-works","content":"Because they live in the page's DOM, the page provides their styles. Two ways:"},"1337":{"id":"/docs/atomic-angular/workspaces/custom-elements-10","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#how-it-works","content":"**A Tailwind build that scans the library**, as for the Angular components."},"1338":{"id":"/docs/atomic-angular/workspaces/custom-elements-11","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#how-it-works","content":"**The prebuilt stylesheet**, `workspace-elements/styles/lexiq-workspaces.css`, for a page without a Tailwind build.\nIt holds the galactik tokens as a *fallback* (a host that already defines them keeps its own), a small reset limited\nto the elements and the dialogs they open, and exactly the utilities the components use — unlayered, so a class beats\nthe page's own `h3 { … }` or `p { … }`. The dark tokens apply under a `.dark` class: `theme=\"dark\"` on\n`<lexiq-workspaces>` puts it on the element."},"1339":{"id":"/docs/atomic-angular/workspaces/custom-elements-12","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#reference","content":"<TypeTable\n  type=\"{\n  &#x22;<lexiq-workspaces>&#x22;: {\n    type: &#x22;attributes&#x22;,\n    description: &#x22;upload-endpoint, query-name, theme (light or dark), workspace-id. Methods: showList(), showDetail(id), addWorkspace().&#x22;,\n  },\n  &#x22;<lexiq-workspace-picker>&#x22;: {\n    type: &#x22;methods&#x22;,\n    description: &#x22;openSaveCard(anchor, { documents }) and openMoveMenu(anchor, documentIds, { fromWorkspaceId }). Events: save (detail: { name }) and moved.&#x22;,\n  },\n  &#x22;<lexiq-workspace-mention-list>&#x22;: {\n    type: &#x22;method and property&#x22;,\n    description: &#x22;selectById(id), and items (the rows, for a host that draws its own menu). Event: selection-changed (detail: { ids, count }).&#x22;,\n  },\n}\"\n/>"},"1340":{"id":"/docs/atomic-angular/workspaces/custom-elements-13","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#reference","content":"`<lexiq-workspaces>` dispatches `lexiq-workspaces:workspace-created` and `lexiq-workspaces:workspace-updated` (detail:\n`{ workspace }`), and `lexiq-workspaces:ask-followup`. All the events bubble and cross a shadow boundary, which\n`@angular/elements` does not do by itself."},"1341":{"id":"/docs/atomic-angular/workspaces/custom-elements-14","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#pitfalls","content":"They take their styles from the page. Load `lexiq-workspaces.css`, or make the page's Tailwind build scan the library.\nThe tokens in the stylesheet are only a fallback: a page that defines its own galactik tokens keeps them."},"1342":{"id":"/docs/atomic-angular/workspaces/custom-elements-15","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#pitfalls","content":"Nothing was registered: importing the entry does not register anything. Call `bootstrapLexiqWorkspacesElements()`,\nor add `provideLexiqWorkspacesElements()` to the providers."},"1343":{"id":"/docs/atomic-angular/workspaces/custom-elements-16","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#pitfalls","content":"Event names with a colon cannot be bound as `(lexiq-workspaces:workspace-created)`. Add the listener with\n`addEventListener` on the element."},"1344":{"id":"/docs/atomic-angular/workspaces/custom-elements-17","page_id":"/docs/atomic-angular/workspaces/custom-elements","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/custom-elements#whats-next","content":"The component `<lexiq-workspaces>` wraps."},"1345":{"id":"/docs/atomic-angular/workspaces","page_id":"/docs/atomic-angular/workspaces","type":"page","content":"Document workspaces","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces"},"1346":{"id":"/docs/atomic-angular/workspaces-0","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces","content":"A user-managed set of documents — listed, opened, uploaded into, shared and previewed — as Angular components, with a custom-element build for pages that are not Angular."},"1347":{"id":"/docs/atomic-angular/workspaces-1","page_id":"/docs/atomic-angular/workspaces","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces#how-the-parts-fit","content":"How the parts fit"},"1348":{"id":"/docs/atomic-angular/workspaces-2","page_id":"/docs/atomic-angular/workspaces","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces#prerequisites","content":"Prerequisites"},"1349":{"id":"/docs/atomic-angular/workspaces-3","page_id":"/docs/atomic-angular/workspaces","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces#whats-next","content":"What's next"},"1350":{"id":"/docs/atomic-angular/workspaces-4","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces","content":"A *workspace* is a named set of documents that a user creates, fills by uploading files, shares with other\npeople and previews. The container API of `@sinequa/atomic` calls it a **container**; that word stays inside the\nlibrary, and everything you touch here says workspace."},"1351":{"id":"/docs/atomic-angular/workspaces-5","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces","content":"The components ship from `@sinequa/atomic-angular/document-workspaces`. The custom elements built on them\n(`<lexiq-workspaces>`, `<lexiq-workspace-picker>`, `<lexiq-workspace-mention-list>`) ship from\n`@sinequa/atomic-angular/workspace-elements`, whose `@angular/elements` peer is optional — an Angular application\nnever needs it."},"1352":{"id":"/docs/atomic-angular/workspaces-6","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#how-the-parts-fit","content":"`WorkspacesShell` is the whole view in one component. Every part it is made of is exported too, for a host that\nwants its own layout. None of the parts navigates or opens a dialog it does not own: each one *says* what the user\nasked for, and whoever hosts it decides."},"1353":{"id":"/docs/atomic-angular/workspaces-7","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#how-the-parts-fit","content":"All of them read the same `WorkspacesStore`, so a change made in one — a role changed from \"Manage access\", a\nstatus patched by the upload flow — shows in the others without anything being pushed."},"1354":{"id":"/docs/atomic-angular/workspaces-8","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#prerequisites","content":"`@sinequa/atomic` 2.7 or later, which carries the container API the store calls, and a configured client\n(`setGlobalConfig`, or the application's own bootstrap)."},"1355":{"id":"/docs/atomic-angular/workspaces-9","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#prerequisites","content":"Transloco, with the `document-workspaces` translation scope the package ships, and `provideTranslocoMessageformat()`:\nthe plurals (\"3 people have access\") are written in ICU."},"1356":{"id":"/docs/atomic-angular/workspaces-10","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#prerequisites","content":"The styles: the components are styled with galactik tokens and Tailwind utilities, so the application's Tailwind\nbuild scans the library, as it does for the rest of `@sinequa/atomic-angular`."},"1357":{"id":"/docs/atomic-angular/workspaces-11","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#whats-next","content":"The whole view in one component."},"1358":{"id":"/docs/atomic-angular/workspaces-12","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#whats-next","content":"The parts the shell is made of, to lay out yourself."},"1359":{"id":"/docs/atomic-angular/workspaces-13","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#whats-next","content":"Staging files, sending them as one batch, and following their progress."},"1360":{"id":"/docs/atomic-angular/workspaces-14","page_id":"/docs/atomic-angular/workspaces","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces#whats-next","content":"The same view for a page that is not Angular."},"1361":{"id":"/docs/atomic-angular/workspaces/list-and-detail","page_id":"/docs/atomic-angular/workspaces/list-and-detail","type":"page","content":"List and detail","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces/list-and-detail"},"1362":{"id":"/docs/atomic-angular/workspaces/list-and-detail-0","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail","content":"Lay out the workspace list and a single workspace yourself — each says what the user asked for, and your host decides where it goes."},"1363":{"id":"/docs/atomic-angular/workspaces/list-and-detail-1","page_id":"/docs/atomic-angular/workspaces/list-and-detail","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/list-and-detail#minimal-example","content":"Minimal example"},"1364":{"id":"/docs/atomic-angular/workspaces/list-and-detail-2","page_id":"/docs/atomic-angular/workspaces/list-and-detail","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/list-and-detail#how-it-works","content":"How it works"},"1365":{"id":"/docs/atomic-angular/workspaces/list-and-detail-3","page_id":"/docs/atomic-angular/workspaces/list-and-detail","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/list-and-detail#options","content":"Options"},"1366":{"id":"/docs/atomic-angular/workspaces/list-and-detail-4","page_id":"/docs/atomic-angular/workspaces/list-and-detail","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/list-and-detail#pitfalls","content":"Pitfalls"},"1367":{"id":"/docs/atomic-angular/workspaces/list-and-detail-5","page_id":"/docs/atomic-angular/workspaces/list-and-detail","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/list-and-detail#whats-next","content":"What's next"},"1368":{"id":"/docs/atomic-angular/workspaces/list-and-detail-6","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail","content":"`<workspace-list>` shows every workspace the user can reach, as a grid or a list; `<workspace-detail>` shows one\nworkspace and its documents. Use them instead of `WorkspacesShell` when the two belong\nin different places of your layout, or when navigation is the router's business."},"1369":{"id":"/docs/atomic-angular/workspaces/list-and-detail-7","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#minimal-example","content":"`EditWorkspace.call()` without an injector needs `provideCallable()` from `@sinequa/galactik` in the application's\nproviders; the components themselves pass their own injector and never do."},"1370":{"id":"/docs/atomic-angular/workspaces/list-and-detail-8","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#how-it-works","content":"Both read `WorkspacesStore`, which is shared: the workspace and its documents are cached, so opening the same one\ntwice is instant, and a change made anywhere shows everywhere."},"1371":{"id":"/docs/atomic-angular/workspaces/list-and-detail-9","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#how-it-works","content":"**The list** refreshes each time it is shown — workspaces created by others since the last time appear, and\nthe document counts match the server. The list already on screen stays until the answer lands, and a failure leaves\nit untouched behind an inline error. It filters by tab (all, editor, reader) and by search, and offers multi-selection\nand deletion for the workspaces the user can write to."},"1372":{"id":"/docs/atomic-angular/workspaces/list-and-detail-10","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#how-it-works","content":"**The detail** reads the workspace and its documents, with search, multi-selection, upload, edit, share and delete.\nOnly someone who can write to the workspace sees the edit, share, delete, upload and select controls."},"1373":{"id":"/docs/atomic-angular/workspaces/list-and-detail-11","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#options","content":"<TypeTable\n  type=\"{\n  workspaceId: { type: &#x22;string&#x22;, description: &#x22;Required on <workspace-detail>. The workspace shown; changing it loads the other one.&#x22; },\n  uploadEndpoint: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;<workspace-detail>: the tus endpoint uploads go to.&#x22; },\n  previewedDocumentId: { type: &#x22;string | null&#x22;, default: &#x22;null&#x22;, description: &#x22;<workspace-detail>: the document open in the preview. A two-way model, so the host can open one and is told when it changes.&#x22; },\n  queryName: { type: &#x22;string&#x22;, default: '&#x22;_query&#x22;', description: &#x22;<workspace-detail>: the query the preview web service renders a document for.&#x22; },\n}\"\n/>"},"1374":{"id":"/docs/atomic-angular/workspaces/list-and-detail-12","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#options","content":"`<workspace-list>` has two outputs: `opened` (the `Workspace` chosen) and `createRequested`. `<workspace-detail>` has\nfour: `back`, `deleted` (the `Workspace`), `workspaceUpdated` (the `Workspace` as the server now has it) and\n`askFollowUp` (`AskFollowUp`)."},"1375":{"id":"/docs/atomic-angular/workspaces/list-and-detail-13","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#pitfalls","content":"The list never creates a workspace itself: it emits `createRequested` and leaves the dialog to its host. Handle the\noutput — as above, with `EditWorkspace.call({ mode: \"add\" })`."},"1376":{"id":"/docs/atomic-angular/workspaces/list-and-detail-14","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#pitfalls","content":"Both fill their parent and scroll inside it (`h-full`). Give the parent a height, or a flex layout with\n`min-h-0 flex-1`."},"1377":{"id":"/docs/atomic-angular/workspaces/list-and-detail-15","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#pitfalls","content":"The user is a reader of that workspace: those controls are for creators and owners, and the server refuses the\nrest anyway."},"1378":{"id":"/docs/atomic-angular/workspaces/list-and-detail-16","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#whats-next","content":"What the upload button and the tracker do."},"1379":{"id":"/docs/atomic-angular/workspaces/list-and-detail-17","page_id":"/docs/atomic-angular/workspaces/list-and-detail","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/list-and-detail#whats-next","content":"The \"Manage access\" dialog the detail opens."},"1380":{"id":"/docs/atomic-angular/workspaces/preview-a-document","page_id":"/docs/atomic-angular/workspaces/preview-a-document","type":"page","content":"Preview a document","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces/preview-a-document"},"1381":{"id":"/docs/atomic-angular/workspaces/preview-a-document-0","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document","content":"Show the converted copy of a workspace document in a frame, with a zoom, a find-in-text box and an \"Ask follow-up\" action."},"1382":{"id":"/docs/atomic-angular/workspaces/preview-a-document-1","page_id":"/docs/atomic-angular/workspaces/preview-a-document","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/preview-a-document#minimal-example","content":"Minimal example"},"1383":{"id":"/docs/atomic-angular/workspaces/preview-a-document-2","page_id":"/docs/atomic-angular/workspaces/preview-a-document","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/preview-a-document#how-it-works","content":"How it works"},"1384":{"id":"/docs/atomic-angular/workspaces/preview-a-document-3","page_id":"/docs/atomic-angular/workspaces/preview-a-document","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/preview-a-document#options","content":"Options"},"1385":{"id":"/docs/atomic-angular/workspaces/preview-a-document-4","page_id":"/docs/atomic-angular/workspaces/preview-a-document","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/preview-a-document#pitfalls","content":"Pitfalls"},"1386":{"id":"/docs/atomic-angular/workspaces/preview-a-document-5","page_id":"/docs/atomic-angular/workspaces/preview-a-document","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/preview-a-document#whats-next","content":"What's next"},"1387":{"id":"/docs/atomic-angular/workspaces/preview-a-document-6","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document","content":"`<document-preview-panel>` previews one document. `<workspace-detail>` opens it beside the list when a document is\nchosen; use the panel on its own to preview a `WorkspaceDocument` anywhere else."},"1388":{"id":"/docs/atomic-angular/workspaces/preview-a-document-7","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document#how-it-works","content":"The panel asks the preview web service for the document by id, as a search application does, and shows the converted\ncopy the service points at in a frame. Until the backend hands out the index id for an uploaded document (the listing\ncarries the upload-side id) the service answers an error — the panel then says the document cannot be previewed,\nrather than showing a stand-in."},"1389":{"id":"/docs/atomic-angular/workspaces/preview-a-document-8","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document#how-it-works","content":"Finding text has to read the frame, so it only works when the converted copy is served from the **same origin** as\nthe page. Otherwise the box is disabled, and says why in its tooltip."},"1390":{"id":"/docs/atomic-angular/workspaces/preview-a-document-9","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document#options","content":"<TypeTable\n  type=\"{\n  document: { type: &#x22;WorkspaceDocument&#x22;, description: &#x22;Required. The document to preview.&#x22; },\n  queryName: { type: &#x22;string&#x22;, default: '&#x22;_query&#x22;', description: &#x22;The query the preview web service renders the document for.&#x22; },\n}\"\n/>"},"1391":{"id":"/docs/atomic-angular/workspaces/preview-a-document-10","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document#options","content":"Outputs: `closed`, and `askFollowUp` (`AskFollowUp`: the document's `title` and `type`, a `placeholder` and\nthree `suggestions`, already translated)."},"1392":{"id":"/docs/atomic-angular/workspaces/preview-a-document-11","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document#pitfalls","content":"The preview service did not know the id — \"This document cannot be previewed.\" For an uploaded document the\nlisting only carries the upload-side id, so the service has nothing to convert until the backend exposes the index id."},"1393":{"id":"/docs/atomic-angular/workspaces/preview-a-document-12","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document#pitfalls","content":"The frame is from another origin, so the page may not read its text (\"This document cannot be searched from here.\"). Serve\nthe converted copy under the page's own origin, for instance behind a reverse proxy, to enable the search."},"1394":{"id":"/docs/atomic-angular/workspaces/preview-a-document-13","page_id":"/docs/atomic-angular/workspaces/preview-a-document","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/preview-a-document#whats-next","content":"The detail view that opens the panel beside the documents."},"1395":{"id":"/docs/atomic-angular/workspaces/save-to-workspace","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"page","content":"Save to a workspace","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace"},"1396":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-0","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace","content":"Let the user put documents into a workspace, or move them to another — a popover under your button, a sheet on a narrow screen — and tick workspaces to mention."},"1397":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-1","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace#minimal-example","content":"Minimal example"},"1398":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-2","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace#how-it-works","content":"How it works"},"1399":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-3","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace#recipes","content":"Recipes"},"1400":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-4","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace#move-documents-out-of-a-workspace","content":"Move documents out of a workspace"},"1401":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-5","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace#tick-workspaces-from-a-menu","content":"Tick workspaces from a menu"},"1402":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-6","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace#pitfalls","content":"Pitfalls"},"1403":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-7","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/save-to-workspace#whats-next","content":"What's next"},"1404":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-8","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace","content":"`PickWorkspace` opens the \"Save to workspace\" / \"Move to workspace\" picker. It offers only the workspaces the user can\nwrite to, and can make a new one on the spot. `<workspace-mention-list>` is the other way in: the workspaces as rows to\ntick, for a chat's \"+\" menu."},"1405":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-9","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace#minimal-example","content":"Without an injector, `call()` needs `provideCallable()` from `@sinequa/galactik` in the providers."},"1406":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-10","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace#how-it-works","content":"On a wide window with an `anchor`, the picker is a popover hung under that element; the browser's light dismiss closes\nit on an outside press or Escape, and it resolves with a plain `dialog-cancel`. On a narrow window — or without an\nanchor — it is a modal sheet at the bottom of the screen instead. Which one is decided when it opens."},"1407":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-11","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace#how-it-works","content":"The picker does the work itself (`saveDocuments`, or `moveDocuments` from the store) and resolves once the check mark has\nbeen seen, with `{ type: \"dialog-confirm\", workspace }`. When moving, the workspace the documents come from is left out\nof the list. A new workspace needs a name that no other workspace has, whatever its case — the same name twice cannot\nbe told apart in a list."},"1408":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-12","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace#tick-workspaces-from-a-menu","content":"The ticks live in `WorkspacesStore`, not in the component: however many lists are on screen, they show the same ones.\nEvery workspace is listed, the ones shared read-only too — mentioning one only reads it. `items()` gives a host that draws\nits own menu the rows, and `select(id)` ticks one from outside."},"1409":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-13","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace#pitfalls","content":"The picker is for *writing*: a workspace shared read-only stays out of it. It stays in the mention list, which only reads."},"1410":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-14","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace#pitfalls","content":"It had no `anchor`. Pass the element it should hang from — the button the user pressed."},"1411":{"id":"/docs/atomic-angular/workspaces/save-to-workspace-15","page_id":"/docs/atomic-angular/workspaces/save-to-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/save-to-workspace#whats-next","content":"The picker and the mention list as `<lexiq-workspace-picker>` and `<lexiq-workspace-mention-list>`."},"1412":{"id":"/docs/atomic-angular/workspaces/share-a-workspace","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","type":"page","content":"Share a workspace","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces/share-a-workspace"},"1413":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-0","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace","content":"Open the \"Manage access\" dialog to give people the owner or reader role on a workspace, change a role or take access away — each change is saved at once."},"1414":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-1","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/share-a-workspace#minimal-example","content":"Minimal example"},"1415":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-2","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/share-a-workspace#how-it-works","content":"How it works"},"1416":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-3","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/share-a-workspace#pitfalls","content":"Pitfalls"},"1417":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-4","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/share-a-workspace#whats-next","content":"What's next"},"1418":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-5","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace","content":"`ShareWorkspace` opens the \"Manage access\" dialog for one workspace. `<workspace-detail>` opens it from its\n\"Manage access\" button; call it yourself from anywhere else."},"1419":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-6","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#minimal-example","content":"Without an injector, `call()` needs `provideCallable()` from `@sinequa/galactik` in the providers. The workspace has\nto be known to `WorkspacesStore` — loaded by a list, a detail or `ensureLoaded()` — because the dialog reads it from there."},"1420":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-7","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#how-it-works","content":"Every change — a role, a removal, people added — is saved at once, with the arrays the workspace holds *now*. The list\nreads the store, so it shows what the server answered, and follows a change made elsewhere. Names arrive after the\nfirst paint (the directory is asked for them), so a row can read as a raw id for a moment."},"1421":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-8","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#how-it-works","content":"**Two rows never get a role menu**: the creator's, which the API treats as immutable, and your own — an owner who\ndemotes or removes themselves loses the workspace with no way back."},"1422":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-9","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#how-it-works","content":"**Removing asks first**, inline in the row."},"1423":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-10","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#how-it-works","content":"**Groups are never offered** in the search: the API documents `owners` and `readers` as *user* ids, so staging a\ngroup would look like it worked and grant nobody anything."},"1424":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-11","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#pitfalls","content":"The workspace is not in the store yet. Load the workspaces first (`WorkspacesStore.ensureLoaded()`), or open the\ndialog from a view that has."},"1425":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-12","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#pitfalls","content":"The dialog shows the failure under the search box — a 403 reads \"You don't have permission to do this.\" Only\ncreators and owners can change access, and the list stays as the server last had it."},"1426":{"id":"/docs/atomic-angular/workspaces/share-a-workspace-13","page_id":"/docs/atomic-angular/workspaces/share-a-workspace","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/share-a-workspace#whats-next","content":"Put documents from elsewhere into a workspace."},"1427":{"id":"/docs/atomic-angular/workspaces/upload-documents","page_id":"/docs/atomic-angular/workspaces/upload-documents","type":"page","content":"Upload documents","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces/upload-documents"},"1428":{"id":"/docs/atomic-angular/workspaces/upload-documents-0","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents","content":"Stage files, send them to a workspace as one batch over tus, and follow each one from upload to indexed — with retries and session recovery."},"1429":{"id":"/docs/atomic-angular/workspaces/upload-documents-1","page_id":"/docs/atomic-angular/workspaces/upload-documents","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/upload-documents#minimal-example","content":"Minimal example"},"1430":{"id":"/docs/atomic-angular/workspaces/upload-documents-2","page_id":"/docs/atomic-angular/workspaces/upload-documents","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/upload-documents#how-it-works","content":"How it works"},"1431":{"id":"/docs/atomic-angular/workspaces/upload-documents-3","page_id":"/docs/atomic-angular/workspaces/upload-documents","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/upload-documents#recipes","content":"Recipes"},"1432":{"id":"/docs/atomic-angular/workspaces/upload-documents-4","page_id":"/docs/atomic-angular/workspaces/upload-documents","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/upload-documents#send-files-without-the-dialog","content":"Send files without the dialog"},"1433":{"id":"/docs/atomic-angular/workspaces/upload-documents-5","page_id":"/docs/atomic-angular/workspaces/upload-documents","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/upload-documents#pitfalls","content":"Pitfalls"},"1434":{"id":"/docs/atomic-angular/workspaces/upload-documents-6","page_id":"/docs/atomic-angular/workspaces/upload-documents","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/upload-documents#whats-next","content":"What's next"},"1435":{"id":"/docs/atomic-angular/workspaces/upload-documents-7","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents","content":"Uploading goes through `UploadService`: it sends the files to the tus endpoint, then follows the indexing of each\none until the document is in the workspace. `<upload-tracker>` shows that progress, and `UploadDocuments` is the\ndialog that stages the files first."},"1436":{"id":"/docs/atomic-angular/workspaces/upload-documents-8","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#minimal-example","content":"`UploadDocuments.call()` without an injector needs `provideCallable()` from `@sinequa/galactik` in the providers.\nThe dialog refuses to open for someone who cannot write to the workspace and ends with `dialog-cancel`."},"1437":{"id":"/docs/atomic-angular/workspaces/upload-documents-9","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#how-it-works","content":"The dialog only *stages*: nothing leaves the browser until \"Upload\" is pressed, so the whole selection goes out as\n**one** ingest job instead of each drop starting its own. Dismissing the dialog any other way discards the selection.\nTwo files with the same name collapse into one, because a document is addressed as `<jobId>/<fileName>` and two\nfiles sharing a name inside a job would collide on the server."},"1438":{"id":"/docs/atomic-angular/workspaces/upload-documents-10","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#how-it-works","content":"While a job is moving, the service matches the server's documents listing to the tracked files by job and file name\n(the server names a document `/DocUpload/DocUpload/|<containerId>/<fileName>`, not `<jobId>/<fileName>`), and a file\ntakes the server's id as soon as the listing shows it — that is the id a delete needs. `sent_for_indexing` counts as\n`indexing`, and a file completes when its job does. The server only reports indexing per job (indexed files out of\ntotal), so the tracker's uploading and indexing bars show the overall progress of the phase (`UploadTrackerStore.progress()`),\nand files being indexed show animated dots rather than the job's percentage. The workspace detail only lists documents\nthat are indexed or being indexed: transfers and failures stay in the tracker."},"1439":{"id":"/docs/atomic-angular/workspaces/upload-documents-11","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#how-it-works","content":"The tracker only reads `UploadTrackerStore`, so it shows whatever is in it — which is also how you can drive it in\na test or a demo, without any network."},"1440":{"id":"/docs/atomic-angular/workspaces/upload-documents-12","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#send-files-without-the-dialog","content":"`addFiles` returns the tracked id of each file, in order. `cancel(id)`, `retry(id)` and `resumeStalled()` act on\ntracked uploads. `watch(workspaceId)` tells the service which workspace is open, so that the status polling is scoped\nto it and starts when that workspace already holds documents that are not finished — a page reload loses every\nlocal upload handle, and the listing is then the only way to know. `<workspace-detail>` calls it for the workspace it shows."},"1441":{"id":"/docs/atomic-angular/workspaces/upload-documents-13","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#pitfalls","content":"`<upload-tracker>` has to be in the page: the service only fills the store. `<workspaces-shell>` includes it;\nwith the parts, add `<upload-tracker />` once, anywhere that stays on screen."},"1442":{"id":"/docs/atomic-angular/workspaces/upload-documents-14","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#pitfalls","content":"Uploads retry on their own, with a back-off, and a 401 triggers a silent re-authentication before they resume.\nA failure that persists is shown with a retry button, and the connection banner says whether the library is retrying\nor the session is gone — in which case \"Retry\" probes the session again."},"1443":{"id":"/docs/atomic-angular/workspaces/upload-documents-15","page_id":"/docs/atomic-angular/workspaces/upload-documents","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/upload-documents#whats-next","content":"Where the upload button lives."},"1444":{"id":"/docs/atomic-angular/workspaces/workspaces-shell","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"page","content":"WorkspacesShell","breadcrumbs":["Docs","Atomic Angular","Document workspaces"],"tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell"},"1445":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-0","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell","content":"Show the whole workspaces view — the list, a workspace with its documents and preview, the dialogs they open and the upload tracker — from one component."},"1446":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-1","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#minimal-example","content":"Minimal example"},"1447":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-2","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#how-it-works","content":"How it works"},"1448":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-3","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#recipes","content":"Recipes"},"1449":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-4","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#open-on-a-workspace-and-follow-the-route","content":"Open on a workspace, and follow the route"},"1450":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-5","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#hand-a-previewed-document-to-a-chat","content":"Hand a previewed document to a chat"},"1451":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-6","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#options","content":"Options"},"1452":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-7","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#pitfalls","content":"Pitfalls"},"1453":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-8","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","type":"heading","tags":[],"url":"/docs/atomic-angular/workspaces/workspaces-shell#whats-next","content":"What's next"},"1454":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-9","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell","content":"`<workspaces-shell>` is the piece that decides where things go: choosing a workspace opens it, \"Add workspace\"\nopens the dialog and then the new workspace, leaving a workspace goes back to the list."},"1455":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-10","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#minimal-example","content":"The shell fills its parent (`h-full`), so give it a height — and let it scroll itself: the list and the document\narea scroll inside it, the title and the toolbar stay in place."},"1456":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-11","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#how-it-works","content":"`workspaceId` is what is shown. `null` is the list; an id is that workspace, with its documents. It is a two-way\nmodel, so a host can open a workspace and is told which one is open."},"1457":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-12","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#options","content":"<TypeTable\n  type=\"{\n  workspaceId: { type: &#x22;string | null&#x22;, default: &#x22;null&#x22;, description: &#x22;The workspace shown; null is the list. A two-way model (workspaceIdChange).&#x22; },\n  uploadEndpoint: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;The tus endpoint uploads go to. A relative path resolves against the configured backend.&#x22; },\n  queryName: { type: &#x22;string&#x22;, default: '&#x22;_query&#x22;', description: &#x22;The query the preview web service renders a document for.&#x22; },\n  theme: { type: '&#x22;light&#x22; | &#x22;dark&#x22; | null', default: &#x22;null&#x22;, description: &#x22;dark turns the dark tokens on for the shell; otherwise it follows the page.&#x22; },\n}\"\n/>"},"1458":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-13","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#options","content":"Outputs: `workspaceCreated` and `workspaceUpdated` (the `Workspace` as the server now has it) and `askFollowUp`\n(`AskFollowUp`). `addWorkspace()` opens the \"Add workspace\" dialog from code."},"1459":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-14","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#pitfalls","content":"`uploadEndpoint` defaults to an empty string, which is no endpoint. Give the tus endpoint of your backend — a\nrelative path is resolved against the configured `backendUrl`."},"1460":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-15","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#pitfalls","content":"The catalogs write plurals in ICU. Without `provideTranslocoMessageformat()` Transloco prints the message\nuntouched. Add the provider next to `provideTransloco()`."},"1461":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-16","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#pitfalls","content":"The shell has no height of its own. A parent with `height: auto` collapses it to nothing — give it one\n(`h-[40rem]`, or a flex parent with `min-h-0 flex-1`)."},"1462":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-17","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#whats-next","content":"Lay the parts out yourself instead."},"1463":{"id":"/docs/atomic-angular/workspaces/workspaces-shell-18","page_id":"/docs/atomic-angular/workspaces/workspaces-shell","tags":[],"type":"text","url":"/docs/atomic-angular/workspaces/workspaces-shell#whats-next","content":"The shell as `<lexiq-workspaces>`."},"1464":{"id":"/docs/galactik/display/avatar","page_id":"/docs/galactik/display/avatar","type":"page","content":"Avatar","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display/avatar"},"1465":{"id":"/docs/galactik/display/avatar-0","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar","content":"Represent a user or entity as a picture or initials, with an automatic fallback when the image hasn't loaded yet or fails to load."},"1466":{"id":"/docs/galactik/display/avatar-1","page_id":"/docs/galactik/display/avatar","type":"heading","tags":[],"url":"/docs/galactik/display/avatar#minimal-example","content":"Minimal example"},"1467":{"id":"/docs/galactik/display/avatar-2","page_id":"/docs/galactik/display/avatar","type":"heading","tags":[],"url":"/docs/galactik/display/avatar#how-it-works","content":"How it works"},"1468":{"id":"/docs/galactik/display/avatar-3","page_id":"/docs/galactik/display/avatar","type":"heading","tags":[],"url":"/docs/galactik/display/avatar#recipes","content":"Recipes"},"1469":{"id":"/docs/galactik/display/avatar-4","page_id":"/docs/galactik/display/avatar","type":"heading","tags":[],"url":"/docs/galactik/display/avatar#status-badge-composition","content":"Status badge composition"},"1470":{"id":"/docs/galactik/display/avatar-5","page_id":"/docs/galactik/display/avatar","type":"heading","tags":[],"url":"/docs/galactik/display/avatar#options","content":"Options"},"1471":{"id":"/docs/galactik/display/avatar-6","page_id":"/docs/galactik/display/avatar","type":"heading","tags":[],"url":"/docs/galactik/display/avatar#pitfalls","content":"Pitfalls"},"1472":{"id":"/docs/galactik/display/avatar-7","page_id":"/docs/galactik/display/avatar","type":"heading","tags":[],"url":"/docs/galactik/display/avatar#whats-next","content":"What's next"},"1473":{"id":"/docs/galactik/display/avatar-8","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar","content":"`Avatar` represents a user or entity as a picture or initials, switching between the two automatically as the\nimage loads, fails, or is absent — no manual state handling required. It is composed of the `Avatar`\ncontainer plus two projected sub-components, `AvatarImage` and `AvatarFallback`."},"1474":{"id":"/docs/galactik/display/avatar-9","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#how-it-works","content":"`AvatarImage` preloads its `src` through an off-DOM `Image()` probe before anything renders, so there is never\na layout-shifting broken-image icon. `AvatarFallback` is shown until that probe resolves, and stays shown\npermanently if it fails — or if there is no `AvatarImage` at all, for an initials-only avatar."},"1475":{"id":"/docs/galactik/display/avatar-10","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#how-it-works","content":"`AvatarFallback` also inherits `size`/`fill`/`scheme` from its parent `<avatar>` through the `AVATAR_REF`\ntoken, so a size set once on `<avatar>` sizes the fallback too — set a prop directly on `<AvatarFallback>` to\noverride just that one."},"1476":{"id":"/docs/galactik/display/avatar-11","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#status-badge-composition","content":"`Avatar` has no built-in slot for a status dot; it composes with `Badge` through a relatively-positioned\nwrapper — the same pattern the design system uses everywhere a status pill is glued to another element."},"1477":{"id":"/docs/galactik/display/avatar-12","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#options","content":"<TypeTable\n  type=\"{\n  size: { type: '&#x22;xsmall&#x22; | &#x22;small&#x22; | &#x22;medium&#x22; | &#x22;large&#x22;', default: '&#x22;large&#x22;', description: &#x22;Footprint, mapped to --row-height-* tokens. xsmall is meant to stay picture-only per the design guideline, though nothing enforces it.&#x22; },\n  fill: { type: '&#x22;primary&#x22; | &#x22;secondary&#x22;', default: '&#x22;primary&#x22;', description: &#x22;Only visibly affects AvatarFallback (initials) — an AvatarImage that has loaded covers the whole surface.&#x22; },\n  scheme: { type: '&#x22;sage&#x22; | &#x22;almond&#x22; | &#x22;grey&#x22; | &#x22;indigo&#x22; | &#x22;cyan&#x22; | &#x22;yellow&#x22; | &#x22;cherry&#x22; | &#x22;info&#x22; | &#x22;error&#x22; | &#x22;pink&#x22; | &#x22;success&#x22; | &#x22;warning&#x22;', default: '&#x22;sage&#x22;', description: &#x22;Semantic color palette, applied to the fallback initials.&#x22; },\n}\"\n/>"},"1478":{"id":"/docs/galactik/display/avatar-13","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#options","content":"`AvatarImage` additionally takes `src` (required), `alt`, `width`, `height`. `AvatarFallback` accepts explicit\n`size`/`fill`/`scheme` overrides, inherited from the parent `<avatar>` when omitted."},"1479":{"id":"/docs/galactik/display/avatar-14","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#pitfalls","content":"`Avatar`'s template projects content through two typed `<ng-content select>` slots, tied to the exact tag\nspelling `AvatarImage`/`AvatarFallback` — any other projected content (plain text, a different element) is\nsilently dropped rather than falling through to a default slot. The kebab-case (`<avatar-image>`) and\nlowercase (`<avatarimage>`) selector aliases exist for standalone use elsewhere, but are not guaranteed to\nland in `Avatar`'s projection slots — stick to the PascalCase forms when nesting inside `<avatar>`."},"1480":{"id":"/docs/galactik/display/avatar-15","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#pitfalls","content":"`AvatarImageComponent`'s probe calls `console.log(\"Image failed to load\", src)` — not `console.error` — on\n`onerror`. Expect console noise in views with unreliable avatar URLs; there is no output to intercept this\ninstead."},"1481":{"id":"/docs/galactik/display/avatar-16","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#whats-next","content":"The status-dot composition pattern shown above, in full."},"1482":{"id":"/docs/galactik/display/avatar-17","page_id":"/docs/galactik/display/avatar","tags":[],"type":"text","url":"/docs/galactik/display/avatar#whats-next","content":"An adjacent role/category label to pair with an avatar in a member row."},"1483":{"id":"/docs/galactik/display/badge","page_id":"/docs/galactik/display/badge","type":"page","content":"Badge","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display/badge"},"1484":{"id":"/docs/galactik/display/badge-0","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge","content":"A small pastille apposed on another element — a numeric counter or a status icon — glued on with your own positioning."},"1485":{"id":"/docs/galactik/display/badge-1","page_id":"/docs/galactik/display/badge","type":"heading","tags":[],"url":"/docs/galactik/display/badge#minimal-example","content":"Minimal example"},"1486":{"id":"/docs/galactik/display/badge-2","page_id":"/docs/galactik/display/badge","type":"heading","tags":[],"url":"/docs/galactik/display/badge#how-it-works","content":"How it works"},"1487":{"id":"/docs/galactik/display/badge-3","page_id":"/docs/galactik/display/badge","type":"heading","tags":[],"url":"/docs/galactik/display/badge#options","content":"Options"},"1488":{"id":"/docs/galactik/display/badge-4","page_id":"/docs/galactik/display/badge","type":"heading","tags":[],"url":"/docs/galactik/display/badge#pitfalls","content":"Pitfalls"},"1489":{"id":"/docs/galactik/display/badge-5","page_id":"/docs/galactik/display/badge","type":"heading","tags":[],"url":"/docs/galactik/display/badge#whats-next","content":"What's next"},"1490":{"id":"/docs/galactik/display/badge-6","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge","content":"`Badge` is a small pastille apposed on another element — a numeric counter (notifications, result counts) or a\nstatus icon (online, verified, featured). It is a bare directive with no template: it only contributes host\nclasses (and, optionally, ARIA attributes) to whichever tag you write it on."},"1491":{"id":"/docs/galactik/display/badge-7","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge#how-it-works","content":"`variant=\"number\"` gives breathing-room padding and a minimum width equal to the row height, so it grows into\na pill past one or two digits. `variant=\"icon\"` forces a square aspect ratio, meant for a single icon child.\nNeither variant carries any positioning of its own — gluing a badge onto another element (a status dot on an\n`Avatar`, an unread count on a tab) is your own `relative`/`absolute` wrapper:"},"1492":{"id":"/docs/galactik/display/badge-8","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge#options","content":"<TypeTable\n  type=\"{\n  variant: { type: '&#x22;icon&#x22; | &#x22;number&#x22;', default: '&#x22;number&#x22;', description: &#x22;icon forces a square aspect ratio for a single icon child; number adds horizontal padding and a min-width floor.&#x22; },\n  fill: { type: '&#x22;primary&#x22; | &#x22;secondary&#x22;', default: '&#x22;primary&#x22;', description: &#x22;primary = solid fill, secondary = tonal fill.&#x22; },\n  scheme: { type: '&#x22;sage&#x22; | &#x22;almond&#x22; | &#x22;pink&#x22; | &#x22;grey&#x22; | &#x22;success&#x22; | &#x22;warning&#x22; | &#x22;info&#x22; | &#x22;error&#x22; | &#x22;cyan&#x22; | &#x22;yellow&#x22; | &#x22;cherry&#x22; | &#x22;indigo&#x22;', default: '&#x22;sage&#x22;', description: &#x22;Semantic color palette.&#x22; },\n  size: { type: '&#x22;md&#x22; | &#x22;sm&#x22; | &#x22;xs&#x22;', default: '&#x22;sm&#x22;', description: &#x22;Row-height-driven size.&#x22; },\n  &#x22;aria-label&#x22;: { type: &#x22;string | undefined&#x22;, description: 'When set, the host also gets role=&#x22;img&#x22; — see Pitfalls.' },\n}\"\n/>"},"1493":{"id":"/docs/galactik/display/badge-9","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge#pitfalls","content":"By default `Badge` carries no ARIA role at all. Plain text content (a digit) is still read because it is real\ntext, but an `icon` badge's SVG typically carries `aria-hidden=\"true\"` of its own — which makes the whole\nbadge invisible to assistive technology unless you opt in. Set `aria-label`: the host then gets `role=\"img\"`\nand the given name, so the icon and its chrome are announced as one meaningful unit."},"1494":{"id":"/docs/galactik/display/badge-10","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge#pitfalls","content":"The generated icon catalog (`CircleCheckIcon`, `BellIcon`, …) is exported from the main `@sinequa/galactik` barrel, like\nevery other component. `@sinequa/ui` exports over a hundred icons under the **same class names** — in a file\nimporting from both libraries, alias the import or take every icon from a single source to avoid silently\npicking the wrong one."},"1495":{"id":"/docs/galactik/display/badge-11","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge#whats-next","content":"Compose a status Badge with a user avatar, as shown above."},"1496":{"id":"/docs/galactik/display/badge-12","page_id":"/docs/galactik/display/badge","tags":[],"type":"text","url":"/docs/galactik/display/badge#whats-next","content":"A read-only inline chip for categorizing content, instead of a pastille glued to another element."},"1497":{"id":"/docs/galactik/display/bullet","page_id":"/docs/galactik/display/bullet","type":"page","content":"Bullet","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display/bullet"},"1498":{"id":"/docs/galactik/display/bullet-0","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet","content":"A colored dot showing a status, category or priority next to a label — the dot half of Badge, without the content."},"1499":{"id":"/docs/galactik/display/bullet-1","page_id":"/docs/galactik/display/bullet","type":"heading","tags":[],"url":"/docs/galactik/display/bullet#minimal-example","content":"Minimal example"},"1500":{"id":"/docs/galactik/display/bullet-2","page_id":"/docs/galactik/display/bullet","type":"heading","tags":[],"url":"/docs/galactik/display/bullet#how-it-works","content":"How it works"},"1501":{"id":"/docs/galactik/display/bullet-3","page_id":"/docs/galactik/display/bullet","type":"heading","tags":[],"url":"/docs/galactik/display/bullet#options","content":"Options"},"1502":{"id":"/docs/galactik/display/bullet-4","page_id":"/docs/galactik/display/bullet","type":"heading","tags":[],"url":"/docs/galactik/display/bullet#pitfalls","content":"Pitfalls"},"1503":{"id":"/docs/galactik/display/bullet-5","page_id":"/docs/galactik/display/bullet","type":"heading","tags":[],"url":"/docs/galactik/display/bullet#whats-next","content":"What's next"},"1504":{"id":"/docs/galactik/display/bullet-6","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet","content":"`Bullet` is a colored dot: a status, a category or a priority, shown next to a label. It is a bare directive\nwith no template — you write it as its own empty element. Think of it as the dot half of\n`Badge`: the same twelve schemes, the same two fills, without the content — a bullet and a\nbadge of the same scheme share the same background tokens."},"1505":{"id":"/docs/galactik/display/bullet-7","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet#how-it-works","content":"A bullet has no text, so on its own it says nothing to assistive technology — when the label next to it\nalready names the status, that is correct: the dot is decoration, and stays out of the accessibility tree. Set\n`aria-label` only when the dot is the *only* indication of the state, and it renders `role=\"img\"` with that\naccessible name."},"1506":{"id":"/docs/galactik/display/bullet-8","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet#how-it-works","content":"`pulse` wraps the dot in an expanding, fading halo for a live \"right now\" status — a `::before` on the dot\nitself, not a second element, so it stays a single boolean to toggle:"},"1507":{"id":"/docs/galactik/display/bullet-9","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet#options","content":"<TypeTable\n  type=\"{\n  scheme: { type: '&#x22;sage&#x22; | &#x22;almond&#x22; | &#x22;pink&#x22; | &#x22;grey&#x22; | &#x22;success&#x22; | &#x22;warning&#x22; | &#x22;info&#x22; | &#x22;error&#x22; | &#x22;cyan&#x22; | &#x22;yellow&#x22; | &#x22;cherry&#x22; | &#x22;indigo&#x22;', default: '&#x22;sage&#x22;', description: &#x22;Color, in Badge's scheme names.&#x22; },\n  fill: { type: '&#x22;primary&#x22; | &#x22;secondary&#x22;', default: '&#x22;primary&#x22;', description: &#x22;primary is the solid fill, secondary the light tonal one.&#x22; },\n  size: { type: '&#x22;md&#x22; | &#x22;sm&#x22; | &#x22;xs&#x22;', default: '&#x22;md&#x22;', description: &#x22;Diameter: 18px / 12px / 8px.&#x22; },\n  pulse: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Wraps the dot in an expanding, fading halo. No animation under prefers-reduced-motion.&#x22; },\n  &#x22;aria-label&#x22;: { type: &#x22;string | undefined&#x22;, description: &#x22;Accessible name. Set it and the dot becomes role=\\&#x22;img\\&#x22;.&#x22; },\n}\"\n/>"},"1508":{"id":"/docs/galactik/display/bullet-10","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet#pitfalls","content":"Expected the second way, not the first: `pulse`'s halo animates nothing under `prefers-reduced-motion` — a\nblinking indicator is precisely what such a user asked to be spared (WCAG 2.3.3). If you instead reach for\n`class=\"animate-pulse\"` for a softer, no-halo variation, pair it with `motion-reduce:animate-none` yourself;\nand do not stack the two — `animate-pulse` fades the whole element, halo included, cancelling `pulse` out."},"1509":{"id":"/docs/galactik/display/bullet-11","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet#pitfalls","content":"A color is never the only carrier of information (WCAG 1.4.1). Pair the bullet with a text label, or give it\nan `aria-label` when there genuinely is no label next to it. Do not put text inside a bullet either — its\nsize is fixed and content would be clipped; write the label as a sibling instead."},"1510":{"id":"/docs/galactik/display/bullet-12","page_id":"/docs/galactik/display/bullet","tags":[],"type":"text","url":"/docs/galactik/display/bullet#whats-next","content":"The same twelve schemes and two fills, with projected content instead of a bare dot."},"1511":{"id":"/docs/galactik/display","page_id":"/docs/galactik/display","type":"page","content":"Display","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display"},"1512":{"id":"/docs/galactik/display-0","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display","content":"Presentation primitives — Tag, Badge, Bullet, Kbd, Avatar, List, RowGrid — with no business logic of their own."},"1513":{"id":"/docs/galactik/display-1","page_id":"/docs/galactik/display","type":"heading","tags":[],"url":"/docs/galactik/display#whats-next","content":"What's next"},"1514":{"id":"/docs/galactik/display-2","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display","content":"Small, composable primitives for showing content — a status, a category, an identity, a row of selectable or\nnavigable items. None of these depend on a service or a store; they render whatever inputs and projected\ncontent you give them."},"1515":{"id":"/docs/galactik/display-3","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display#whats-next","content":"A static, read-only chip for categorizing content."},"1516":{"id":"/docs/galactik/display-4","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display#whats-next","content":"A pastille apposed on another element — a counter or a status icon."},"1517":{"id":"/docs/galactik/display-5","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display#whats-next","content":"A colored status dot, the undressed half of Badge."},"1518":{"id":"/docs/galactik/display-6","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display#whats-next","content":"Show a keyboard shortcut, single key or combination."},"1519":{"id":"/docs/galactik/display-7","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display#whats-next","content":"A user or entity, as a picture or initials, with an automatic fallback."},"1520":{"id":"/docs/galactik/display-8","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display#whats-next","content":"An accessible list of selectable rows, built on @angular/aria/listbox."},"1521":{"id":"/docs/galactik/display-9","page_id":"/docs/galactik/display","tags":[],"type":"text","url":"/docs/galactik/display#whats-next","content":"A keyboard-navigable grid for rows that need more than one focusable control."},"1522":{"id":"/docs/galactik/display/kbd","page_id":"/docs/galactik/display/kbd","type":"page","content":"Kbd","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display/kbd"},"1523":{"id":"/docs/galactik/display/kbd-0","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd","content":"Render a single keyboard key, or a whole combination, as a visual hint — it shows the shortcut, it does not bind it."},"1524":{"id":"/docs/galactik/display/kbd-1","page_id":"/docs/galactik/display/kbd","type":"heading","tags":[],"url":"/docs/galactik/display/kbd#minimal-example","content":"Minimal example"},"1525":{"id":"/docs/galactik/display/kbd-2","page_id":"/docs/galactik/display/kbd","type":"heading","tags":[],"url":"/docs/galactik/display/kbd#how-it-works","content":"How it works"},"1526":{"id":"/docs/galactik/display/kbd-3","page_id":"/docs/galactik/display/kbd","type":"heading","tags":[],"url":"/docs/galactik/display/kbd#options","content":"Options"},"1527":{"id":"/docs/galactik/display/kbd-4","page_id":"/docs/galactik/display/kbd","type":"heading","tags":[],"url":"/docs/galactik/display/kbd#pitfalls","content":"Pitfalls"},"1528":{"id":"/docs/galactik/display/kbd-5","page_id":"/docs/galactik/display/kbd","type":"heading","tags":[],"url":"/docs/galactik/display/kbd#whats-next","content":"What's next"},"1529":{"id":"/docs/galactik/display/kbd-6","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd","content":"`Kbd` renders a single keyboard key, and `KbdGroup` presents several of them as one combination. Both are bare\ndirectives with no template — write them on the tag you want (`<kbd>` for a key, anything for the group). Use\nthem to *show* a shortcut; wiring the actual key listener stays the application's job."},"1530":{"id":"/docs/galactik/display/kbd-7","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd#how-it-works","content":"`KbdGroup` carries the accessible name of the whole combination, and the keys inside it are hidden from\nassistive technology — without that, a screen reader announces \"Control\", \"plus\", \"Shift\" as three separate\nitems, separators included."},"1531":{"id":"/docs/galactik/display/kbd-8","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd#how-it-works","content":"The name passed to `KbdGroup` should be the ARIA form of the combination (`Control+Shift+F`) — which is also\nwhat belongs in `aria-keyshortcuts` on the control the\nshortcut drives — while the visible keys can use the shorter labels a user reads on their own keyboard\n(`Ctrl`, `⌥`). The visual and the announced form must agree."},"1532":{"id":"/docs/galactik/display/kbd-9","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd#options","content":"<TypeTable\n  type=\"{\n  size: { type: '&#x22;sm&#x22; | &#x22;md&#x22;', default: '&#x22;sm&#x22;', description: &#x22;sm sits inside body text, md next to a md control.&#x22; },\n}\"\n/>"},"1533":{"id":"/docs/galactik/display/kbd-10","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd#options","content":"`KbdGroup` takes no input — it only lays its keys out in a row."},"1534":{"id":"/docs/galactik/display/kbd-11","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd#pitfalls","content":"Write the keys inside a real `<kbd>` element (the role comes from the tag; the directive only styles it), put\nthe accessible name on `KbdGroup`, and mark every key and separator inside it `aria-hidden=\"true\"` — see the\ncombination example above. Without that split, a screen reader reads \"Control\", \"plus\", \"Shift\" as three\nseparate items instead of one shortcut."},"1535":{"id":"/docs/galactik/display/kbd-12","page_id":"/docs/galactik/display/kbd","tags":[],"type":"text","url":"/docs/galactik/display/kbd#whats-next","content":"Another component driven entirely by keyboard interaction, this one via @angular/aria."},"1536":{"id":"/docs/galactik/display/list","page_id":"/docs/galactik/display/list","type":"page","content":"List","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display/list"},"1537":{"id":"/docs/galactik/display/list-0","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list","content":"An accessible list of selectable rows built on @angular/aria/listbox, with composable slots for content lists, action menus and navigation lists."},"1538":{"id":"/docs/galactik/display/list-1","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#minimal-example","content":"Minimal example"},"1539":{"id":"/docs/galactik/display/list-2","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#how-it-works","content":"How it works"},"1540":{"id":"/docs/galactik/display/list-3","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#recipes","content":"Recipes"},"1541":{"id":"/docs/galactik/display/list-4","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#multi-selection-with-a-per-row-action","content":"Multi-selection with a per-row action"},"1542":{"id":"/docs/galactik/display/list-5","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#tree-rows","content":"Tree rows"},"1543":{"id":"/docs/galactik/display/list-6","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#options","content":"Options"},"1544":{"id":"/docs/galactik/display/list-7","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#pitfalls","content":"Pitfalls"},"1545":{"id":"/docs/galactik/display/list-8","page_id":"/docs/galactik/display/list","type":"heading","tags":[],"url":"/docs/galactik/display/list#whats-next","content":"What's next"},"1546":{"id":"/docs/galactik/display/list-9","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list","content":"`List` is a container of selectable rows built on `@angular/aria/listbox` (`role=\"listbox\"`/`role=\"option\"`).\n`ListItem` is a row, and a set of slot components/directives (`ListItemText`, `ListItemLeft`, `ListItemIcon`,\n`ListItemAvatar`, `ListItemAction`, `ListItemChevron`, `ListItemExpander`) compose the row content for content\nlists, action menus, navigation lists and tree-style rows."},"1547":{"id":"/docs/galactik/display/list-10","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#how-it-works","content":"`List` composes `@angular/aria/listbox`'s `Listbox` as a **host directive** on its own host element (not a\nwrapper), and `ListItem` composes `Option` the same way — required so a projected `ListItem` resolves its\nancestor `Listbox` through the element-injector hierarchy, which an `ng-content` wrapper would break. Every\nselection, keyboard-navigation and ARIA-reflection concern (`aria-selected`, `aria-disabled`, roving tabindex,\ntypeahead) comes from `@angular/aria`, not from galactik."},"1548":{"id":"/docs/galactik/display/list-11","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#how-it-works","content":"By default, `selectionMode=\"follow\"` means moving keyboard focus (arrow keys) immediately changes the\nselection — the listbox default. Set `selectionMode=\"explicit\"` (paired with `multi`, typically) whenever a\nrow also carries its own interactive affordance like `ListItemAction`, since \"select on focus\" would otherwise\nfight with reaching that action."},"1549":{"id":"/docs/galactik/display/list-12","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#tree-rows","content":"`depth` indents a row by 20px per level, and `ListItemExpander` renders the rotating expand/collapse chevron.\nIn today's listbox-backed `List`, tree behavior is **style only** — expansion state and which children render\nis entirely up to the consumer; there is no `role=\"tree\"` keyboard semantics yet (a future\n`@angular/aria/tree`-backed variant will add it)."},"1550":{"id":"/docs/galactik/display/list-13","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#options","content":"<TypeTable\n  type=\"{\n  variant: { type: '&#x22;list-content&#x22; | &#x22;list-navigation&#x22; | &#x22;list-menu&#x22;', default: '&#x22;list-content&#x22;', description: &#x22;Set on List, propagated to every child ListItem (an item may override it locally).&#x22; },\n  size: { type: '&#x22;small&#x22; | &#x22;medium&#x22;', default: '&#x22;small&#x22;', description: &#x22;Set on List, propagated to every child ListItem.&#x22; },\n  value: { type: &#x22;V[]&#x22;, default: &#x22;[]&#x22;, description: &#x22;Selection model, bind with [(value)]. Always an array, even for single selection.&#x22; },\n  multi: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Enables multiple selection.&#x22; },\n  selectionMode: { type: '&#x22;follow&#x22; | &#x22;explicit&#x22;', default: '&#x22;follow&#x22;', description: &#x22;follow: selection tracks keyboard focus. explicit: select only via click/Space.&#x22; },\n  focusMode: { type: '&#x22;roving&#x22; | &#x22;activedescendant&#x22;', default: '&#x22;roving&#x22;', description: 'activedescendant keeps DOM focus on a host input (used by Autocomplete); the &#x22;focused&#x22; row is then exposed via data-active, not native :focus.' },\n}\"\n/>"},"1551":{"id":"/docs/galactik/display/list-14","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#options","content":"`disabled`, `readonly`, `softDisabled`, `wrap`, `orientation`, `typeaheadDelay` are forwarded from\n`@angular/aria/listbox`'s `Listbox` and default to whatever that package ships. `ListItem` additionally takes\n`depth` (tree indentation, 20px/level) and forwards `value` (required), `disabled`, `label` from `Option`."},"1552":{"id":"/docs/galactik/display/list-15","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#pitfalls","content":"`ListItemAction` renders a non-focusable `<span aria-hidden=\"true\">`, not a `<button>` — its host `<ListItem>`\nis already a listbox `option`, and ARIA forbids an option from containing an interactive control. The label\nyou pass renders as `title` (a mouse tooltip), not `aria-label`, since the span is hidden from assistive\ntechnology anyway."},"1553":{"id":"/docs/galactik/display/list-16","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#pitfalls","content":"The keyboard path is `Delete` on the focused row: `<ListItem>` sets `aria-keyshortcuts=\"Delete\"` whenever it\nprojects a `ListItemAction`, and pressing `Delete` clicks the action's element on your behalf — your\n`(click)` handler on `<ListItemAction>` still fires, unchanged. `ListItemExpander` is the exception in this\nfamily: it does render a real `<button>`, reachable by `Tab` in the usual way."},"1554":{"id":"/docs/galactik/display/list-17","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#pitfalls","content":"`List`'s virtualizer estimates row height at a fixed value and never measures actual rendered height — keep\nrows a uniform height. This does not apply to `<aggregation-tree>`-style consumers with their own measured\nvirtualizer; a plain `List` always assumes uniform rows."},"1555":{"id":"/docs/galactik/display/list-18","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#pitfalls","content":"Even a single-selection `List` compares `value` against a `V[]` selection model — there is no scalar shortcut.\nEvery `ListItem` needs its own `value`, since it is the row's identity in that array."},"1556":{"id":"/docs/galactik/display/list-19","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#pitfalls","content":"`@sinequa/ui` (atomic-ui) also exports a `ListItemComponent`, but as a thinner styling-only directive\n(variants `default`/`destructive`/`primary`/`link`/`none`) with no `List` container, no slot sub-components,\nand no `@angular/aria` backing. Double-check the import path whenever `ListItem`/`ListItemComponent` is\nambiguous — for new work, the galactik version documented here is the target."},"1557":{"id":"/docs/galactik/display/list-20","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#whats-next","content":"Reach for it instead of List whenever a row needs more than one focusable control."},"1558":{"id":"/docs/galactik/display/list-21","page_id":"/docs/galactik/display/list","tags":[],"type":"text","url":"/docs/galactik/display/list#whats-next","content":"Another @angular/aria-backed composite widget, for switching between panels instead of selecting rows."},"1559":{"id":"/docs/galactik/display/row-grid","page_id":"/docs/galactik/display/row-grid","type":"page","content":"RowGrid","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display/row-grid"},"1560":{"id":"/docs/galactik/display/row-grid-0","page_id":"/docs/galactik/display/row-grid","tags":[],"type":"text","url":"/docs/galactik/display/row-grid","content":"A keyboard-navigable ARIA grid shell for a list of rows that hold more than one focusable control — reach for it instead of List/ListItem in that case."},"1561":{"id":"/docs/galactik/display/row-grid-1","page_id":"/docs/galactik/display/row-grid","type":"heading","tags":[],"url":"/docs/galactik/display/row-grid#minimal-example","content":"Minimal example"},"1562":{"id":"/docs/galactik/display/row-grid-2","page_id":"/docs/galactik/display/row-grid","type":"heading","tags":[],"url":"/docs/galactik/display/row-grid#how-it-works","content":"How it works"},"1563":{"id":"/docs/galactik/display/row-grid-3","page_id":"/docs/galactik/display/row-grid","type":"heading","tags":[],"url":"/docs/galactik/display/row-grid#recipes","content":"Recipes"},"1564":{"id":"/docs/galactik/display/row-grid-4","page_id":"/docs/galactik/display/row-grid","type":"heading","tags":[],"url":"/docs/galactik/display/row-grid#infinite-scroll","content":"Infinite scroll"},"1565":{"id":"/docs/galactik/display/row-grid-5","page_id":"/docs/galactik/display/row-grid","type":"heading","tags":[],"url":"/docs/galactik/display/row-grid#options","content":"Options"},"1566":{"id":"/docs/galactik/display/row-grid-6","page_id":"/docs/galactik/display/row-grid","type":"heading","tags":[],"url":"/docs/galactik/display/row-grid#pitfalls","content":"Pitfalls"},"1567":{"id":"/docs/galactik/display/row-grid-7","page_id":"/docs/galactik/display/row-grid","type":"heading","tags":[],"url":"/docs/galactik/display/row-grid#whats-next","content":"What's next"},"1568":{"id":"/docs/galactik/display/row-grid-8","page_id":"/docs/galactik/display/row-grid","tags":[],"type":"text","url":"/docs/galactik/display/row-grid","content":"`RowGrid` is a keyboard-navigable ARIA grid shell for a list of rows: `↑`/`↓` walk the rows, `Tab` enters the\nfocused row's own controls, `Enter` activates the row. Row content is fully projected, so it fits any row\nshape a consumer needs. Reach for it instead of `List`/`ListItem` whenever a row holds more than\none focusable control — a listbox `option` cannot contain one at all."},"1569":{"id":"/docs/galactik/display/row-grid-9","page_id":"/docs/galactik/display/row-grid","tags":[],"type":"text","url":"/docs/galactik/display/row-grid#how-it-works","content":"Roles, keyboard navigation and the reflected state come entirely from `@angular/aria/grid`'s\n`Grid`/`GridRow`/`GridCell` — `RowGrid` renders no ARIA behavior of its own, only the shell around it and its\ntwo outputs."},"1570":{"id":"/docs/galactik/display/row-grid-10","page_id":"/docs/galactik/display/row-grid","tags":[],"type":"text","url":"/docs/galactik/display/row-grid#how-it-works","content":"`rowActivate` fires on `Enter` because the interactive cell sits above the projected content in the DOM.\n`endApproached` fires once keyboard focus reaches the last `rowsBeforeEnd` rows, so an infinite-scroll list can\nkeep growing for a keyboard user who never touches the mouse wheel."},"1571":{"id":"/docs/galactik/display/row-grid-11","page_id":"/docs/galactik/display/row-grid","tags":[],"type":"text","url":"/docs/galactik/display/row-grid#options","content":"<TypeTable\n  type=\"{\n  items: { type: &#x22;readonly T[]&#x22;, description: &#x22;Required. The rows to render.&#x22; },\n  ariaLabel: { type: &#x22;string | undefined&#x22;, description: &#x22;Names the grid for assistive technology.&#x22; },\n  ariaRowCount: { type: &#x22;number | null&#x22;, default: &#x22;null&#x22;, description: &#x22;Total row count when items is only a partial page. Leave unset for a fully-loaded list.&#x22; },\n  trackBy: { type: &#x22;(item: T, index: number) => unknown&#x22;, default: &#x22;(_, index) => index&#x22;, description: &#x22;Track function for the @for loop.&#x22; },\n  rowsBeforeEnd: { type: &#x22;number&#x22;, default: &#x22;2&#x22;, description: &#x22;How many rows from the end a keyboard focus move starts requesting more via endApproached.&#x22; },\n  gridClass: { type: &#x22;string&#x22;, default: '&#x22;gap-(--spacing-sm)&#x22;', description: &#x22;Spacing between rows.&#x22; },\n  cellClass: { type: &#x22;string&#x22;, default: '&#x22;rounded-(--radius-lg)&#x22;', description: &#x22;Shape of a row's cell.&#x22; },\n}\"\n/>"},"1572":{"id":"/docs/galactik/display/row-grid-12","page_id":"/docs/galactik/display/row-grid","tags":[],"type":"text","url":"/docs/galactik/display/row-grid#pitfalls","content":"It should not — `RowGrid` sets `rowWrap=\"nowrap\"` deliberately: wrapping would send a keyboard user on a\npointless trip to the far end of an infinitely-scrolling list. If you see wrapping, check that no surrounding\ncode is overriding the grid's wrap behavior."},"1573":{"id":"/docs/galactik/display/row-grid-13","page_id":"/docs/galactik/display/row-grid","tags":[],"type":"text","url":"/docs/galactik/display/row-grid#whats-next","content":"The selection-oriented alternative, for rows without their own focusable controls."},"1574":{"id":"/docs/galactik/display/tag","page_id":"/docs/galactik/display/tag","type":"page","content":"Tag","breadcrumbs":["Docs","Galactik","Display"],"tags":[],"url":"/docs/galactik/display/tag"},"1575":{"id":"/docs/galactik/display/tag-0","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag","content":"A static, read-only chip for categorizing content — a document type, an applied filter shown for reference, a status label."},"1576":{"id":"/docs/galactik/display/tag-1","page_id":"/docs/galactik/display/tag","type":"heading","tags":[],"url":"/docs/galactik/display/tag#minimal-example","content":"Minimal example"},"1577":{"id":"/docs/galactik/display/tag-2","page_id":"/docs/galactik/display/tag","type":"heading","tags":[],"url":"/docs/galactik/display/tag#how-it-works","content":"How it works"},"1578":{"id":"/docs/galactik/display/tag-3","page_id":"/docs/galactik/display/tag","type":"heading","tags":[],"url":"/docs/galactik/display/tag#removable-tags","content":"Removable tags"},"1579":{"id":"/docs/galactik/display/tag-4","page_id":"/docs/galactik/display/tag","type":"heading","tags":[],"url":"/docs/galactik/display/tag#options","content":"Options"},"1580":{"id":"/docs/galactik/display/tag-5","page_id":"/docs/galactik/display/tag","type":"heading","tags":[],"url":"/docs/galactik/display/tag#pitfalls","content":"Pitfalls"},"1581":{"id":"/docs/galactik/display/tag-6","page_id":"/docs/galactik/display/tag","type":"heading","tags":[],"url":"/docs/galactik/display/tag#whats-next","content":"What's next"},"1582":{"id":"/docs/galactik/display/tag-7","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag","content":"`Tag` categorizes content read-only — a document type, an applied filter shown for reference, a status label.\nIt is a bare directive with no template: it only contributes host classes to whichever tag you write it on,\nprojecting its content as-is."},"1583":{"id":"/docs/galactik/display/tag-8","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#how-it-works","content":"`variant` (`primary` soft fill / `secondary` outline) is crossed with `scheme` (12 semantic palettes). Having\nno template means a `Tag` composes with anything projected inside it — plain text, or an icon alongside a\nlabel, sized automatically through the `.tag-icon` slot class:"},"1584":{"id":"/docs/galactik/display/tag-9","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#removable-tags","content":"A tag the user can take away carries a `tag-remove` after its label: a real `<button>` (Tab to reach it, Enter or Space\nto activate it) named after the tag, with an `removed` event."},"1585":{"id":"/docs/galactik/display/tag-10","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#removable-tags","content":"`TagInput`, the principal picker's chips and `Autocomplete`'s chips all use it. It is an element with its own button, not an\nattribute on yours: a component that imports `ButtonComponent` (which matches every `button` of its template) would\notherwise restyle it."},"1586":{"id":"/docs/galactik/display/tag-11","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#options","content":"<TypeTable\n  type=\"{\n  variant: { type: '&#x22;primary&#x22; | &#x22;secondary&#x22;', default: '&#x22;primary&#x22;', description: &#x22;primary = soft/tinted fill; secondary = transparent background with a colored outline.&#x22; },\n  scheme: { type: '&#x22;sage&#x22; | &#x22;almond&#x22; | &#x22;pink&#x22; | &#x22;grey&#x22; | &#x22;yellow&#x22; | &#x22;cherry&#x22; | &#x22;indigo&#x22; | &#x22;cyan&#x22; | &#x22;success&#x22; | &#x22;warning&#x22; | &#x22;info&#x22; | &#x22;error&#x22;', default: '&#x22;sage&#x22;', description: &#x22;Semantic color palette.&#x22; },\n  size: { type: '&#x22;xs&#x22; | &#x22;sm&#x22; | &#x22;md&#x22;', default: '&#x22;md&#x22;', description: &#x22;Controls padding, radius, text size and the .tag-icon slot size. xsmall/small/medium are accepted aliases, kept for BEM parity — prefer the short forms.&#x22; },\n}\"\n/>"},"1587":{"id":"/docs/galactik/display/tag-12","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#options","content":"`<tag-remove>`:"},"1588":{"id":"/docs/galactik/display/tag-13","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#options","content":"<TypeTable\n  type=\"{\n  &#x22;aria-label&#x22;: { type: &#x22;string&#x22;, description: &#x22;Required. What the button removes (\\&#x22;Remove design\\&#x22;): an icon alone names nothing. Nothing in the library translates, so pass it translated and bind it as [aria-label].&#x22; },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;The button stays in place and removes nothing.&#x22; },\n  removed: { type: &#x22;void&#x22;, description: &#x22;Output. Fires on a click, Enter or Space. The click does not bubble, so a handler on the field around the tags is not triggered.&#x22; },\n}\"\n/>"},"1589":{"id":"/docs/galactik/display/tag-14","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#pitfalls","content":"`Tag` has no click handler, no `disabled` state, and no built-in remove/close button — it is read-only by\ndesign. For a removable tag list backed by search/selection state, reach for `Autocomplete`, which renders its\napplied values as `Tag`s internally and exposes the removal outputs; don't try to bolt dismiss behavior onto a\nbare `Tag`."},"1590":{"id":"/docs/galactik/display/tag-15","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#pitfalls","content":"`Tag` uses `variant` itself for solid/outline styling (`primary`/`secondary`) and has no separate `fill`\ninput. `Badge` (see Badge) instead uses `variant` for its icon/number discriminator and a\nseparate `fill` for solid/tonal styling. The two components' `variant` values name unrelated things."},"1591":{"id":"/docs/galactik/display/tag-16","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#whats-next","content":"A pastille apposed on another element — a counter or a status icon — rather than an inline chip."},"1592":{"id":"/docs/galactik/display/tag-17","page_id":"/docs/galactik/display/tag","tags":[],"type":"text","url":"/docs/galactik/display/tag#whats-next","content":"Render rows that might carry a Tag as a status column, alongside an icon and a label."},"1593":{"id":"/docs/galactik/buttons/button","page_id":"/docs/galactik/buttons/button","type":"page","content":"Button","breadcrumbs":["Docs","Galactik","Buttons"],"tags":[],"url":"/docs/galactik/buttons/button"},"1594":{"id":"/docs/galactik/buttons/button-0","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button","content":"Restyle native <button> elements as a Galactik button — six variants, four sizes, icon-only mode — with no wrapper component and no change to native button behavior."},"1595":{"id":"/docs/galactik/buttons/button-1","page_id":"/docs/galactik/buttons/button","type":"heading","tags":[],"url":"/docs/galactik/buttons/button#minimal-example","content":"Minimal example"},"1596":{"id":"/docs/galactik/buttons/button-2","page_id":"/docs/galactik/buttons/button","type":"heading","tags":[],"url":"/docs/galactik/buttons/button#how-it-works","content":"How it works"},"1597":{"id":"/docs/galactik/buttons/button-3","page_id":"/docs/galactik/buttons/button","type":"heading","tags":[],"url":"/docs/galactik/buttons/button#recipes","content":"Recipes"},"1598":{"id":"/docs/galactik/buttons/button-4","page_id":"/docs/galactik/buttons/button","type":"heading","tags":[],"url":"/docs/galactik/buttons/button#variants-sizes-and-icon-only","content":"Variants, sizes and icon-only"},"1599":{"id":"/docs/galactik/buttons/button-5","page_id":"/docs/galactik/buttons/button","type":"heading","tags":[],"url":"/docs/galactik/buttons/button#options","content":"Options"},"1600":{"id":"/docs/galactik/buttons/button-6","page_id":"/docs/galactik/buttons/button","type":"heading","tags":[],"url":"/docs/galactik/buttons/button#pitfalls","content":"Pitfalls"},"1601":{"id":"/docs/galactik/buttons/button-7","page_id":"/docs/galactik/buttons/button","type":"heading","tags":[],"url":"/docs/galactik/buttons/button#whats-next","content":"What's next"},"1602":{"id":"/docs/galactik/buttons/button-8","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button","content":"`Button` is a directive on the native `button` selector, not a wrapped component: importing it into a\ncomponent's `imports` restyles every `<button>` that component's own template renders directly, while leaving\n`type`, `disabled`, form association and keyboard behavior exactly as the platform provides them."},"1603":{"id":"/docs/galactik/buttons/button-9","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button#how-it-works","content":"Because there is no dedicated tag, `ButtonComponent` only activates on `<button>` elements the *importing*\ncomponent's own template renders — a nested child component must import it itself too, exactly like any other\nAngular directive."},"1604":{"id":"/docs/galactik/buttons/button-10","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button#options","content":"<TypeTable\n  type=\"{\n  variant: {\n    type: '&#x22;primary&#x22; | &#x22;secondary&#x22; | &#x22;tertiary&#x22; | &#x22;accent&#x22; | &#x22;light-accent&#x22; | &#x22;none&#x22;',\n    default: '&#x22;primary&#x22;',\n    description: '&#x22;none&#x22; returns only class(), bypassing size/scheme/iconOnly entirely — see Pitfalls.',\n  },\n  scheme: {\n    type: '&#x22;default&#x22; | &#x22;neutral&#x22;',\n    default: '&#x22;default&#x22;',\n    description: &#x22;Only affects variant=\\&#x22;tertiary\\&#x22;; no visible effect on any other variant.&#x22;,\n  },\n  size: {\n    type: '&#x22;xs&#x22; | &#x22;sm&#x22; | &#x22;md&#x22; | &#x22;lg&#x22;',\n    default: '&#x22;md&#x22;',\n    description: '&#x22;xsmall&#x22;/&#x22;small&#x22;/&#x22;medium&#x22;/&#x22;large&#x22; accepted as byte-identical aliases.',\n  },\n  iconOnly: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Renders a square button matching size, no horizontal padding. Pair with an explicit aria-label.&#x22;,\n  },\n  class: { type: &#x22;string | undefined&#x22;, description: &#x22;Merged (via cn()) into the computed variant classes.&#x22; },\n}\"\n/>"},"1605":{"id":"/docs/galactik/buttons/button-11","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button#options","content":"This component has no outputs of its own — use the native `(click)` and other native button/keyboard events\ndirectly."},"1606":{"id":"/docs/galactik/buttons/button-12","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button#pitfalls","content":"`variant=\"none\"` short-circuits the whole variant computation and returns `class()` alone — `size`, `iconOnly`\nand `scheme` are silently ignored whenever `variant` is `\"none\"`. For an icon-only button, keep a real variant\n(commonly `\"tertiary\"`) together with `[iconOnly]=\"true\"`; never rely on `variant=\"none\"` to get a bare icon\nbutton."},"1607":{"id":"/docs/galactik/buttons/button-13","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button#pitfalls","content":"The icon-slot compound variants (`.btn-icon-left`/`.btn-icon-right`/`.btn-icon-solo`) only apply to an icon\nelement that already carries one of those marker classes — and the constants that name them\n(`BUTTON_ICON_LEFT_CLASS` and friends) are **not** part of the public API (only `ButtonComponent` and the\n`ButtonVariants` type are exported). An icon placed inside a `<button>` keeps its own intrinsic size unless you\napply the matching class yourself as a literal string."},"1608":{"id":"/docs/galactik/buttons/button-14","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button#pitfalls","content":"`@sinequa/ui` (the library Galactik replaces) also exports a class named `ButtonComponent` on the same global\n`button` selector — importing both in one file requires aliasing one of them\n(`import { ButtonComponent as UiButton } from \"@sinequa/ui\"`). The two are not interchangeable: `@sinequa/ui`'s\nvariant vocabulary is much larger and shares no compatible values with Galactik's `Button`. Always check the\nimport path."},"1609":{"id":"/docs/galactik/buttons/button-15","page_id":"/docs/galactik/buttons/button","tags":[],"type":"text","url":"/docs/galactik/buttons/button#whats-next","content":"A pressed/unpressed pill, standalone or grouped into a segmented control."},"1610":{"id":"/docs/galactik/buttons","page_id":"/docs/galactik/buttons","type":"page","content":"Buttons","breadcrumbs":["Docs","Galactik","Buttons"],"tags":[],"url":"/docs/galactik/buttons"},"1611":{"id":"/docs/galactik/buttons-0","page_id":"/docs/galactik/buttons","tags":[],"type":"text","url":"/docs/galactik/buttons","content":"The button family — Button and the Toggle/ToggleGroup segmented control — and the variants they share."},"1612":{"id":"/docs/galactik/buttons-1","page_id":"/docs/galactik/buttons","type":"heading","tags":[],"url":"/docs/galactik/buttons#whats-next","content":"What's next"},"1613":{"id":"/docs/galactik/buttons-2","page_id":"/docs/galactik/buttons","tags":[],"type":"text","url":"/docs/galactik/buttons","content":"A directive that restyles the native `<button>` element, and a pressed/unpressed pill that works standalone\nor grouped into an exclusive or multi-selection toolbar."},"1614":{"id":"/docs/galactik/buttons-3","page_id":"/docs/galactik/buttons","tags":[],"type":"text","url":"/docs/galactik/buttons#whats-next","content":"Six visual variants, four sizes, and an icon-only mode — no wrapper element."},"1615":{"id":"/docs/galactik/buttons-4","page_id":"/docs/galactik/buttons","tags":[],"type":"text","url":"/docs/galactik/buttons#whats-next","content":"A pressed/unpressed pill, standalone or as a segmented control built on @angular/aria/toolbar."},"1616":{"id":"/docs/galactik/buttons/toggle","page_id":"/docs/galactik/buttons/toggle","type":"page","content":"Toggle","breadcrumbs":["Docs","Galactik","Buttons"],"tags":[],"url":"/docs/galactik/buttons/toggle"},"1617":{"id":"/docs/galactik/buttons/toggle-0","page_id":"/docs/galactik/buttons/toggle","tags":[],"type":"text","url":"/docs/galactik/buttons/toggle","content":"A pill-shaped pressed/unpressed button, standalone or grouped into a segmented control built on @angular/aria/toolbar."},"1618":{"id":"/docs/galactik/buttons/toggle-1","page_id":"/docs/galactik/buttons/toggle","type":"heading","tags":[],"url":"/docs/galactik/buttons/toggle#minimal-example","content":"Minimal example"},"1619":{"id":"/docs/galactik/buttons/toggle-2","page_id":"/docs/galactik/buttons/toggle","type":"heading","tags":[],"url":"/docs/galactik/buttons/toggle#how-it-works","content":"How it works"},"1620":{"id":"/docs/galactik/buttons/toggle-3","page_id":"/docs/galactik/buttons/toggle","type":"heading","tags":[],"url":"/docs/galactik/buttons/toggle#recipes","content":"Recipes"},"1621":{"id":"/docs/galactik/buttons/toggle-4","page_id":"/docs/galactik/buttons/toggle","type":"heading","tags":[],"url":"/docs/galactik/buttons/toggle#a-single-selection-segmented-control","content":"A single-selection segmented control"},"1622":{"id":"/docs/galactik/buttons/toggle-5","page_id":"/docs/galactik/buttons/toggle","type":"heading","tags":[],"url":"/docs/galactik/buttons/toggle#options","content":"Options"},"1623":{"id":"/docs/galactik/buttons/toggle-6","page_id":"/docs/galactik/buttons/toggle","type":"heading","tags":[],"url":"/docs/galactik/buttons/toggle#pitfalls","content":"Pitfalls"},"1624":{"id":"/docs/galactik/buttons/toggle-7","page_id":"/docs/galactik/buttons/toggle","tags":[],"type":"text","url":"/docs/galactik/buttons/toggle","content":"`Toggle` is a pill-shaped pressed/unpressed button. Used alone it is a self-contained two-way `[(pressed)]`\ncontrol; nested inside a `ToggleGroup` it becomes an item of a segmented control — `single` (exclusive, like a\nradio group) or `multi` (independent selections)."},"1625":{"id":"/docs/galactik/buttons/toggle-8","page_id":"/docs/galactik/buttons/toggle","tags":[],"type":"text","url":"/docs/galactik/buttons/toggle#how-it-works","content":"`Toggle` (standalone) and `Toggle[value]` (grouped item) are two distinct components sharing the `Toggle`/\n`toggle` tag name, discriminated by the presence of the `value` attribute. Grouped items require an ancestor\n`<ToggleGroup>` — its selection model comes entirely from `@angular/aria/toolbar` (roving tabindex, arrow keys,\ntypeahead, all free)."},"1626":{"id":"/docs/galactik/buttons/toggle-9","page_id":"/docs/galactik/buttons/toggle","tags":[],"type":"text","url":"/docs/galactik/buttons/toggle#a-single-selection-segmented-control","content":"The group's `value` model is always a `string[]`, even in single-selection mode — bind an array signal."},"1627":{"id":"/docs/galactik/buttons/toggle-10","page_id":"/docs/galactik/buttons/toggle","tags":[],"type":"text","url":"/docs/galactik/buttons/toggle#options","content":"<TypeTable\n  type=\"{\n  variant: { type: '&#x22;unique&#x22; | &#x22;multi&#x22;', default: '&#x22;unique&#x22;', description: &#x22;Color palette. A grouped item inherits its parent ToggleGroup's palette unless it sets its own.&#x22; },\n  size: { type: '&#x22;sm&#x22; | &#x22;md&#x22;', default: '&#x22;sm&#x22;', description: '&#x22;small&#x22;/&#x22;medium&#x22; accepted as legacy aliases.' },\n  iconOnly: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Renders a square, icon-only pill.&#x22; },\n  pressed: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Standalone Toggle only — two-way bindable pressed state.&#x22; },\n  value: { type: &#x22;string&#x22;, description: &#x22;Grouped item only. Required — the widget's identity within the parent ToggleGroup's selection.&#x22; },\n}\"\n/>"},"1628":{"id":"/docs/galactik/buttons/toggle-11","page_id":"/docs/galactik/buttons/toggle","tags":[],"type":"text","url":"/docs/galactik/buttons/toggle#pitfalls","content":"Standard `@angular/aria/toolbar` selection-group behavior, not a bug: in single-selection mode, re-activating\nthe currently selected item deselects it. If a view must always have exactly one active item (a view-mode\nswitcher, say), bind the group with a one-way `[value]` + `(valueChange)` pair and reject empty emissions in\nthe handler, rather than `[(value)]`."},"1629":{"id":"/docs/galactik/buttons/toggle-12","page_id":"/docs/galactik/buttons/toggle","tags":[],"type":"text","url":"/docs/galactik/buttons/toggle#pitfalls","content":"A grouped item requires an ancestor `<ToggleGroup>` (or any `ngToolbar`) — `ToolbarWidget` resolves\n`inject(Toolbar)` through the regular element-injector hierarchy, so `<Toggle value>` items must be light-DOM\ndescendants of `<ToggleGroup>`, not children of some other wrapping component."},"1630":{"id":"/docs/galactik/form/autocomplete","page_id":"/docs/galactik/form/autocomplete","type":"page","content":"Autocomplete","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/autocomplete"},"1631":{"id":"/docs/galactik/form/autocomplete-0","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete","content":"An editable combobox for debounced backend search with multi-selection — labels, filter facets, people pickers — where picked values render as removable chips inside the field."},"1632":{"id":"/docs/galactik/form/autocomplete-1","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#when-to-use-it","content":"When to use it"},"1633":{"id":"/docs/galactik/form/autocomplete-2","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#minimal-example","content":"Minimal example"},"1634":{"id":"/docs/galactik/form/autocomplete-3","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#how-it-works","content":"How it works"},"1635":{"id":"/docs/galactik/form/autocomplete-4","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#recipes","content":"Recipes"},"1636":{"id":"/docs/galactik/form/autocomplete-5","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#persisting-the-pick-before-reflecting-it","content":"Persisting the pick before reflecting it"},"1637":{"id":"/docs/galactik/form/autocomplete-6","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#a-people-picker","content":"A people picker"},"1638":{"id":"/docs/galactik/form/autocomplete-7","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#free-text-creation","content":"Free-text creation"},"1639":{"id":"/docs/galactik/form/autocomplete-8","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#options","content":"Options"},"1640":{"id":"/docs/galactik/form/autocomplete-9","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#pitfalls","content":"Pitfalls"},"1641":{"id":"/docs/galactik/form/autocomplete-10","page_id":"/docs/galactik/form/autocomplete","type":"heading","tags":[],"url":"/docs/galactik/form/autocomplete#whats-next","content":"What's next"},"1642":{"id":"/docs/galactik/form/autocomplete-11","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete","content":"`Autocomplete` fills the gap `SelectMenu` deliberately doesn't cover: `SelectMenu` is a\nfixed/synchronous options list behind a non-editable trigger, while `Autocomplete` is always multi-selection\nand always backed by an async `loader`. Visually the two are the same component family — both wear the same\n`selectWrapVariants` wrap, so label, field, popup, rows and hint come from one design-system source of truth.\nIt is the one component behind every \"type, pick from a list\" field of the library, and it replaces `SearchSelect`."},"1643":{"id":"/docs/galactik/form/autocomplete-12","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete","content":"`Autocomplete` never mutates its own applied values. `selected` is input-only, and `picked`/`removed` only\nreport the user's intent — the host calls its own backend (with error handling) before reflecting the change\nback into `selected`. This mirrors a real \"add labels to a document\" flow."},"1644":{"id":"/docs/galactik/form/autocomplete-13","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#when-to-use-it","content":"The options come from an async source and are too many to list (labels, filter facets, people, tags with\nsuggestions), the user builds a **multiple** selection shown as removable chips, and the host runs its own call\nbefore the pick lands."},"1645":{"id":"/docs/galactik/form/autocomplete-14","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#when-to-use-it","content":"The options are a fixed synchronous list (`SelectMenu`), the value is free text with no\nsuggestions (`TagInput`), the field is a search box that filters a page\n(`SearchInput`, `SearchBar`), or it is a facet with counters or a tree."},"1646":{"id":"/docs/galactik/form/autocomplete-15","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#when-to-use-it","content":"It is multi-selection by design — `picked` appends. A single value out of a search is possible with `closeOnPick` and\na host that replaces `selected` with one entry, but if that becomes the common case it deserves its own contract."},"1647":{"id":"/docs/galactik/form/autocomplete-16","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#how-it-works","content":"A search fires once the typed query, debounced, reaches `minLength` characters. While it is in flight the field's\nchevron gives way to a spinner and the rows of the previous search stay on screen — replacing them with a\n\"Searching…\" line made the list blink on every keystroke — so `searchingText` only shows when there is nothing\nto keep. Only a search that has come back (empty) may claim there is nothing, and a failed one says so in an\nalert row (`errorText`). The `loader` receives an `AbortSignal`: a newer query aborts the request of the older\none — hand it to `fetch`. The popup is a manual popover in the top layer, so a dialog's edges don't clip it."},"1648":{"id":"/docs/galactik/form/autocomplete-17","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#how-it-works","content":"The suggestion under the mouse becomes the active row (`activateOnHover`), so only one row is highlighted and the arrow\nkeys resume from it; Enter without any arrow or hover still picks the first one."},"1649":{"id":"/docs/galactik/form/autocomplete-18","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#persisting-the-pick-before-reflecting-it","content":"`picked`/`removed` only report intent — the host is responsible for the backend call and for updating\n`selected` only on success."},"1650":{"id":"/docs/galactik/form/autocomplete-19","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#a-people-picker","content":"When the applied values aren't shaped like the suggestions (a person found in a directory becomes an entry with\na role), `selectedKey` and `selectedLabel` tell the component how to read them. `excludeKeys` keeps out\npeople who already have access, `closeOnPick` closes the list and clears the text after a pick — a chat's\nmention box — and an element marked `autocompleteSuffix` is projected inside the field, after the text."},"1651":{"id":"/docs/galactik/form/autocomplete-20","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#free-text-creation","content":"Setting `createFromText` lets pressing Enter with no suggestions shown create a new option straight\nfrom the typed text."},"1652":{"id":"/docs/galactik/form/autocomplete-21","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#options","content":"<TypeTable\n  type=\"{\n  selected: { type: &#x22;readonly TSelected[]&#x22;, description: &#x22;Currently-applied values — display only. Drives chip rendering and suggestion exclusion. The host owns and persists them.&#x22; },\n  loader: {\n    type: &#x22;(query: string, context: { signal: AbortSignal }) => Promise<TOption[]>&#x22;,\n    description: &#x22;Backend search function. The signal is aborted when a newer query supersedes this one. A signal read only inside the closure body won't reactively re-trigger the fetch — call reload() if that's needed.&#x22;,\n  },\n  minLength: { type: &#x22;number&#x22;, default: &#x22;1&#x22;, description: &#x22;Minimum typed length before a search is triggered.&#x22; },\n  debounceMs: { type: &#x22;number&#x22;, default: &#x22;300&#x22;, description: &#x22;Debounce delay (ms) applied to the typed query.&#x22; },\n  key: { type: &#x22;(option: TOption) => unknown&#x22;, default: &#x22;identity&#x22;, description: &#x22;Identity of a suggestion, for exclusion.&#x22; },\n  label: { type: &#x22;(option: TOption) => string&#x22;, default: &#x22;String(option)&#x22;, description: &#x22;Text of a suggestion row.&#x22; },\n  selectedKey: { type: &#x22;(selected: TSelected) => unknown&#x22;, default: &#x22;key&#x22;, description: &#x22;Identity of an applied value, when it isn't shaped like a suggestion.&#x22; },\n  selectedLabel: { type: &#x22;(selected: TSelected) => string&#x22;, default: &#x22;label&#x22;, description: &#x22;Text of an applied value, in its chip.&#x22; },\n  excludeKeys: { type: &#x22;readonly unknown[]&#x22;, default: &#x22;[]&#x22;, description: &#x22;Identities kept out of the suggestions, besides the applied values.&#x22; },\n  createFromText: { type: &#x22;(text: string) => TOption&#x22;, description: &#x22;When set, Enter with no suggestions shown creates a free-text option from the typed query.&#x22; },\n  closeOnPick: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Picking closes the list and clears the text, like a chat's mention box. Off: the list stays open to pick several in a row.&#x22; },\n  chips: { type: '&#x22;inline&#x22; | &#x22;below&#x22; | &#x22;none&#x22;', default: '&#x22;inline&#x22;', description: &#x22;Where the applied values are shown: inside the field, before the text being typed (the field grows with them, and Backspace in an empty field removes the last one), in a row under it, or not drawn — the host shows them.&#x22; },\n  popup: { type: '&#x22;top-layer&#x22; | &#x22;inline&#x22;', default: '&#x22;top-layer&#x22;', description: &#x22;The popup as a manual popover in the top layer (above a dialog), or a plain fixed panel.&#x22; },\n  indicator: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Shows the chevron. The spinner still shows while a search runs.&#x22; },\n  ariaLabel: { type: &#x22;string&#x22;, description: &#x22;Accessible name of the field when there is no fieldLabel. Default: the placeholder.&#x22; },\n  noResultsText: { type: &#x22;string&#x22;, default: '&#x22;No results&#x22;', description: &#x22;Row shown once a search has answered with nothing. Never while pending.&#x22; },\n  searchingText: { type: &#x22;string&#x22;, default: '&#x22;Searching…&#x22;', description: &#x22;Row shown while a search runs and there is no row of a previous search to keep.&#x22; },\n  errorText: { type: &#x22;string&#x22;, default: '&#x22;Search failed&#x22;', description: &#x22;Alert row shown when the search failed.&#x22; },\n  allowRemove: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Shows/hides the remove (×) button on the default chip, and Backspace removal.&#x22; },\n  removeLabel: { type: &#x22;string&#x22;, default: '&#x22;Remove {label}&#x22;', description: &#x22;Accessible name of a chip's remove button; {label} is replaced by its label. Nothing in the library translates: pass it translated.&#x22; },\n}\"\n/>"},"1653":{"id":"/docs/galactik/form/autocomplete-22","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#pitfalls","content":"`@angular/aria`'s Combobox opens the popover on every keystroke, long before the debounce elapses and the fetch\nstarts. `Autocomplete` takes the popup back (`expanded` follows its own \"a search is on screen\" state, put back\nin a microtask), so the row only ever appears once a search has genuinely come back empty."},"1654":{"id":"/docs/galactik/form/autocomplete-23","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#pitfalls","content":"`resource.value()` throws in the error state. `Autocomplete` reads it behind `hasValue()`, so a failing `loader`\nshows an alert row (`errorText`) instead of crashing — nothing to guard on the consumer side."},"1655":{"id":"/docs/galactik/form/autocomplete-24","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#pitfalls","content":"Cleared by a pick (`closeOnPick`) or by Enter on `createFromText`, the typed text settles at once instead of\nafter the debounce: with a settled value that lagged behind, typing the same text again found the search already\n\"done\" for it. Nothing to do on the consumer side."},"1656":{"id":"/docs/galactik/form/autocomplete-25","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#pitfalls","content":"The resource backing `loader` only tracks `query` as its reactive parameter — a signal read only inside the\nclosure body (an extra filter flag, say) does not reactively re-trigger the fetch. Call the component's public\n`reload()` method when that value changes."},"1657":{"id":"/docs/galactik/form/autocomplete-26","page_id":"/docs/galactik/form/autocomplete","tags":[],"type":"text","url":"/docs/galactik/form/autocomplete#whats-next","content":"The synchronous sibling for a fixed options list — same look, non-editable trigger, single or multiple."},"1658":{"id":"/docs/galactik/form/checkbox","page_id":"/docs/galactik/form/checkbox","type":"page","content":"Checkbox","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/checkbox"},"1659":{"id":"/docs/galactik/form/checkbox-0","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox","content":"A native checkbox wrapped in an accessible label, with an indeterminate visual state and Signal Forms integration."},"1660":{"id":"/docs/galactik/form/checkbox-1","page_id":"/docs/galactik/form/checkbox","type":"heading","tags":[],"url":"/docs/galactik/form/checkbox#minimal-example","content":"Minimal example"},"1661":{"id":"/docs/galactik/form/checkbox-2","page_id":"/docs/galactik/form/checkbox","type":"heading","tags":[],"url":"/docs/galactik/form/checkbox#recipes","content":"Recipes"},"1662":{"id":"/docs/galactik/form/checkbox-3","page_id":"/docs/galactik/form/checkbox","type":"heading","tags":[],"url":"/docs/galactik/form/checkbox#indeterminate-state-driven-from-a-select-all-parent","content":"Indeterminate state, driven from a \"select all\" parent"},"1663":{"id":"/docs/galactik/form/checkbox-4","page_id":"/docs/galactik/form/checkbox","type":"heading","tags":[],"url":"/docs/galactik/form/checkbox#options","content":"Options"},"1664":{"id":"/docs/galactik/form/checkbox-5","page_id":"/docs/galactik/form/checkbox","type":"heading","tags":[],"url":"/docs/galactik/form/checkbox#pitfalls","content":"Pitfalls"},"1665":{"id":"/docs/galactik/form/checkbox-6","page_id":"/docs/galactik/form/checkbox","type":"heading","tags":[],"url":"/docs/galactik/form/checkbox#whats-next","content":"What's next"},"1666":{"id":"/docs/galactik/form/checkbox-7","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox","content":"`Checkbox` wraps a native `<input type=\"checkbox\">` inside an accessible `<label>`, with built-in support for a\nsecondary hint line and an indeterminate (\"mixed\") visual state."},"1667":{"id":"/docs/galactik/form/checkbox-8","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox#indeterminate-state-driven-from-a-select-all-parent","content":"`indeterminate` is purely visual/AT-facing — it never changes `checked`, and clicking still toggles `checked`\nfrom whatever value it currently holds."},"1668":{"id":"/docs/galactik/form/checkbox-9","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox#options","content":"<TypeTable\n  type=\"{\n  checked: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Two-way bindable checked state ([(checked)], or [checked] + (checkedChange)).&#x22; },\n  indeterminate: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Renders the mixed state (dash icon) and sets aria-checked=\\&#x22;mixed\\&#x22;. DOM-only, does not affect checked.&#x22; },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables the control; usable as a bare attribute.&#x22; },\n  hint: { type: &#x22;string | undefined&#x22;, description: &#x22;Optional secondary text rendered under the label.&#x22; },\n}\"\n/>"},"1669":{"id":"/docs/galactik/form/checkbox-10","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox#pitfalls","content":"`Checkbox` stops click propagation on its host, so nesting it inside a clickable row (a list item, say) never\nalso fires the row's handler. `Radio` and `Switch` do **not** do this — the same nesting on those two\ncomponents will trigger the row's click handler as well."},"1670":{"id":"/docs/galactik/form/checkbox-11","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox#pitfalls","content":"`@sinequa/ui` also exports a `CheckboxComponent` with the identical selector (`checkbox, Checkbox`) and a\n`checked` model of the same name, but it renders a `role=\"checkbox\"` `<div>`-like host with a manual click\nhandler and no real native `<input>` underneath, plus a `size` input galactik's `Checkbox` doesn't have.\nDouble-check the import path (`@sinequa/ui` vs. `@sinequa/galactik`) before assuming which accessibility model\napplies."},"1671":{"id":"/docs/galactik/form/checkbox-12","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox#whats-next","content":"The mutually-exclusive sibling — grouped by native name attribute rather than a container component."},"1672":{"id":"/docs/galactik/form/checkbox-13","page_id":"/docs/galactik/form/checkbox","tags":[],"type":"text","url":"/docs/galactik/form/checkbox#whats-next","content":"An on/off toggle with the same Signal Forms shape as Checkbox."},"1673":{"id":"/docs/galactik/form","page_id":"/docs/galactik/form","type":"page","content":"Form","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form"},"1674":{"id":"/docs/galactik/form-0","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form","content":"Form controls — Checkbox, Radio, Switch, Input, Textarea, Search fields, Select and Autocomplete — and how they compose with Angular Signal Forms."},"1675":{"id":"/docs/galactik/form-1","page_id":"/docs/galactik/form","type":"heading","tags":[],"url":"/docs/galactik/form#whats-next","content":"What's next"},"1676":{"id":"/docs/galactik/form-2","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form","content":"Every control in this section wraps a real native element (`<input>`, `<textarea>`, or the accessible\n`@angular/aria` combobox/listbox primitives for `Select`) and drives its visual state from CSS reading that\nnative element — never from a JavaScript class toggle. Most also implement one of Angular Signal Forms'\ncontrol contracts (`FormValueControl` or `FormCheckboxControl`), so `[formField]` works alongside plain\ntwo-way binding."},"1677":{"id":"/docs/galactik/form-3","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form","content":"Several of these components share a selector and a bound-property name with an equivalent still exported by\n`@sinequa/ui` (the library galactik replaces) — but with a different implementation underneath. Each page's\nPitfalls section calls out the specific difference; always check the import path when in doubt."},"1678":{"id":"/docs/galactik/form-4","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"Independent on/off selection, with an indeterminate visual state."},"1679":{"id":"/docs/galactik/form-5","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"Exclusive selection within a native-name group."},"1680":{"id":"/docs/galactik/form-6","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"An on/off track-and-thumb toggle."},"1681":{"id":"/docs/galactik/form-7","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"A single-line text field with icon slots and a character counter."},"1682":{"id":"/docs/galactik/form-8","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"The multi-line sibling, with content-driven auto-sizing."},"1683":{"id":"/docs/galactik/form-9","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"A search field styled to blend into a form."},"1684":{"id":"/docs/galactik/form-10","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"A self-contained pill search field with clear and send controls."},"1685":{"id":"/docs/galactik/form-11","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"A single- or multiple-choice dropdown over a fixed, synchronous options list."},"1686":{"id":"/docs/galactik/form-12","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"The async, backend-searched sibling of Select: multi-selection as chips — labels, facets, people."},"1687":{"id":"/docs/galactik/form-13","page_id":"/docs/galactik/form","tags":[],"type":"text","url":"/docs/galactik/form#whats-next","content":"A free-text field that turns what is typed into removable tags."},"1688":{"id":"/docs/galactik/form/input","page_id":"/docs/galactik/form/input","type":"page","content":"Input","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/input"},"1689":{"id":"/docs/galactik/form/input-0","page_id":"/docs/galactik/form/input","tags":[],"type":"text","url":"/docs/galactik/form/input","content":"A native input wrapped in a styled flex container that drives its focus, disabled and read-only look purely from the input's own state, with optional icon slots and a character counter."},"1690":{"id":"/docs/galactik/form/input-1","page_id":"/docs/galactik/form/input","type":"heading","tags":[],"url":"/docs/galactik/form/input#minimal-example","content":"Minimal example"},"1691":{"id":"/docs/galactik/form/input-2","page_id":"/docs/galactik/form/input","type":"heading","tags":[],"url":"/docs/galactik/form/input#recipes","content":"Recipes"},"1692":{"id":"/docs/galactik/form/input-3","page_id":"/docs/galactik/form/input","type":"heading","tags":[],"url":"/docs/galactik/form/input#icon-character-counter-and-validation-together","content":"Icon, character counter and validation together"},"1693":{"id":"/docs/galactik/form/input-4","page_id":"/docs/galactik/form/input","type":"heading","tags":[],"url":"/docs/galactik/form/input#options","content":"Options"},"1694":{"id":"/docs/galactik/form/input-5","page_id":"/docs/galactik/form/input","type":"heading","tags":[],"url":"/docs/galactik/form/input#pitfalls","content":"Pitfalls"},"1695":{"id":"/docs/galactik/form/input-6","page_id":"/docs/galactik/form/input","type":"heading","tags":[],"url":"/docs/galactik/form/input#whats-next","content":"What's next"},"1696":{"id":"/docs/galactik/form/input-7","page_id":"/docs/galactik/form/input","tags":[],"type":"text","url":"/docs/galactik/form/input","content":"`InputGroup` wraps a native `<input>` in a styled flex container — no JavaScript state duplication, every\nvisual state (focus, disabled, read-only) is driven by CSS `has-[]` selectors reading the native control's own\nstate."},"1697":{"id":"/docs/galactik/form/input-8","page_id":"/docs/galactik/form/input","tags":[],"type":"text","url":"/docs/galactik/form/input#options","content":"<TypeTable\n  type=\"{\n  size: { type: '&#x22;lg&#x22; | &#x22;md&#x22; | &#x22;sm&#x22;', default: '&#x22;md&#x22;', description: &#x22;Field height and padding.&#x22; },\n  scheme: { type: '&#x22;default&#x22; | &#x22;success&#x22; | &#x22;error&#x22;', default: '&#x22;default&#x22;', description: &#x22;Tints border, icons and, if mirrored, the counter.&#x22; },\n  filled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Tinted background, no border.&#x22; },\n  numbers: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Right-aligns text and applies tabular numerals.&#x22; },\n  autoHeight: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;The group grows with its content (wrapping chips, tags before the text) instead of keeping a fixed height; the size's height is its minimum.&#x22; },\n}\"\n/>"},"1698":{"id":"/docs/galactik/form/input-9","page_id":"/docs/galactik/form/input","tags":[],"type":"text","url":"/docs/galactik/form/input#pitfalls","content":"`@sinequa/ui` also exports an `InputComponent`, but it styles the native `<input>` directly via a `variant`\ninput applied to the element itself — a different composition from galactik's wrap-plus-projected-directives\nmodel. Always check the import path (`@sinequa/ui` vs `@sinequa/galactik`) before assuming which one is in\nscope."},"1699":{"id":"/docs/galactik/form/input-10","page_id":"/docs/galactik/form/input","tags":[],"type":"text","url":"/docs/galactik/form/input#pitfalls","content":"`size`/`scheme` are not linked automatically between `InputGroup` and `InputCounterComponent` — their CVAs are\nindependent. Mirror both explicitly on the counter, as in the recipe above."},"1700":{"id":"/docs/galactik/form/input-11","page_id":"/docs/galactik/form/input","tags":[],"type":"text","url":"/docs/galactik/form/input#whats-next","content":"The multi-line sibling, sharing the same state model and scheme palette."},"1701":{"id":"/docs/galactik/form/radio","page_id":"/docs/galactik/form/radio","type":"page","content":"Radio","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/radio"},"1702":{"id":"/docs/galactik/form/radio-0","page_id":"/docs/galactik/form/radio","tags":[],"type":"text","url":"/docs/galactik/form/radio","content":"A native radio input wrapped in an accessible label, grouped by a shared name and a derived selection signal rather than a container component."},"1703":{"id":"/docs/galactik/form/radio-1","page_id":"/docs/galactik/form/radio","type":"heading","tags":[],"url":"/docs/galactik/form/radio#minimal-example","content":"Minimal example"},"1704":{"id":"/docs/galactik/form/radio-2","page_id":"/docs/galactik/form/radio","type":"heading","tags":[],"url":"/docs/galactik/form/radio#how-it-works","content":"How it works"},"1705":{"id":"/docs/galactik/form/radio-3","page_id":"/docs/galactik/form/radio","type":"heading","tags":[],"url":"/docs/galactik/form/radio#options","content":"Options"},"1706":{"id":"/docs/galactik/form/radio-4","page_id":"/docs/galactik/form/radio","type":"heading","tags":[],"url":"/docs/galactik/form/radio#pitfalls","content":"Pitfalls"},"1707":{"id":"/docs/galactik/form/radio-5","page_id":"/docs/galactik/form/radio","type":"heading","tags":[],"url":"/docs/galactik/form/radio#whats-next","content":"What's next"},"1708":{"id":"/docs/galactik/form/radio-6","page_id":"/docs/galactik/form/radio","tags":[],"type":"text","url":"/docs/galactik/form/radio","content":"`Radio` wraps a native `<input type=\"radio\">` inside an accessible `<label>`, meant to be used in groups of two\nor more sharing the same `name` for a single exclusive choice. There is no `RadioGroup` container — exclusivity\ncomes from giving every radio the same `name` and deriving each one's `checked` from one shared signal."},"1709":{"id":"/docs/galactik/form/radio-7","page_id":"/docs/galactik/form/radio","tags":[],"type":"text","url":"/docs/galactik/form/radio#how-it-works","content":"Each `<radio>` owns an independent `checked` model — grouping relies on two things working together: the\nnative `name` attribute (native focus/keyboard roving, and the browser visually unchecking siblings), and\nderiving every radio's `[checked]` from one shared signal so the app's own state stays authoritative. As long\nas `[checked]` is a derived expression (`selected() === 'x'`) rather than an independent local boolean per\nradio, a sibling recomputes to `false` automatically when another one is picked — the native `(change)` only\nfires on the newly-selected radio, never on the one that gets unchecked, and this is what makes that safe."},"1710":{"id":"/docs/galactik/form/radio-8","page_id":"/docs/galactik/form/radio","tags":[],"type":"text","url":"/docs/galactik/form/radio#options","content":"<TypeTable\n  type=\"{\n  checked: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Two-way bindable checked state of this individual radio.&#x22; },\n  name: { type: &#x22;string | undefined&#x22;, description: &#x22;Native name attribute — give every radio in a group the same value for native exclusivity.&#x22; },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables this radio; usable as a bare attribute.&#x22; },\n  hint: { type: &#x22;string | undefined&#x22;, description: &#x22;Optional secondary text rendered under the label.&#x22; },\n}\"\n/>"},"1711":{"id":"/docs/galactik/form/radio-9","page_id":"/docs/galactik/form/radio","tags":[],"type":"text","url":"/docs/galactik/form/radio#pitfalls","content":"A single `Radio` exposes exactly `checked = model<boolean>(...)`, the structural shape `FormCheckboxControl`\nrequires — so `[formField]` binds one radio to one boolean sub-field, but `FormCheckboxControl` doesn't give a\nwhole group mutual exclusivity by itself. For an exclusive choice backed by Signal Forms, keep the shared-signal\npattern from the minimal example (or wrap the group behind a custom `FormValueControl<string>`)."},"1712":{"id":"/docs/galactik/form/radio-10","page_id":"/docs/galactik/form/radio","tags":[],"type":"text","url":"/docs/galactik/form/radio#pitfalls","content":"`@sinequa/ui` also exports a `RadioComponent` with the identical selector (`radio, Radio`) and a `checked` model\nof the same name, but it renders `role=\"radio\"` directly on the host — no real native `<input>`, no `name`\nattribute, no native keyboard roving — and adds a `size` input galactik's `Radio` doesn't have. Double-check the\nimport path before assuming which accessibility model applies."},"1713":{"id":"/docs/galactik/form/radio-11","page_id":"/docs/galactik/form/radio","tags":[],"type":"text","url":"/docs/galactik/form/radio#whats-next","content":"The independent-selection sibling, with an indeterminate visual state."},"1714":{"id":"/docs/galactik/form/search-bar","page_id":"/docs/galactik/form/search-bar","type":"page","content":"Search Bar","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/search-bar"},"1715":{"id":"/docs/galactik/form/search-bar-0","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar","content":"A self-contained, pill-shaped search field with a leading icon and built-in clear/send controls, meant to stand on its own rather than inside a form."},"1716":{"id":"/docs/galactik/form/search-bar-1","page_id":"/docs/galactik/form/search-bar","type":"heading","tags":[],"url":"/docs/galactik/form/search-bar#minimal-example","content":"Minimal example"},"1717":{"id":"/docs/galactik/form/search-bar-2","page_id":"/docs/galactik/form/search-bar","type":"heading","tags":[],"url":"/docs/galactik/form/search-bar#how-it-works","content":"How it works"},"1718":{"id":"/docs/galactik/form/search-bar-3","page_id":"/docs/galactik/form/search-bar","type":"heading","tags":[],"url":"/docs/galactik/form/search-bar#recipes","content":"Recipes"},"1719":{"id":"/docs/galactik/form/search-bar-4","page_id":"/docs/galactik/form/search-bar","type":"heading","tags":[],"url":"/docs/galactik/form/search-bar#projecting-app-actions-on-both-sides-of-the-send-button","content":"Projecting app actions on both sides of the send button"},"1720":{"id":"/docs/galactik/form/search-bar-5","page_id":"/docs/galactik/form/search-bar","type":"heading","tags":[],"url":"/docs/galactik/form/search-bar#options","content":"Options"},"1721":{"id":"/docs/galactik/form/search-bar-6","page_id":"/docs/galactik/form/search-bar","type":"heading","tags":[],"url":"/docs/galactik/form/search-bar#pitfalls","content":"Pitfalls"},"1722":{"id":"/docs/galactik/form/search-bar-7","page_id":"/docs/galactik/form/search-bar","type":"heading","tags":[],"url":"/docs/galactik/form/search-bar#whats-next","content":"What's next"},"1723":{"id":"/docs/galactik/form/search-bar-8","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar","content":"A self-contained search field — think an application's global search — with a leading magnifier icon and\nbuilt-in clear (×) and send controls, distinct from `SearchInput` which blends into a\nform alongside other fields."},"1724":{"id":"/docs/galactik/form/search-bar-9","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#how-it-works","content":"The clear (×) button appears automatically once `value` is non-empty and calls `value.set(\"\")` internally; the\nsend button emits the current `value()` on click or Enter. `SearchBar` never navigates or calls a\nbackend itself — `search` only reports the submitted text, leaving persistence/navigation entirely to the host."},"1725":{"id":"/docs/galactik/form/search-bar-10","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#how-it-works","content":"Content projected into the pill lands in one of two places: the **default** slot, between the clear and send\nbuttons (query-scoped actions like a favourite toggle), or `slot=\"trailing\"`, after the send button (an\nend-of-pill call to action)."},"1726":{"id":"/docs/galactik/form/search-bar-11","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#projecting-app-actions-on-both-sides-of-the-send-button","content":"Conditional trailing content needs the `slot=\"trailing\"` marker on an `<ng-container>` wrapping the block —\nAngular only hoists a block's marker onto the block itself when it has a single root node, and a sibling\nelement or a `@let` breaks that (see Pitfalls)."},"1727":{"id":"/docs/galactik/form/search-bar-12","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#options","content":"<TypeTable\n  type=\"{\n  value: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;The search text (two-way binding). Also the FormValueControl<string> contract member.&#x22; },\n  placeholder: { type: &#x22;string&#x22;, default: '&#x22;Search...&#x22;', description: &#x22;Placeholder text of the inner input.&#x22; },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables the field and both action buttons.&#x22; },\n  clearLabel: { type: &#x22;string&#x22;, default: '&#x22;Clear search&#x22;', description: &#x22;Accessible name of the clear button. Nothing in the library translates: pass it translated.&#x22; },\n  sendLabel: { type: &#x22;string&#x22;, default: '&#x22;Send&#x22;', description: &#x22;Accessible name of the send button. Nothing in the library translates: pass it translated.&#x22; },\n  hotkey: { type: &#x22;string&#x22;, description: &#x22;Value written to aria-keyshortcuts — informational only, no global key listener is wired.&#x22; },\n  size: { type: '&#x22;small&#x22; | &#x22;medium&#x22; | &#x22;large&#x22;', default: '&#x22;large&#x22;', description: &#x22;Field height and icon size.&#x22; },\n}\"\n/>"},"1728":{"id":"/docs/galactik/form/search-bar-13","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#pitfalls","content":"Angular hoists a `slot=\"trailing\"` marker onto a block only when that block has a single root node. Putting the\nmarker on an element that is itself inside an `@if`/`@for`, or beside a `@let`, breaks the hoist (the compiler\nreports `NG8011`) and the content lands in the default slot instead. Put the marker on an `<ng-container>`\nwrapping the whole block:"},"1729":{"id":"/docs/galactik/form/search-bar-14","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#pitfalls","content":"`searchBarVariants` styles the disabled state with `has-disabled:` (`:has(:disabled)`), which matches **any**\ndisabled descendant — including your own projected content — and greys out the entire pill. Use `aria-disabled`\nplus `pointer-events-none opacity-50` and guard the handler yourself instead of the native `disabled` attribute\non projected content."},"1730":{"id":"/docs/galactik/form/search-bar-15","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#pitfalls","content":"Galactik icons render with `display: contents`, so the `<svg>` itself is the flex item — inside the pill's tight\nlayout it collapses without an explicit size. Add `shrink-0` to a bare projected icon; icons already wrapped in\na `<Button>` are unaffected."},"1731":{"id":"/docs/galactik/form/search-bar-16","page_id":"/docs/galactik/form/search-bar","tags":[],"type":"text","url":"/docs/galactik/form/search-bar#whats-next","content":"The inline-form sibling, styled like InputGroup, no send button."},"1732":{"id":"/docs/galactik/form/search-input","page_id":"/docs/galactik/form/search-input","type":"page","content":"Search Input","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/search-input"},"1733":{"id":"/docs/galactik/form/search-input-0","page_id":"/docs/galactik/form/search-input","tags":[],"type":"text","url":"/docs/galactik/form/search-input","content":"A search field styled like InputGroup, meant to sit inline among other form fields rather than standing alone as a pill."},"1734":{"id":"/docs/galactik/form/search-input-1","page_id":"/docs/galactik/form/search-input","type":"heading","tags":[],"url":"/docs/galactik/form/search-input#minimal-example","content":"Minimal example"},"1735":{"id":"/docs/galactik/form/search-input-2","page_id":"/docs/galactik/form/search-input","type":"heading","tags":[],"url":"/docs/galactik/form/search-input#options","content":"Options"},"1736":{"id":"/docs/galactik/form/search-input-3","page_id":"/docs/galactik/form/search-input","type":"heading","tags":[],"url":"/docs/galactik/form/search-input#pitfalls","content":"Pitfalls"},"1737":{"id":"/docs/galactik/form/search-input-4","page_id":"/docs/galactik/form/search-input","type":"heading","tags":[],"url":"/docs/galactik/form/search-input#whats-next","content":"What's next"},"1738":{"id":"/docs/galactik/form/search-input-5","page_id":"/docs/galactik/form/search-input","tags":[],"type":"text","url":"/docs/galactik/form/search-input","content":"`SearchInput` reuses `InputGroup`'s visual system (icon slots, border/focus/disabled states) and\nadds only a clear (×) button — no send button, no pill shape. For a self-contained search field with its own\nsubmit control, see `SearchBar` instead."},"1739":{"id":"/docs/galactik/form/search-input-6","page_id":"/docs/galactik/form/search-input","tags":[],"type":"text","url":"/docs/galactik/form/search-input#options","content":"<TypeTable\n  type=\"{\n  value: { type: &#x22;string&#x22;, default: '&#x22;&#x22;', description: &#x22;The search text (two-way binding). Also the FormValueControl<string> contract member.&#x22; },\n  placeholder: { type: &#x22;string&#x22;, default: '&#x22;Search...&#x22;', description: &#x22;Placeholder text of the inner input.&#x22; },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables the field and dims the host.&#x22; },\n  clearLabel: { type: &#x22;string&#x22;, default: '&#x22;Clear search&#x22;', description: &#x22;Accessible name of the clear button. Nothing in the library translates: pass it translated.&#x22; },\n  hotkey: { type: &#x22;string&#x22;, description: &#x22;Value written to aria-keyshortcuts — informational only, no global key listener is wired.&#x22; },\n}\"\n/>"},"1740":{"id":"/docs/galactik/form/search-input-7","page_id":"/docs/galactik/form/search-input","tags":[],"type":"text","url":"/docs/galactik/form/search-input#pitfalls","content":"`disabled` is conveyed by ARIA, not by the native property: the inner `<input>` carries the combobox directive, which takes\nover `[disabled]` and exposes `aria-disabled=\"true\"` and `readonly`, while the host is dimmed and ignores the pointer. The\nDOM `disabled` property stays `false`, and the field stays reachable with `Tab`. Assert on\n`input.getAttribute(\"aria-disabled\")` instead. This follows the combobox pattern, which wants a disabled field to remain\nfocusable; a native `disabled` would take it out of the tab order."},"1741":{"id":"/docs/galactik/form/search-input-8","page_id":"/docs/galactik/form/search-input","tags":[],"type":"text","url":"/docs/galactik/form/search-input#pitfalls","content":"Expected — `SearchInput` has no `search` output and no send button by design: submission is driven by the\nsurrounding form (native `submit`, a button, or `(keydown.enter)` on the input), consistent with it being \"just\nanother field\" in a larger form. Reach for `SearchBar` when a self-contained field with its own submit is\nwanted."},"1742":{"id":"/docs/galactik/form/search-input-9","page_id":"/docs/galactik/form/search-input","tags":[],"type":"text","url":"/docs/galactik/form/search-input#whats-next","content":"The self-contained sibling — a pill with its own clear and send controls."},"1743":{"id":"/docs/galactik/form/select","page_id":"/docs/galactik/form/select","type":"page","content":"Select","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/select"},"1744":{"id":"/docs/galactik/form/select-0","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select","content":"A single- or multiple-choice dropdown built on the accessible @angular/aria combobox/listbox primitives, with a fully custom trigger and option rendering when the default chrome doesn't fit."},"1745":{"id":"/docs/galactik/form/select-1","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#minimal-example","content":"Minimal example"},"1746":{"id":"/docs/galactik/form/select-2","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#how-it-works","content":"How it works"},"1747":{"id":"/docs/galactik/form/select-3","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#recipes","content":"Recipes"},"1748":{"id":"/docs/galactik/form/select-4","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#multiple-selection","content":"Multiple selection"},"1749":{"id":"/docs/galactik/form/select-5","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#object-options--custom-key-label-and-row","content":"Object options — custom key, label and row"},"1750":{"id":"/docs/galactik/form/select-6","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#a-fully-custom-trigger","content":"A fully custom trigger"},"1751":{"id":"/docs/galactik/form/select-7","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#options","content":"Options"},"1752":{"id":"/docs/galactik/form/select-8","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#pitfalls","content":"Pitfalls"},"1753":{"id":"/docs/galactik/form/select-9","page_id":"/docs/galactik/form/select","type":"heading","tags":[],"url":"/docs/galactik/form/select#whats-next","content":"What's next"},"1754":{"id":"/docs/galactik/form/select-10","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select","content":"A dropdown that behaves like a native `<select>` — keyboard navigable, `aria-selected`, popup positioned near\nthe field — but accepts option and trigger content of any shape. `SelectMenu` (`SelectComponent`) covers both\nsingle and multiple selection from one component."},"1755":{"id":"/docs/galactik/form/select-11","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select","content":"Angular Signal Forms recognizes a component as a form control when it exposes a `value` model matching the\n`FormValueControl<TValue>` contract. `SelectMenu` implements it through its own `value` model, so `[formField]`\nworks exactly like it would on a native input — no adapter needed."},"1756":{"id":"/docs/galactik/form/select-12","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#how-it-works","content":"The trigger and popup are the accessible `@angular/aria` combobox/listbox primitives — every role and ARIA\nstate (`role=\"combobox\"`, `aria-expanded`, `aria-haspopup=\"listbox\"` on the trigger; `role=\"listbox\"`,\n`aria-activedescendant`, `aria-selected` on the popup) comes from there, nothing to wire by hand. The popup is\npositioned with `@floating-ui/dom` (`offset(4)`, `flip()`, `shift({ padding: 8 })`), its width bound to the\ntrigger's, and reopening it scrolls the current selection into view automatically."},"1757":{"id":"/docs/galactik/form/select-13","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#how-it-works","content":"The row under the mouse becomes the active row (`pointermove` on the `ngListbox`, via `activateOnHover`), so only one\nrow is highlighted at a time and the arrow keys carry on from it; a still pointer under a scrolling list changes nothing."},"1758":{"id":"/docs/galactik/form/select-14","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#how-it-works","content":"**Single vs. multiple** only changes the shape of `value` and whether the popup closes on pick: single mode\n(default) is `TOption | null` and closes the popup once a choice is made; `multiple` makes `value` an array,\nkeeps the popup open across picks, and shows a check mark via the option template's `selected` context."},"1759":{"id":"/docs/galactik/form/select-15","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#object-options--custom-key-label-and-row","content":"`key`/`label` default to identity/`String(option)`, correct only for primitive options. Any object-shaped\noption needs explicit functions — otherwise the trigger prints `[object Object]` and selection comparisons\nbreak (see Pitfalls)."},"1760":{"id":"/docs/galactik/form/select-16","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#a-fully-custom-trigger","content":"Project a `[selectTrigger]` element to replace the default trigger entirely — useful for a compact, chrome-less\ntrigger such as a sort selector. `placeholder` and `#selectValue` no longer apply once a custom trigger is\nprojected; render the current value yourself."},"1761":{"id":"/docs/galactik/form/select-17","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#options","content":"<TypeTable\n  type=\"{\n  options: { type: &#x22;readonly TOption[]&#x22;, default: &#x22;[]&#x22;, description: &#x22;Available options.&#x22; },\n  value: {\n    type: &#x22;TValue&#x22;,\n    default: &#x22;null&#x22;,\n    description:\n      &#x22;Selected value — two-way ([(value)]). Single (default): TOption | null. Multiple: value becomes TOption[]. Empty state is always null, never undefined.&#x22;,\n  },\n  multiple: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Enables multi-selection; value becomes an array and the popup stays open across picks.&#x22; },\n  selectionMode: {\n    type: '&#x22;explicit&#x22; | &#x22;follow&#x22;',\n    default: '&#x22;explicit&#x22;',\n    description: &#x22;explicit: arrow keys only highlight, Enter/click commits. follow: selection follows keyboard navigation.&#x22;,\n  },\n  size: { type: '&#x22;lg&#x22; | &#x22;md&#x22; | &#x22;sm&#x22;', default: '&#x22;md&#x22;', description: &#x22;Trigger height 44 / 36 / 24px, one ladder for text, label and gaps.&#x22; },\n  placement: { type: &#x22;Placement (@floating-ui/dom)&#x22;, default: '&#x22;bottom-start&#x22;', description: &#x22;Popup placement relative to the trigger.&#x22; },\n  key: { type: &#x22;(option: TOption) => unknown&#x22;, default: &#x22;(option) => option&#x22;, description: &#x22;Comparable identity of an option. Required for object options.&#x22; },\n  label: { type: &#x22;(option: TOption) => string&#x22;, default: &#x22;(option) => String(option)&#x22;, description: &#x22;Text label for typeahead and the default templates.&#x22; },\n  fieldLabel: { type: &#x22;string&#x22;, description: &#x22;Visible label above the trigger. It also names the default trigger and the popup's list: the trigger reads “<fieldLabel>, <value>”.&#x22; },\n  &#x22;aria-label&#x22;: {\n    type: &#x22;string&#x22;,\n    description:\n      &#x22;Accessible name when there is no visible fieldLabel (a compact sort selector, say). Bound as aria-label=\\&#x22;…\\&#x22; or [aria-label]=\\&#x22;expr\\&#x22; — translate it. Ignored with a custom [selectTrigger], whose name is yours.&#x22;,\n  },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables the default trigger. Ignored with a custom [selectTrigger].&#x22; },\n  noOptionsText: { type: &#x22;string&#x22;, default: '&#x22;No options&#x22;', description: &#x22;Text shown in place of the list when options is empty.&#x22; },\n}\"\n/>"},"1762":{"id":"/docs/galactik/form/select-18","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#pitfalls","content":"With neither `fieldLabel` nor `aria-label`, the default trigger has no accessible name beyond its own text — a\nscreen reader says “Apple”, with no hint of what is being chosen. Give every select one of the two. The default\ntrigger is then named `aria-labelledby` the label first and itself second (“Fruit, Apple”), so the current value\nstays part of the announcement; a native `<label for>` would not do that, since it replaces a button's content in\nthe name. The popup's list carries the same name."},"1763":{"id":"/docs/galactik/form/select-19","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#pitfalls","content":"A rich label that `fieldLabel` cannot express goes in a projected `.select-label` element, with\n`SelectLabelDirective` in the `imports` of the declaring component: the directive gives the element an id and the\nselect names the trigger and the list from it (the projected label wins over `fieldLabel`). Without the directive\nthe element is painted but is not part of the accessible name."},"1764":{"id":"/docs/galactik/form/select-20","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#pitfalls","content":"One limit: a projected `[selectTrigger]` gets no automatic name — put an `aria-label` or `aria-labelledby` on it."},"1765":{"id":"/docs/galactik/form/select-21","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#pitfalls","content":"The empty state of `value` must be `null`, never `undefined` — setting it to `undefined` removes the property\nfrom the field entirely, which Signal Forms reports as an orphan field (`NG01902`) rather than a valid empty\nvalue. Type the field as `string | null` (or your option type `| null`), initial `null`, and never write\n`undefined` to it yourself."},"1766":{"id":"/docs/galactik/form/select-22","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#pitfalls","content":"`key`/`label` default to identity/`String(option)`, which only makes sense for primitive options (strings,\nnumbers). Any object-shaped option needs explicit `[key]` and `[label]` functions — see Object\noptions above."},"1767":{"id":"/docs/galactik/form/select-23","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#pitfalls","content":"`placeholder`, `size` and the built-in chevron only apply to the **default** trigger. Once you project a\n`[selectTrigger]`, you own the whole trigger element — size it, disable it and render its value yourself; none\nof the default-trigger inputs apply anymore."},"1768":{"id":"/docs/galactik/form/select-24","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#whats-next","content":"The async, backend-searched sibling of Select — same look, always multi-selection, always tag-based."},"1769":{"id":"/docs/galactik/form/select-25","page_id":"/docs/galactik/form/select","tags":[],"type":"text","url":"/docs/galactik/form/select#whats-next","content":"Install galactik and set up its design tokens."},"1770":{"id":"/docs/galactik/form/switch","page_id":"/docs/galactik/form/switch","type":"page","content":"Switch","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/switch"},"1771":{"id":"/docs/galactik/form/switch-0","page_id":"/docs/galactik/form/switch","tags":[],"type":"text","url":"/docs/galactik/form/switch","content":"A native checkbox styled as an on/off track-and-thumb toggle, with the same Signal Forms shape as Checkbox."},"1772":{"id":"/docs/galactik/form/switch-1","page_id":"/docs/galactik/form/switch","type":"heading","tags":[],"url":"/docs/galactik/form/switch#minimal-example","content":"Minimal example"},"1773":{"id":"/docs/galactik/form/switch-2","page_id":"/docs/galactik/form/switch","type":"heading","tags":[],"url":"/docs/galactik/form/switch#options","content":"Options"},"1774":{"id":"/docs/galactik/form/switch-3","page_id":"/docs/galactik/form/switch","type":"heading","tags":[],"url":"/docs/galactik/form/switch#pitfalls","content":"Pitfalls"},"1775":{"id":"/docs/galactik/form/switch-4","page_id":"/docs/galactik/form/switch","type":"heading","tags":[],"url":"/docs/galactik/form/switch#whats-next","content":"What's next"},"1776":{"id":"/docs/galactik/form/switch-5","page_id":"/docs/galactik/form/switch","tags":[],"type":"text","url":"/docs/galactik/form/switch","content":"`Switch` wraps a native `<input type=\"checkbox\" role=\"switch\">` inside an accessible `<label>`, styled as an\non/off track-and-thumb toggle with a built-in check/cross icon in the thumb."},"1777":{"id":"/docs/galactik/form/switch-6","page_id":"/docs/galactik/form/switch","tags":[],"type":"text","url":"/docs/galactik/form/switch#options","content":"<TypeTable\n  type=\"{\n  checked: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Two-way bindable on/off state.&#x22; },\n  size: { type: '&#x22;small&#x22; | &#x22;xsmall&#x22;', default: '&#x22;small&#x22;', description: '&#x22;xs&#x22; is also accepted, identical to &#x22;xsmall&#x22;.' },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables the control; usable as a bare attribute.&#x22; },\n}\"\n/>"},"1778":{"id":"/docs/galactik/form/switch-7","page_id":"/docs/galactik/form/switch","tags":[],"type":"text","url":"/docs/galactik/form/switch#pitfalls","content":"Unlike `Checkbox`, `Switch` does not stop click propagation on its host — a `<switch>` nested inside another\nclickable row will also fire that row's own click handler. Stop propagation yourself on the row if that is not\nwanted."},"1779":{"id":"/docs/galactik/form/switch-8","page_id":"/docs/galactik/form/switch","tags":[],"type":"text","url":"/docs/galactik/form/switch#pitfalls","content":"`@sinequa/ui` also exports a `SwitchComponent` with the identical selector (`switch, Switch&#x60;), but its two-way\nbindable state is named &#x2A;*`toggled`**, not `checked`, and it adds a `variant` input galactik's `Switch` doesn't\nhave. The property name difference means example code does not silently port between the two — double-check\nboth the import path and the binding name before reusing it."},"1780":{"id":"/docs/galactik/form/switch-9","page_id":"/docs/galactik/form/switch","tags":[],"type":"text","url":"/docs/galactik/form/switch#whats-next","content":"The multi-select sibling, with an indeterminate state and Signal Forms integration."},"1781":{"id":"/docs/galactik/form/tag-input","page_id":"/docs/galactik/form/tag-input","type":"page","content":"Tag Input","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/tag-input"},"1782":{"id":"/docs/galactik/form/tag-input-0","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input","content":"A free-text field that turns what is typed into removable tags — comma or Enter adds one, Backspace removes the last, duplicates are ignored."},"1783":{"id":"/docs/galactik/form/tag-input-1","page_id":"/docs/galactik/form/tag-input","type":"heading","tags":[],"url":"/docs/galactik/form/tag-input#minimal-example","content":"Minimal example"},"1784":{"id":"/docs/galactik/form/tag-input-2","page_id":"/docs/galactik/form/tag-input","type":"heading","tags":[],"url":"/docs/galactik/form/tag-input#how-it-works","content":"How it works"},"1785":{"id":"/docs/galactik/form/tag-input-3","page_id":"/docs/galactik/form/tag-input","type":"heading","tags":[],"url":"/docs/galactik/form/tag-input#options","content":"Options"},"1786":{"id":"/docs/galactik/form/tag-input-4","page_id":"/docs/galactik/form/tag-input","type":"heading","tags":[],"url":"/docs/galactik/form/tag-input#pitfalls","content":"Pitfalls"},"1787":{"id":"/docs/galactik/form/tag-input-5","page_id":"/docs/galactik/form/tag-input","type":"heading","tags":[],"url":"/docs/galactik/form/tag-input#whats-next","content":"What's next"},"1788":{"id":"/docs/galactik/form/tag-input-6","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input","content":"`TagInput` collects a list of short free-text labels — keywords, categories, e-mail addresses — in one field. The tags\nsit inside the field, before the text being typed. It reuses `InputGroup`'s visual system (border,\nfocus, disabled and error states) and shows each tag as a `Tag` with a remove button."},"1789":{"id":"/docs/galactik/form/tag-input-7","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input","content":"For a choice among known options, with suggestions, use `Autocomplete` instead: `TagInput`\nnever proposes anything and accepts any text."},"1790":{"id":"/docs/galactik/form/tag-input-8","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#how-it-works","content":"`TagInput` is a signal forms `FormValueControl<string[]>`: bind it with `[(value)]`, or as a form field."},"1791":{"id":"/docs/galactik/form/tag-input-9","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#how-it-works","content":"What typing does:"},"1792":{"id":"/docs/galactik/form/tag-input-10","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#how-it-works","content":"**The separator** (`,` by default; `separator=\",;\"` gives several) and **Enter** add the tag being typed. Enter never\nsubmits the surrounding form."},"1793":{"id":"/docs/galactik/form/tag-input-11","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#how-it-works","content":"A tag is trimmed. An empty one is ignored, and so is a duplicate **whatever its case** — the first spelling stays."},"1794":{"id":"/docs/galactik/form/tag-input-12","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#how-it-works","content":"**Backspace** in an empty field removes the last tag. The remove button of a tag removes that one."},"1795":{"id":"/docs/galactik/form/tag-input-13","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#how-it-works","content":"**Pasting** `a, b, c` (or one tag per line) adds three tags."},"1796":{"id":"/docs/galactik/form/tag-input-14","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#how-it-works","content":"**Leaving the field** adds what is typed (`addOnBlur`, on by default), so a Save button never loses the last word."},"1797":{"id":"/docs/galactik/form/tag-input-15","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#options","content":"<TypeTable\n  type=\"{\n  value: { type: &#x22;string[]&#x22;, default: &#x22;[]&#x22;, description: &#x22;The tags, in the order they were added (two-way binding). Also the FormValueControl<string[]> contract member.&#x22; },\n  placeholder: { type: &#x22;string&#x22;, default: '&#x22;Add a tag…&#x22;', description: &#x22;Shown only while there is no tag.&#x22; },\n  separator: { type: &#x22;string&#x22;, default: '&#x22;,&#x22;', description: &#x22;The character(s) that add the tag being typed, besides Enter.&#x22; },\n  addOnBlur: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Adds what is typed when the field loses focus.&#x22; },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables the field and every remove button; dims the host.&#x22; },\n  readonly: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;The tags stay visible but cannot be changed.&#x22; },\n  scheme: { type: '&#x22;default&#x22; | &#x22;success&#x22; | &#x22;error&#x22;', default: '&#x22;default&#x22;', description: &#x22;The InputGroup colour scheme; error also sets aria-invalid on the field.&#x22; },\n  size: { type: '&#x22;sm&#x22; | &#x22;md&#x22; | &#x22;lg&#x22;', default: '&#x22;md&#x22;', description: &#x22;The InputGroup size; the field grows past it when the tags wrap.&#x22; },\n  &#x22;aria-label&#x22;: { type: &#x22;string&#x22;, description: &#x22;The accessible name of the group — what the tags are. Written on the element, as for SearchInput.&#x22; },\n  addLabel: { type: &#x22;string&#x22;, default: '&#x22;Add a tag&#x22;', description: &#x22;The accessible name of the typing field.&#x22; },\n  removeLabel: { type: &#x22;string&#x22;, default: '&#x22;Remove {tag}&#x22;', description: &#x22;The accessible name of a remove button; {tag} is replaced.&#x22; },\n  addedLabel: { type: &#x22;string&#x22;, default: '&#x22;{tag} added&#x22;', description: &#x22;Announced politely after an addition; {tag} is replaced.&#x22; },\n  removedLabel: { type: &#x22;string&#x22;, default: '&#x22;{tag} removed&#x22;', description: &#x22;Announced politely after a removal; {tag} is replaced.&#x22; },\n}\"\n/>"},"1798":{"id":"/docs/galactik/form/tag-input-16","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#options","content":"Methods: `commit()` adds what is typed and clears the field, `add(text)` and `remove(tag)` do what the keyboard does,\nand `focus()` moves the focus into the field."},"1799":{"id":"/docs/galactik/form/tag-input-17","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#options","content":"Nothing in the library translates: pass the five labels translated."},"1800":{"id":"/docs/galactik/form/tag-input-18","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#pitfalls","content":"`addOnBlur` covers a click on a Save button, which takes the focus first. A form that submits with the field still\nfocused — Enter in *another* field, or a programmatic `submit()` — has to call `commit()` first:\n`viewChild(TagInputComponent).commit()`."},"1801":{"id":"/docs/galactik/form/tag-input-19","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#pitfalls","content":"`[formField]` rewrites the `id` of the inner input, and the host is a group, not a control. Name the field with\n`aria-label` (and show the visible label next to it), as the examples do."},"1802":{"id":"/docs/galactik/form/tag-input-20","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#whats-next","content":"The async, backend-searched sibling, always tag-based."},"1803":{"id":"/docs/galactik/form/tag-input-21","page_id":"/docs/galactik/form/tag-input","tags":[],"type":"text","url":"/docs/galactik/form/tag-input#whats-next","content":"The chip each tag is drawn with."},"1804":{"id":"/docs/galactik/form/textarea","page_id":"/docs/galactik/form/textarea","type":"page","content":"Textarea","breadcrumbs":["Docs","Galactik","Form"],"tags":[],"url":"/docs/galactik/form/textarea"},"1805":{"id":"/docs/galactik/form/textarea-0","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea","content":"A native textarea wrapped like Input, with three height strategies and a rows-independent min/max bound for content-driven auto-sizing."},"1806":{"id":"/docs/galactik/form/textarea-1","page_id":"/docs/galactik/form/textarea","type":"heading","tags":[],"url":"/docs/galactik/form/textarea#minimal-example","content":"Minimal example"},"1807":{"id":"/docs/galactik/form/textarea-2","page_id":"/docs/galactik/form/textarea","type":"heading","tags":[],"url":"/docs/galactik/form/textarea#how-it-works","content":"How it works"},"1808":{"id":"/docs/galactik/form/textarea-3","page_id":"/docs/galactik/form/textarea","type":"heading","tags":[],"url":"/docs/galactik/form/textarea#recipes","content":"Recipes"},"1809":{"id":"/docs/galactik/form/textarea-4","page_id":"/docs/galactik/form/textarea","type":"heading","tags":[],"url":"/docs/galactik/form/textarea#auto-sizing-bounded-by-minrowsmaxrows","content":"Auto-sizing bounded by minRows/maxRows"},"1810":{"id":"/docs/galactik/form/textarea-5","page_id":"/docs/galactik/form/textarea","type":"heading","tags":[],"url":"/docs/galactik/form/textarea#options","content":"Options"},"1811":{"id":"/docs/galactik/form/textarea-6","page_id":"/docs/galactik/form/textarea","type":"heading","tags":[],"url":"/docs/galactik/form/textarea#pitfalls","content":"Pitfalls"},"1812":{"id":"/docs/galactik/form/textarea-7","page_id":"/docs/galactik/form/textarea","type":"heading","tags":[],"url":"/docs/galactik/form/textarea#whats-next","content":"What's next"},"1813":{"id":"/docs/galactik/form/textarea-8","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea","content":"`TextareaGroup` is the multi-line sibling of `InputGroup` — same state model, same scheme\npalette, same counter typography — plus a `resize` strategy for how its height behaves."},"1814":{"id":"/docs/galactik/form/textarea-9","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#how-it-works","content":"`resize=\"auto\"` is a progressive enhancement: the CSS `field-sizing: content` property ships in Chrome/Edge\n123+ and Safari 17.4+, but not in Firefox, so the drag handle is only removed inside an `@supports` guard —\napplying it unconditionally would leave Firefox with a box that neither grows nor can be dragged."},"1815":{"id":"/docs/galactik/form/textarea-10","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#auto-sizing-bounded-by-minrowsmaxrows","content":"`rows` has no effect once `field-sizing: content` applies, so `minRows`/`maxRows` exist precisely to bound an\nauto-sizing field — the sizing API that survives where `rows` no longer does."},"1816":{"id":"/docs/galactik/form/textarea-11","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#options","content":"<TypeTable\n  type=\"{\n  size: { type: '&#x22;lg&#x22; | &#x22;md&#x22; | &#x22;sm&#x22;', default: '&#x22;md&#x22;', description: &#x22;Padding, radius and type scale — never a fixed height.&#x22; },\n  scheme: { type: '&#x22;default&#x22; | &#x22;success&#x22; | &#x22;error&#x22;', default: '&#x22;default&#x22;', description: &#x22;Tints border, focus ring and text.&#x22; },\n  resize: {\n    type: '&#x22;vertical&#x22; | &#x22;none&#x22; | &#x22;auto&#x22;',\n    default: '&#x22;vertical&#x22;',\n    description: &#x22;vertical: native drag handle. none: locked to rows. auto: grows with content (field-sizing).&#x22;,\n  },\n  minRows: { type: &#x22;number | undefined&#x22;, description: &#x22;Height floor in lines of text. Applied as min-height.&#x22; },\n  maxRows: { type: &#x22;number | undefined&#x22;, description: &#x22;Height ceiling in lines of text; the control scrolls past it. Applied as max-height.&#x22; },\n  filled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Tinted background, no border.&#x22; },\n}\"\n/>"},"1817":{"id":"/docs/galactik/form/textarea-12","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#pitfalls","content":"Expected: per the `field-sizing` spec, `rows`/`cols` have no effect once `field-sizing: content` applies. Use\n`minRows`/`maxRows` to bound the height instead — they compile to `min-height`/`max-height`, the only sizing\n`field-sizing` honours. Keep writing `rows` anyway: it is what the unsupported-engine (Firefox) fallback uses."},"1818":{"id":"/docs/galactik/form/textarea-13","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#pitfalls","content":"A `height` utility on the control cancels `field-sizing` outright. Bound the height with `minRows`/`maxRows` on\nthe wrapper instead of a fixed `h-*` class on the control in `auto` mode."},"1819":{"id":"/docs/galactik/form/textarea-14","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#pitfalls","content":"Bind `[attr.readonly]`, never `[readonly]`. The read-only look keys off `has-[[readonly]]`, an **attribute**\nselector — Angular's `[readonly]` binding sets the `readOnly` DOM *property* and reflects nothing into the\nmarkup, so the field behaves as read-only while still looking editable:"},"1820":{"id":"/docs/galactik/form/textarea-15","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#pitfalls","content":"The same applies to `[attr.disabled]` if toggled dynamically outside a form control."},"1821":{"id":"/docs/galactik/form/textarea-16","page_id":"/docs/galactik/form/textarea","tags":[],"type":"text","url":"/docs/galactik/form/textarea#whats-next","content":"The single-line sibling — same state model, scheme palette and counter."},"1822":{"id":"/docs/galactik/integration/breakpoint-observer","page_id":"/docs/galactik/integration/breakpoint-observer","type":"page","content":"BreakpointObserverService","breadcrumbs":["Docs","Galactik","Integration"],"tags":[],"url":"/docs/galactik/integration/breakpoint-observer"},"1823":{"id":"/docs/galactik/integration/breakpoint-observer-0","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer","content":"Answer one question as a signal — is the viewport narrower than the md breakpoint? — for structural choices CSS cannot express."},"1824":{"id":"/docs/galactik/integration/breakpoint-observer-1","page_id":"/docs/galactik/integration/breakpoint-observer","type":"heading","tags":[],"url":"/docs/galactik/integration/breakpoint-observer#minimal-example","content":"Minimal example"},"1825":{"id":"/docs/galactik/integration/breakpoint-observer-2","page_id":"/docs/galactik/integration/breakpoint-observer","type":"heading","tags":[],"url":"/docs/galactik/integration/breakpoint-observer#how-it-works","content":"How it works"},"1826":{"id":"/docs/galactik/integration/breakpoint-observer-3","page_id":"/docs/galactik/integration/breakpoint-observer","type":"heading","tags":[],"url":"/docs/galactik/integration/breakpoint-observer#options","content":"Options"},"1827":{"id":"/docs/galactik/integration/breakpoint-observer-4","page_id":"/docs/galactik/integration/breakpoint-observer","type":"heading","tags":[],"url":"/docs/galactik/integration/breakpoint-observer#pitfalls","content":"Pitfalls"},"1828":{"id":"/docs/galactik/integration/breakpoint-observer-5","page_id":"/docs/galactik/integration/breakpoint-observer","type":"heading","tags":[],"url":"/docs/galactik/integration/breakpoint-observer#whats-next","content":"What's next"},"1829":{"id":"/docs/galactik/integration/breakpoint-observer-6","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer","content":"`BreakpointObserverService` answers one question as a signal: is the viewport narrower than the `md`\nbreakpoint (768px)? It exists for the cases CSS cannot express — choosing a component (a sheet instead of a\nside panel), a placement (`bottom-start` instead of `left-start`), a size input."},"1830":{"id":"/docs/galactik/integration/breakpoint-observer-7","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer","content":"Anything that is purely a matter of layout belongs in a Tailwind `md:` variant instead: the CSS costs nothing\nat runtime, needs no injection, and cannot fall out of sync with the service."},"1831":{"id":"/docs/galactik/integration/breakpoint-observer-8","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer#how-it-works","content":"The service is backed by `matchMedia`, observing `(width < 768px)` — the exact negation of Tailwind's `md`, so\nthe signal and the CSS always agree at every width. It reacts to a resize with no `resize` listener of its\nown, removes its listener when the injector is destroyed, and is inert under server-side rendering (no\n`window` access — the signal stays `false`)."},"1832":{"id":"/docs/galactik/integration/breakpoint-observer-9","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer#how-it-works","content":"The viewport is measured in the constructor, not in an `afterNextRender` callback, so a consumer that injects\nthe service and reads `isMobile()` during change detection — a `computed`, a template expression — gets the\nreal answer straight away, with no render needed first."},"1833":{"id":"/docs/galactik/integration/breakpoint-observer-10","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer#options","content":"<TypeTable\n  type=\"{\n  isMobile: { type: &#x22;Signal<boolean>&#x22;, description: &#x22;true while the viewport is narrower than 768px.&#x22; },\n}\"\n/>"},"1834":{"id":"/docs/galactik/integration/breakpoint-observer-11","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer#pitfalls","content":"`matchMedia` is not driveable in JSDOM — it matches nothing and cannot be told to change. Provide the service\ninstead of trying to steer the real one:"},"1835":{"id":"/docs/galactik/integration/breakpoint-observer-12","page_id":"/docs/galactik/integration/breakpoint-observer","tags":[],"type":"text","url":"/docs/galactik/integration/breakpoint-observer#whats-next","content":"The component that reaches for this service to decide when to become a mobile drawer."},"1836":{"id":"/docs/galactik/integration","page_id":"/docs/galactik/integration","type":"page","content":"Integration","breadcrumbs":["Docs","Galactik","Integration"],"tags":[],"url":"/docs/galactik/integration"},"1837":{"id":"/docs/galactik/integration-0","page_id":"/docs/galactik/integration","tags":[],"type":"text","url":"/docs/galactik/integration","content":"Cross-cutting utilities for wiring galactik into a host application — the breakpoint observer service."},"1838":{"id":"/docs/galactik/integration-1","page_id":"/docs/galactik/integration","type":"heading","tags":[],"url":"/docs/galactik/integration#whats-next","content":"What's next"},"1839":{"id":"/docs/galactik/integration-2","page_id":"/docs/galactik/integration","tags":[],"type":"text","url":"/docs/galactik/integration","content":"Utilities that sit outside any single component family — a signal answering a structural, non-CSS question\nabout the current viewport."},"1840":{"id":"/docs/galactik/integration-3","page_id":"/docs/galactik/integration","tags":[],"type":"text","url":"/docs/galactik/integration#whats-next","content":"Is the viewport narrower than the md breakpoint, as a signal."},"1841":{"id":"/docs/galactik/navigation","page_id":"/docs/galactik/navigation","type":"page","content":"Navigation","breadcrumbs":["Docs","Galactik","Navigation"],"tags":[],"url":"/docs/galactik/navigation"},"1842":{"id":"/docs/galactik/navigation-0","page_id":"/docs/galactik/navigation","tags":[],"type":"text","url":"/docs/galactik/navigation","content":"Navigation components — Link, Tabs, Sidebar — for moving between views inside an application shell."},"1843":{"id":"/docs/galactik/navigation-1","page_id":"/docs/galactik/navigation","type":"heading","tags":[],"url":"/docs/galactik/navigation#whats-next","content":"What's next"},"1844":{"id":"/docs/galactik/navigation-2","page_id":"/docs/galactik/navigation","tags":[],"type":"text","url":"/docs/galactik/navigation","content":"Components for moving around inside an application: a styled anchor, a tabbed panel switcher, and a\ncollapsible app-shell navigation panel with a built-in mobile drawer."},"1845":{"id":"/docs/galactik/navigation-3","page_id":"/docs/galactik/navigation","tags":[],"type":"text","url":"/docs/galactik/navigation#whats-next","content":"A native anchor styled as a navigation link, internal or external."},"1846":{"id":"/docs/galactik/navigation-4","page_id":"/docs/galactik/navigation","tags":[],"type":"text","url":"/docs/galactik/navigation#whats-next","content":"A thin styling layer over @angular/aria/tabs."},"1847":{"id":"/docs/galactik/navigation-5","page_id":"/docs/galactik/navigation","tags":[],"type":"text","url":"/docs/galactik/navigation#whats-next","content":"A collapsible app navigation panel, with an automatic mobile drawer."},"1848":{"id":"/docs/galactik/navigation/link","page_id":"/docs/galactik/navigation/link","type":"page","content":"Link","breadcrumbs":["Docs","Galactik","Navigation"],"tags":[],"url":"/docs/galactik/navigation/link"},"1849":{"id":"/docs/galactik/navigation/link-0","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link","content":"Style a native anchor as a navigation link, internal or external, while keeping every native and router semantic intact."},"1850":{"id":"/docs/galactik/navigation/link-1","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#minimal-example","content":"Minimal example"},"1851":{"id":"/docs/galactik/navigation/link-2","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#how-it-works","content":"How it works"},"1852":{"id":"/docs/galactik/navigation/link-3","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#recipes","content":"Recipes"},"1853":{"id":"/docs/galactik/navigation/link-4","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#router-integration","content":"Router integration"},"1854":{"id":"/docs/galactik/navigation/link-5","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#external-link","content":"External link"},"1855":{"id":"/docs/galactik/navigation/link-6","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#options","content":"Options"},"1856":{"id":"/docs/galactik/navigation/link-7","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#pitfalls","content":"Pitfalls"},"1857":{"id":"/docs/galactik/navigation/link-8","page_id":"/docs/galactik/navigation/link","type":"heading","tags":[],"url":"/docs/galactik/navigation/link#whats-next","content":"What's next"},"1858":{"id":"/docs/galactik/navigation/link-9","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link","content":"`Link` styles a native `<a>` as a navigation link while keeping every native and router semantic intact —\n`href`, `routerLink`, `target`, `aria-current`, and so on. Hover, active and focus rely on native\npseudo-classes; the current-page and disabled looks react directly to the `aria-current=\"page\"` and\n`aria-disabled` attributes, however they got set."},"1859":{"id":"/docs/galactik/navigation/link-10","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link#how-it-works","content":"`Link` never touches `aria-current` itself — its styling only reacts to the attribute being present, however\nit got there. That is what lets Angular Router own it entirely:"},"1860":{"id":"/docs/galactik/navigation/link-11","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link#router-integration","content":"Let `routerLinkActive` + `[ariaCurrentWhenActive]=\"'page'\"` drive the current-page look — this is the\nsupported way, not comparing the current URL by hand."},"1861":{"id":"/docs/galactik/navigation/link-12","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link#external-link","content":"`openWindow` fully owns `target`/`rel` — the same way `disabled` owns `aria-disabled`/`tabindex` — and appends\nthe external-link icon automatically. Don't set `target`/`rel` manually on a link that binds it, and don't use\nit if a custom `rel` is needed (use a manual `link-icon-right` in that case instead)."},"1862":{"id":"/docs/galactik/navigation/link-13","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link#options","content":"<TypeTable\n  type=\"{\n  size: { type: '&#x22;sm&#x22; | &#x22;md&#x22;', default: '&#x22;sm&#x22;', description: '12px / 14px (&#x22;small&#x22;/&#x22;medium&#x22; aliases also accepted).' },\n  visited: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Adds the previously-visited bottom-border treatment.&#x22; },\n  openWindow: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: 'Sets target=&#x22;_blank&#x22;, rel=&#x22;noopener noreferrer&#x22; and renders the trailing external-link icon.' },\n  disabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: 'Sets aria-disabled=&#x22;true&#x22; and tabindex=&#x22;-1&#x22; — native anchors have no real disabled attribute.' },\n}\"\n/>"},"1863":{"id":"/docs/galactik/navigation/link-14","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link#pitfalls","content":"`disabled` is a purely visual/semantic flag — native anchors have no real `disabled` attribute, so the link\nstays present in the DOM with its `href` intact unless you remove that separately. `aria-disabled` and\n`tabindex=\"-1\"` only take it out of the tab order and suppress hover/active/click styling."},"1864":{"id":"/docs/galactik/navigation/link-15","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link#pitfalls","content":"Check that something is actually setting `aria-current=\"page\"` — `Link` never sets it itself. The supported\npath is `routerLinkActive` + `[ariaCurrentWhenActive]=\"'page'\"`; setting it by hand elsewhere risks fighting\nthe router for ownership of the same attribute."},"1865":{"id":"/docs/galactik/navigation/link-16","page_id":"/docs/galactik/navigation/link","tags":[],"type":"text","url":"/docs/galactik/navigation/link#whats-next","content":"Sidebar items follow the exact same aria-current contract as Link."},"1866":{"id":"/docs/galactik/navigation/sidebar","page_id":"/docs/galactik/navigation/sidebar","type":"page","content":"Sidebar","breadcrumbs":["Docs","Galactik","Navigation"],"tags":[],"url":"/docs/galactik/navigation/sidebar"},"1867":{"id":"/docs/galactik/navigation/sidebar-0","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar","content":"An app navigation panel — collapsible to an icon rail on desktop, a native-dialog drawer below the mobile breakpoint — with no rail and no nested submenus."},"1868":{"id":"/docs/galactik/navigation/sidebar-1","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#minimal-example","content":"Minimal example"},"1869":{"id":"/docs/galactik/navigation/sidebar-2","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#how-it-works","content":"How it works"},"1870":{"id":"/docs/galactik/navigation/sidebar-3","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#recipes","content":"Recipes"},"1871":{"id":"/docs/galactik/navigation/sidebar-4","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#trailing-badge-and-disabled-item","content":"Trailing badge and disabled item"},"1872":{"id":"/docs/galactik/navigation/sidebar-5","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#inset-and-floating-variants","content":"`inset` and `floating` variants"},"1873":{"id":"/docs/galactik/navigation/sidebar-6","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#reading-the-collapsed-state-from-a-projected-component","content":"Reading the collapsed state from a projected component"},"1874":{"id":"/docs/galactik/navigation/sidebar-7","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#options","content":"Options"},"1875":{"id":"/docs/galactik/navigation/sidebar-8","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#sidebartriggerdirective","content":"`SidebarTriggerDirective`"},"1876":{"id":"/docs/galactik/navigation/sidebar-9","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#sidebar_ref","content":"`SIDEBAR_REF`"},"1877":{"id":"/docs/galactik/navigation/sidebar-10","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#pitfalls","content":"Pitfalls"},"1878":{"id":"/docs/galactik/navigation/sidebar-11","page_id":"/docs/galactik/navigation/sidebar","type":"heading","tags":[],"url":"/docs/galactik/navigation/sidebar#whats-next","content":"What's next"},"1879":{"id":"/docs/galactik/navigation/sidebar-12","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar","content":"`Sidebar` is an app navigation panel: collapsible to icons on desktop, a native `<dialog>` drawer\n(`Sheet`) below the mobile breakpoint. It covers the common case — no rail, no nested\nsubmenus, no skeleton loading — with a real focusable trigger, a genuinely modal mobile drawer, and item labels\nthat stay in the accessibility tree once the panel goes icon-only."},"1880":{"id":"/docs/galactik/navigation/sidebar-13","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#how-it-works","content":"`Sidebar` renders as a native `<aside>` on desktop, and swaps to a `Sheet` anchored to\n`side()` below the 768px breakpoint (via `BreakpointObserverService`)\n— projecting the exact same `sidebarHeader`/`sidebarContent`/`sidebarFooter` content either way, nothing to\nbranch on in application code."},"1881":{"id":"/docs/galactik/navigation/sidebar-14","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#how-it-works","content":"The mobile drawer starts closed, and its entire content — including a trigger placed inside `sidebarHeader` —\nlives inside it. Below the breakpoint there is nothing on screen to open it from unless the app keeps a\n**second** trigger outside the `<Sidebar>` (its own top bar, typically), passed the panel explicitly since it\ncannot resolve `SIDEBAR_REF` through DI from outside:"},"1882":{"id":"/docs/galactik/navigation/sidebar-15","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#how-it-works","content":"The mobile drawer reuses `Sheet` unmodified — focus trap, `Escape`-to-close, focus restoration and the\n`::backdrop` all come from the native `<dialog>` + `showModal()` — sized to the full viewport width (a fixed\n`Sheet` width can otherwise push the in-header trigger off-screen on a narrow phone) and painted with the same\n`--sidebar`/`--sidebar-foreground` tokens as the desktop panel, so a themed app gets a matching drawer with no\nextra work."},"1883":{"id":"/docs/galactik/navigation/sidebar-16","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#trailing-badge-and-disabled-item","content":"A trailing `Badge` is pinned to the end of an item and dropped automatically once the\nsidebar is icon-only — there is no room next to a bare icon for a pill."},"1884":{"id":"/docs/galactik/navigation/sidebar-17","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#trailing-badge-and-disabled-item","content":"`disabled` reflects `aria-disabled=\"true\"` and sets `tabindex=\"-1\"` — the same contract as\n`Link`'s own `disabled`."},"1885":{"id":"/docs/galactik/navigation/sidebar-18","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#inset-and-floating-variants","content":"`variant=\"inset\"` draws no border or fill on `Sidebar` itself; the encased look comes from `sidebarInset` on\nthe app's main content wrapper instead, which supplies the surface. `variant=\"floating\"` needs no companion\nelement — it detaches with a margin, border and shadow of its own, and reserves **no** layout space, ever,\nfloating on top of whatever sibling content follows it."},"1886":{"id":"/docs/galactik/navigation/sidebar-19","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#inset-and-floating-variants","content":"`floating`/`inset` collapse differently from the default `sidebar` variant: instead of narrowing to an icon\nrail, the *whole* panel slides off-screen (and is marked `inert` while hidden, so its own header trigger\ncannot still be reached by keyboard). An app using either variant with collapse therefore needs a **third**\ntrigger placed outside the `<Sidebar>`, shown only while `collapsed()` is true."},"1887":{"id":"/docs/galactik/navigation/sidebar-20","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#reading-the-collapsed-state-from-a-projected-component","content":"A component projected inside `sidebarHeader`/`sidebarContent`/`sidebarFooter` reads the panel's own state by\ninjecting `SIDEBAR_REF` — the same token `SidebarTriggerDirective` itself resolves through."},"1888":{"id":"/docs/galactik/navigation/sidebar-21","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#options","content":"<TypeTable\n  type=\"{\n  collapsed: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Collapsed/expanded, two-way bindable. No persistence of its own.&#x22; },\n  side: { type: '&#x22;left&#x22; | &#x22;right&#x22;', default: '&#x22;left&#x22;', description: &#x22;Edge the panel is anchored to, desktop and mobile alike.&#x22; },\n  variant: { type: '&#x22;sidebar&#x22; | &#x22;floating&#x22; | &#x22;inset&#x22;', default: '&#x22;sidebar&#x22;', description: &#x22;Visual treatment — see Recipes above.&#x22; },\n  &#x22;aria-label&#x22;: { type: &#x22;string | undefined&#x22;, description: &#x22;Accessible name of the panel — the <aside>'s, and the mobile <dialog>'s only name. No default.&#x22; },\n}\"\n/>"},"1889":{"id":"/docs/galactik/navigation/sidebar-22","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#sidebartriggerdirective","content":"<TypeTable\n  type=\"{\n  &#x22;aria-label&#x22;: { type: &#x22;string | undefined&#x22;, description: &#x22;Accessible name of the button — usually its only one, being icon-only. No default.&#x22; },\n  sidebar: { type: &#x22;SidebarRef | undefined&#x22;, description: &#x22;The <Sidebar> to control, when this button isn't projected inside one.&#x22; },\n}\"\n/>"},"1890":{"id":"/docs/galactik/navigation/sidebar-23","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#sidebartriggerdirective","content":"`SidebarTriggerDirective` also reflects `aria-expanded` on its host, bound to the resolved sidebar's\n`expanded()` signal — a screen reader announces whether activating it opens or closes the panel, whichever\nviewport applies."},"1891":{"id":"/docs/galactik/navigation/sidebar-24","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#sidebar_ref","content":"An `InjectionToken<SidebarRef>` a `<Sidebar>` provides for anything projected into it, exposing `collapsed`,\n`isMobile`, `expanded` (all `Signal<boolean>`) and `toggle()`/`open()`/`close()` — the last three branch on\n`isMobile()` automatically (desktop collapse vs. the mobile drawer)."},"1892":{"id":"/docs/galactik/navigation/sidebar-25","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#pitfalls","content":"Fixed in the current component, but worth knowing why it happened: `<aside>` used to carry an\nalways-active `translateX(0)`. Per the CSS Transforms spec, **any** transform value other than `none` —\nincluding one that moves nothing — establishes a new containing block for `position: fixed`/`absolute`\ndescendants. A `Menu`/`Popover`/`Dialog` projected into `sidebarContent`/`sidebarFooter` is exactly such a\ndescendant, and floating-ui still measures the *real* viewport for its placement decisions — so the\ncomputed placement gets applied against the wrong containing block, commonly looking like it \"flipped\" to\nthe wrong side no matter which `placement` was requested. If you see this with a custom fork or an older\nversion, check that the transform resolves to the literal keyword `none` whenever no slide is in progress."},"1893":{"id":"/docs/galactik/navigation/sidebar-26","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#pitfalls","content":"`--sidebar-width`/`--sidebar-width-icon` must be declared on `SidebarComponent`'s own host (an ancestor of\nthe reserved-width slot), never only on the `<aside>` it visually applies to — CSS custom properties only\never inherit downward, and the slot `<div>` is `<aside>`'s **parent**. Declaring a variable only on a\ndescendant leaves an ancestor's own `var()` reference unresolved. The general rule: before reading a custom\nproperty through `var()` on element A, make sure it is declared on A itself or one of A's actual ancestors."},"1894":{"id":"/docs/galactik/navigation/sidebar-27","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#pitfalls","content":"Unlike most galactik roots, `Sidebar` has no `sidebar`/`sidebar` lowercase alias — `@sinequa/ui` also exports a\n`SidebarComponent` whose selector is exactly `sidebar`, and two components matching the same element is a\ncompile error. Use the exact `Sidebar` PascalCase tag."},"1895":{"id":"/docs/galactik/navigation/sidebar-28","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#whats-next","content":"The modal panel the mobile drawer reuses unmodified."},"1896":{"id":"/docs/galactik/navigation/sidebar-29","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#whats-next","content":"The service that decides when Sidebar swaps to its mobile drawer."},"1897":{"id":"/docs/galactik/navigation/sidebar-30","page_id":"/docs/galactik/navigation/sidebar","tags":[],"type":"text","url":"/docs/galactik/navigation/sidebar#whats-next","content":"The same native aria-current contract SidebarItem follows."},"1898":{"id":"/docs/galactik/navigation/tabs","page_id":"/docs/galactik/navigation/tabs","type":"page","content":"Tabs","breadcrumbs":["Docs","Galactik","Navigation"],"tags":[],"url":"/docs/galactik/navigation/tabs"},"1899":{"id":"/docs/galactik/navigation/tabs-0","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs","content":"A thin Tailwind styling layer over Angular's official @angular/aria/tabs primitives — roles, focus and keyboard navigation come entirely from Angular."},"1900":{"id":"/docs/galactik/navigation/tabs-1","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#minimal-example","content":"Minimal example"},"1901":{"id":"/docs/galactik/navigation/tabs-2","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#how-it-works","content":"How it works"},"1902":{"id":"/docs/galactik/navigation/tabs-3","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#recipes","content":"Recipes"},"1903":{"id":"/docs/galactik/navigation/tabs-4","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#vertical-orientation","content":"Vertical orientation"},"1904":{"id":"/docs/galactik/navigation/tabs-5","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#preserving-panel-content-and-disabled-tabs","content":"Preserving panel content, and disabled tabs"},"1905":{"id":"/docs/galactik/navigation/tabs-6","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#options","content":"Options"},"1906":{"id":"/docs/galactik/navigation/tabs-7","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#pitfalls","content":"Pitfalls"},"1907":{"id":"/docs/galactik/navigation/tabs-8","page_id":"/docs/galactik/navigation/tabs","type":"heading","tags":[],"url":"/docs/galactik/navigation/tabs#whats-next","content":"What's next"},"1908":{"id":"/docs/galactik/navigation/tabs-9","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs","content":"`Tabs` is a thin styling layer over Angular's official ARIA tabs primitives (`@angular/aria/tabs`).\n`TabsComponent`, `TabListComponent`, `TabComponent` and `TabPanelComponent` each apply the matching\n`@angular/aria/tabs` directive as a host directive — roles, focus management, keyboard navigation and ARIA\nattributes are entirely delegated to `@angular/aria`; galactik only contributes visual variants and classes."},"1909":{"id":"/docs/galactik/navigation/tabs-10","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#minimal-example","content":"Unlike `atomic-ui`'s `Tabs`, `TabsComponent` ships **no default layout classes** — always add your own\n(`flex flex-col` for stacked tabs above panels, `flex flex-row` for side-by-side vertical tabs)."},"1910":{"id":"/docs/galactik/navigation/tabs-11","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#minimal-example","content":"`selectedTab` on `TabList` sets the initially active tab; selection then becomes user-driven, or bind\n`[(selectedTab)]` for full two-way control from the host."},"1911":{"id":"/docs/galactik/navigation/tabs-12","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#how-it-works","content":"`selectionMode=\"follow\"` (default) activates a tab as soon as focus reaches it — best for stateless content.\n`selectionMode=\"explicit\"` only highlights the tab on focus; the user must press `Space`/`Enter` to activate\nit — best when activation is expensive (a network fetch, a heavy render)."},"1912":{"id":"/docs/galactik/navigation/tabs-13","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#vertical-orientation","content":"Set `orientation=\"vertical\"` on `TabList` and switch the wrapping `Tabs` to a row layout so the list and\npanels sit side by side. Arrow-key navigation automatically switches to Up/Down."},"1913":{"id":"/docs/galactik/navigation/tabs-14","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#preserving-panel-content-and-disabled-tabs","content":"Set `preserveContent` on a `TabPanel` to keep it mounted (merely hidden via `.hidden`) while inactive —\nuseful for forms that must retain user input. `softDisabled` on `TabList` (default `true`) keeps a\n`disabled` tab reachable by keyboard even though it cannot be activated."},"1914":{"id":"/docs/galactik/navigation/tabs-15","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#options","content":"<TypeTable\n  type=\"{\n  &#x22;TabList.variant&#x22;: { type: '&#x22;primary&#x22; | &#x22;secondary&#x22; | &#x22;inner&#x22;', default: '&#x22;primary&#x22;', description: &#x22;Visual style, pairs with Tab's own variant.&#x22; },\n  &#x22;TabList.selectionMode&#x22;: { type: '&#x22;follow&#x22; | &#x22;explicit&#x22;', default: '&#x22;follow&#x22;', description: &#x22;Whether keyboard focus auto-activates the tab.&#x22; },\n  &#x22;TabList.selectedTab&#x22;: { type: &#x22;string | undefined&#x22;, description: &#x22;Model. Two-way bindable with [(selectedTab)].&#x22; },\n  &#x22;TabList.softDisabled&#x22;: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Disabled tabs remain keyboard-reachable when true.&#x22; },\n  &#x22;TabList.orientation&#x22;: { type: '&#x22;horizontal&#x22; | &#x22;vertical&#x22;', default: '&#x22;horizontal&#x22;', description: &#x22;Layout direction and arrow-key axis.&#x22; },\n  &#x22;Tab.value&#x22;: { type: &#x22;string&#x22;, description: &#x22;Required. Identifier matching a TabPanel.&#x22; },\n  &#x22;Tab.noTruncate&#x22;: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Disables the default label truncation.&#x22; },\n  &#x22;TabPanel.value&#x22;: { type: &#x22;string&#x22;, description: &#x22;Required. Identifier matching a Tab.&#x22; },\n  &#x22;TabPanel.preserveContent&#x22;: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Keeps the panel rendered (hidden via .hidden) while inactive.&#x22; },\n}\"\n/>"},"1915":{"id":"/docs/galactik/navigation/tabs-16","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#options","content":"`--tab-max-width` (fallback `100%`) caps a tab's label width on any ancestor; `noTruncate` exempts a single\ntab from it."},"1916":{"id":"/docs/galactik/navigation/tabs-17","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#pitfalls","content":"`TabsComponent` applies **no default layout classes at all** — unlike `atomic-ui`'s `Tabs`. Always add\n`class=\"flex flex-col\"` (stacked) or `class=\"flex flex-row\"` (side by side) yourself."},"1917":{"id":"/docs/galactik/navigation/tabs-18","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#pitfalls","content":"`@sinequa/ui` ships its own `Tabs`/`TabList`/`Tab`/`TabPanel`, also a thin layer over\n`@angular/aria/tabs`, with an almost identical input surface — but different tokens, and (unlike this one) a\ndefault `flex flex-col overflow-hidden` layout. Always verify the import path before assuming which\nimplementation is in scope."},"1918":{"id":"/docs/galactik/navigation/tabs-19","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#pitfalls","content":"Don't add ARIA attributes manually on any of these — the underlying `@angular/aria/tabs` host directives\nalready manage `role`, `aria-controls`, `aria-labelledby`, `aria-orientation` and the roving `tabindex`."},"1919":{"id":"/docs/galactik/navigation/tabs-20","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#whats-next","content":"A navigation panel that composes many of the same accessibility patterns."},"1920":{"id":"/docs/galactik/navigation/tabs-21","page_id":"/docs/galactik/navigation/tabs","tags":[],"type":"text","url":"/docs/galactik/navigation/tabs#whats-next","content":"Another @angular/aria-backed composite widget, for selecting rows instead of switching panels."},"1921":{"id":"/docs/galactik/layout","page_id":"/docs/galactik/layout","type":"page","content":"Layout","breadcrumbs":["Docs","Galactik","Layout"],"tags":[],"url":"/docs/galactik/layout"},"1922":{"id":"/docs/galactik/layout-0","page_id":"/docs/galactik/layout","tags":[],"type":"text","url":"/docs/galactik/layout","content":"Panel layout — ResizablePanelGroup, ResizablePanel, ResizableHandle — for user-resizable panel arrangements."},"1923":{"id":"/docs/galactik/layout-1","page_id":"/docs/galactik/layout","type":"heading","tags":[],"url":"/docs/galactik/layout#whats-next","content":"What's next"},"1924":{"id":"/docs/galactik/layout-2","page_id":"/docs/galactik/layout","tags":[],"type":"text","url":"/docs/galactik/layout","content":"Lay a row or column of panels out with a boundary the user can drag or arrow — the split view a filters panel\nand a results panel, or an editor and a preview, typically need."},"1925":{"id":"/docs/galactik/layout-3","page_id":"/docs/galactik/layout","tags":[],"type":"text","url":"/docs/galactik/layout#whats-next","content":"Percentage-based panel sizing, with keyboard-reachable handles and optional persistence."},"1926":{"id":"/docs/galactik/layout/resizable","page_id":"/docs/galactik/layout/resizable","type":"page","content":"Resizable","breadcrumbs":["Docs","Galactik","Layout"],"tags":[],"url":"/docs/galactik/layout/resizable"},"1927":{"id":"/docs/galactik/layout/resizable-0","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable","content":"Lay a row or column of panels out and let the user move the boundary between two of them, by dragging or by arrowing the handle."},"1928":{"id":"/docs/galactik/layout/resizable-1","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#minimal-example","content":"Minimal example"},"1929":{"id":"/docs/galactik/layout/resizable-2","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#how-it-works","content":"How it works"},"1930":{"id":"/docs/galactik/layout/resizable-3","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#recipes","content":"Recipes"},"1931":{"id":"/docs/galactik/layout/resizable-4","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#remembering-the-layout","content":"Remembering the layout"},"1932":{"id":"/docs/galactik/layout/resizable-5","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#driving-the-layout-from-the-outside","content":"Driving the layout from the outside"},"1933":{"id":"/docs/galactik/layout/resizable-6","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#options","content":"Options"},"1934":{"id":"/docs/galactik/layout/resizable-7","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#resizablepanel","content":"`ResizablePanel`"},"1935":{"id":"/docs/galactik/layout/resizable-8","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#resizablehandle","content":"`ResizableHandle`"},"1936":{"id":"/docs/galactik/layout/resizable-9","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#pitfalls","content":"Pitfalls"},"1937":{"id":"/docs/galactik/layout/resizable-10","page_id":"/docs/galactik/layout/resizable","type":"heading","tags":[],"url":"/docs/galactik/layout/resizable#whats-next","content":"What's next"},"1938":{"id":"/docs/galactik/layout/resizable-11","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable","content":"`ResizablePanelGroup` lays a row (or column) of panels out and lets the user move the boundary between two of\nthem, by dragging the handle or by arrowing it. Three components work together: `ResizablePanelGroup` (the\nflex container and single owner of the sizes), `ResizablePanel` (one region, sized as a share of the group)\nand `ResizableHandle` (the divider, focusable and draggable)."},"1939":{"id":"/docs/galactik/layout/resizable-12","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable","content":"Sizes are percentages of the group, never pixels — that is what makes a layout survive a window resize. The\ngroup normalizes whatever `defaultSize`s you give so they sum to 100."},"1940":{"id":"/docs/galactik/layout/resizable-13","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#minimal-example","content":"The group takes the full size of its parent (`size-full`), so it needs a parent with a height — one in a\nplain `<div>` with no height collapses."},"1941":{"id":"/docs/galactik/layout/resizable-14","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#how-it-works","content":"`minSize`/`maxSize` per panel are honoured by both the pointer and the keyboard — what one panel refuses to\ntake, its neighbour keeps, so the total always stays at 100%. The handle implements the ARIA\nwindow-splitter pattern: `role=\"separator\"`,\n`aria-orientation` (the orientation of the *line*, not of the group — a separator between side-by-side panels\nis vertical), and `aria-valuenow`/`valuemin`/`valuemax` bounded by the panel before it. Arrow keys move the\nfocused handle by 10% of the group, along the axis the group's `direction` implies — a resize is therefore\nfully reachable without a pointer (WCAG 2.1.1). Dragging uses pointer events with pointer capture, so the drag\nfollows the pointer far outside the handle with no window-level listener, and a full-page overlay during the\ndrag keeps an `<iframe>` in a panel from swallowing the pointer."},"1942":{"id":"/docs/galactik/layout/resizable-15","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#remembering-the-layout","content":"Give the group an `autoSaveId` and the layout is remembered in `localStorage`, under the key\n`resizable-panel:<autoSaveId>` — restored on the next visit, but only if the group still has the same number\nof panels; otherwise the panels' own `defaultSize`s are the better answer."},"1943":{"id":"/docs/galactik/layout/resizable-16","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#driving-the-layout-from-the-outside","content":"`setLayout()` is ignored unless the array covers exactly the panels present — a partial layout would leave the\ngroup summing to something other than 100%."},"1944":{"id":"/docs/galactik/layout/resizable-17","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#options","content":"<TypeTable\n  type=\"{\n  direction: { type: '&#x22;horizontal&#x22; | &#x22;vertical&#x22;', default: '&#x22;horizontal&#x22;', description: &#x22;Axis the panels are laid out along.&#x22; },\n  autoSaveId: { type: &#x22;string | undefined&#x22;, description: &#x22;Key the layout is persisted under. Without it, nothing is stored.&#x22; },\n}\"\n/>"},"1945":{"id":"/docs/galactik/layout/resizable-18","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#resizablepanel","content":"<TypeTable\n  type=\"{\n  id: { type: &#x22;string&#x22;, default: '&#x22;resizable-panel-<n>&#x22;', description: &#x22;Written to the DOM — what the handle points at with aria-controls.&#x22; },\n  defaultSize: { type: &#x22;number&#x22;, default: &#x22;50&#x22;, description: &#x22;Share before any resize, in percent. Normalized across siblings.&#x22; },\n  minSize: { type: &#x22;number&#x22;, default: &#x22;0&#x22;, description: &#x22;Lower bound, in percent.&#x22; },\n  maxSize: { type: &#x22;number&#x22;, default: &#x22;100&#x22;, description: &#x22;Upper bound, in percent.&#x22; },\n}\"\n/>"},"1946":{"id":"/docs/galactik/layout/resizable-19","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#resizablehandle","content":"<TypeTable\n  type=\"{\n  withHandle: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Shows the grip pill on the line.&#x22; },\n  &#x22;aria-label&#x22;: { type: &#x22;string&#x22;, default: '&#x22;Resize panels&#x22;', description: &#x22;Accessible name of the separator. Override per handle when a group has several.&#x22; },\n}\"\n/>"},"1947":{"id":"/docs/galactik/layout/resizable-20","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#pitfalls","content":"A group with no measurable size (a hidden route, `display: none`) cannot turn a pointer move into a\npercentage, and the drag is simply ignored until the group has a size again. Check that the group's parent\nactually has a height — a bare `<div>` with no height collapses the whole group to zero."},"1948":{"id":"/docs/galactik/layout/resizable-21","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#pitfalls","content":"One handle sits between every two panels, in document order — the group pairs the handle at index *i* with\nthe panels at index *i* and *i+1*. A handle placed elsewhere in the projected content resizes nothing."},"1949":{"id":"/docs/galactik/layout/resizable-22","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#pitfalls","content":"That is the default `aria-label`, shared by every handle. Give each handle its own `aria-label` whenever a\ngroup has more than one."},"1950":{"id":"/docs/galactik/layout/resizable-23","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#pitfalls","content":"`layout` fires on every pointer move during a drag, not only when it settles. Persist through `autoSaveId`\ninstead of a manual handler, or debounce anything expensive you attach to it directly."},"1951":{"id":"/docs/galactik/layout/resizable-24","page_id":"/docs/galactik/layout/resizable","tags":[],"type":"text","url":"/docs/galactik/layout/resizable#whats-next","content":"Another panel-composition component, collapsible rather than resizable."},"1952":{"id":"/docs/galactik/overlay/dialog","page_id":"/docs/galactik/overlay/dialog","type":"page","content":"Dialog","breadcrumbs":["Docs","Galactik","Overlay"],"tags":[],"url":"/docs/galactik/overlay/dialog"},"1953":{"id":"/docs/galactik/overlay/dialog-0","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog","content":"Open a modal or non-modal window on the native <dialog> element, and get a typed result back from an imperative call() without wiring a viewChild by hand."},"1954":{"id":"/docs/galactik/overlay/dialog-1","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#minimal-example","content":"Minimal example"},"1955":{"id":"/docs/galactik/overlay/dialog-2","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#how-it-works","content":"How it works"},"1956":{"id":"/docs/galactik/overlay/dialog-3","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#recipes","content":"Recipes"},"1957":{"id":"/docs/galactik/overlay/dialog-4","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#compose-all-six-slots-and-the-three-open-modes","content":"Compose all six slots, and the three open modes"},"1958":{"id":"/docs/galactik/overlay/dialog-5","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#typed-payload-in-typed-result-out","content":"Typed payload in, typed result out"},"1959":{"id":"/docs/galactik/overlay/dialog-6","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#stacked-position-aware-dialogs","content":"Stacked, position-aware dialogs"},"1960":{"id":"/docs/galactik/overlay/dialog-7","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#close-the-parent-dialog-from-a-projected-sub-component--dialog_ref","content":"Close the parent dialog from a projected sub-component — `DIALOG_REF`"},"1961":{"id":"/docs/galactik/overlay/dialog-8","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#options","content":"Options"},"1962":{"id":"/docs/galactik/overlay/dialog-9","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#pitfalls","content":"Pitfalls"},"1963":{"id":"/docs/galactik/overlay/dialog-10","page_id":"/docs/galactik/overlay/dialog","type":"heading","tags":[],"url":"/docs/galactik/overlay/dialog#whats-next","content":"What's next"},"1964":{"id":"/docs/galactik/overlay/dialog-11","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog","content":"A confirmation prompt, an edit form, a notice that needs an explicit dismissal — each of those is a window\nthat has to sit above the rest of the page, trap focus while it is open, and hand a result back to whoever\nopened it. `Dialog` is that window, built on the native HTML `<dialog>` element (or a `[dialog]` attribute on\nany other host), and `createCallable`/`injectCallRef` is the typed call/result API most of this page teaches."},"1965":{"id":"/docs/galactik/overlay/dialog-12","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog","content":"The browser's `<dialog>` element renders in the **top layer**, a stacking context above everything else in the\ndocument — no application `z-index` can cover it, and none is needed to keep it on top. `showModal()` also\ngives it a native `::backdrop` pseudo-element and traps focus inside it for free. `Dialog` prefers a real\n`<dialog>` tag for exactly this reason, and falls back to a `[dialog]` attribute (with a manual backdrop and\n`Escape` handling) only for hosts that cannot be a `<dialog>` tag."},"1966":{"id":"/docs/galactik/overlay/dialog-13","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#minimal-example","content":"The recommended, imperative way to open a dialog: bind a component once with `createCallable`, then `await` it\nfrom anywhere. `provideCallable()` must be registered once at bootstrap — see Options."},"1967":{"id":"/docs/galactik/overlay/dialog-14","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#minimal-example","content":"`(closed)=\"call.end($event === 'dialog-confirm')\"` resolves the promise however the dialog closes — clicking\nConfirm, clicking Cancel, or pressing `Escape` all reach the same handler, with no dedicated \"Escape\" branch\nto write."},"1968":{"id":"/docs/galactik/overlay/dialog-15","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"Three things happen once, in order: the dialog opens through one of three methods, its content mounts, and\nclosing it resolves whatever awaited the call."},"1969":{"id":"/docs/galactik/overlay/dialog-16","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"`DialogContent` never needs a `for` or an explicit id to associate its title: `DialogTitle` publishes its own\nid (generated, or set explicitly) into the `MODAL_LABEL` token it shares with `DialogContent`, which reads it\nback for `aria-labelledby`. The same token pattern lets `DialogHeader`'s built-in close button — and any\ncustom sub-component you project — close the dialog by injecting `DIALOG_REF`, without ever depending on\n`DialogComponent` itself (see Pitfalls)."},"1970":{"id":"/docs/galactik/overlay/dialog-17","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"**Three open modes**, all on the same template reference:"},"1971":{"id":"/docs/galactik/overlay/dialog-18","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"`show()` — non-modal. On a real `<dialog>` tag this has **no** backdrop."},"1972":{"id":"/docs/galactik/overlay/dialog-19","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"`showModal()` — modal, native `<dialog>` semantics (native focus trap, native `Escape`) when applied to a\nreal `<dialog>` tag."},"1973":{"id":"/docs/galactik/overlay/dialog-20","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"`showPopover()` — the native Popover API, light-dismiss."},"1974":{"id":"/docs/galactik/overlay/dialog-21","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"The imperative call itself goes through `DialogService`, which `createCallable` wraps:"},"1975":{"id":"/docs/galactik/overlay/dialog-22","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#how-it-works","content":"Calling a callable more than once mounts independent, concurrently open instances rather than replacing the\nprevious one — `DialogService.call()` stacks by design, which is what lets `injectCallRef().index()` and\n`.stackSize()` drive position-aware UI in a stacked notification (see Recipes)."},"1976":{"id":"/docs/galactik/overlay/dialog-23","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#compose-all-six-slots-and-the-three-open-modes","content":"A declarative (non-callable) dialog, using every layout slot plus the three ways to open the same `<dialog>`\nreference."},"1977":{"id":"/docs/galactik/overlay/dialog-24","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#typed-payload-in-typed-result-out","content":"`createCallable<P, R>` types both the arguments passed into `call(props)` and the value the promise resolves\nwith — here a `{ name: string } | null` result, `null` on cancel."},"1978":{"id":"/docs/galactik/overlay/dialog-25","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#stacked-position-aware-dialogs","content":"Calling a callable several times in a row mounts independent, concurrently open instances rather than\nreplacing the previous one. `injectCallRef()` exposes `index()`/`stackSize()` for position-aware UI, and\n`ended()` for driving an exit-animation state while teardown is pending. `call(props, options)` also accepts\nan explicit `injector` — useful when `provideCallable()` was not registered, or from a lazily-loaded\nsubtree — and an `unmountDelay` that leaves time for a CSS exit transition before the component is destroyed."},"1979":{"id":"/docs/galactik/overlay/dialog-26","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#close-the-parent-dialog-from-a-projected-sub-component--dialog_ref","content":"Content projected into a dialog — including your own reusable pieces, not just `DialogHeader`'s built-in\nclose button — closes the parent dialog by injecting `DIALOG_REF`. This is exactly the pattern\n`DialogHeaderComponent`'s own close button uses internally."},"1980":{"id":"/docs/galactik/overlay/dialog-27","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#options","content":"<TypeTable\n  type=\"{\n  size: {\n    type: '&#x22;sm&#x22; | &#x22;md&#x22; | &#x22;lg&#x22; | &#x22;xl&#x22;',\n    default: '&#x22;sm&#x22;',\n    description:\n      &#x22;Nominal width: sm 400px · md 520px · lg 720px · xl 960px. Each size yields to a viewport narrower than it — the resolved width is capped at calc(100dvw - 2rem) — so nothing overflows on a phone-width screen.&#x22;,\n  },\n  labelledby: {\n    type: &#x22;string&#x22;,\n    description:\n      &#x22;Explicit aria-labelledby override, on DialogContent. Without it, DialogContent falls back to the id published by a projected DialogTitle.&#x22;,\n  },\n  closeLabel: {\n    type: &#x22;string&#x22;,\n    default: '&#x22;Close&#x22;',\n    description:\n      &#x22;Accessible name of the built-in close button. Set on the <dialog>, it names the button of every DialogHeader inside — the default header included. Set on a DialogHeader, it wins over the dialog's. The icon is decorative, so this label is the button's only name — translate it.&#x22;,\n  },\n  class: {\n    type: &#x22;string&#x22;,\n    description: &#x22;Additional CSS classes, merged via cn(). Available on every slot.&#x22;,\n  },\n}\"\n/>"},"1981":{"id":"/docs/galactik/overlay/dialog-28","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#options","content":"`provideCallable()` — registered once at bootstrap (`providers: [provideCallable()]`) — captures the root\n`Injector` so `Callable.call(props)` works without passing `{ injector }` explicitly. Without it, and with no\n`injector` passed in `options`, `call()` throws synchronously."},"1982":{"id":"/docs/galactik/overlay/dialog-29","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"You injected `DialogComponent` directly from a sub-component rendered inside the dialog — a custom footer\nbutton, a custom header action. `DialogComponent` renders the very content that would be importing it, so\nthat is a circular dependency, not a plain DI mistake."},"1983":{"id":"/docs/galactik/overlay/dialog-30","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"Inject `DIALOG_REF` instead — see Close the parent dialog from a projected sub-component above. It resolves to the same dialog without ever importing\n`DialogComponent`'s type."},"1984":{"id":"/docs/galactik/overlay/dialog-31","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"Expected, and it depends on which host you used. On a real `<dialog>` tag, `show()` opens **non-modally** — no\nbackdrop, no native `Escape` handling, by browser design; only `showModal()`/`openModal()` get those. On a\n`[dialog]` **attribute** host, there is no such distinction: the component cannot tell `show()` from\n`showModal()` there, so `show()` still gets the manual backdrop and the manual `document:keydown.escape`\nlistener."},"1985":{"id":"/docs/galactik/overlay/dialog-32","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"Use a real `<dialog>` tag when you want a genuinely backdrop-less, `Escape`-inert non-modal window; use\n`openModal()` (which forces `isModal` unconditionally) when you want a `[dialog]` host to never close on a\nbackdrop click."},"1986":{"id":"/docs/galactik/overlay/dialog-33","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"`DialogComponent`'s template wraps all projected content in `@if (isOpen())` — closing it fully **destroys**\nthe projected tree rather than hiding it. Any local component state inside a declaratively-wired (non-callable)\ndialog body resets on every reopen."},"1987":{"id":"/docs/galactik/overlay/dialog-34","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"For state that should survive a close/reopen cycle, lift it above the dialog (a parent component field, a\nservice) rather than holding it in a component that only exists while the dialog is open."},"1988":{"id":"/docs/galactik/overlay/dialog-35","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"The built-in close button is named by `closeLabel`, which defaults to the English `\"Close\"` — the library\ntranslates nothing. Set it &#x2A;*once on the `<dialog>`** and every `DialogHeader` inside inherits it, including the\ndefault header a `<dialog>` renders when you project no `DialogContent`:\n`<dialog closeLabel=\"Fermer\">`. A `DialogHeader` that sets its own `closeLabel` keeps it."},"1989":{"id":"/docs/galactik/overlay/dialog-36","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"(A dialog with no `DialogTitle` has no accessible name whichever header it uses: project a titled\n`DialogContent` rather than relying on the default one.)"},"1990":{"id":"/docs/galactik/overlay/dialog-37","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"Only `aria-labelledby` is wired automatically, through the `MODAL_LABEL` token shared between `DialogTitle` and\n`DialogContent`. There is no equivalent auto-wiring for `DialogDescription` into `aria-describedby`."},"1991":{"id":"/docs/galactik/overlay/dialog-38","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"Set an explicit `id` directly on `<DialogDescription id=\"...\">` — it is a bare `@Directive`, so native\nattributes pass through — and bind `[attr.aria-describedby]` on `<DialogContent>` yourself."},"1992":{"id":"/docs/galactik/overlay/dialog-39","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"`DialogContent`, like `DialogBody`, `DialogFooter`, `DialogTitle` and `DialogDescription`, is a bare\n`@Directive`, not a `@Component` — it has no template of its own, so its children are the literal markup you\nwrote between the tags, not content projected through an `<ng-content>`. Only `DialogHeader` is a real\n`@Component`, with two `<ng-content select>` slots plus the built-in close button."},"1993":{"id":"/docs/galactik/overlay/dialog-40","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"`DialogService.syncStack()` tags every instance except the bottom-most with an `atomic-dialog--behind` host\nclass, meant to leave exactly one visible backdrop for a whole stack — but `@sinequa/galactik` ships no CSS for\nit. Nothing acts on that class unless your application defines the rule."},"1994":{"id":"/docs/galactik/overlay/dialog-41","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"Add the equivalent for the manual backdrop `<div>` too, if you stack `[dialog]` attribute hosts."},"1995":{"id":"/docs/galactik/overlay/dialog-42","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#pitfalls","content":"`@sinequa/ui`'s `Dialog` (the library `@sinequa/galactik` is replacing) is a **different implementation** with\nan overlapping vocabulary — the same `createCallable`/`injectCallRef`/`DialogService` concept, even the same\n`DialogEvent`-shaped close events — but a distinct component tree (no separate `DialogBody`/`DialogDescription`\nsplit) and a separate module. Check the import path before assuming two dialog-related symbols are the same\none; do not mix imports from `@sinequa/ui` and `@sinequa/galactik` in the same file."},"1996":{"id":"/docs/galactik/overlay/dialog-43","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#whats-next","content":"What this library is, what it deliberately does not do, and how it relates to atomic-angular."},"1997":{"id":"/docs/galactik/overlay/dialog-44","page_id":"/docs/galactik/overlay/dialog","tags":[],"type":"text","url":"/docs/galactik/overlay/dialog#whats-next","content":"Install the library and set up the tokens every component, Dialog included, renders from."},"1998":{"id":"/docs/galactik/overlay/floating-panel","page_id":"/docs/galactik/overlay/floating-panel","type":"page","content":"Floating panel","breadcrumbs":["Docs","Galactik","Overlay"],"tags":[],"url":"/docs/galactik/overlay/floating-panel"},"1999":{"id":"/docs/galactik/overlay/floating-panel-0","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel","content":"injectFloatingPanel keeps a popup — a combobox's list, a submenu — under or beside an anchor with Floating UI, as wide as the anchor on request and in the top layer above a dialog."},"2000":{"id":"/docs/galactik/overlay/floating-panel-1","page_id":"/docs/galactik/overlay/floating-panel","type":"heading","tags":[],"url":"/docs/galactik/overlay/floating-panel#minimal-example","content":"Minimal example"},"2001":{"id":"/docs/galactik/overlay/floating-panel-2","page_id":"/docs/galactik/overlay/floating-panel","type":"heading","tags":[],"url":"/docs/galactik/overlay/floating-panel#how-it-works","content":"How it works"},"2002":{"id":"/docs/galactik/overlay/floating-panel-3","page_id":"/docs/galactik/overlay/floating-panel","type":"heading","tags":[],"url":"/docs/galactik/overlay/floating-panel#options","content":"Options"},"2003":{"id":"/docs/galactik/overlay/floating-panel-4","page_id":"/docs/galactik/overlay/floating-panel","type":"heading","tags":[],"url":"/docs/galactik/overlay/floating-panel#pitfalls","content":"Pitfalls"},"2004":{"id":"/docs/galactik/overlay/floating-panel-5","page_id":"/docs/galactik/overlay/floating-panel","type":"heading","tags":[],"url":"/docs/galactik/overlay/floating-panel#whats-next","content":"What's next"},"2005":{"id":"/docs/galactik/overlay/floating-panel-6","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel","content":"`injectFloatingPanel()` positions a panel against an anchor with Floating UI. It is what `Select`, `Autocomplete`,\n`SubMenu` and a combobox's popup in general need, and what each of them used to write by hand: wait for the panel and the\nanchor, follow them with `autoUpdate`, compute the position, write `left` and `top`, stop on destroy. For a panel opened by\na button and light-dismissed, `PopoverDirective` is enough; reach for this one when the anchor is not the\ntrigger, the panel is created later (a combobox renders its popup when it opens), or it must not close on an outside press."},"2006":{"id":"/docs/galactik/overlay/floating-panel-7","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#how-it-works","content":"**The panel must be `position: fixed`**, as a class on it: it is then never in flow, not even on the frame it is created.\nFloating UI answers in viewport coordinates; without `fixed` they would be relative to the offset parent and the panel\nwould drift by the page's scroll."},"2007":{"id":"/docs/galactik/overlay/floating-panel-8","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#how-it-works","content":"**It is hidden until placed.** The panel is `visibility: hidden` until its first position is computed, so it never\npaints for a frame in the corner of the page."},"2008":{"id":"/docs/galactik/overlay/floating-panel-9","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#how-it-works","content":"**It may come and go.** `panel` and `anchor` are signal reads: the panel is positioned each time it appears, and the\n`autoUpdate` of the previous one is stopped."},"2009":{"id":"/docs/galactik/overlay/floating-panel-10","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#how-it-works","content":"**`topLayer`** makes the panel a manual popover (`popover=\"manual\"` and `showPopover()`): it goes above a `<dialog>`\nand outside the clipping of every ancestor, and is hidden again when it goes away. Without it, a modal dialog clips what\noverflows its own box."},"2010":{"id":"/docs/galactik/overlay/floating-panel-11","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#options","content":"<TypeTable\n  type=\"{\n  panel: { type: &#x22;() => HTMLElement | null | undefined&#x22;, description: &#x22;Required. The panel; a signal read — it may appear and disappear.&#x22; },\n  anchor: { type: &#x22;() => HTMLElement | null | undefined&#x22;, description: &#x22;Required. The element the panel hangs from: the field box, a trigger, the parent item of a submenu.&#x22; },\n  placement: { type: &#x22;Placement | (() => Placement)&#x22;, default: '&#x22;bottom-start&#x22;', description: &#x22;Any Floating UI placement; it flips and shifts when the room runs out.&#x22; },\n  offset: { type: &#x22;number&#x22;, default: &#x22;4&#x22;, description: &#x22;Distance from the anchor, in pixels.&#x22; },\n  padding: { type: &#x22;number&#x22;, default: &#x22;8&#x22;, description: &#x22;Margin kept from the viewport edges when the panel is shifted back in.&#x22; },\n  anchorWidthVariable: { type: &#x22;string&#x22;, description: 'A CSS custom property (&#x22;--select-trigger-w&#x22;) that receives the anchor\\'s width, for the panel\\'s own CSS.' },\n  matchAnchorWidth: { type: &#x22;boolean | (() => boolean)&#x22;, default: &#x22;false&#x22;, description: &#x22;Gives the panel the width of the anchor (an inline width).&#x22; },\n  topLayer: { type: &#x22;boolean | (() => boolean)&#x22;, default: &#x22;false&#x22;, description: &#x22;Puts the panel in the browser's top layer, above a dialog.&#x22; },\n  afterPosition: { type: &#x22;(anchor: HTMLElement, panel: HTMLElement) => void&#x22;, description: &#x22;Runs after each position update.&#x22; },\n}\"\n/>"},"2011":{"id":"/docs/galactik/overlay/floating-panel-12","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#pitfalls","content":"It is not `position: fixed`. Put `fixed` in the panel's class: the helper writes viewport coordinates and relies on it."},"2012":{"id":"/docs/galactik/overlay/floating-panel-13","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#pitfalls","content":"Turn on `topLayer`. A `fixed` panel escapes an ancestor's `overflow`, but a modal `<dialog>` and a `transform`ed ancestor\nstill clip or re-anchor it; the top layer is above all of them."},"2013":{"id":"/docs/galactik/overlay/floating-panel-14","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#pitfalls","content":"It creates an `afterRenderEffect`, which needs an injection context: call it from the constructor (or a field initializer)\nof the component that owns the panel."},"2014":{"id":"/docs/galactik/overlay/floating-panel-15","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#whats-next","content":"The directive for a panel opened by a button and light-dismissed."},"2015":{"id":"/docs/galactik/overlay/floating-panel-16","page_id":"/docs/galactik/overlay/floating-panel","tags":[],"type":"text","url":"/docs/galactik/overlay/floating-panel#whats-next","content":"Its submenus are positioned with this helper."},"2016":{"id":"/docs/galactik/overlay","page_id":"/docs/galactik/overlay","type":"page","content":"Overlay","breadcrumbs":["Docs","Galactik","Overlay"],"tags":[],"url":"/docs/galactik/overlay"},"2017":{"id":"/docs/galactik/overlay-0","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay","content":"Components that float above the page — Dialog, Sheet, Menu, Popover, Tooltip — and the tokens and layering rules they share."},"2018":{"id":"/docs/galactik/overlay-1","page_id":"/docs/galactik/overlay","type":"heading","tags":[],"url":"/docs/galactik/overlay#whats-next","content":"What's next"},"2019":{"id":"/docs/galactik/overlay-2","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay","content":"An overlay is anything that renders above the rest of the page and captures focus or dismissal on its own\nterms: a modal dialog, an edge-anchored sheet, a dropdown menu, a floating popover. `@sinequa/galactik`'s\noverlays share the same scrim tokens (`--scrim-base`, `--blur-xs`) and, wherever the platform allows it, the\nnative top layer — so none of them need an application-level `z-index` to stack correctly above ordinary\ncontent."},"2020":{"id":"/docs/galactik/overlay-3","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay#whats-next","content":"Modal and non-modal windows, six composable layout slots, and the imperative call/result API every\nstacked overlay in this library builds on."},"2021":{"id":"/docs/galactik/overlay-4","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay#whats-next","content":"A modal panel anchored to one edge of the viewport — the drawer pattern — sharing Dialog's tokens."},"2022":{"id":"/docs/galactik/overlay-5","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay#whats-next","content":"An accessible dropdown/contextual menu with nested submenus and checkable items."},"2023":{"id":"/docs/galactik/overlay-6","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay#whats-next","content":"The positioning primitive Menu is built on, for any floating content that isn't a list of actions."},"2024":{"id":"/docs/galactik/overlay-7","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay#whats-next","content":"Keeps a popup under or beside an anchor — a combobox's list, a submenu — in the top layer on request."},"2025":{"id":"/docs/galactik/overlay-8","page_id":"/docs/galactik/overlay","tags":[],"type":"text","url":"/docs/galactik/overlay#whats-next","content":"A short description on hover and keyboard focus, in the top layer, with the same selector as the @sinequa/ui one."},"2026":{"id":"/docs/galactik/overlay/menu","page_id":"/docs/galactik/overlay/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Galactik","Overlay"],"tags":[],"url":"/docs/galactik/overlay/menu"},"2027":{"id":"/docs/galactik/overlay/menu-0","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu","content":"An accessible dropdown or contextual menu built on @angular/aria — roving focus, typeahead, unlimited nested submenus, and checkable items with no interactive control inside a menuitem."},"2028":{"id":"/docs/galactik/overlay/menu-1","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#minimal-example","content":"Minimal example"},"2029":{"id":"/docs/galactik/overlay/menu-2","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#how-it-works","content":"How it works"},"2030":{"id":"/docs/galactik/overlay/menu-3","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#recipes","content":"Recipes"},"2031":{"id":"/docs/galactik/overlay/menu-4","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#grouping-items-with-a-separator","content":"Grouping items, with a separator"},"2032":{"id":"/docs/galactik/overlay/menu-5","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#nested-submenus","content":"Nested submenus"},"2033":{"id":"/docs/galactik/overlay/menu-6","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#checkable-items--no-control-inside-a-menuitem","content":"Checkable items — no control inside a `menuitem`"},"2034":{"id":"/docs/galactik/overlay/menu-7","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#right-click--context-menu","content":"Right-click / context menu"},"2035":{"id":"/docs/galactik/overlay/menu-8","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#give-another-panel-the-menus-look","content":"Give another panel the Menu's look"},"2036":{"id":"/docs/galactik/overlay/menu-9","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#options","content":"Options"},"2037":{"id":"/docs/galactik/overlay/menu-10","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#pitfalls","content":"Pitfalls"},"2038":{"id":"/docs/galactik/overlay/menu-11","page_id":"/docs/galactik/overlay/menu","type":"heading","tags":[],"url":"/docs/galactik/overlay/menu#whats-next","content":"What's next"},"2039":{"id":"/docs/galactik/overlay/menu-12","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu","content":"A dropdown of actions, a \"kebab\" row menu, a nested settings menu — `Menu` composes `MenuItem`s (with optional\nnested `SubMenu`s) inside `MenuContent`, wired to a trigger with `MenuTriggerDirective`. It is itself a\npopover — opening, positioning, dismissal and focus restoration all come from the same native Popover API\nPopover is built on, applied as a host directive, so there is no `<div popover>` wrapper to\nwrite yourself."},"2040":{"id":"/docs/galactik/overlay/menu-13","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu","content":"A menu's items are not each individually tabbable: `Tab` leaves the whole menu in one step, and `↓`/`↑`/`Home`/\n`End` move a single \"active\" focus between items instead. This is the ARIA **menu** pattern, and\n`@angular/aria/menu` implements all of it — the roving focus, the keyboard navigation, and typeahead — so\n`Menu` only has to compose the pieces."},"2041":{"id":"/docs/galactik/overlay/menu-14","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#minimal-example","content":"`[menuTrigger]=\"menu\"` wires `popovertarget`, `aria-haspopup=\"menu\"` and a reactive `aria-expanded` onto the\nbutton — no manual `id` to invent or keep in sync. See Pitfalls for the one thing this example\nwould silently break without: the `#menu=\"menu\"` export form."},"2042":{"id":"/docs/galactik/overlay/menu-15","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#how-it-works","content":"`Menu` applies two host directives rather than wrapping either: `@angular/aria`'s `Menu` (roving focus,\nkeyboard navigation, typeahead, the `itemSelected` output) and this library's own `PopoverDirective`\n(positioning, native show/close, the `state` signal). Selecting a non-submenu item closes the popover; opening\na submenu never bubbles into that same close path, so the root stays open while a submenu is showing."},"2043":{"id":"/docs/galactik/overlay/menu-16","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#how-it-works","content":"`itemSelected` bound only on the root `<Menu>` still fires for an item selected several `SubMenu` levels deep —\nselection bubbles all the way up, so there is never a reason to bind a handler on every nested level."},"2044":{"id":"/docs/galactik/overlay/menu-17","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#grouping-items-with-a-separator","content":"`MenuContent` accepts arbitrary projected content — group items visually with `role=\"group\"` + a heading span,\nseparated by a `.dialog-sep` marker div (both pre-styled)."},"2045":{"id":"/docs/galactik/overlay/menu-18","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#grouping-items-with-a-separator","content":"`[disabled]=\"true\"` excludes an item from keyboard navigation and selection. `.heading` spans and `role=\"group\"`\nwrappers are not focusable and are skipped by the roving navigation."},"2046":{"id":"/docs/galactik/overlay/menu-19","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#nested-submenus","content":"Nest a `<SubMenu>` as a **sibling** of the `<MenuItem>` that opens it — never a child — and wire the two\ntogether with `[submenu]`. Submenus can be nested arbitrarily deep by repeating the pattern."},"2047":{"id":"/docs/galactik/overlay/menu-20","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#nested-submenus","content":"Do **not** add a `<MenuContent>` inside `<SubMenu>` — it is already implicit in the component's own template.\nCustomize a submenu's side with `placement` (defaults to `\"right-start\"`, and flips/shifts with Floating UI\nlike the root popover does)."},"2048":{"id":"/docs/galactik/overlay/menu-21","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#checkable-items--no-control-inside-a-menuitem","content":"A menu entry that toggles a state cannot put a control (a checkbox, a switch) **inside** a `MenuItem`: a\n`menuitem` containing an interactive control is invalid ARIA, and it would leave that control out of the\nmenu's own keyboard navigation. The ARIA APG answer is for the item itself to carry the role and the\nstate — supported through `role=\"menuitemcheckbox\"`/`\"menuitemradio\"` plus a `checked` input, which also stops\nthe menu from closing when such an item is picked, so several options can be toggled in a row."},"2049":{"id":"/docs/galactik/overlay/menu-22","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#checkable-items--no-control-inside-a-menuitem","content":"The state stays owned by the host: the item emits its `value` through `itemSelected` as usual, the host flips\nits own signal, and `checked`/the projected `Switch` reflect it back. `presentational` on `Switch` makes its\nown `<input>` `inert` — out of the keyboard path and the accessibility tree, since the `MenuItem` itself is\nalready the interactive element the switch merely illustrates."},"2050":{"id":"/docs/galactik/overlay/menu-23","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#right-click--context-menu","content":"`[menuTrigger]` only sets `popovertarget` — the native browser auto-invoke for that attribute only applies to\n`<button>`, so a plain element needs to open the menu imperatively, e.g. on `contextmenu`."},"2051":{"id":"/docs/galactik/overlay/menu-24","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#right-click--context-menu","content":"`MenuComponent` exposes its underlying `PopoverDirective` through the public `popover` property\n(`menu.popover.show()`/`.close()`/`.toggle()`/`.state()`), which is what makes this kind of imperative control\npossible."},"2052":{"id":"/docs/galactik/overlay/menu-25","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#give-another-panel-the-menus-look","content":"A panel that is not a `Menu` — a listbox of search results, a custom popover — can wear the same surface through the\nclass helpers the `Menu` itself is built from: `menuPanelVariants()` (rounded, shadowed, padded panel),\n`menuItemVariants()` (a row, with hover, active and disabled states), `menuContentVariants()` and\n`menuSeparatorVariants()`. They only return class names; the behaviour — roles, keyboard, positioning — stays yours."},"2053":{"id":"/docs/galactik/overlay/menu-26","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#give-another-panel-the-menus-look","content":"A row that is the current one is tinted like a hovered item: `data-active=\"true\"` for the Menu's own roving items and for\nthe options of an `@angular/aria` listbox (which mark the current row that way), `aria-selected=\"true\"` for a listbox written\nby hand following the APG."},"2054":{"id":"/docs/galactik/overlay/menu-27","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#options","content":"<TypeTable\n  type=\"{\n  wrap: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;Forwarded from @angular/aria/menu. Whether focus wraps from the last item back to the first, and vice versa.&#x22;,\n  },\n  typeaheadDelay: {\n    type: &#x22;number&#x22;,\n    default: &#x22;500&#x22;,\n    description: &#x22;Forwarded from @angular/aria/menu. Delay (ms) before the typeahead search buffer clears.&#x22;,\n  },\n  placement: {\n    type: &#x22;Placement&#x22;,\n    default: '&#x22;bottom&#x22; (root) · &#x22;right-start&#x22; (SubMenu)',\n    description: &#x22;Forwarded from PopoverDirective. Any @floating-ui/dom placement; flips/shifts on collision.&#x22;,\n  },\n  offset: { type: &#x22;number&#x22;, default: &#x22;4&#x22;, description: &#x22;Forwarded from PopoverDirective. Distance in pixels between trigger and menu.&#x22; },\n  class: { type: &#x22;string&#x22;, description: &#x22;Additional Tailwind classes, merged via cn().&#x22; },\n}\"\n/>"},"2055":{"id":"/docs/galactik/overlay/menu-28","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#options","content":"`itemSelected` emits the selected `MenuItem`'s `value` — never emitted by an item that only opens a submenu.\nBecause the output is exposed through a host directive, Angular does not infer its generic type from the\ntemplate: type the handler's parameter explicitly to constrain it."},"2056":{"id":"/docs/galactik/overlay/menu-29","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#pitfalls","content":"The template reference must use the `exportAs` form — `#menu=\"menu\"` — not a bare `#menu`. Without it, Angular\ntypes the reference as the host `HTMLElement` instead of `MenuComponent`, which is what `[menuTrigger]` and\n`.popover` both need."},"2057":{"id":"/docs/galactik/overlay/menu-30","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#pitfalls","content":"The reference on `<SubMenu>` must be `#moreSub=\"ngMenu\"`, **not** `=\"submenu\"`. `[submenu]` on `MenuItem`\nexpects the underlying `@angular/aria` `Menu` directive instance — exported as `ngMenu` — not the\n`SubMenuComponent` wrapper, which is what `=\"submenu\"` would give you instead."},"2058":{"id":"/docs/galactik/overlay/menu-31","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#pitfalls","content":"Putting an interactive control **inside** a `MenuItem` is invalid ARIA and takes that control out of the\nmenu's own roving focus — clicking it may also close the menu on every toggle. Use\n`role=\"menuitemcheckbox\"`/`\"menuitemradio\"` plus the `checked` input on `MenuItem` itself instead, with a\n`presentational` `Switch`/`Checkbox` as illustration only — see\nCheckable items above."},"2059":{"id":"/docs/galactik/overlay/menu-32","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#pitfalls","content":"`SubMenu`'s host relies on a `data-[visible=false]:hidden` utility to hide itself when closed. Overriding\n`class` with a `display` utility (`flex`, `block`, …) on `<SubMenu>` drops that variant unless you keep it or\nan equivalent rule — the panel then lays out inline even while closed."},"2060":{"id":"/docs/galactik/overlay/menu-33","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#pitfalls","content":"`atomic-ui`'s legacy `Menu`/`MenuContent`/`MenuItem` docs describe an older implementation, but on this branch\n`Menu` has already been fully migrated to Galactik across `@sinequa/atomic-angular` — there is no active\nduplicate to reconcile here, unlike `Sheet` and `Popover`. Any remaining `atomic-ui` `Menu` reference you find\nis historical."},"2061":{"id":"/docs/galactik/overlay/menu-34","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#whats-next","content":"The positioning primitive Menu is built on — reach for it directly for content that isn't a list of actions."},"2062":{"id":"/docs/galactik/overlay/menu-35","page_id":"/docs/galactik/overlay/menu","tags":[],"type":"text","url":"/docs/galactik/overlay/menu#whats-next","content":"A modal window with the same imperative call/result API, for content heavier than a menu."},"2063":{"id":"/docs/galactik/overlay/popover","page_id":"/docs/galactik/overlay/popover","type":"page","content":"Popover","breadcrumbs":["Docs","Galactik","Overlay"],"tags":[],"url":"/docs/galactik/overlay/popover"},"2064":{"id":"/docs/galactik/overlay/popover-0","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover","content":"Enhance the native HTML Popover API with Floating UI positioning — the bare primitive Menu and every other floating panel in this library are built from."},"2065":{"id":"/docs/galactik/overlay/popover-1","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#minimal-example","content":"Minimal example"},"2066":{"id":"/docs/galactik/overlay/popover-2","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#how-it-works","content":"How it works"},"2067":{"id":"/docs/galactik/overlay/popover-3","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#recipes","content":"Recipes"},"2068":{"id":"/docs/galactik/overlay/popover-4","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#dropdown--closes-on-item-click","content":"Dropdown — closes on item click"},"2069":{"id":"/docs/galactik/overlay/popover-5","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#locking-the-position-for-a-trigger-that-moves","content":"Locking the position, for a trigger that moves"},"2070":{"id":"/docs/galactik/overlay/popover-6","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#programmatic-control-and-reactive-state","content":"Programmatic control and reactive state"},"2071":{"id":"/docs/galactik/overlay/popover-7","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#options","content":"Options"},"2072":{"id":"/docs/galactik/overlay/popover-8","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#pitfalls","content":"Pitfalls"},"2073":{"id":"/docs/galactik/overlay/popover-9","page_id":"/docs/galactik/overlay/popover","type":"heading","tags":[],"url":"/docs/galactik/overlay/popover#whats-next","content":"What's next"},"2074":{"id":"/docs/galactik/overlay/popover-10","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover","content":"`PopoverDirective` wraps the native HTML **Popover API** (the `popover` attribute) with intelligent\npositioning from Floating UI. It responds to two selectors — `[popover]` and `[dropdown]` — which are the same\ndirective; `[dropdown]` only changes one default. Reach for it directly when the floating content is not a\nlist of actions; when it is, Menu is built on exactly this directive and adds the ARIA menu\nsemantics on top."},"2075":{"id":"/docs/galactik/overlay/popover-11","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover","content":"An element with a `popover` attribute renders in the browser's **top layer** — above everything else, no\n`z-index` required — and is shown/hidden by the browser itself: native focus handling, `Escape`-to-close and\nclick-outside dismissal all come from the platform. `PopoverDirective` adds what the platform does not:\ncomputed placement relative to a trigger, collision-aware repositioning, and a couple of small ergonomics the\nraw attribute leaves to you."},"2076":{"id":"/docs/galactik/overlay/popover-12","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#minimal-example","content":"The trigger/target contract is entirely native HTML: any `<button>` with `popovertarget=\"<id>\"` auto-invokes\nthe element carrying `[popover]`/`[dropdown]` with a matching, page-unique `id` — `PopoverDirective` only adds\nthe positioning once it opens."},"2077":{"id":"/docs/galactik/overlay/popover-13","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#how-it-works","content":"The element starts `visibility: hidden` until the first position is computed, avoiding a flash at the wrong\nspot. `autoUpdate` (repositioning on scroll, resize, or a DOM mutation near the trigger) only runs while the\npopover is open — zero overhead while closed. `[dropdown]` is the exact same directive as `[popover]`; it only\nchanges what `closeOnClick` defaults to (see Options)."},"2078":{"id":"/docs/galactik/overlay/popover-14","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#dropdown--closes-on-item-click","content":"Use `[dropdown]` for menus or lists where picking an item should always close the panel. `PopoverDirective` is\na bare positioning primitive with no \"menu item\" look of its own — factor the item classes into your own\nreusable component, or reach for Menu when the content is an actions list with keyboard\nnavigation."},"2079":{"id":"/docs/galactik/overlay/popover-15","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#dropdown--closes-on-item-click","content":"Opt a `[dropdown]` out of its default click-to-close with an explicit `[config]`:\n`[config]=\"{ closeOnClick: false }\"`."},"2080":{"id":"/docs/galactik/overlay/popover-16","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#locking-the-position-for-a-trigger-that-moves","content":"By default `flip()`/`shift()` reposition the popover if the viewport runs out of room. `[lockPosition]=\"true\"`\ndisables both, forcing it to stay at the exact configured `placement` — useful when a consuming component\nalready accounts for available space itself and a repositioning popover would fight that logic."},"2081":{"id":"/docs/galactik/overlay/popover-17","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#programmatic-control-and-reactive-state","content":"Grab the directive instance with `exportAs=\"popover\"` (or `\"dropdown\"`) to drive it imperatively, and read\n`state()` to react to it."},"2082":{"id":"/docs/galactik/overlay/popover-18","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#options","content":"<TypeTable\n  type=\"{\n  class: { type: &#x22;string&#x22;, description: &#x22;Additional classes merged with the directive's own defaults (m-0 fixed — no padding: the surface that wears the directive decides) via cn().&#x22; },\n  placement: {\n    type: &#x22;Placement&#x22;,\n    default: '&#x22;bottom&#x22;',\n    description: &#x22;Position relative to the trigger. Any of the 12 @floating-ui/dom placements.&#x22;,\n  },\n  offset: { type: &#x22;number&#x22;, default: &#x22;4&#x22;, description: &#x22;Distance in pixels between the trigger and the popover.&#x22; },\n  config: {\n    type: &#x22;{ closeOnScroll?: boolean; closeOnClick?: boolean }&#x22;,\n    default: &#x22;{} — closeOnClick true only via [dropdown]&#x22;,\n    description: &#x22;Not re-exported from public-api.ts — pass a matching object literal inline, no import required.&#x22;,\n  },\n  lockPosition: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Forces the popover to stay at the exact placement, disabling the flip()/shift() middleware.&#x22;,\n  },\n}\"\n/>"},"2083":{"id":"/docs/galactik/overlay/popover-19","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#options","content":"Read through a template reference (`#ref=\"popover\"` or `\"dropdown\"`): `width` (`Signal<number>`, the trigger's\n`offsetWidth`, handy for width-matched panels) and `state` (`Signal<\"open\" | \"closed\">`). Methods: `close()`,\n`show()`, `toggle()`. No outputs — react to `state()` instead."},"2084":{"id":"/docs/galactik/overlay/popover-20","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#pitfalls","content":"Not anymore, on this branch — both `PopoverDirective` and its `DropdownDirective` alias are exported from\n`public-api.ts`. Either import name resolves to the same class; the **selector you write in the template**\n(`[popover]` vs `[dropdown]`), not the TypeScript import name, is what decides the default `closeOnClick`."},"2085":{"id":"/docs/galactik/overlay/popover-21","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#pitfalls","content":"Expected on the very first paint of a popover that has never opened before: the element starts\n`visibility: hidden` until the first `computePosition` resolves, specifically to avoid a flash at an\nunpositioned spot. If you still see a visible flash, check that nothing overrides that initial visibility with\na `class` input."},"2086":{"id":"/docs/galactik/overlay/popover-22","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#pitfalls","content":"The native auto-invoke behavior for `popovertarget` only applies to `<button>`/`<input type=\"button\">`\nelements. A `<div>` or similar acting as a trigger (a context-menu anchor, for instance) needs to open the\npopover imperatively — grab the directive with a template reference and call `.show()`/`.toggle()` from your\nown event handler, as in Programmatic control above."},"2087":{"id":"/docs/galactik/overlay/popover-23","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#pitfalls","content":"The native Popover API requirement means no iOS 16 and below. Minimum versions: Chrome 114+, Edge 114+, Safari\n17+ (iOS 17+), Firefox 125+."},"2088":{"id":"/docs/galactik/overlay/popover-24","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#pitfalls","content":"`@sinequa/ui` ships its own `PopoverDirective`/`DropdownDirective` with a similar API shape (the same\n`placement`/`offset`/`config`, the same `exportAs` pattern) but a distinct implementation and CSS — unlike\n`Menu`, which has fully migrated, **both implementations genuinely coexist** on this branch. Always check the\nactual import path before assuming which one a `Popover`/`Dropdown` symbol in a file refers to."},"2089":{"id":"/docs/galactik/overlay/popover-25","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#whats-next","content":"The ARIA menu built on this same directive, for a list of actions with keyboard navigation."},"2090":{"id":"/docs/galactik/overlay/popover-26","page_id":"/docs/galactik/overlay/popover","tags":[],"type":"text","url":"/docs/galactik/overlay/popover#whats-next","content":"What this library is, and how it relates to atomic-angular."},"2091":{"id":"/docs/galactik/overlay/sheet","page_id":"/docs/galactik/overlay/sheet","type":"page","content":"Sheet","breadcrumbs":["Docs","Galactik","Overlay"],"tags":[],"url":"/docs/galactik/overlay/sheet"},"2092":{"id":"/docs/galactik/overlay/sheet-0","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet","content":"A modal panel anchored to one edge of the viewport — the drawer pattern — built on the same native <dialog> as Dialog, with its own slide-in/out animation and scroll lock."},"2093":{"id":"/docs/galactik/overlay/sheet-1","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#minimal-example","content":"Minimal example"},"2094":{"id":"/docs/galactik/overlay/sheet-2","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#how-it-works","content":"How it works"},"2095":{"id":"/docs/galactik/overlay/sheet-3","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#recipes","content":"Recipes"},"2096":{"id":"/docs/galactik/overlay/sheet-4","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#the-four-sides","content":"The four sides"},"2097":{"id":"/docs/galactik/overlay/sheet-5","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#a-footer-with-actions","content":"A footer with actions"},"2098":{"id":"/docs/galactik/overlay/sheet-6","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#a-panel-with-no-visible-title","content":"A panel with no visible title"},"2099":{"id":"/docs/galactik/overlay/sheet-7","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#returning-a-value--createcallable","content":"Returning a value — `createCallable`"},"2100":{"id":"/docs/galactik/overlay/sheet-8","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#options","content":"Options"},"2101":{"id":"/docs/galactik/overlay/sheet-9","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#pitfalls","content":"Pitfalls"},"2102":{"id":"/docs/galactik/overlay/sheet-10","page_id":"/docs/galactik/overlay/sheet","type":"heading","tags":[],"url":"/docs/galactik/overlay/sheet#whats-next","content":"What's next"},"2103":{"id":"/docs/galactik/overlay/sheet-11","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet","content":"Filters sliding in from the right, a navigation panel from the left, a mobile action tray from the bottom —\n`Sheet` is that edge-anchored panel. It is built on a native `<dialog>` opened with `showModal()`, exactly as\nDialog is: a sheet **is** a modal dialog, only its geometry differs, so both share the same\n`DIALOG_REF`/`MODAL_LABEL` tokens and the same `DialogEvent` close events."},"2104":{"id":"/docs/galactik/overlay/sheet-12","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet","content":"Unlike `Dialog`, `Sheet` has no inner content element: the `<dialog>` itself carries the surface, the geometry\nand the animation. A native modal `<dialog>` already exposes `role=\"dialog\"` and `aria-modal=\"true\"`, so an\ninner element repeating them would put a second, redundant dialog in the accessibility tree — and the element\nthat animates has to be the one the component owns, which projected content is not."},"2105":{"id":"/docs/galactik/overlay/sheet-13","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#minimal-example","content":"`#panel=\"sheet\"` reads `SheetComponent` off its `exportAs`, then `open()` (an alias for `showModal()`) shows it.\nThere is no intermediate content element — `SheetHeader`/`SheetBody` project straight into `<Sheet>`."},"2106":{"id":"/docs/galactik/overlay/sheet-14","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`side` is what distinguishes a sheet from a dialog: it drives the inset, the size axis (a **width** for\n`left`/`right`, a **height** for `top`/`bottom`), the border, the rounded corners (the two corners flush\nagainst the viewport stay square) and the slide direction, all from the one input."},"2107":{"id":"/docs/galactik/overlay/sheet-15","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`size`"},"2108":{"id":"/docs/galactik/overlay/sheet-16","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`left` / `right` (width)"},"2109":{"id":"/docs/galactik/overlay/sheet-17","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`top` / `bottom` (height)"},"2110":{"id":"/docs/galactik/overlay/sheet-18","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`sm`"},"2111":{"id":"/docs/galactik/overlay/sheet-19","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"400px"},"2112":{"id":"/docs/galactik/overlay/sheet-20","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"25% of the viewport"},"2113":{"id":"/docs/galactik/overlay/sheet-21","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`md&#x60; &#x2A;(default)*"},"2114":{"id":"/docs/galactik/overlay/sheet-22","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"520px"},"2115":{"id":"/docs/galactik/overlay/sheet-23","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"33% of the viewport"},"2116":{"id":"/docs/galactik/overlay/sheet-24","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`lg`"},"2117":{"id":"/docs/galactik/overlay/sheet-25","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"720px"},"2118":{"id":"/docs/galactik/overlay/sheet-26","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"50% of the viewport"},"2119":{"id":"/docs/galactik/overlay/sheet-27","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`xl`"},"2120":{"id":"/docs/galactik/overlay/sheet-28","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"960px"},"2121":{"id":"/docs/galactik/overlay/sheet-29","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"75% of the viewport"},"2122":{"id":"/docs/galactik/overlay/sheet-30","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`full`"},"2123":{"id":"/docs/galactik/overlay/sheet-31","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`100dvw`"},"2124":{"id":"/docs/galactik/overlay/sheet-32","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`100dvh`"},"2125":{"id":"/docs/galactik/overlay/sheet-33","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"Opening and closing both come from the same two CSS declarations — no keyframes, no JavaScript timer:"},"2126":{"id":"/docs/galactik/overlay/sheet-34","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"`getAnimations()` rather than a `transitionend` listener: a transition that is **interrupted** emits\n`transitioncancel`, never `transitionend`, and one that never starts — under `prefers-reduced-motion`, where\nevery duration is zero — emits nothing at all. Both were measured on a consumer, where the projected content\nstayed mounted for good inside a hidden panel because `closeEnd` never fired to release it."},"2127":{"id":"/docs/galactik/overlay/sheet-35","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#how-it-works","content":"**The page scroll is locked while a sheet is open** — the one deliberate divergence from `Dialog`. A dialog\ncovers a small part of the viewport and locks nothing; a sheet covers a whole edge of it, so a wheel or touch\ndrag scrolling the page behind it would be disorienting. The lock is counted (`openSheets`), so stacked sheets\nrestore the previous value only once, at the last close — and it compensates for the scrollbar it removes with\nan equal `padding-right`, so a consumer's width-based media query (a `BreakpointObserverService` mobile/desktop\nsplit, say) never observes a spurious viewport-width change from opening one."},"2128":{"id":"/docs/galactik/overlay/sheet-36","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#a-footer-with-actions","content":"`SheetFooter` is a right-aligned action row on a tinted band, pinned below the scrollable body. Every close\npath — a footer button, the header's close button, `Escape`, a scrim click — lands on the same `closed` output."},"2129":{"id":"/docs/galactik/overlay/sheet-37","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#a-panel-with-no-visible-title","content":"A sheet still needs an accessible name with no heading in the design. `ariaLabel` provides it directly and\ntakes precedence over `labelledby` and over any projected title; `closeButton` floats a close affordance for a\nfull-bleed panel that carries no `SheetHeader` at all."},"2130":{"id":"/docs/galactik/overlay/sheet-38","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#returning-a-value--createcallable","content":"A sheet that answers a question — pick a collection, confirm an export — opens imperatively and resolves,\nexactly like a callable dialog: `createCallable` takes any standalone component, and nothing in that path\nrequires a `<dialog>` element, so a `Sheet` works with it unchanged. Wire `end()` to `closeEnd` rather than to\nthe click that closes the panel — that is what lets the exit animation play before the component is destroyed."},"2131":{"id":"/docs/galactik/overlay/sheet-39","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#returning-a-value--createcallable","content":"Cancelling resolves with `undefined`, since `picked` was never set — the promise always settles, whichever way\nthe panel closed, `Escape` and a scrim click included. Reach for this only when the panel's *purpose* is to\nproduce an answer for its caller; a panel driven by state that lives elsewhere (a preview bound to the current\nselection) has no result to await, and a declarative `<Sheet>` fits better there."},"2132":{"id":"/docs/galactik/overlay/sheet-40","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#options","content":"<TypeTable\n  type=\"{\n  side: {\n    type: '&#x22;left&#x22; | &#x22;right&#x22; | &#x22;top&#x22; | &#x22;bottom&#x22;',\n    default: '&#x22;right&#x22;',\n    description: &#x22;Edge the panel is anchored to. Drives the inset, the size axis, the border, the corners and the slide direction.&#x22;,\n  },\n  size: {\n    type: '&#x22;sm&#x22; | &#x22;md&#x22; | &#x22;lg&#x22; | &#x22;xl&#x22; | &#x22;full&#x22;',\n    default: '&#x22;md&#x22;',\n    description: &#x22;Extent along the axis side implies — a width for left/right, a height for top/bottom. See the table above.&#x22;,\n  },\n  labelledby: {\n    type: &#x22;string&#x22;,\n    description: &#x22;Explicit aria-labelledby; otherwise falls back to the id published by a projected DialogTitle.&#x22;,\n  },\n  ariaLabel: {\n    type: &#x22;string&#x22;,\n    description: &#x22;Accessible name for a panel with no visible title. Takes precedence over labelledby and any projected title.&#x22;,\n  },\n  dismissible: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n    description: &#x22;Whether a click on the scrim closes the sheet. Escape closes it either way — see Pitfalls.&#x22;,\n  },\n  closeButton: {\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n    description: &#x22;Floats a close button over the panel, for a full-bleed sheet with no SheetHeader to carry one.&#x22;,\n  },\n  closeLabel: {\n    type: &#x22;string&#x22;,\n    default: '&#x22;Close&#x22;',\n    description: &#x22;Accessible name of the close buttons: the floating one, and every SheetHeader's unless it sets its own closeLabel. Its icon is decorative — translate this.&#x22;,\n  },\n  class: {\n    type: &#x22;string&#x22;,\n    description: &#x22;Additional CSS classes, merged via cn(), onto the <dialog> itself.&#x22;,\n  },\n}\"\n/>"},"2133":{"id":"/docs/galactik/overlay/sheet-41","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#options","content":"`closed` emits a `DialogEvent` once per close, however triggered. `closeEnd` emits once the exit animation has\nsettled and the content has left the DOM — use it, not `closed`, to release anything rendered inside the\npanel."},"2134":{"id":"/docs/galactik/overlay/sheet-42","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#pitfalls","content":"`Sheet` invents no default accessible name. Project a `DialogTitle` into `SheetHeader`, or set `ariaLabel` (or\n`labelledby`) — one of the three is required for an accessible sheet, and this is the single most common way\nto ship one that is not."},"2135":{"id":"/docs/galactik/overlay/sheet-43","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#pitfalls","content":"Expected. `dismissible` only neutralizes the scrim click — `Escape` is native `<dialog>` behavior, and the\ncomponent does not fight it. Suppressing `Escape` would trap a keyboard user inside the panel, which is worse\nthan the dismissal you were trying to prevent."},"2136":{"id":"/docs/galactik/overlay/sheet-44","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#pitfalls","content":"The projected tree is destroyed once the exit animation ends, so any state held in a component inside the body\nstarts over on the next `open()`. Keep state that must survive a close in the host component, not in a child\nmounted only while the sheet is open."},"2137":{"id":"/docs/galactik/overlay/sheet-45","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#pitfalls","content":"If you release resources or reset selection state in response to `(closed)`, do it in `(closeEnd)` instead.\n`closed` fires when closing **starts** — reacting to it by dropping the content a consumer renders inside the\npanel empties it while it is still sliding off-screen. `closeEnd` fires once the exit animation has actually\nsettled (immediately, under reduced motion)."},"2138":{"id":"/docs/galactik/overlay/sheet-46","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#pitfalls","content":"`@sinequa/ui` ships its own `Sheet` (a Radix-style tree of `sheet-root`/`sheet-content`/… driven by a\n`SheetService`, no native `<dialog>` underneath) exporting the very same class names —\n`SheetComponent`/`SheetHeaderComponent`/`SheetFooterComponent` — and, critically, its root selector is the bare\n`sheet`, which also matches Galactik's `Sheet, sheet` selector pattern. That collision is why this `Sheet` has\n**no lowercase `sheet` alias yet**: importing both into the same template makes two components fight over one\nelement. Always check the import path, and never import a `Sheet*`/`[sheetClose]`/`[sheetTrigger]` symbol from\n`@sinequa/ui` in a file that also uses this one."},"2139":{"id":"/docs/galactik/overlay/sheet-47","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#whats-next","content":"The tokens, close events and imperative call/result API this component shares with Sheet."},"2140":{"id":"/docs/galactik/overlay/sheet-48","page_id":"/docs/galactik/overlay/sheet","tags":[],"type":"text","url":"/docs/galactik/overlay/sheet#whats-next","content":"An accessible dropdown/contextual menu, itself built as a popover."},"2141":{"id":"/docs/galactik/overlay/tooltip","page_id":"/docs/galactik/overlay/tooltip","type":"page","content":"Tooltip","breadcrumbs":["Docs","Galactik","Overlay"],"tags":[],"url":"/docs/galactik/overlay/tooltip"},"2142":{"id":"/docs/galactik/overlay/tooltip-0","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip","content":"A short description shown next to any element on hover and keyboard focus, placed in the top layer — the galactik replacement of the @sinequa/ui tooltip directive."},"2143":{"id":"/docs/galactik/overlay/tooltip-1","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#minimal-example","content":"Minimal example"},"2144":{"id":"/docs/galactik/overlay/tooltip-2","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#how-it-works","content":"How it works"},"2145":{"id":"/docs/galactik/overlay/tooltip-3","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#recipes","content":"Recipes"},"2146":{"id":"/docs/galactik/overlay/tooltip-4","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#a-template-as-the-content","content":"A template as the content"},"2147":{"id":"/docs/galactik/overlay/tooltip-5","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#delays-lifetime-and-which-event-opens-it","content":"Delays, lifetime, and which event opens it"},"2148":{"id":"/docs/galactik/overlay/tooltip-6","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#everything-in-one-object","content":"Everything in one object"},"2149":{"id":"/docs/galactik/overlay/tooltip-7","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#driving-it-from-code","content":"Driving it from code"},"2150":{"id":"/docs/galactik/overlay/tooltip-8","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#options","content":"Options"},"2151":{"id":"/docs/galactik/overlay/tooltip-9","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Migration from @sinequa/ui"},"2152":{"id":"/docs/galactik/overlay/tooltip-10","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#pitfalls","content":"Pitfalls"},"2153":{"id":"/docs/galactik/overlay/tooltip-11","page_id":"/docs/galactik/overlay/tooltip","type":"heading","tags":[],"url":"/docs/galactik/overlay/tooltip#whats-next","content":"What's next"},"2154":{"id":"/docs/galactik/overlay/tooltip-12","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip","content":"`TooltipDirective` (`[tooltip]`) shows a short text, or a template, next to the element it sits on. It opens on\nhover **and** on keyboard focus, closes on `Escape`, on blur and on scroll, and lets the pointer move onto the\ntooltip without closing it."},"2155":{"id":"/docs/galactik/overlay/tooltip-13","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip","content":"The host gets `aria-describedby` pointing at the tooltip **while it is open**. A screen reader reads the\ndescription after the element's own name, so an icon-only button still needs an `aria-label`: the tooltip is\nnever its accessible name. Keep the text short — anything the user must read or interact with belongs in a\nPopover or a Dialog."},"2156":{"id":"/docs/galactik/overlay/tooltip-14","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#how-it-works","content":"The panel is a `role=\"tooltip\"` element created on demand — inside the closest `<dialog>` or `[popover]` when the host is in one (a modal dialog makes everything outside it `inert`, and a popover closes on a click outside of it: left on `body`, the tooltip could no longer be hovered or clicked), in `body` otherwise — and positioned by\n`injectFloatingPanel` as a manual popover: it renders in the top layer, above a `<dialog>`\nand outside the clipping of any ancestor, with no `z-index`. Nothing listens on the document while the tooltip is\nclosed — the `Escape` and `scroll` listeners are added when it opens and removed when it closes."},"2157":{"id":"/docs/galactik/overlay/tooltip-15","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#how-it-works","content":"A press on the host (`pointerdown`, `click`) closes the tooltip, and the focus that a press gives a button does\nnot open it again: only a keyboard focus does."},"2158":{"id":"/docs/galactik/overlay/tooltip-16","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#a-template-as-the-content","content":"Pass a `TemplateRef`, or declare an `<ng-template tooltip-content>` inside the host."},"2159":{"id":"/docs/galactik/overlay/tooltip-17","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#everything-in-one-object","content":"`[tooltipOptions]` takes the same settings as the inputs. An input set on its own wins over the object."},"2160":{"id":"/docs/galactik/overlay/tooltip-18","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#driving-it-from-code","content":"`exportAs=\"tooltip\"` gives the instance: `show()`, `hide()` and the `isOpen` signal."},"2161":{"id":"/docs/galactik/overlay/tooltip-19","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#options","content":"<TypeTable\n  type=\"{\n  tooltip: { type: &#x22;string | TemplateRef<unknown> | null | undefined&#x22;, description: &#x22;The content. Empty or blank shows nothing.&#x22; },\n  tooltipPosition: { type: &#x22;Placement&#x22;, default: '&#x22;bottom&#x22;', description: &#x22;Where it goes. top, bottom, left, right, or any Floating UI placement (top-start…).&#x22; },\n  tooltipEvent: { type: '&#x22;hover&#x22; | &#x22;focus&#x22; | &#x22;both&#x22;', default: '&#x22;both&#x22;', description: &#x22;What opens it.&#x22; },\n  showDelay: { type: &#x22;number&#x22;, default: &#x22;0&#x22;, description: &#x22;Milliseconds before it opens.&#x22; },\n  hideDelay: { type: &#x22;number&#x22;, default: &#x22;0&#x22;, description: &#x22;Milliseconds before it closes once the pointer left. With autoHide, never below a short grace of 100 ms.&#x22; },\n  life: { type: &#x22;number&#x22;, default: &#x22;0&#x22;, description: &#x22;Closes it after that many milliseconds, even if the host is still hovered. 0 = no limit.&#x22; },\n  tooltipArrow: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;A small arrow pointing at the host, on the side that touches it (follows the flip). false removes it.&#x22; },\n  tooltipOffset: { type: &#x22;number&#x22;, default: &#x22;8&#x22;, description: &#x22;Distance to the host, in pixels.&#x22; },\n  autoHide: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Stays open while the pointer is over the tooltip (WCAG 1.4.13). Off, it ignores the pointer.&#x22; },\n  hideOnEscape: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;Closes on Escape, and keeps that Escape from also closing a dialog around it.&#x22; },\n  escape: { type: &#x22;boolean&#x22;, default: &#x22;true&#x22;, description: &#x22;The content is text. false renders it as HTML, sanitized by Angular.&#x22; },\n  tooltipDisabled: { type: &#x22;boolean&#x22;, default: &#x22;false&#x22;, description: &#x22;Turns it off. PrimeNG calls this disabled, which is the native attribute of a button.&#x22; },\n  tooltipStyleClass: { type: &#x22;string&#x22;, description: &#x22;Classes merged last into the tooltip's own.&#x22; },\n  tooltipOptions: { type: &#x22;TooltipOptions&#x22;, description: &#x22;All of the above in one object (tooltipLabel for the text, id for the element id).&#x22; },\n}\"\n/>"},"2162":{"id":"/docs/galactik/overlay/tooltip-20","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#options","content":"The tooltip's width is capped by the `--tooltip-max-w` custom property (default `20rem`); set it on the host\nor on an ancestor."},"2163":{"id":"/docs/galactik/overlay/tooltip-21","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"The selector is the same, so a consumer moves with an import change — and cannot use both directives in one\ntemplate. What changed, and why:"},"2164":{"id":"/docs/galactik/overlay/tooltip-22","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`@sinequa/ui`"},"2165":{"id":"/docs/galactik/overlay/tooltip-23","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`@sinequa/galactik`"},"2166":{"id":"/docs/galactik/overlay/tooltip-24","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Hover only"},"2167":{"id":"/docs/galactik/overlay/tooltip-25","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Hover **and** keyboard focus (`tooltipEvent`), `Escape` closes it"},"2168":{"id":"/docs/galactik/overlay/tooltip-26","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"No ARIA"},"2169":{"id":"/docs/galactik/overlay/tooltip-27","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`role=\"tooltip\"` and `aria-describedby` while open"},"2170":{"id":"/docs/galactik/overlay/tooltip-28","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`tooltip-position`"},"2171":{"id":"/docs/galactik/overlay/tooltip-29","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`tooltipPosition` (the old name still works)"},"2172":{"id":"/docs/galactik/overlay/tooltip-30","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`tooltip-delay` (delay before hiding)"},"2173":{"id":"/docs/galactik/overlay/tooltip-31","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`hideDelay` (the old name still works)"},"2174":{"id":"/docs/galactik/overlay/tooltip-32","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`tooltip-offset`"},"2175":{"id":"/docs/galactik/overlay/tooltip-33","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`tooltipOffset` (the old name still works)"},"2176":{"id":"/docs/galactik/overlay/tooltip-34","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`tooltip-duration`, default 3000"},"2177":{"id":"/docs/galactik/overlay/tooltip-35","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`life`, default 0 — **a tooltip no longer closes by itself** (the old name still works)"},"2178":{"id":"/docs/galactik/overlay/tooltip-36","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"No arrow"},"2179":{"id":"/docs/galactik/overlay/tooltip-37","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"An arrow by default (`[tooltipArrow]=\"false\"` removes it)"},"2180":{"id":"/docs/galactik/overlay/tooltip-38","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`[strategy]`"},"2181":{"id":"/docs/galactik/overlay/tooltip-39","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Removed: always `fixed`, in the top layer"},"2182":{"id":"/docs/galactik/overlay/tooltip-40","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`.tooltip` class styled by the application"},"2183":{"id":"/docs/galactik/overlay/tooltip-41","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Styled by the library, from galactik tokens"},"2184":{"id":"/docs/galactik/overlay/tooltip-42","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Appended to the closest `<dialog>` or `body`"},"2185":{"id":"/docs/galactik/overlay/tooltip-43","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Always in the top layer, above dialogs"},"2186":{"id":"/docs/galactik/overlay/tooltip-44","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"`document` scroll listener never removed"},"2187":{"id":"/docs/galactik/overlay/tooltip-45","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#migration-from-sinequaui","content":"Listeners live only while the tooltip is open"},"2188":{"id":"/docs/galactik/overlay/tooltip-46","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#pitfalls","content":"A disabled `<button>` receives no pointer events in most browsers, so nothing opens the tooltip. Put the\ndirective on a wrapper element, or use `aria-disabled=\"true\"` instead of `disabled`."},"2189":{"id":"/docs/galactik/overlay/tooltip-47","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#pitfalls","content":"By design: the first `Escape` dismisses the tooltip and is `preventDefault`-ed, so the native `cancel` of the\n`<dialog>` does not fire; a second `Escape` closes the dialog. Set `[hideOnEscape]=\"false\"` to opt out."},"2190":{"id":"/docs/galactik/overlay/tooltip-48","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#pitfalls","content":"With `autoHide` off the tooltip closes the moment the pointer leaves the host, so it cannot be hovered.\nLeave `autoHide` on (the default): a 100 ms grace lets the pointer cross the gap."},"2191":{"id":"/docs/galactik/overlay/tooltip-49","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#pitfalls","content":"The tooltip is a *description*. If the element has no accessible name, add an `aria-label` (an icon-only\nbutton), and do not repeat the same text in both: a screen reader reads the name, then the description."},"2192":{"id":"/docs/galactik/overlay/tooltip-50","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#pitfalls","content":"The tooltip uses the native Popover API, like Popover: Chrome 114+, Edge 114+, Safari 17+,\nFirefox 125+. Without it the tooltip is still positioned, but without the top layer."},"2193":{"id":"/docs/galactik/overlay/tooltip-51","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#whats-next","content":"The positioning helper the tooltip is placed with."},"2194":{"id":"/docs/galactik/overlay/tooltip-52","page_id":"/docs/galactik/overlay/tooltip","tags":[],"type":"text","url":"/docs/galactik/overlay/tooltip#whats-next","content":"For floating content the user must read or interact with."}},"count":2194},"sorti